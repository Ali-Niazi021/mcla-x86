 }
 
+XmaContext::PacketHandle XmaContext::GetPacketHandle(XMA_CONTEXT_DATA* data, uint32_t packet_index,
+                                                     uint32_t current_input_packet_count) {
+  PacketHandle result{};
+  uint8_t buffer_index = data->current_buffer;
+  const bool in_next_buffer = packet_index >= current_input_packet_count;
+  if (in_next_buffer) {
+    buffer_index ^= 1;
+    packet_index -= current_input_packet_count;
+  }
+  if (!data->IsInputBufferValid(buffer_index)) {
+    return result;
+  }
+  const uint32_t buffer_address = data->GetInputBufferAddress(buffer_index);
+  if (!buffer_address) {
+    REXAPU_ERROR("XmaContext {}: the packet is expected in the {} buffer, which is marked valid but "
+                 "has a null pointer!",
+                 id(), in_next_buffer ? "next" : "current");
+    return result;
+  }
+  if (packet_index >= data->GetInputBufferPacketCount(buffer_index)) {
+    REXAPU_ERROR("XmaContext {}: the packet is expected in the {} buffer, which is too short for it!",
+                 id(), in_next_buffer ? "next" : "current");
+    return result;
+  }
+  result.buffer_index = buffer_index;
+  result.packet_index = packet_index;
+  result.valid = true;
+  return result;
+}
+
 const uint8_t* XmaContext::GetNextPacket(XMA_CONTEXT_DATA* data, uint32_t next_packet_index,
                                          uint32_t current_input_packet_count) {
+  if (cross_buffer_packets_) {
+    const PacketHandle handle = GetPacketHandle(data, next_packet_index, current_input_packet_count);
+    if (!handle.valid) {
+      return nullptr;
+    }
+    return memory()->TranslatePhysical(data->GetInputBufferAddress(handle.buffer_index)) +
+           handle.packet_index * kBytesPerPacket;
+  }
+
   if (next_packet_index < current_input_packet_count) {
     return memory()->TranslatePhysical(data->GetCurrentInputBufferAddress()) +
            next_packet_index * kBytesPerPacket;
@@ -483,6 +531,17 @@ uint32_t XmaContext::GetNextPacketReadOffset(uint8_t* buffer, uint32_t next_pack
   return kBitsPerPacketHeader;
 }
 
+uint32_t XmaContext::GetNextPacketReadOffset(XMA_CONTEXT_DATA* data, uint32_t next_packet_index,
+                                             uint32_t current_input_packet_count) {
+  const PacketHandle handle = GetPacketHandle(data, next_packet_index, current_input_packet_count);
+  if (!handle.valid) {
+    return kBitsPerPacketHeader;
+  }
+  return GetNextPacketReadOffset(
+      memory()->TranslatePhysical(data->GetInputBufferAddress(handle.buffer_index)),
+      handle.packet_index, data->GetInputBufferPacketCount(handle.buffer_index));
+}
+
 memory::RingBuffer XmaContext::PrepareOutputRingBuffer(XMA_CONTEXT_DATA* data) {
   const uint32_t output_capacity = data->output_buffer_block_count * kOutputBytesPerBlock;
   const uint32_t output_read_offset = data->output_buffer_read_offset * kOutputBytesPerBlock;
