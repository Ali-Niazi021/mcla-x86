  private:
+  // LOCAL PATCH - MCLA x86 (xma_cross_buffer_packets): a packet index resolved to (buffer, index),
+  // past the current buffer's end into the other one (Xenia Canary's kPacketHandle).
+  struct PacketHandle {
+    uint8_t buffer_index = 0;
+    uint32_t packet_index = 0;
+    bool valid = false;
+  };
+
   static void SwapInputBuffer(XMA_CONTEXT_DATA* data);
   static int GetSampleRate(int id);
   static int16_t GetPacketNumber(size_t size, size_t bit_offset);
@@ -252,6 +260,10 @@ class XmaContext {
                                uint32_t current_input_packet_count);
   uint32_t GetNextPacketReadOffset(uint8_t* buffer, uint32_t next_packet_index,
                                    uint32_t current_input_packet_count);
+  PacketHandle GetPacketHandle(XMA_CONTEXT_DATA* data, uint32_t packet_index,
+                               uint32_t current_input_packet_count);
+  uint32_t GetNextPacketReadOffset(XMA_CONTEXT_DATA* data, uint32_t next_packet_index,
+                                   uint32_t current_input_packet_count);
   uint8_t* GetCurrentInputBuffer(XMA_CONTEXT_DATA* data);
 
   void Decode(XMA_CONTEXT_DATA* data);
@@ -327,6 +339,7 @@ class XmaContext {
   // lock (a cvar can change between calls, not within one).
   bool race_fixes_ = false;
   bool canary_fixes_ = false;
+  bool cross_buffer_packets_ = false;
 
   std::unique_ptr<DumpState> dump_;
 };
