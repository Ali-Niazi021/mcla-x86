+// LOCAL PATCH - MCLA (0816): resolve_elide_keep_file
+void D3D12TextureCache::InitializeResolveElideStorage(const std::filesystem::path& cache_root, uint32_t title_id) {
+  resolve_elide_keep_file_path_.clear();
+  if (!REXCVAR_GET(resolve_elide_keep_file) || !IsDrawResolutionScaled()) {
+    return;
+  }
+  const std::filesystem::path directory = cache_root / "shaders" / "shareable";
+  std::error_code directory_error;
+  std::filesystem::create_directories(directory, directory_error);
+  resolve_elide_keep_file_path_ = directory / fmt::format("{:08X}.resolve-keep.txt", title_id);
+  FILE* file = rex::filesystem::OpenFile(resolve_elide_keep_file_path_, "rb");
+  if (!file) {
+    return;
+  }
+  char line[256];
+  while (std::fgets(line, sizeof(line), file)) {
+    // addr=0x...,len=...,pitch=...,height=...,fmt=...,src=... (DescribeResolveElideKey).
+    static const char* const kFieldNames[] = {"addr=", "len=", "pitch=", "height=", "fmt=", "src="};
+    ResolveElideKeyFields fields = {};
+    const char* cursor = line;
+    bool parsed = true;
+    for (size_t field = 0; field < fields.size() && parsed; ++field) {
+      const size_t name_length = std::strlen(kFieldNames[field]);
+      if (std::strncmp(cursor, kFieldNames[field], name_length)) {
+        parsed = false;
+        break;
+      }
+      char* end = nullptr;
+      fields[field] = uint32_t(std::strtoul(cursor + name_length, &end, 0));
+      if (end == cursor + name_length || (field + 1 < fields.size() && *end != ',')) {
+        parsed = false;
+        break;
+      }
+      cursor = end + (field + 1 < fields.size() ? 1 : 0);
+    }
+    if (!parsed || resolve_elide_keys_.size() >= kMaxResolveElideKeys ||
+        resolve_elide_key_indices_.find(fields) != resolve_elide_key_indices_.end()) {
+      continue;
+    }
+    resolve_elide_key_indices_.emplace(fields, uint32_t(resolve_elide_keys_.size()));
+    resolve_elide_keys_.emplace_back();
+    ResolveElideKeyInfo& info = resolve_elide_keys_.back();
+    info.fields = fields;
+    info.kept_consumed = true;
+    info.from_file = true;
+    ++resolve_elide_keep_file_rules_;
+  }
+  std::fclose(file);
+  REXGPU_INFO("[resolve-elide] keep file: {} destinations stored from the start, from {}", resolve_elide_keep_file_rules_,
+              rex::path_to_utf8(resolve_elide_keep_file_path_));
+}
+
 std::string D3D12TextureCache::DescribeResolveElideKey(const ResolveElideKeyInfo& info) const {
   const ResolveElideKeyFields& f = info.fields;
   return fmt::format("addr=0x{:08X},len={},pitch={},height={},fmt={},src={}", f[0], f[1], f[2], f[3], f[4], f[5]);
