index 18a7ec3..e9453e2 100644
--- a/src/graphics/d3d12/render_target_cache.cpp
+++ b/src/graphics/d3d12/render_target_cache.cpp
@@ -106,6 +106,27 @@ REXCVAR_DECLARE(bool, resolve_dual_write_msaa);  // LOCAL PATCH - MCLA (0530): r
 // LOCAL PATCH - MCLA (0560): resolve_defer_memory_write (defined in resolve_defer.cpp)
 REXCVAR_DECLARE(bool, resolve_defer_memory_write);
 
+// LOCAL PATCH - MCLA (0813): transfer_skip_scrambled
+REXCVAR_DEFINE_INT32(transfer_skip_scrambled, 0, "GPU/D3D12",
+                     "Host render targets: an EDRAM ownership transfer whose source and destination lay their pixels "
+                     "out differently in the EDRAM is not made (the destination keeps what its own resource holds), "
+                     "a bit for each difference: 1 the sample count (1x / 2x / 4x MSAA), 2 the bits a pixel (32 against "
+                     "64), 4 the pitch. Each pixel of such a destination would get the bits of another pixel (or "
+                     "sample) of the source: the console shows that garbage, nothing can use it. Transfers between "
+                     "targets of the same layout are always made, also from depth to colour and between formats (the "
+                     "same pixel's bits read another way, which titles do use), and so are those whose bases differ "
+                     "only (a whole-tile shift). 0, the default: every transfer is made. Logs "
+                     "'[transfer-skip-scrambled] ...' every 10 s")
+    .range(0, 7)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_BOOL(transfer_skip_scrambled_poison, false, "GPU/D3D12",
+                    "Development check of transfer_skip_scrambled: the area of a transfer it leaves out is cleared "
+                    "instead (colour: magenta; depth / stencil: depth 0.5, stencil 0xA5, which a depth or stencil test "
+                    "that relied on it passes or fails in large patches), so anything that uses those pixels before "
+                    "they are drawn or cleared shows in the picture")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
