+  // LOCAL PATCH - MCLA (0813): transfer_skip_scrambled: the transfers of each render target without the ones whose source
+  // lays its pixels out differently (mask: the bits of the cvar), the area of those cleared with the poison if asked;
+  // `transfers` itself when none is left out. cutout: the area the transfers are cut to anyway.
+  const std::vector<Transfer>* FilterScrambledTransfers(uint32_t render_target_count,
+                                                        RenderTarget* const* render_targets,
+                                                        const std::vector<Transfer>* transfers,
+                                                        const Transfer::Rectangle* cutout, uint32_t mask);
+  std::vector<Transfer> scrambled_filtered_transfers_[1 + xenos::kMaxColorRenderTargets];
 
   // Accepts an array of (1 + xenos::kMaxColorRenderTargets) render targets,
   // first depth, then color.
