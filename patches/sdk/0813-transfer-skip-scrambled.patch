         for (uint32_t j = 0; j < full_count; ++j) {
           pixels_full += uint64_t(census_rectangles[j].width_pixels) * census_rectangles[j].height_pixels;
@@ -5714,7 +5888,7 @@ void D3D12RenderTargetCache::PerformTransfersAndResolveClears(
       // would mean no depth / stencil target), so the rectangle is the whole cut of the stencil.
       const Transfer::Rectangle* stencil_cutout = resolve_clear_rectangle;
       if (need_stencil_bit_draws && transfer_stencil_cutout_valid_ &&
-          &current_transfers == &last_update_transfers()[0] &&
+          render_target_transfers_in == last_update_transfers() && i == 0 &&  // LOCAL PATCH - MCLA (0813): the input
           (!resolve_clear_rectangle || !resolve_clear_rectangle->width_pixels ||
            !resolve_clear_rectangle->height_pixels)) {
         stencil_cutout = &transfer_stencil_cutout_;
