 // IssueSwap and d3d12_presenter.cpp). Read by every resolve and every swap.
 REXCVAR_DEFINE_BOOL(swap_direct_present, false, "GPU/D3D12",
@@ -5229,16 +5250,169 @@ uint32_t ClearFullOutsideRects(LONG width, LONG height, const D3D12_RECT& rect,
   return count;
 }
 
+// The counts behind the 10 s line. The CP thread only.
+struct ScrambledTransferStats {
+  uint64_t skipped_by_bit[3] = {};
+  uint64_t skipped = 0, kept = 0;
+  uint64_t host_pixels = 0, bytes = 0, stencil_bit_passes = 0, poisoned = 0;
+  std::chrono::steady_clock::time_point window_start = std::chrono::steady_clock::now();
+
+  void LogIfDue() {
+    const auto now = std::chrono::steady_clock::now();
+    const double seconds = std::chrono::duration<double>(now - window_start).count();
+    if (seconds < 10.0) {
+      return;
+    }
+    if (skipped || kept) {
+      REXGPU_INFO(
+          "[transfer-skip-scrambled] {:.1f} s: {} transfers left out (sample count differs {}, bits a pixel {}, pitch "
+          "{}; a transfer can have several), {} of the same layout made; {:.1f} host Mpx and {:.1f} MB (read and "
+          "written) not moved, {} stencil-bit passes not drawn{}",
+          seconds, skipped, skipped_by_bit[0], skipped_by_bit[1], skipped_by_bit[2], kept, double(host_pixels) / 1e6,
+          double(bytes) / 1048576.0, stencil_bit_passes,
+          poisoned ? fmt::format(" ({} areas filled: transfer_skip_scrambled_poison)", poisoned) : std::string());
+    }
+    *this = ScrambledTransferStats();
+    window_start = now;
+  }
+};
+ScrambledTransferStats g_scrambled_transfer_stats;
+
 }  // namespace
 
+// LOCAL PATCH - MCLA (0813): transfer_skip_scrambled
+const std::vector<RenderTargetCache::Transfer>* D3D12RenderTargetCache::FilterScrambledTransfers(
+    uint32_t render_target_count, RenderTarget* const* render_targets, const std::vector<Transfer>* transfers,
+    const Transfer::Rectangle* cutout, uint32_t mask) {
+  assert_true(render_target_count <= 1 + xenos::kMaxColorRenderTargets);
+  // Which of the differences that move a pixel's EDRAM bits to another pixel or sample the two render targets have: 1 the
+  // sample count, 2 the bits a pixel, 4 the pitch (the address of the samples of a pixel is a function of the base, the
+  // pitch in tiles at 32 bits a pixel, the bits a pixel and the sample count alone; the base is left out: a different base
+  // with the rest the same is a shift by whole tiles).
+  auto GetScrambledTransferBits = [](RenderTargetKey source, RenderTargetKey dest) -> uint32_t {
+    uint32_t bits = 0;
+    if (source.msaa_samples != dest.msaa_samples) {
+      bits |= 1;
+    }
+    if (source.Is64bpp() != dest.Is64bpp()) {
+      bits |= 2;
+    }
+    if (source.pitch_tiles_at_32bpp != dest.pitch_tiles_at_32bpp) {
+      bits |= 4;
+    }
+    return bits;
+  };
+  bool any = false;
+  for (uint32_t i = 0; i < render_target_count && !any; ++i) {
+    if (!render_targets[i]) {
+      continue;
+    }
+    for (const Transfer& transfer : transfers[i]) {
+      if (transfer.source && (GetScrambledTransferBits(transfer.source->key(), render_targets[i]->key()) & mask)) {
+        any = true;
+        break;
+      }
+    }
+  }
+  ScrambledTransferStats& stats = g_scrambled_transfer_stats;
+  if (!any) {
+    for (uint32_t i = 0; i < render_target_count; ++i) {
+      stats.kept += render_targets[i] ? transfers[i].size() : 0;
+    }
+    stats.LogIfDue();
+    return transfers;
+  }
+  const bool poison = REXCVAR_GET(transfer_skip_scrambled_poison);
+  const uint64_t scale_area = uint64_t(draw_resolution_scale_x()) * draw_resolution_scale_y();
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  for (uint32_t i = 0; i < render_target_count; ++i) {
+    std::vector<Transfer>& filtered = scrambled_filtered_transfers_[i];
+    filtered.clear();
+    RenderTarget* dest_rt = render_targets[i];
+    if (!dest_rt) {
+      continue;
+    }
+    const RenderTargetKey dest_key = dest_rt->key();
+    auto& dest_d3d12_rt = *static_cast<D3D12RenderTarget*>(dest_rt);
+    const uint64_t samples = uint64_t(1) << uint32_t(dest_key.msaa_samples);
+    const uint64_t dest_bytes = GetRenderTargetBytesPerSample(dest_d3d12_rt.resource()->GetDesc().Format);
+    for (const Transfer& transfer : transfers[i]) {
+      const uint32_t bits =
+          transfer.source ? (GetScrambledTransferBits(transfer.source->key(), dest_key) & mask) : 0;
+      if (!bits) {
+        filtered.push_back(transfer);
+        ++stats.kept;
+        continue;
+      }
+      Transfer::Rectangle rectangles[Transfer::kMaxRectanglesWithCutout];
+      const uint32_t rectangle_count =
+          transfer.GetRectangles(dest_key.base_tiles, dest_key.GetPitchTiles(), dest_key.msaa_samples,
+                                 dest_key.Is64bpp(), edram_tile_count(), rectangles, cutout);
+      uint64_t pixels = 0;
+      for (uint32_t j = 0; j < rectangle_count; ++j) {
+        pixels += uint64_t(rectangles[j].width_pixels) * rectangles[j].height_pixels;
+      }
+      const uint64_t source_bytes = GetRenderTargetBytesPerSample(
+          static_cast<const D3D12RenderTarget*>(transfer.source)->resource()->GetDesc().Format);
+      ++stats.skipped;
+      for (uint32_t b = 0; b < 3; ++b) {
+        stats.skipped_by_bit[b] += (bits >> b) & 1;
+      }
+      stats.host_pixels += pixels * scale_area;
+      stats.bytes += pixels * scale_area * samples * (source_bytes + dest_bytes);
+      if (dest_key.is_depth && !use_stencil_reference_output_) {
+        stats.stencil_bit_passes += 8;
+      }
+      if (poison && rectangle_count) {
+        D3D12_RECT host_rects[Transfer::kMaxRectanglesWithCutout];
+        for (uint32_t j = 0; j < rectangle_count; ++j) {
+          host_rects[j].left = LONG(rectangles[j].x_pixels * draw_resolution_scale_x());
+          host_rects[j].top = LONG(rectangles[j].y_pixels * draw_resolution_scale_y());
+          host_rects[j].right =
+              LONG((rectangles[j].x_pixels + rectangles[j].width_pixels) * draw_resolution_scale_x());
+          host_rects[j].bottom =
+              LONG((rectangles[j].y_pixels + rectangles[j].height_pixels) * draw_resolution_scale_y());
+        }
+        const D3D12_RESOURCE_STATES state =
+            dest_key.is_depth ? D3D12_RESOURCE_STATE_DEPTH_WRITE : D3D12_RESOURCE_STATE_RENDER_TARGET;
+        command_processor_.PushTransitionBarrier(dest_d3d12_rt.resource(), dest_d3d12_rt.SetResourceState(state),
+                                                 state);
+        command_processor_.SubmitBarriers();
+        if (dest_key.is_depth) {
+          command_list.D3DClearDepthStencilView(dest_d3d12_rt.descriptor_draw().GetHandle(),
+                                                D3D12_CLEAR_FLAG_DEPTH | D3D12_CLEAR_FLAG_STENCIL, 0.5f, 0xA5,
+                                                rectangle_count, host_rects);
+        } else {
+          static const float kMagenta[4] = {1.0f, 0.0f, 1.0f, 1.0f};
+          command_list.D3DClearRenderTargetView(dest_d3d12_rt.descriptor_load_separate().IsValid()
+                                                    ? dest_d3d12_rt.descriptor_load_separate().GetHandle()
+                                                    : dest_d3d12_rt.descriptor_draw().GetHandle(),
+                                                kMagenta, rectangle_count, host_rects);
+        }
+        ++stats.poisoned;
+      }
+    }
+  }
+  stats.LogIfDue();
+  return scrambled_filtered_transfers_;
+}
