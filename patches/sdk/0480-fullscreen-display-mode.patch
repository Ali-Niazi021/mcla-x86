+// LOCAL PATCH - MCLA (0480): fullscreen_mode. "desktop" keeps SDL's borderless fullscreen at the
+// desktop's size. Any other value asks for an exclusive fullscreen mode: SDL switches the display
+// to it while the window is fullscreen (ChangeDisplaySettingsEx on Windows), so the window's client
+// area, hence the presenter's swap chain, is exactly that size and the display's own scaler fills
+// the panel. SDL puts the desktop mode back when the window leaves fullscreen, is destroyed, or
+// loses focus (SDL_HINT_VIDEO_MINIMIZE_ON_FOCUS_LOSS "auto" minimizes an exclusive-mode window),
+// and takes the mode again when it is restored.
+struct FullscreenModeRequest {
+  bool exclusive = false;  // false: "desktop"
+  bool guest = false;      // the size is the guest's video mode
+  int32_t width = 0;
+  int32_t height = 0;
+  double refresh_hz = 0.0;  // 0: the highest multiple of 60 Hz, 120 preferred
+};
+
+bool EqualsIgnoreCase(std::string_view a, std::string_view b) {
+  return std::equal(a.begin(), a.end(), b.begin(), b.end(), [](char x, char y) {
+    return std::tolower(static_cast<unsigned char>(x)) ==
+           std::tolower(static_cast<unsigned char>(y));
+  });
+}
+
+// "desktop" | "guest"[@Hz] | "WxH"[@Hz] (anything video_mode_util's resolution parser takes:
+// 1280x800, 1080p, ...).
+bool ParseFullscreenMode(std::string_view text, FullscreenModeRequest& request) {
+  request = {};
+  while (!text.empty() && std::isspace(static_cast<unsigned char>(text.front()))) {
+    text.remove_prefix(1);
+  }
+  while (!text.empty() && std::isspace(static_cast<unsigned char>(text.back()))) {
+    text.remove_suffix(1);
+  }
+  std::string_view size = text;
+  if (const size_t at = text.find('@'); at != std::string_view::npos) {
+    size = text.substr(0, at);
+    const std::string hz_text(text.substr(at + 1));
+    char* hz_end = nullptr;
+    request.refresh_hz = std::strtod(hz_text.c_str(), &hz_end);
+    if (hz_text.empty() || hz_end != hz_text.c_str() + hz_text.size() ||
+        !(request.refresh_hz >= 1.0 && request.refresh_hz <= 1000.0)) {
+      return false;
+    }
+  }
+  if (size.empty() || EqualsIgnoreCase(size, "desktop")) {
+    return request.refresh_hz == 0.0;
+  }
+  request.exclusive = true;
+  if (EqualsIgnoreCase(size, "guest")) {
+    request.guest = true;
+    return true;
+  }
+  return rex::graphics::video_mode_util::TryParseResolutionPreset(size, request.width,
+                                                                  request.height);
+}
+
+// The guest's video mode size, resolved the way xboxkrnl_video.cpp does
+// (GetConfiguredVideoModeWidth/Height).
+void GetGuestVideoModeSize(int32_t& width, int32_t& height) {
+  width = REXCVAR_GET(video_mode_width);
+  height = REXCVAR_GET(video_mode_height);
+  int32_t preset_width = 0;
+  int32_t preset_height = 0;
+  const bool has_preset =
+      rex::graphics::video_mode_util::TryGetResolutionPresetFromCVar(preset_width, preset_height);
+  if (!rex::cvar::HasNonDefaultValue("video_mode_width")) {
+    if (rex::cvar::HasNonDefaultValue("window_width") && REXCVAR_GET(window_width) > 0) {
+      width = REXCVAR_GET(window_width);
+    } else if (has_preset) {
+      width = preset_width;
+    }
+  }
+  if (!rex::cvar::HasNonDefaultValue("video_mode_height")) {
+    if (rex::cvar::HasNonDefaultValue("window_height") && REXCVAR_GET(window_height) > 0) {
+      height = REXCVAR_GET(window_height);
+    } else if (has_preset) {
+      height = preset_height;
+    }
+  }
+  width = std::clamp(width, 640, 0x0FFF);
+  height = std::clamp(height, 480, 0x0FFF);
+}
+
+// k when `hz` is within half a hertz of k x 60 Hz (59.94 and 119.88 count), else 0.
+int MultipleOf60(float hz) {
+  const int k = int(std::lround(hz / 60.0f));
+  return k >= 1 && std::fabs(hz - 60.0f * float(k)) <= 0.5f ? k : 0;
+}
+
+// The display mode for a request on `display`: the size asked for if the display lists it, else the
+// smallest listed size at least that large (SDL_GetClosestFullscreenDisplayMode); the refresh rate
+// asked for (nearest), or the best multiple of 60 Hz (120 if the display has it, else the highest;
+// no multiple: the highest rate).
+bool ChooseDisplayMode(SDL_DisplayID display, int32_t width, int32_t height, double wanted_hz,
+                       SDL_DisplayMode& chosen, std::string& note, std::string& why_not) {
+  int count = 0;
+  SDL_DisplayMode** modes = SDL_GetFullscreenDisplayModes(display, &count);
+  if (!modes || count <= 0) {
+    why_not = fmt::format("the display lists no fullscreen modes ({})", SDL_GetError());
+    SDL_free(modes);
+    return false;
+  }
+  int target_width = width;
+  int target_height = height;
+  bool exact = false;
+  for (int i = 0; i < count && !exact; ++i) {
+    exact = modes[i]->w == width && modes[i]->h == height && modes[i]->pixel_density <= 1.0f;
+  }
+  if (!exact) {
+    SDL_DisplayMode closest;
+    if (!SDL_GetClosestFullscreenDisplayMode(display, width, height, 0.0f, false, &closest)) {
+      why_not = fmt::format("the display has no mode of at least {}x{}", width, height);
+      SDL_free(modes);
+      return false;
+    }
+    target_width = closest.w;
+    target_height = closest.h;
+    note = fmt::format("the display has no {}x{} mode, the closest larger one is {}x{}", width,
+                       height, target_width, target_height);
+  }
+  // Higher tuple = better: more colour bits last, so only a tie on the refresh rate falls through
+  // to them.
+  const auto rank = [&](const SDL_DisplayMode& m) {
+    const int bits = SDL_BITSPERPIXEL(m.format);
+    if (wanted_hz > 0.0) {
+      return std::make_tuple(0, -std::fabs(double(m.refresh_rate) - wanted_hz), 0.0, bits);
+    }
+    const int k = MultipleOf60(m.refresh_rate);
+    if (k == 2) {
+      return std::make_tuple(3, 0.0, 0.0, bits);
+    }
+    if (k > 0) {
+      return std::make_tuple(2, double(k), -std::fabs(double(m.refresh_rate) - 60.0 * k), bits);
+    }
+    return std::make_tuple(1, double(m.refresh_rate), 0.0, bits);
+  };
+  const SDL_DisplayMode* best = nullptr;
+  for (int i = 0; i < count; ++i) {
+    const SDL_DisplayMode* m = modes[i];
+    if (m->w == target_width && m->h == target_height && m->pixel_density <= 1.0f &&
+        (!best || rank(*m) > rank(*best))) {
+      best = m;
+    }
+  }
+  if (!best) {
+    why_not = fmt::format("the display has no {}x{} mode at a pixel density of 1", target_width,
+                          target_height);
+    SDL_free(modes);
+    return false;
+  }
+  if (wanted_hz > 0.0) {
+    if (std::fabs(double(best->refresh_rate) - wanted_hz) > 0.5) {
+      note += fmt::format("{}no {} Hz at {}x{}, the nearest is {:.2f} Hz", note.empty() ? "" : "; ",
+                          wanted_hz, target_width, target_height, best->refresh_rate);
+    }
+  } else if (MultipleOf60(best->refresh_rate) == 0) {
+    note += fmt::format(
+        "{}no multiple of 60 Hz at {}x{} (the guest's vblank can't lock to the display), "
+        "using the highest",
+        note.empty() ? "" : "; ", target_width, target_height);
+  }
+  chosen = *best;
+  SDL_free(modes);
+  return true;
+}
+
+// Sets the window's fullscreen display mode from fullscreen_mode, before
+// SDL_SetWindowFullscreen(true). Desktop (the default, or a value that can't be used, logged) is
+// SDL's borderless fullscreen: a NULL mode.
+void ApplyFullscreenMode(SDL_Window* window) {
+  const std::string& spec = REXCVAR_GET(fullscreen_mode);
+  FullscreenModeRequest request;
+  if (!ParseFullscreenMode(spec, request)) {
+    REXLOG_WARN(
+        "[ui] fullscreen mode desktop (fullscreen_mode \"{}\" is not desktop, guest, WxH or "
+        "WxH@Hz)",
+        spec);
+    request = {};
+  }
+  if (!request.exclusive) {
+    SDL_SetWindowFullscreenMode(window, nullptr);
+    return;
+  }
+  int32_t width = request.width;
+  int32_t height = request.height;
+  std::string requested = spec;
+  if (request.guest) {
+    GetGuestVideoModeSize(width, height);
+    requested = fmt::format("{} = {}x{}", spec, width, height);
+  }
+  SDL_DisplayID display = SDL_GetDisplayForWindow(window);
+  if (!display) {
+    display = SDL_GetPrimaryDisplay();
+  }
+  SDL_DisplayMode mode;
+  std::string note;
+  std::string why_not;
+  if (!ChooseDisplayMode(display, width, height, request.refresh_hz, mode, note, why_not)) {
+    REXLOG_WARN("[ui] fullscreen mode desktop (requested {}: {})", requested, why_not);
+    SDL_SetWindowFullscreenMode(window, nullptr);
+    return;
+  }
+  if (!SDL_SetWindowFullscreenMode(window, &mode)) {
+    REXLOG_WARN(
+        "[ui] fullscreen mode desktop (requested {}: SDL_SetWindowFullscreenMode failed: {})",
+        requested, SDL_GetError());
+    SDL_SetWindowFullscreenMode(window, nullptr);
+    return;
+  }
+  REXLOG_INFO("[ui] fullscreen mode {}x{}@{:.2f} (requested {}{})", mode.w, mode.h,
+              mode.refresh_rate, requested, note.empty() ? std::string() : "; " + note);
+}
+
