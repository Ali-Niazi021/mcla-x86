+        for (uint32_t j = 0; j < full_count; ++j) {
+          pixels_full += uint64_t(census_rectangles[j].width_pixels) * census_rectangles[j].height_pixels;
+        }
+        const uint64_t host_samples = pixels_made * scale_area * census_samples;
+        const uint64_t source_bytes =
+            bytes_per_sample(transfer.source) +
+            (transfer.host_depth_source && transfer.host_depth_source != census_dest
+                 ? bytes_per_sample(transfer.host_depth_source)
+                 : 0);
