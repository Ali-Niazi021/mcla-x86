+// LOCAL PATCH - MCLA (0811): transfer_census_log. The CP thread only.
+class TransferCensus {
+ public:
+  void Note(uint32_t source, uint32_t dest, bool dest_is_depth, const char* reason, bool skipped_whole,
+            uint64_t host_pixels_full, uint64_t host_pixels_made, uint64_t bytes_read, uint64_t bytes_written,
+            uint32_t stencil_bit_passes) {
+    Row& row = rows_[std::make_tuple(source, dest, reason)];
+    if (skipped_whole) {
+      ++row.skipped;
+    } else {
+      ++row.made;
+      if (host_pixels_made < host_pixels_full) {
+        ++row.cut;
+      }
+    }
+    row.pixels_full += host_pixels_full;
+    row.pixels_made += host_pixels_made;
+    row.bytes_read += bytes_read;
+    row.bytes_written += bytes_written;
+    row.stencil_bit_passes += stencil_bit_passes;
+    row.stencil_bit_pixels += uint64_t(stencil_bit_passes) * host_pixels_made;
+    // Depth against colour destinations.
+    Row& kind = dest_is_depth ? depth_ : colour_;
+    kind.made += skipped_whole ? 0 : 1;
+    kind.skipped += skipped_whole ? 1 : 0;
+    kind.pixels_made += host_pixels_made;
+    kind.bytes_read += bytes_read;
+    kind.bytes_written += bytes_written;
+    kind.stencil_bit_passes += stencil_bit_passes;
+    kind.stencil_bit_pixels += uint64_t(stencil_bit_passes) * host_pixels_made;
+  }
+
+  template <typename DescribeKey>
+  void LogIfDue(uint64_t current_frame, DescribeKey describe_key) {
+    const auto now = std::chrono::steady_clock::now();
+    const double seconds = std::chrono::duration<double>(now - window_start_).count();
+    // A window much older than the period is from before the census was switched off.
+    if (!started_ || seconds > 30.0) {
+      rows_.clear();
+      colour_ = Row();
+      depth_ = Row();
+      started_ = true;
+      window_start_ = now;
+      window_frame_ = current_frame;
+      return;
+    }
+    if (seconds < 10.0) {
+      return;
+    }
+    const uint64_t frames = current_frame > window_frame_ ? current_frame - window_frame_ : 0;
+    const double per_frame = frames ? 1.0 / double(frames) : 0.0;
+    std::vector<std::pair<const std::tuple<uint32_t, uint32_t, const char*>*, const Row*>> order;
+    Row total;
+    for (const auto& entry : rows_) {
+      order.emplace_back(&entry.first, &entry.second);
+      total.made += entry.second.made;
+      total.cut += entry.second.cut;
+      total.skipped += entry.second.skipped;
+      total.pixels_full += entry.second.pixels_full;
+      total.pixels_made += entry.second.pixels_made;
+      total.bytes_read += entry.second.bytes_read;
+      total.bytes_written += entry.second.bytes_written;
+    }
+    std::sort(order.begin(), order.end(), [](const auto& a, const auto& b) {
+      const uint64_t bytes_a = a.second->bytes_read + a.second->bytes_written;
+      const uint64_t bytes_b = b.second->bytes_read + b.second->bytes_written;
+      return bytes_a != bytes_b ? bytes_a > bytes_b : a.second->pixels_full > b.second->pixels_full;
+    });
+    REXGPU_INFO(
+        "[transfer-census] a frame over {} frames ({:.1f} s): {:.2f} transfers made ({:.2f} of them cut), {:.2f} left out "
+        "whole by a cut; host {:.3f} Mpx made of {:.3f}; {:.2f} MB read, {:.2f} MB written; {} rows (source -> "
+        "destination, reason), the first {}:",
+        frames, seconds, double(total.made) * per_frame, double(total.cut) * per_frame,
+        double(total.skipped) * per_frame, double(total.pixels_made) * per_frame / 1e6,
+        double(total.pixels_full) * per_frame / 1e6, double(total.bytes_read) * per_frame / 1048576.0,
+        double(total.bytes_written) * per_frame / 1048576.0, order.size(), std::min(order.size(), size_t(24)));
+    for (const Row* kind : {&colour_, &depth_}) {
+      REXGPU_INFO(
+          "[transfer-census]   into {} targets: {:.2f} made, {:.2f} left out whole; host {:.3f} Mpx; {:.2f} MB read, "
+          "{:.2f} MB written; {:.2f} stencil-bit passes over {:.3f} host Mpx",
+          kind == &depth_ ? "depth / stencil" : "colour", double(kind->made) * per_frame,
+          double(kind->skipped) * per_frame, double(kind->pixels_made) * per_frame / 1e6,
+          double(kind->bytes_read) * per_frame / 1048576.0, double(kind->bytes_written) * per_frame / 1048576.0,
+          double(kind->stencil_bit_passes) * per_frame, double(kind->stencil_bit_pixels) * per_frame / 1e6);
+    }
+    for (size_t i = 0; i < std::min(order.size(), size_t(24)); ++i) {
+      const Row& row = *order[i].second;
+      REXGPU_INFO(
+          "[transfer-census]   {} -> {} ({}): {:.2f} made ({:.2f} cut), {:.2f} left out whole; host {:.3f} of {:.3f} Mpx; "
+          "{:.2f} MB read, {:.2f} MB written; {:.2f} stencil-bit passes",
+          describe_key(std::get<0>(*order[i].first)), describe_key(std::get<1>(*order[i].first)),
+          std::get<2>(*order[i].first), double(row.made) * per_frame, double(row.cut) * per_frame,
+          double(row.skipped) * per_frame, double(row.pixels_made) * per_frame / 1e6,
+          double(row.pixels_full) * per_frame / 1e6, double(row.bytes_read) * per_frame / 1048576.0,
+          double(row.bytes_written) * per_frame / 1048576.0, double(row.stencil_bit_passes) * per_frame);
+    }
+    rows_.clear();
+    colour_ = Row();
+    depth_ = Row();
+    window_start_ = now;
+    window_frame_ = current_frame;
+  }
+
+ private:
+  struct Row {
+    uint64_t made = 0, cut = 0, skipped = 0;
+    uint64_t pixels_full = 0, pixels_made = 0;
+    uint64_t bytes_read = 0, bytes_written = 0;
+    uint64_t stencil_bit_passes = 0, stencil_bit_pixels = 0;
+  };
+  std::map<std::tuple<uint32_t, uint32_t, const char*>, Row> rows_;
+  Row colour_, depth_;
+  std::chrono::steady_clock::time_point window_start_ = std::chrono::steady_clock::now();
+  uint64_t window_frame_ = 0;
+  bool started_ = false;
+};
