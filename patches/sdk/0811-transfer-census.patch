+// LOCAL PATCH - MCLA (0811): transfer_census_log
+bool RenderTargetCache::IsTransferCensusOn() { return REXCVAR_GET(transfer_census_log); }
+
+void RenderTargetCache::NoteTransferCensus(RenderTargetKey source, RenderTargetKey dest, bool skipped_whole,
+                                           uint64_t host_pixels_full, uint64_t host_pixels_made, uint64_t bytes_read,
+                                           uint64_t bytes_written, uint32_t stencil_bit_passes) {
+  g_transfer_census.Note(source.key, dest.key, dest.is_depth != 0, transfer_census_reason_, skipped_whole,
+                         host_pixels_full, host_pixels_made, bytes_read, bytes_written, stencil_bit_passes);
+}
+
+void RenderTargetCache::LogTransferCensusIfDue(uint64_t current_frame) {
+  g_transfer_census.LogIfDue(current_frame, [](uint32_t key_value) {
+    RenderTargetKey key;
+    key.key = key_value;
+    return key.IsEmpty() ? std::string("(none)") : key.GetDebugName();
+  });
+}
