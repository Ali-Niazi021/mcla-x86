   for (uint32_t i = 0; i < edram_bases_sorted_count; ++i) {
     const std::pair<uint32_t, uint32_t>& rt_base_index = edram_bases_sorted[i];
     uint32_t rt_bit_index = rt_base_index.second;
@@ -1260,7 +1408,10 @@ bool RenderTargetCache::Update(bool is_rasterization_done,
   // contents: the stencil test is a pass, the depth is kept) are made here, whole, and not left for them.
   if (tonemap_skip_cut && (depth_and_color_rts_used_bits & 1) && rts[0] && !last_update_transfers_[0].empty()) {
     static const Transfer::Rectangle no_cutout = {};
