                     &rectangles[i]);
     ClearRectangleWaitingForDraw& waiting = clear_rectangles_waiting_for_draw_[i];
@@ -2108,6 +2260,24 @@ bool RenderTargetCache::GetOverwrittenRectangle(const Shader& vertex_shader,
