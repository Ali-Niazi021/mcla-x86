From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mcla-x86 SDK patch layer
Date: Thu, 26 Nov 2026 00:00:00 +0000
Subject: [PATCH] 0520: gpu_timing_ops: GPU time per emulation operation class (resolve, dual-written resolve, texture load, EDRAM transfer, clear, upload, barrier) per render phase

Source: Ours (stream LOCK60 wave 2, F2). Validated in game: runs lk-fl1..lk-fl3
Licence: GPL-3 (owner's own work, part of mcla-x86); the patched files are ReXGlue SDK code (BSD-3-Clause)
Purpose: D3D12. Cvar gpu_timing_ops (false; with gpu_timing=1): every emulation operation is bracketed by two timestamps (a second
  query heap, 4096 per frame), summed per (class, phase); CSV columns <group>_<class>_us/_n, an '[gpu-timing] ops' log line, and
  per-frame resolve kinds (dual-written / msaa fallback / other). Measurement only: each bracket drains the pipeline.
Bucket: REDO

0520-gpu-timing-ops.patch (mcla-x86 LOCK60 wave 2).

---
diff --git a/include/rex/graphics/d3d12/command_processor.h b/include/rex/graphics/d3d12/command_processor.h
index 981d4d2d..06a30662 100644
--- a/include/rex/graphics/d3d12/command_processor.h
+++ b/include/rex/graphics/d3d12/command_processor.h
@@ -112,12 +112,78 @@ class D3D12CommandProcessor : public CommandProcessor {
     kGtBar,    // ResourceBarrier batches
     kGtExp,    // guest draws the draw experiment changed
     kGtVrs,    // LOCAL PATCH - MCLA (0500): guest draws recorded at a coarse shading rate
+    kGtResDw,    // LOCAL PATCH - MCLA (0520): resolves that also wrote a texture (resolve_dual_write)
+    kGtResMsaa,  // LOCAL PATCH - MCLA (0520): resolve_dual_write fallbacks: the render target read is multisampled
+    kGtResFb,    // LOCAL PATCH - MCLA (0520): resolve_dual_write fallbacks for any other reason
     kGtCounterCount,
   };
   void GpuTimingCount(GpuTimingCounter counter, uint32_t count = 1) {
     gpu_timing_.counts[gpu_timing_.group][counter] += count;
   }
 
+  // LOCAL PATCH - MCLA (0520): gpu_timing_ops. The classes of emulation operation whose GPU time is bracketed with two
+  // timestamps (begin before the operation's first command, end after its last), per render phase.
+  enum GpuTimingOp : uint32_t {
+    kGtOpResolve,    // IssueCopy (from its BeginSubmission to its return) minus the xfer / clear parts, not dual-written
+    kGtOpResolveDw,  // the same for a resolve that also wrote a texture (resolve_dual_write)
+    kGtOpTexload,    // a texture load, its dispatches and barriers
+    kGtOpXfer,       // PerformTransfersAndResolveClears: the transfer draws (and the host depth stores), also in a resolve
+    kGtOpClear,      // PerformTransfersAndResolveClears: the resolve clears (always inside IssueCopy)
+    kGtOpUpload,     // shared memory uploads (the copies from the upload buffers)
+    kGtOpBarrier,    // SubmitBarriers batches outside the other brackets
+    kGtOpCount,
+  };
+  // Brackets the commands recorded from Start (the constructor, unless `start` is false) to End (the destructor, unless
+  // called before). An operation inside another one's bracket is not bracketed itself (a depth counter): only the
+  // outermost counts, except that an xfer / clear scope inside another bracket (PerformTransfersAndResolveClears in
+  // IssueCopy) carves its time out of it: the outer bracket switches to the xfer / clear class and back at the end.
+  // Does nothing, but one check, when gpu_timing_ops is off for the frame.
+  class GpuTimingOpScope {
+   public:
+    GpuTimingOpScope(D3D12CommandProcessor& command_processor, GpuTimingOp op, bool start = true)
+        : cp_(command_processor), op_(op) {
+      if (start) {
+        Start();
+      }
+    }
+    ~GpuTimingOpScope() { End(); }
+    GpuTimingOpScope(const GpuTimingOpScope&) = delete;
+    GpuTimingOpScope& operator=(const GpuTimingOpScope&) = delete;
+    void Start() {
+      if (!depth_ && cp_.gpu_timing_.ops) {
+        depth_ = cp_.GpuTimingOpBegin(op_, epoch_);
+      }
+    }
+    void Start(GpuTimingOp op) {
+      op_ = op;
+      Start();
+    }
+    void End() {
+      if (depth_) {
+        cp_.GpuTimingOpEnd(depth_, epoch_);
+        depth_ = 0;
+      }
+    }
+    // The commands from here on belong to another class (one shared timestamp ends one bracket and starts the next).
+    void Switch(GpuTimingOp op) {
+      if (depth_) {
+        cp_.GpuTimingOpSwitch(op, depth_, epoch_);
+      }
+    }
+
+   private:
+    D3D12CommandProcessor& cp_;
+    GpuTimingOp op_;
+    uint32_t depth_ = 0;  // the nesting depth of the bracket (1: outermost, recorded); 0: not started
+    uint32_t epoch_ = 0;
+  };
+  // The kind of the resolve being issued (IssueCopy): 1 dual-written, 2 resolve_dual_write fallback because the render
+  // target read is multisampled, 3 another fallback (at most one per resolve; none: not tried). Counted per frame.
+  void GpuTimingResolveKind(uint32_t kind) {
+    gpu_timing_.resolve_kind = kind;
+    ++gpu_timing_.counts[gpu_timing_.group][kind == 1 ? kGtResDw : (kind == 2 ? kGtResMsaa : kGtResFb)];
+  }
+
   // LOCAL PATCH - MCLA (0500): vrs. Called before every draw the backend records outside IssueDraw (EDRAM transfers,
   // clears by drawing, the HDR restore): such draws are always at the 1x1 rate; costs a compare when it already is.
   void VrsEnsureFine() {
@@ -1120,6 +1186,18 @@ class D3D12CommandProcessor : public CommandProcessor {
   // Reads the frames whose submissions are done.
   void GpuTimingCollect();
   void GpuTimingFlushCsv();
+  // LOCAL PATCH - MCLA (0520): gpu_timing_ops, the brackets (GpuTimingOpScope). Begin returns the nesting depth (0: the
+  // operation is not bracketed: ops off for the frame, no open list), writes the begin timestamp at depth 1; End
+  // writes the end timestamp at depth 1; Switch ends the open bracket and starts one of another class with one shared
+  // timestamp. `epoch` tells a bracket from an earlier frame (the frame ended or was dropped inside it).
+  uint32_t GpuTimingOpBegin(GpuTimingOp op, uint32_t& epoch_out);
+  void GpuTimingOpEnd(uint32_t depth, uint32_t epoch);
+  void GpuTimingOpSwitch(GpuTimingOp op, uint32_t depth, uint32_t epoch);
+  void GpuTimingOpClose();
+  bool GpuTimingOpSwitchRecord(GpuTimingOp op, bool continuation);
+  void GpuTimingOpFlushPending();
+  void GpuTimingOpsFrameEnd();
+  bool GpuTimingOpsInit();
   // The experiment (0: none) the guest draw about to be recorded gets.
   uint32_t GpuTimingDrawExperiment(bool memexport_used);
   void GpuTimingCountDraw(uint32_t host_count, uint32_t experiment) {
@@ -1185,11 +1263,46 @@ class D3D12CommandProcessor : public CommandProcessor {
     bool have_last_start = false;
     uint64_t last_start_ticks = 0;
     bool in_gap = false;  // an idle mark was written at the end of the last list of the open frame
+    // LOCAL PATCH - MCLA (0520): gpu_timing_ops. The brackets of the operations (GpuTimingOpScope) go to a second
+    // query heap of kRing x kOpSlots timestamps (created when first used), resolved with the frame's other slots into
+    // a second readback buffer. A bracket is a record (class, group of the segment it starts in, begin slot, end
+    // slot); a Switch shares one timestamp between the end of a record and the begin of the next.
+    static constexpr uint32_t kOpSlots = 4096;
+    static constexpr uint32_t kOpNone = 0xFFFFFFFFu;
+    struct OpFrame {
+      bool on = false;
+      uint16_t slots = 0;    // timestamps resolved
+      uint16_t records = 0;
+      uint32_t overflow = 0;  // brackets not recorded for lack of slots
+      uint32_t split = 0;     // brackets cut by the end of a command list (dropped)
+      uint8_t op[kOpSlots];   // GpuTimingOp, 0xFF: dropped
+      uint8_t group[kOpSlots];  // bit 7: the rest of a bracket after a carved-out part (not counted again)
+      uint16_t begin[kOpSlots];
+      uint16_t end[kOpSlots];
+    };
+    bool ops = false;  // the frame being recorded brackets operations (latched at its start; needs mode 2)
+    bool ops_init_failed = false;
+    uint32_t op_epoch = 0;
+    uint32_t op_depth = 0;
+    uint32_t op_slots = 0;
+    uint32_t op_cur = kOpNone;      // the open record
+    uint32_t op_first = 0;          // the first record of the open outermost bracket
+    bool op_carve = false;          // an xfer / clear scope at depth 2 has taken the open record from the outer bracket
+    uint32_t op_carve_restore = 0;  // the outer bracket's class
+    uint64_t op_cur_submission = 0;  // the submission it started in
+    uint32_t op_pending = kOpNone;  // a slot whose timestamp is written when the next list starts
+    uint32_t resolve_kind = 0;      // of the resolve in progress, see GpuTimingResolveKind
+    Microsoft::WRL::ComPtr<ID3D12QueryHeap> op_heap;
+    Microsoft::WRL::ComPtr<ID3D12Resource> op_readback;
+    std::vector<OpFrame> op_frames;
+    std::vector<uint64_t> op_ticks;
   } gpu_timing_;
   // Statistics, the CSV and the experiment cycle (defined in command_processor.cpp).
   struct GpuTimingReport;
   GpuTimingReport& GpuTimingGetReport();
-  void GpuTimingProcessFrame(const GpuTiming::Frame& frame, const uint64_t* ticks);
+  // LOCAL PATCH - MCLA (0520): `ops` and `op_ticks` (the slots of ops->slots) are null for a frame without brackets.
+  void GpuTimingProcessFrame(const GpuTiming::Frame& frame, const uint64_t* ticks, const GpuTiming::OpFrame* ops,
+                             const uint64_t* op_ticks);
   // Logs the statistics if gpu_timing_log_s seconds have passed (or `force`), and writes the CSV rows.
   void GpuTimingMaybeLog(bool force);
   std::unique_ptr<GpuTimingReport> gpu_timing_report_;
