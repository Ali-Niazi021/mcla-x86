+// LOCAL PATCH - MCLA (0520): gpu_timing_ops, the operation brackets (see GpuTiming::kOpSlots in the header).
+bool D3D12CommandProcessor::GpuTimingOpsInit() {
+  GpuTiming& g = gpu_timing_;
+  if (g.op_readback) {
+    return true;
+  }
+  if (g.ops_init_failed) {
+    return false;
+  }
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  D3D12_QUERY_HEAP_DESC heap_desc = {D3D12_QUERY_HEAP_TYPE_TIMESTAMP, GpuTiming::kRing * GpuTiming::kOpSlots, 0};
+  D3D12_RESOURCE_DESC buffer_desc;
+  ui::d3d12::util::FillBufferResourceDesc(
+      buffer_desc, sizeof(uint64_t) * GpuTiming::kRing * GpuTiming::kOpSlots, D3D12_RESOURCE_FLAG_NONE);
+  if (!device || FAILED(device->CreateQueryHeap(&heap_desc, IID_PPV_ARGS(&g.op_heap))) ||
+      FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesReadback,
+                                             GetD3D12Provider().GetHeapFlagCreateNotZeroed(), &buffer_desc,
+                                             D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                             IID_PPV_ARGS(&g.op_readback)))) {
+    g.op_heap.Reset();
+    g.op_readback.Reset();
+    g.ops_init_failed = true;
+    REXGPU_WARN("gpu_timing_ops: the timestamp heap of the operation brackets could not be made, it is off");
+    return false;
+  }
+  g.op_frames.resize(GpuTiming::kRing);
+  g.op_ticks.resize(GpuTiming::kOpSlots);
+  REXGPU_INFO("gpu_timing_ops: {} timestamps per frame for the operation brackets", GpuTiming::kOpSlots);
+  return true;
+}
+
+uint32_t D3D12CommandProcessor::GpuTimingOpBegin(GpuTimingOp op, uint32_t& epoch_out) {
+  GpuTiming& g = gpu_timing_;
+  epoch_out = g.op_epoch;
+  if (!g.ops || !g.active || !submission_open_) {
+    return 0;
+  }
+  const uint32_t depth = ++g.op_depth;
+  if (depth != 1) {
+    // Inside another bracket: it counts for the outer one, except that transfers and clears are carved out of it (the
+    // open record becomes theirs until the scope ends: GpuTimingOpEnd).
+    if (depth == 2 && (op == kGtOpXfer || op == kGtOpClear) && g.op_cur != GpuTiming::kOpNone) {
+      const uint32_t outer = g.op_frames[g.ring].op[g.op_cur];
+      if (outer < kGtOpCount && outer != kGtOpXfer && outer != kGtOpClear && GpuTimingOpSwitchRecord(op, false)) {
+        g.op_carve = true;
+        g.op_carve_restore = outer;
+      }
+    }
+    return depth;
+  }
+  g.op_cur = GpuTiming::kOpNone;
+  g.op_carve = false;
+  if (op == kGtOpResolve) {
+    g.resolve_kind = 0;
+  }
+  GpuTiming::OpFrame& of = g.op_frames[g.ring];
+  // The begin and the end: the barrier brackets (the most numerous) leave a quarter of the slots to the others.
+  const uint32_t limit = op == kGtOpBarrier ? GpuTiming::kOpSlots * 3 / 4 : GpuTiming::kOpSlots;
+  if (g.op_slots + 2 > limit || of.records >= GpuTiming::kOpSlots) {
+    ++of.overflow;
+    return depth;
+  }
+  const uint32_t slot = g.op_slots++;
+  deferred_command_list_.D3DEndQuery(g.op_heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
