+    of.op[record] = 0xFF;
+    ++of.split;
+  }
+}
+
+void D3D12CommandProcessor::GpuTimingOpSwitch(GpuTimingOp op, uint32_t depth, uint32_t epoch) {
+  GpuTiming& g = gpu_timing_;
+  if (epoch != g.op_epoch || !(depth == 1 || (depth == 2 && g.op_carve))) {
+    return;
+  }
+  GpuTimingOpSwitchRecord(op, false);
+}
+
+bool D3D12CommandProcessor::GpuTimingOpSwitchRecord(GpuTimingOp op, bool continuation) {
+  GpuTiming& g = gpu_timing_;
+  if (g.op_cur == GpuTiming::kOpNone || !submission_open_ || g.op_cur_submission != submission_current_) {
+    return false;
+  }
+  GpuTiming::OpFrame& of = g.op_frames[g.ring];
+  if (of.op[g.op_cur] == op) {
+    return false;
+  }
+  if (g.op_slots + 2 > GpuTiming::kOpSlots || of.records >= GpuTiming::kOpSlots) {
+    ++of.overflow;
+    return false;
+  }
+  // One timestamp ends the open bracket and begins the next.
+  const uint32_t slot = g.op_slots++;
+  deferred_command_list_.D3DEndQuery(g.op_heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                     g.ring * GpuTiming::kOpSlots + slot);
+  of.end[g.op_cur] = uint16_t(slot);
+  const uint32_t record = of.records++;
+  of.op[record] = uint8_t(op);
+  of.group[record] = uint8_t(g.group | (continuation ? 0x80u : 0u));
+  of.begin[record] = uint16_t(slot);
+  of.end[record] = 0xFFFF;
+  g.op_cur = record;
+  return true;
+}
+
+void D3D12CommandProcessor::GpuTimingOpFlushPending() {
+  GpuTiming& g = gpu_timing_;
+  if (g.op_pending == GpuTiming::kOpNone) {
+    return;
+  }
+  const uint32_t slot = g.op_pending;
+  g.op_pending = GpuTiming::kOpNone;
+  if (g.ops && submission_open_) {
+    deferred_command_list_.D3DEndQuery(g.op_heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                       g.ring * GpuTiming::kOpSlots + slot);
+  }
+}
+
+void D3D12CommandProcessor::GpuTimingOpsFrameEnd() {
+  GpuTiming& g = gpu_timing_;
+  if (!g.ops) {
+    return;
+  }
+  if (g.op_cur != GpuTiming::kOpNone) {
+    GpuTimingOpClose();  // the frame's last list ends inside a bracket
+  }
+  GpuTimingOpFlushPending();
+  g.ops = false;
+  g.op_depth = 0;
+  ++g.op_epoch;  // the scopes still open will not touch the next frame
+  GpuTiming::OpFrame& of = g.op_frames[g.ring];
+  of.slots = uint16_t(g.op_slots);
+  of.on = true;
+  if (g.op_slots) {
+    deferred_command_list_.D3DResolveQueryData(g.op_heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                               g.ring * GpuTiming::kOpSlots, g.op_slots, g.op_readback.Get(),
+                                               uint64_t(g.ring) * GpuTiming::kOpSlots * sizeof(uint64_t));
+  }
+}
