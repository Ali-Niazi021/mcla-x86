+
+void D3D12CommandProcessor::GpuTimingOpEnd(uint32_t depth, uint32_t epoch) {
+  GpuTiming& g = gpu_timing_;
+  if (epoch != g.op_epoch) {
+    return;  // the frame ended (or was dropped) inside the bracket
+  }
+  if (depth == 2 && g.op_carve) {
+    // The carved-out part is over: the rest of the outer bracket is its class again (a continuation, not counted).
+    g.op_carve = false;
+    GpuTimingOpSwitchRecord(GpuTimingOp(g.op_carve_restore), true);
+  }
+  g.op_depth = depth - 1;
+  if (depth == 1) {
+    GpuTimingOpClose();
+  }
+}
+
+void D3D12CommandProcessor::GpuTimingOpClose() {
+  GpuTiming& g = gpu_timing_;
+  const uint32_t record = g.op_cur;
+  g.op_cur = GpuTiming::kOpNone;
+  if (record == GpuTiming::kOpNone) {
+    return;
+  }
+  GpuTiming::OpFrame& of = g.op_frames[g.ring];
+  // The slot is there: a bracket (and each Switch) is only started with one left over for its end.
+  const uint32_t slot = g.op_slots++;
+  of.end[record] = uint16_t(slot);
+  if (g.resolve_kind == 1 && of.op[g.op_first] == kGtOpResolve) {
+    for (uint32_t k = g.op_first; k < of.records; ++k) {  // the parts of the bracket (a carve-out splits it)
+      if (of.op[k] == kGtOpResolve) {
+        of.op[k] = uint8_t(kGtOpResolveDw);
+      }
+    }
+  }
