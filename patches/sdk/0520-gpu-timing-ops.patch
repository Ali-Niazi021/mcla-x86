+    // list (every slot taken has to be written before it is resolved), and the bracket, which spans the gap, is dropped.
+    g.op_pending = slot;
+    of.op[record] = 0xFF;
+    ++of.split;
+    return;
+  }
+  deferred_command_list_.D3DEndQuery(g.op_heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                     g.ring * GpuTiming::kOpSlots + slot);
