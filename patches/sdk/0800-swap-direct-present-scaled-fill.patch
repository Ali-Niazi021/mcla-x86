index 0000000..1fafa55
--- /dev/null
+++ b/src/ui/shaders/guest_output_gamma_table_fill.ps.hlsl
@@ -0,0 +1,33 @@
+// guest_output_gamma_table_fill.ps.hlsl - mcla-x86 patch 0800 (swap_direct_present at a draw resolution scale above 1),
+// written for this SDK.
+//
+// guest_output_gamma_table.ps.hlsl (patch 04a0) with the source read at max(pixel_index, xe_gamma_source_fill): the way a
+// resolve at a draw resolution scale above 1 that fills the half-pixel gap wrote the texture the swap would otherwise
+// load (the first xe_gamma_source_fill.x columns and .y rows of the picture take the value of the column and row that
+// many pixels further in; resolve.xesli half_pixel_offset_fill_source = resolution_scale >> 1). The source is the host
+// render target that resolve read, whose first host row and column the game's passes did not write. With
+// xe_gamma_source_fill = (0, 0) the output is that of guest_output_gamma_table.ps.hlsl.
+//
+// fxc /T ps_5_1 /E main /O3 /Qstrip_reflect /Qstrip_debug /Qstrip_priv /Vn guest_output_gamma_table_fill_ps
+//     /Fh guest_output_gamma_table_fill_ps.h guest_output_gamma_table_fill.ps.hlsl
+
+Buffer<float4> xe_gamma_ramp : register(t0);
+Texture2D<float4> xe_gamma_source : register(t1);
+
+cbuffer push_consts_xe : register(b0) {
+  int2 xe_gamma_output_offset;
+  int2 xe_gamma_source_fill;
+};
+
+float4 main(float4 xe_position : SV_Position) : SV_Target {
+  // Truncated like the bilinear pass's own pixel index (ftoi), so a pixel centre maps to its own texel.
+  int2 pixel_index = int2(xe_position.xy) - xe_gamma_output_offset;
+  float3 source = xe_gamma_source.Load(int3(max(pixel_index, xe_gamma_source_fill), 0)).rgb;
+  // The same rounding as apply_gamma_table_cs: the 8-bit value of the channel.
+  uint3 table_indices = uint3(source * 255.0 + 0.5);
+  float3 result;
+  result.r = xe_gamma_ramp[table_indices.r].b;
+  result.g = xe_gamma_ramp[table_indices.g].g;
+  result.b = xe_gamma_ramp[table_indices.b].r;
+  return float4(result, 1.0);
+}
