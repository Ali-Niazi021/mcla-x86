+  // The stretching ones with the loads of each thread issued together (XE_RESOLVE_DIRECT_BATCHED_LOADS and
+  // XE_RESOLVE_DIRECT_STRETCH together), for resolve_direct_batched_loads; null where there is none.
+  static const ResolveDirectShaderCode
+      kResolveDirectBatchedStretchShaders[size_t(draw_util::ResolveCopyShaderIndex::kCount)];
 
   // HDR output: the restore draw, for 1x and 4x.
   Microsoft::WRL::ComPtr<ID3D12RootSignature> hdr_restore_root_signature_;
