+// The stretching ones (kResolveDirectStretchShaders) with the loads of each thread issued together, for
+// resolve_direct_batched_loads: the four resolves of a squeezed scene (depth, shadow mask, HDR colour) read a
+// single-sampled render target through the stretch, and without these they were the only direct resolves left with a
+// round trip to memory for each of their samples.
+const D3D12RenderTargetCache::ResolveDirectShaderCode
+    D3D12RenderTargetCache::kResolveDirectBatchedStretchShaders[size_t(
+        draw_util::ResolveCopyShaderIndex::kCount)] = {
+        // kFast32bpp1x2xMSAA
+        {shaders::resolve_direct_batched_fast_32bpp_stretch_cs,
+         sizeof(shaders::resolve_direct_batched_fast_32bpp_stretch_cs),
+         shaders::resolve_direct_batched_fast_32bpp_stretch_scaled_cs,
+         sizeof(shaders::resolve_direct_batched_fast_32bpp_stretch_scaled_cs)},
+        // kFast32bpp4xMSAA - the 1x/2x MSAA one's
+        {},
+        // kFast64bpp1x2xMSAA
+        {shaders::resolve_direct_batched_fast_64bpp_stretch_cs,
+         sizeof(shaders::resolve_direct_batched_fast_64bpp_stretch_cs),
+         shaders::resolve_direct_batched_fast_64bpp_stretch_scaled_cs,
+         sizeof(shaders::resolve_direct_batched_fast_64bpp_stretch_scaled_cs)},
+        // kFast64bpp4xMSAA - the 1x/2x MSAA one's
+        {},
+        // kFull8bpp - none (not needed by the game's scene)
+        {},
+        // kFull16bpp - none (not needed by the game's scene)
+        {},
+        // kFull32bpp
+        {shaders::resolve_direct_batched_full_32bpp_stretch_cs,
+         sizeof(shaders::resolve_direct_batched_full_32bpp_stretch_cs),
+         shaders::resolve_direct_batched_full_32bpp_stretch_scaled_cs,
+         sizeof(shaders::resolve_direct_batched_full_32bpp_stretch_scaled_cs)},
+        // kFull64bpp
+        {shaders::resolve_direct_batched_full_64bpp_stretch_cs,
+         sizeof(shaders::resolve_direct_batched_full_64bpp_stretch_cs),
+         shaders::resolve_direct_batched_full_64bpp_stretch_scaled_cs,
+         sizeof(shaders::resolve_direct_batched_full_64bpp_stretch_scaled_cs)},
+        // kFull128bpp - no direct shader
+        {},
+};
+
 const uint32_t D3D12RenderTargetCache::kTransferUsedRootParameters[size_t(
     TransferRootSignatureIndex::kCount)] = {
     // kColor
@@ -1537,8 +1584,18 @@ ID3D12PipelineState* D3D12RenderTargetCache::GetDirectResolveStretchPipeline(
   if (index >= size_t(draw_util::ResolveCopyShaderIndex::kCount)) {
     return nullptr;
   }
-  const ResolveDirectShaderCode& shader_code = kResolveDirectStretchShaders[index];
+  // With resolve_direct_batched_loads, the stretching shader with batched loads where there is one.
   bool scaled = IsDrawResolutionScaled();
+  const ResolveDirectShaderCode* shader_code_ptr = &kResolveDirectStretchShaders[index];
+  bool batched = false;
+  if (REXCVAR_GET(resolve_direct_batched_loads)) {
+    const ResolveDirectShaderCode& batched_code = kResolveDirectBatchedStretchShaders[index];
+    if (scaled ? batched_code.scaled : batched_code.unscaled) {
+      shader_code_ptr = &batched_code;
+      batched = true;
+    }
+  }
+  const ResolveDirectShaderCode& shader_code = *shader_code_ptr;
   const void* code = scaled ? shader_code.scaled : shader_code.unscaled;
   size_t code_size = scaled ? shader_code.scaled_size : shader_code.unscaled_size;
   if (!code) {
@@ -1554,6 +1611,9 @@ ID3D12PipelineState* D3D12RenderTargetCache::GetDirectResolveStretchPipeline(
           "Direct stretching {} from 1x RT", draw_util::resolve_copy_shader_info[index].debug_name));
       pipeline->SetName(reinterpret_cast<LPCWSTR>(pipeline_name.c_str()));
       direct_resolve_stretch_pipelines_[index] = pipeline;
+      REXGPU_INFO("D3D12RenderTargetCache: the stretching direct {} pipeline is made ({} loads)",
+                  draw_util::resolve_copy_shader_info[index].debug_name,
+                  batched ? "batched" : "one at a time");
     } else {
       direct_resolve_stretch_failed_ = true;
       REXGPU_ERROR("D3D12RenderTargetCache: Failed to create the stretching direct {} pipeline",
