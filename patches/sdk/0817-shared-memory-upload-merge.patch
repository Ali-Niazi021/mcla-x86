+  // (the GPU may write anything) and ClearCache start anew.
+  uint32_t shadow_generation_ = 1;
+  uint32_t shadow_used_ = 0;
+  uint32_t shadow_slots_ = 0;
+  std::vector<uint8_t> shadow_bytes_;
+  std::vector<uint32_t> shadow_slot_page_;
+  std::vector<uint32_t> shadow_slot_generation_;
+  std::vector<uint32_t> shadow_page_slot_;  // Per page: slot + 1, 0 none.
+  // The slot of a page whose bytes in the buffer are known, or UINT32_MAX.
+  uint32_t ShadowFind(uint32_t page) const;
+  // Copies the page from guest memory into a slot of its own and from there to `upload_dst` (what the copy command
