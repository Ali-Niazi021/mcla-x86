+// LOCAL PATCH - MCLA (0817): the cvars of this patch choose the way. All off: UploadRangesPlain, the code as it was
+// (with the census, if it is on).
 bool D3D12SharedMemory::UploadRanges(
     const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges) {
   if (upload_page_ranges.empty()) {
     return true;
   }
+  census_.active = REXCVAR_GET(d3d12_upload_census);
+  if (census_.active) {
+    CensusFrame();
+  }
+  const uint32_t skip_same = std::min(uint32_t(REXCVAR_GET(d3d12_upload_skip_same)), uint32_t(2));
+  if (!skip_same && shadow_used_) {
+    // A page copied from now on may not hold the bytes of its slot.
+    ShadowReset();
+  }
+  if (REXCVAR_GET(d3d12_upload_merge) || skip_same) {
+    return UploadRangesJoined(upload_page_ranges);
+  }
+  return UploadRangesPlain(upload_page_ranges);
+}
