+void D3D12SharedMemory::CensusLog() {
+  const double seconds =
+      std::chrono::duration<double>(std::chrono::steady_clock::now() - census_.window_start).count();
+  const double frames = double(std::max<uint64_t>(census_.window_frames, 1));
+  const Census& c = census_;
+  REXGPU_INFO(
+      "[upload-census] {:.1f} s, {} frames with uploads, per frame: {:.1f} copies made ({:.1f} pieces, {:.1f} of them "
+      "went on an earlier copy), {:.0f} KB (+{:.0f} KB bridged), {:.1f} calls ({:.1f} hoisted, {:.1f} in place with no "
+      "run going, {:.1f} in place for a page a draw of the run had read); transitions to copy dest {:.1f}, from it "
+      "{:.1f}, hoisted run pairs {:.1f}",
+      seconds, c.window_frames, double(c.commands) / frames, double(c.pieces) / frames, double(c.extended) / frames,
+      double(c.bytes) / 1024.0 / frames, double(c.bridged_bytes) / 1024.0 / frames, double(c.calls) / frames,
+      double(c.hoisted_calls) / frames, double(c.in_place_no_run) / frames, double(c.in_place_page_read) / frames,
+      double(c.barriers_to_copy) / frames, double(c.barriers_from_copy) / frames, double(c.hoisted_pairs) / frames);
+  REXGPU_INFO(
+      "[upload-census] pages per frame: {:.1f} distinct, {:.1f} uploaded more than once ({:.1f} of them hot; {:.1f} "
+      "extra copies of pages), {:.1f} uploads of hot pages, {:.1f} left out for the same bytes ({} calls); uploaded in "
+      "each of the last 2 / 8 / 32 frames: {:.1f} / {:.1f} / {:.1f}; of the uploads of a page uploaded before: same "
+      "frame same bytes {:.1f} / other bytes {:.1f}, an earlier frame same bytes {:.1f} / other bytes {:.1f}",
+      double(c.pages_distinct) / frames, double(c.pages_repeated) / frames, double(c.pages_repeated_hot) / frames,
+      double(c.page_extra_copies) / frames, double(c.hot_pages) / frames, double(c.skipped_pages) / frames,
+      c.skipped_calls, double(c.pages_in_2) / frames, double(c.pages_in_8) / frames, double(c.pages_in_32) / frames,
+      double(c.same_in_frame) / frames, double(c.changed_in_frame) / frames, double(c.same_earlier_frame) / frames,
+      double(c.changed_earlier_frame) / frames);
+  REXGPU_INFO(
+      "[upload-census] by kind (pieces, KB a frame): other {:.1f}, {:.0f}; texture {:.1f}, {:.0f}; vertex {:.1f}, {:.0f}; "
+      "index {:.1f}, {:.0f}; memexport {:.1f}, {:.0f}; resolve {:.1f}, {:.0f}",
+      double(c.pieces_by_kind[0]) / frames, double(c.bytes_by_kind[0]) / 1024.0 / frames,
+      double(c.pieces_by_kind[1]) / frames, double(c.bytes_by_kind[1]) / 1024.0 / frames,
+      double(c.pieces_by_kind[2]) / frames, double(c.bytes_by_kind[2]) / 1024.0 / frames,
+      double(c.pieces_by_kind[3]) / frames, double(c.bytes_by_kind[3]) / 1024.0 / frames,
+      double(c.pieces_by_kind[4]) / frames, double(c.bytes_by_kind[4]) / 1024.0 / frames,
+      double(c.pieces_by_kind[5]) / frames, double(c.bytes_by_kind[5]) / 1024.0 / frames);
+  REXGPU_INFO(
+      "[upload-census] copies a frame left if the pieces, in address order, were joined across gaps of up to 0 / 4 / 16 / "
+      "64 KB: {:.1f} / {:.1f} / {:.1f} / {:.1f} (gap bytes copied for them a frame: {:.0f} / {:.0f} / {:.0f} / {:.0f} KB); "
+      "gaps (a frame): overlap {:.1f}, 0 {:.1f}, <= 4K {:.1f}, <= 16K {:.1f}, <= 64K {:.1f}, <= 1M {:.1f}, more {:.1f}; "
+      "pieces that go on from the one made before it: exactly {:.1f}, <= 4K gap {:.1f}, <= 64K gap {:.1f}",
+      double(c.merge_potential[0]) / frames, double(c.merge_potential[1]) / frames,
+      double(c.merge_potential[2]) / frames, double(c.merge_potential[3]) / frames,
+      double(c.merge_bytes[0]) / 1024.0 / frames, double(c.merge_bytes[1]) / 1024.0 / frames,
+      double(c.merge_bytes[2]) / 1024.0 / frames, double(c.merge_bytes[3]) / 1024.0 / frames,
+      double(c.gap_hist[0]) / frames, double(c.gap_hist[1]) / frames, double(c.gap_hist[2]) / frames,
+      double(c.gap_hist[3]) / frames, double(c.gap_hist[4]) / frames, double(c.gap_hist[5]) / frames,
+      double(c.gap_hist[6]) / frames, double(c.adjacent_in_order[0]) / frames,
+      double(c.adjacent_in_order[1]) / frames, double(c.adjacent_in_order[2]) / frames);
+  if (verify_checked_[0] || verify_checked_[1]) {
+    REXGPU_INFO("[upload-verify] checked so far: {} skipped pages ({} mismatched), {} bridged pages ({} mismatched)",
+                verify_checked_[0], verify_mismatched_[0], verify_checked_[1], verify_mismatched_[1]);
+  }
+  // The next window; what is kept of the frame being counted goes on with it.
+  census_.window_start = std::chrono::steady_clock::now();
+  census_.calls = census_.pieces = census_.commands = census_.extended = census_.bytes = census_.bridged_bytes = 0;
+  census_.hoisted_calls = census_.in_place_no_run = census_.in_place_page_read = 0;
+  std::fill(std::begin(census_.pieces_by_kind), std::end(census_.pieces_by_kind), uint64_t(0));
+  std::fill(std::begin(census_.bytes_by_kind), std::end(census_.bytes_by_kind), uint64_t(0));
+  census_.hot_pages = census_.skipped_pages = census_.skipped_calls = 0;
+  census_.barriers_to_copy = census_.barriers_from_copy = census_.hoisted_pairs = census_.hoisted_rewrites = 0;
+  census_.pages_distinct = census_.pages_repeated = census_.pages_repeated_hot = census_.page_extra_copies = 0;
+  census_.same_in_frame = census_.changed_in_frame = census_.same_earlier_frame = census_.changed_earlier_frame = 0;
+  census_.pages_in_2 = census_.pages_in_8 = census_.pages_in_32 = 0;
+  std::fill(std::begin(census_.merge_potential), std::end(census_.merge_potential), uint64_t(0));
+  std::fill(std::begin(census_.merge_bytes), std::end(census_.merge_bytes), uint64_t(0));
+  std::fill(std::begin(census_.gap_hist), std::end(census_.gap_hist), uint64_t(0));
+  std::fill(std::begin(census_.adjacent_in_order), std::end(census_.adjacent_in_order), uint64_t(0));
+  census_.window_frames = 0;
+}
