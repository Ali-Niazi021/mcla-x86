+  void ShadowStore(uint32_t page, const uint8_t* guest, uint8_t* upload_dst);
+  bool ShadowSame(uint32_t page, const uint8_t* guest) const;
+  void ShadowReset();
+
+  // upload_census: what the uploads of a frame are, every 10 s (CensusCopy and the others are no-ops when off).
+  struct Census {
+    bool active = false;
+    uint64_t frame = UINT64_MAX;          // The frame being counted.
+    uint64_t window_first_frame = 0;
+    uint64_t window_frames = 0;           // Frames that had uploads.
+    std::chrono::steady_clock::time_point window_start;
+    // Window totals.
+    uint64_t calls = 0, pieces = 0, commands = 0, extended = 0, bytes = 0, bridged_bytes = 0;
+    uint64_t hoisted_calls = 0, in_place_no_run = 0, in_place_page_read = 0;
+    uint64_t pieces_by_kind[kRequestKindCount] = {};
+    uint64_t bytes_by_kind[kRequestKindCount] = {};
+    uint64_t hot_pages = 0, skipped_pages = 0, skipped_calls = 0;
+    uint64_t barriers_to_copy = 0, barriers_from_copy = 0, hoisted_pairs = 0, hoisted_rewrites = 0;
+    uint64_t pages_distinct = 0, pages_repeated = 0, pages_repeated_hot = 0, page_extra_copies = 0;
+    // Of the uploads of a page that had been uploaded before (the bytes hashed from guest memory when the copy is
+    // made): in the same frame with the same bytes / other bytes, in an earlier frame with the same / other bytes.
+    uint64_t same_in_frame = 0, changed_in_frame = 0, same_earlier_frame = 0, changed_earlier_frame = 0;
+    uint64_t pages_in_2 = 0, pages_in_8 = 0, pages_in_32 = 0;
+    uint64_t merge_potential[4] = {};     // Copies left of a frame's pieces if gaps of 0 / 4 / 16 / 64 KB were bridged.
+    uint64_t merge_bytes[4] = {};         // The bytes of those gaps.
+    uint64_t gap_hist[7] = {};            // overlap, 0, <= 4K, <= 16K, <= 64K, <= 1M, more.
+    uint64_t adjacent_in_order[3] = {};   // Pieces that continue the one before in the order made: exactly / within 4 KB / within 64 KB.
+    // The frame being counted.
+    std::vector<std::pair<uint32_t, uint32_t>> frame_pieces;  // byte start, length, in the order made.
+    std::vector<uint8_t> page_count;      // Per page, uploads this frame (saturating at 127), bit 7: hot at one of them.
+    std::vector<uint64_t> page_hash;      // Per page, a hash of the bytes of its last upload, and the frame of it.
+    std::vector<uint32_t> page_hash_frame;
+    std::vector<uint32_t> page_history;   // Per page, a bit per frame back from page_last_frame.
+    std::vector<uint32_t> page_last_frame;
+    std::vector<uint32_t> touched;
+  };
+  Census census_;
+  void CensusFrame();                     // Closes the frame being counted if the frame number has moved on, logs if due.
+  void CensusCloseFrame();
+  void CensusPiece(uint32_t byte_start, uint32_t length);
+  void CensusCall(bool hoisted, uint64_t no_run_before, uint64_t page_read_before);
+  void CensusLog();
+
+  // upload_verify (a proof mode): the pages a lever left out or covered with a copy of what they were thought to have
+  // (a hot page skipped for having the bytes already; a page bridged between two copies) are read back from the buffer
+  // right then, and compared with the bytes expected there when the submission is done.
+  struct VerifyEntry {
