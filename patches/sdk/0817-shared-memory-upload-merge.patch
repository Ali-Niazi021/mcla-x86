+  // The pages a draw of the run has read, or an upload of the run has written (hoist_pages_): any of [first, first +
+  // count)?
+  bool PagesMarkedInRun(uint32_t page_first, uint32_t page_count) const;
+  // The plain path (every cvar of this patch off) and the one that joins, bridges and skips.
+  bool UploadRangesPlain(const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges);
+  bool UploadRangesJoined(const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges);
+  std::vector<std::pair<uint32_t, uint32_t>> upload_plan_;
