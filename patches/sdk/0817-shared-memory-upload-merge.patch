+// ---------------------------------------------------------------------------------------------------------------------
+// LOCAL PATCH - MCLA (0817): the shared memory uploads: joining, bridging, skipping, the census and the proof mode.
+// docs: scratch/uploads/DESIGN.md.
+// ---------------------------------------------------------------------------------------------------------------------
+
+bool D3D12SharedMemory::PagesMarkedInRun(uint32_t page_first, uint32_t page_count) const {
+  if (!hoist_run_active_) {
+    return false;
+  }
+  for (uint32_t page = page_first; page < page_first + page_count; ++page) {
+    const uint32_t word = page >> 6;
+    if (word >= hoist_pages_.size()) {
+      return true;
+    }
+    if (hoist_pages_serial_[word] == hoist_serial_ && (hoist_pages_[word] & (uint64_t(1) << (page & 63)))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+uint32_t D3D12SharedMemory::ShadowFind(uint32_t page) const {
+  if (page >= shadow_page_slot_.size()) {
+    return UINT32_MAX;
+  }
+  const uint32_t slot_plus_one = shadow_page_slot_[page];
+  if (!slot_plus_one) {
+    return UINT32_MAX;
+  }
+  const uint32_t slot = slot_plus_one - 1;
+  if (slot >= shadow_used_ || shadow_slot_page_[slot] != page ||
+      shadow_slot_generation_[slot] != shadow_generation_) {
+    return UINT32_MAX;
+  }
+  return slot;
+}
+
+bool D3D12SharedMemory::ShadowSame(uint32_t page, const uint8_t* guest) const {
+  const uint32_t slot = ShadowFind(page);
+  if (slot == UINT32_MAX) {
+    return false;
+  }
+  return std::memcmp(shadow_bytes_.data() + (size_t(slot) << page_size_log2()), guest,
+                     size_t(1) << page_size_log2()) == 0;
+}
+
+void D3D12SharedMemory::ShadowStore(uint32_t page, const uint8_t* guest, uint8_t* upload_dst) {
+  const size_t page_size = size_t(1) << page_size_log2();
+  if (shadow_bytes_.empty()) {
+    shadow_slots_ = std::min(std::max(uint32_t(REXCVAR_GET(d3d12_upload_skip_same_pages)), uint32_t(16)), uint32_t(65536));
+    shadow_bytes_.resize(size_t(shadow_slots_) * page_size);
+    shadow_slot_page_.assign(shadow_slots_, 0);
+    shadow_slot_generation_.assign(shadow_slots_, 0);
+    shadow_page_slot_.assign(size_t(kBufferSize) >> page_size_log2(), 0);
+  }
+  uint32_t slot = ShadowFind(page);
+  if (slot == UINT32_MAX) {
+    if (shadow_used_ >= shadow_slots_) {
+      // No slot: copied from guest memory as it is, and the page has no bytes of record.
+      shadow_page_slot_[page] = 0;
+      std::memcpy(upload_dst, guest, page_size);
+      return;
+    }
+    slot = shadow_used_++;
+    shadow_page_slot_[page] = slot + 1;
+    shadow_slot_page_[slot] = page;
+  }
+  shadow_slot_generation_[slot] = shadow_generation_;
+  uint8_t* slot_bytes = shadow_bytes_.data() + (size_t(slot) * page_size);
+  // The copy to the buffer is made from the slot: the slot is, to the byte, what the buffer will hold.
+  std::memcpy(slot_bytes, guest, page_size);
+  std::memcpy(upload_dst, slot_bytes, page_size);
+}
+
+void D3D12SharedMemory::ShadowReset() {
+  ++shadow_generation_;
+  shadow_used_ = 0;
+}
+
+void D3D12SharedMemory::VerifyRecord(const std::vector<uint32_t>& pages, const std::vector<uint8_t>& kinds,
+                                     const std::vector<uint8_t>& expected) {
+  if (pages.empty() || verifies_.size() >= 256) {
+    return;
+  }
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  const size_t page_size = size_t(1) << page_size_log2();
+  D3D12_RESOURCE_DESC readback_desc;
+  ui::d3d12::util::FillBufferResourceDesc(readback_desc, UINT64(pages.size()) * page_size,
+                                          D3D12_RESOURCE_FLAG_NONE);
+  VerifyEntry entry;
+  if (FAILED(provider.GetDevice()->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesReadback, provider.GetHeapFlagCreateNotZeroed(), &readback_desc,
+          D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&entry.readback)))) {
+    REXGPU_WARN("[upload-verify] failed to create the readback buffer");
+    return;
+  }
+  // The buffer is read in place: after every copy recorded so far (hoisted ones too, they run at the start of
+  // their run) and before the ones of this call.
+  CommitUAVWritesAndTransitionBuffer(D3D12_RESOURCE_STATE_COPY_SOURCE);
+  command_processor_.SubmitBarriers();
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  for (size_t i = 0; i < pages.size(); ++i) {
+    command_list.D3DCopyBufferRegion(entry.readback.Get(), UINT64(i) * page_size, buffer_,
+                                     UINT64(pages[i]) << page_size_log2(), UINT64(page_size));
+  }
+  entry.submission = command_processor_.GetCurrentSubmission();
+  entry.pages = pages;
+  entry.kinds = kinds;
+  entry.expected = expected;
+  verifies_.push_back(std::move(entry));
+}
+
+void D3D12SharedMemory::VerifyCompare() {
+  const uint64_t completed = command_processor_.GetCompletedSubmission();
+  const size_t page_size = size_t(1) << page_size_log2();
+  size_t kept = 0;
+  for (size_t v = 0; v < verifies_.size(); ++v) {
+    VerifyEntry& entry = verifies_[v];
+    if (entry.submission > completed) {
+      if (kept != v) {
+        verifies_[kept] = std::move(entry);
+      }
+      ++kept;
+      continue;
+    }
+    D3D12_RANGE read_range = {0, SIZE_T(entry.pages.size() * page_size)};
+    void* mapping = nullptr;
+    if (SUCCEEDED(entry.readback->Map(0, &read_range, &mapping)) && mapping) {
+      for (size_t i = 0; i < entry.pages.size(); ++i) {
+        const uint8_t kind = entry.kinds[i];
+        ++verify_checked_[kind];
+        const uint8_t* got = static_cast<const uint8_t*>(mapping) + i * page_size;
+        const uint8_t* want = entry.expected.data() + i * page_size;
+        if (std::memcmp(got, want, page_size) != 0) {
+          ++verify_mismatched_[kind];
+          if (verify_mismatches_logged_ < 16) {
+            ++verify_mismatches_logged_;
+            size_t first = 0;
+            while (first < page_size && got[first] == want[first]) {
+              ++first;
+            }
+            REXGPU_ERROR(
+                "[upload-verify] MISMATCH ({}) page 0x{:08X}: the buffer differs from the bytes expected, first at "
+                "+0x{:X} (has {:02X}, expected {:02X})",
+                kind ? "bridged" : "skipped", entry.pages[i] << page_size_log2(), first, got[first], want[first]);
+          }
+        }
+      }
+      D3D12_RANGE written_range = {0, 0};
+      entry.readback->Unmap(0, &written_range);
+    }
+  }
+  verifies_.resize(kept);
+}
+
+bool D3D12SharedMemory::UploadRangesJoined(
+    const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges) {
+  const uint32_t page_log2 = page_size_log2();
+  const size_t page_size = size_t(1) << page_log2;
+  const bool merge = REXCVAR_GET(d3d12_upload_merge);
+  const uint32_t skip_mode = std::min(uint32_t(REXCVAR_GET(d3d12_upload_skip_same)), uint32_t(2));
+  const bool skip_same = skip_mode != 0;
+  // Mode 2 compares pages that are not hot: they are valid and watched before their bytes are looked at, as a copy
+  // does (MakeRangeValid before the memcpy), for the whole plan at once; what is not copied stays valid.
+  const bool armed_upfront = skip_mode == 2;
+  const bool verify = REXCVAR_GET(d3d12_upload_verify);
+  const uint32_t bridge_max = merge ? std::min(uint32_t(REXCVAR_GET(d3d12_upload_bridge_pages)), uint32_t(64)) : 0;
+
+  // The plan: sorted by address, the runs that overlap or touch made one (a page of two runs is copied once).
+  upload_plan_.assign(upload_page_ranges.begin(), upload_page_ranges.end());
+  std::sort(upload_plan_.begin(), upload_plan_.end());
+  {
+    size_t joined = 0;
+    for (size_t i = 1; i < upload_plan_.size(); ++i) {
+      std::pair<uint32_t, uint32_t>& previous = upload_plan_[joined];
+      const std::pair<uint32_t, uint32_t>& current = upload_plan_[i];
+      const uint64_t previous_end = uint64_t(previous.first) + previous.second;
+      if (uint64_t(current.first) <= previous_end) {
+        const uint64_t current_end = uint64_t(current.first) + current.second;
+        if (current_end > previous_end) {
+          previous.second = uint32_t(current_end - previous.first);
+        }
+      } else {
+        upload_plan_[++joined] = current;
+      }
+    }
+    upload_plan_.resize(joined + 1);
+  }
+
+  std::vector<uint32_t> verify_pages;
+  std::vector<uint8_t> verify_kinds;
+  std::vector<uint8_t> verify_expected;
+  auto verify_add = [&](uint32_t page, uint8_t kind, const uint8_t* bytes) {
+    if (verify_pages.size() >= 32) {
+      return;
+    }
+    verify_pages.push_back(page);
+    verify_kinds.push_back(kind);
+    verify_expected.insert(verify_expected.end(), bytes, bytes + page_size);
+  };
+
+  if (armed_upfront) {
+    for (const std::pair<uint32_t, uint32_t>& range : upload_plan_) {
+      MakeRangeValid(range.first << page_log2, range.second << page_log2, false);
+    }
+  }
+
+  // Pages at the ends of a run (hot ones; with mode 2 any) that the buffer already holds the bytes of (the bytes of
+  // the slot, which are what the last copy of the page put there) are left out. Never the middle of a run: it would
+  // make two copies of one.
+  if (skip_same) {
+    size_t kept = 0;
+    for (size_t i = 0; i < upload_plan_.size(); ++i) {
+      uint32_t first = upload_plan_[i].first;
+      uint32_t count = upload_plan_[i].second;
+      while (count) {
+        const uint8_t* guest = memory().TranslatePhysical(first << page_log2);
+        if ((skip_mode == 1 && !IsPageHotNow(first)) || !ShadowSame(first, guest)) {
+          break;
+        }
+        if (verify) {
+          verify_add(first, 0, shadow_bytes_.data() + size_t(ShadowFind(first)) * page_size);  // the slot: what the buffer must hold
+        }
+        ++first;
+        --count;
+        if (census_.active) {
+          ++census_.skipped_pages;
+        }
+      }
+      while (count) {
+        const uint32_t last = first + count - 1;
+        const uint8_t* guest = memory().TranslatePhysical(last << page_log2);
+        if ((skip_mode == 1 && !IsPageHotNow(last)) || !ShadowSame(last, guest)) {
+          break;
+        }
+        if (verify) {
+          verify_add(last, 0, shadow_bytes_.data() + size_t(ShadowFind(last)) * page_size);  // the slot: what the buffer must hold
+        }
+        --count;
+        if (census_.active) {
+          ++census_.skipped_pages;
+        }
+      }
+      if (count) {
+        upload_plan_[kept++] = std::make_pair(first, count);
+      }
+    }
+    if (census_.active) {
+      census_.skipped_calls += kept < upload_plan_.size();
+    }
+    upload_plan_.resize(kept);
+    if (upload_plan_.empty() && verify_pages.empty()) {
+      return true;
+    }
+  }
+
+  // The gap before each run of the plan (after the first) that its copy may cover to continue the copy before it.
+  std::vector<uint32_t>& lead_gap = upload_lead_gap_;
+  lead_gap.assign(upload_plan_.size(), 0);
+  if (bridge_max) {
+    for (size_t i = 1; i < upload_plan_.size(); ++i) {
+      const uint32_t previous_end = upload_plan_[i - 1].first + upload_plan_[i - 1].second;
+      const uint32_t gap = upload_plan_[i].first - previous_end;
+      if (gap && gap <= bridge_max && ArePagesPlainValid(previous_end, gap) && !PagesMarkedInRun(previous_end, gap)) {
+        lead_gap[i] = gap;
+        if (verify) {
+          for (uint32_t page = previous_end; page < previous_end + gap; ++page) {
+            verify_add(page, 1, memory().TranslatePhysical(page << page_log2));
+          }
+        }
+      }
+    }
+  }
+  if (!verify_pages.empty()) {
+    // In place, after the readbacks (they are recorded first, which ends the run of draws).
+    VerifyRecord(verify_pages, verify_kinds, verify_expected);
+  }
+  if (upload_plan_.empty()) {
+    return true;
+  }
+
+  const uint64_t census_no_run_before = hoist_stats_.uploads_in_place_no_run;
+  const uint64_t census_page_read_before = hoist_stats_.uploads_in_place_page_read;
+  bool hoist = BeginHoistedUpload(upload_plan_);
+  if (census_.active) {
+    CensusCall(hoist, census_no_run_before, census_page_read_before);
+  }
+  // The gap before the first run: to the copy that ended the last upload of the hoisted run.
+  if (hoist && bridge_max && hoist_tail_.valid && !lead_gap.empty()) {
+    const uint64_t first_byte = uint64_t(upload_plan_[0].first) << page_log2;
+    if (first_byte > hoist_tail_.dst_end) {
+      const uint32_t gap = uint32_t((first_byte - hoist_tail_.dst_end) >> page_log2);
+      const uint32_t gap_first = hoist_tail_.dst_end >> page_log2;
+      if (gap <= bridge_max && ArePagesPlainValid(gap_first, gap) && !PagesMarkedInRun(gap_first, gap)) {
+        lead_gap[0] = gap;
+      }
+    }
+  }
+  D3D12CommandProcessor::GpuTimingOpScope gt_op(command_processor_, D3D12CommandProcessor::kGtOpUpload);
+  if (!hoist) {
+    CommitUAVWritesAndTransitionBuffer(D3D12_RESOURCE_STATE_COPY_DEST);
+    command_processor_.SubmitBarriers();
+  }
+  auto& command_list = command_processor_.GetDeferredCommandList();
+  CopyTail local_tail;
+  CopyTail& tail = hoist ? hoist_tail_ : local_tail;
+  if (!merge) {
+    tail.valid = false;
+  }
+  bool successful = true;
+  size_t failed_range_index = SIZE_MAX;
+  uint32_t failed_start = 0, failed_remaining = 0;
+  for (size_t range_index = 0; range_index < upload_plan_.size() && successful; ++range_index) {
+    uint32_t start = upload_plan_[range_index].first;
+    uint32_t remaining = upload_plan_[range_index].second;
+    uint32_t gap_pages = lead_gap[range_index];
+    while (remaining != 0) {
+      // A gap is only taken if the copy before this one ended exactly where the gap starts.
+      if (gap_pages && !(tail.valid && tail.dst_end == (uint64_t(start - gap_pages) << page_log2))) {
+        gap_pages = 0;
+      }
+      ID3D12Resource* upload_buffer;
+      size_t upload_buffer_offset, upload_buffer_size;
+      uint8_t* upload_buffer_mapping = upload_buffer_pool_->RequestPartial(
+          command_processor_.GetCurrentSubmission(), size_t(gap_pages + remaining) << page_log2,
+          page_size, &upload_buffer, &upload_buffer_offset, &upload_buffer_size, nullptr);
+      if (upload_buffer_mapping == nullptr) {
+        REXGPU_ERROR("Shared memory: Failed to get an upload buffer");
+        successful = false;
+        failed_range_index = range_index;
+        failed_start = start;
+        failed_remaining = remaining;
+        break;
+      }
+      uint32_t block_pages = uint32_t(upload_buffer_size >> page_log2);
+      bool continues = merge && tail.valid && upload_buffer == tail.src && upload_buffer_offset == tail.src_end &&
+                       tail.dst_end == (uint64_t(start - gap_pages) << page_log2);
+      if (gap_pages && (!continues || block_pages <= gap_pages)) {
+        // The block does not go on from the copy before: the gap is not worth a copy of its own.
+        if (block_pages > gap_pages) {
+          upload_buffer_mapping += size_t(gap_pages) << page_log2;
+          upload_buffer_offset += size_t(gap_pages) << page_log2;
+          upload_buffer_size -= size_t(gap_pages) << page_log2;
+          block_pages -= gap_pages;
+          gap_pages = 0;
+          continues = false;
+        } else {
+          // No room in the block (the end of an upload page of the pool) for the gap and a page: ask again, with no gap.
+          gap_pages = 0;
+          continue;
+        }
+      }
+      const uint32_t real_pages = block_pages - gap_pages;
+      const uint32_t first_page = start - gap_pages;
+      if (!armed_upfront) {
+        MakeRangeValid(start << page_log2, real_pages << page_log2, false);
+      }
+      const uint8_t* guest_start = memory().TranslatePhysical(first_page << page_log2);
+      if (skip_same) {
+        // The pages that are hot go through a slot of their own; the others as they were, but a page that had a slot
+        // does not keep it (its bytes are not the ones of the slot any more).
+        uint32_t page = first_page;
+        const uint32_t block_end = first_page + block_pages;
+        while (page < block_end) {
+          // With mode 2 every page of the real part goes through a slot; with 1 the hot ones.
+          const bool through_slot = page >= start && (skip_mode == 2 || IsPageHotNow(page));
+          uint32_t run_end = page + 1;
+          while (run_end < block_end &&
+                 (run_end >= start && (skip_mode == 2 || IsPageHotNow(run_end))) == through_slot) {
+            ++run_end;
+          }
+          if (through_slot) {
+            for (uint32_t p = page; p < run_end; ++p) {
+              ShadowStore(p, guest_start + (size_t(p - first_page) << page_log2),
+                          upload_buffer_mapping + (size_t(p - first_page) << page_log2));
+            }
+          } else {
+            std::memcpy(upload_buffer_mapping + (size_t(page - first_page) << page_log2),
+                        guest_start + (size_t(page - first_page) << page_log2),
+                        size_t(run_end - page) << page_log2);
+            if (!shadow_page_slot_.empty()) {
+              for (uint32_t p = page; p < run_end; ++p) {
+                shadow_page_slot_[p] = 0;
+              }
+            }
+          }
+          page = run_end;
+        }
+      } else {
+        std::memcpy(upload_buffer_mapping, guest_start, upload_buffer_size);
+      }
+      bool extended = false;
+      if (continues) {
+        extended = command_list.ExtendCopyBufferRegion(tail.hoisted, tail.args_index, UINT64(upload_buffer_size));
+        if (extended) {
+          tail.dst_end += uint32_t(upload_buffer_size);
+          tail.src_end += upload_buffer_size;
+        }
+      }
+      if (!extended) {
+        const size_t args_index = command_list.D3DCopyBufferRegionTracked(
+            buffer_, UINT64(first_page) << page_log2, upload_buffer, UINT64(upload_buffer_offset),
+            UINT64(upload_buffer_size));
+        tail.valid = merge;
+        tail.hoisted = hoist;
+        tail.args_index = args_index;
+        tail.dst_end = uint32_t((uint64_t(first_page) << page_log2) + upload_buffer_size);
+        tail.src = upload_buffer;
+        tail.src_end = upload_buffer_offset + upload_buffer_size;
+      }
+      if (census_.active) {
+        CensusPiece(start << page_log2, real_pages << page_log2);
+        census_.commands += !extended;
+        census_.extended += extended;
+        census_.bridged_bytes += uint64_t(gap_pages) << page_log2;
+      }
+      start += real_pages;
+      remaining -= real_pages;
+      gap_pages = 0;
+    }
+  }
+  gt_op.End();
+  if (!successful && armed_upfront && failed_range_index != SIZE_MAX) {
+    // The pages that were made valid ahead of their copy and did not get one are not valid.
+    MemoryInvalidationCallback(failed_start << page_log2, failed_remaining << page_log2, true);
+    for (size_t i = failed_range_index + 1; i < upload_plan_.size(); ++i) {
+      MemoryInvalidationCallback(upload_plan_[i].first << page_log2, upload_plan_[i].second << page_log2, true);
+    }
+  }
+  if (hoist) {
+    // Also after a failure, to leave the hoisted stream well-formed.
+    hoist_byte_ranges_temp_.clear();
+    for (const std::pair<uint32_t, uint32_t>& range : upload_plan_) {
+      hoist_byte_ranges_temp_.emplace_back(range.first << page_size_log2(), range.second << page_size_log2());
+    }
+    EndHoistedUpload(hoist_byte_ranges_temp_);
+  }
+  return successful;
+}
+
+// ----- The census -----
+
+void D3D12SharedMemory::CensusFrame() {
+  const uint64_t frame = command_processor_.GetCurrentFrame();
+  if (census_.frame == frame) {
+    return;
+  }
+  const size_t pages = size_t(kBufferSize) >> page_size_log2();
+  if (census_.page_count.empty()) {
+    census_.page_count.assign(pages, 0);
+    census_.page_hash.assign(pages, 0);
+    census_.page_hash_frame.assign(pages, 0);
+    census_.page_history.assign(pages, 0);
+    census_.page_last_frame.assign(pages, 0);
+    census_.window_start = std::chrono::steady_clock::now();
+  }
+  if (census_.frame != UINT64_MAX) {
+    CensusCloseFrame();
+  }
+  census_.frame = frame;
+  if (std::chrono::steady_clock::now() - census_.window_start >= std::chrono::seconds(10)) {
+    CensusLog();
+  }
+}
+
+void D3D12SharedMemory::CensusPiece(uint32_t byte_start, uint32_t length) {
+  ++census_.pieces;
+  census_.bytes += length;
+  const uint32_t kind = std::min(current_request_kind(), uint32_t(kRequestKindCount - 1));
+  ++census_.pieces_by_kind[kind];
+  census_.bytes_by_kind[kind] += length;
+  census_.frame_pieces.emplace_back(byte_start, length);
+  const uint32_t page_first = byte_start >> page_size_log2();
+  const uint32_t page_last = (byte_start + length - 1) >> page_size_log2();
+  const uint32_t frame32 = uint32_t(census_.frame);
+  for (uint32_t page = page_first; page <= page_last && page < census_.page_count.size(); ++page) {
+    uint8_t& count = census_.page_count[page];
+    if ((count & 0x7F) == 0) {
+      census_.touched.push_back(page);
+    }
+    if ((count & 0x7F) < 127) {
+      ++count;
+    }
+    if (IsPageHotNow(page)) {
+      ++census_.hot_pages;
+      count |= 0x80;
+    }
+    // Is it the bytes the page was last uploaded with? (hashed from guest memory now: for the counts, not a proof)
+    const uint64_t* words = reinterpret_cast<const uint64_t*>(memory().TranslatePhysical(page << page_size_log2()));
+    uint64_t hash = 0xCBF29CE484222325ull;
+    for (size_t i = 0; i < (size_t(1) << page_size_log2()) / sizeof(uint64_t); ++i) {
+      hash = (hash ^ words[i]) * 0x100000001B3ull;
+      hash ^= hash >> 29;
+    }
+    if (census_.page_hash_frame[page] != 0) {
+      const bool same = census_.page_hash[page] == hash;
+      if (census_.page_hash_frame[page] == frame32) {
+        ++(same ? census_.same_in_frame : census_.changed_in_frame);
+      } else {
+        ++(same ? census_.same_earlier_frame : census_.changed_earlier_frame);
+      }
+    }
+    census_.page_hash[page] = hash;
+    census_.page_hash_frame[page] = frame32 ? frame32 : 1;
+  }
+}
+
+void D3D12SharedMemory::CensusCall(bool hoisted, uint64_t no_run_before, uint64_t page_read_before) {
+  ++census_.calls;
+  if (hoisted) {
+    ++census_.hoisted_calls;
+  } else if (hoist_stats_.uploads_in_place_no_run != no_run_before) {
+    ++census_.in_place_no_run;
+  } else if (hoist_stats_.uploads_in_place_page_read != page_read_before) {
+    ++census_.in_place_page_read;
+  }
+}
+
+void D3D12SharedMemory::CensusCloseFrame() {
+  if (census_.frame_pieces.empty()) {
+    return;
+  }
+  ++census_.window_frames;
+  const uint32_t frame32 = uint32_t(census_.frame);
+  for (uint32_t page : census_.touched) {
+    const uint32_t count = census_.page_count[page] & 0x7F;
+    ++census_.pages_distinct;
+    if (count > 1) {
+      ++census_.pages_repeated;
+      census_.pages_repeated_hot += (census_.page_count[page] & 0x80) != 0;
+      census_.page_extra_copies += count - 1;
+    }
+    const uint32_t age = frame32 - census_.page_last_frame[page];
+    uint32_t history = age >= 32 ? 0 : census_.page_history[page] << age;
+    history |= 1;
+    census_.page_history[page] = history;
+    census_.page_last_frame[page] = frame32;
+    census_.pages_in_2 += (history & 0x3u) == 0x3u;
+    census_.pages_in_8 += (history & 0xFFu) == 0xFFu;
+    census_.pages_in_32 += history == 0xFFFFFFFFu;
+    census_.page_count[page] = 0;
+  }
+  census_.touched.clear();
+
+  // The gaps between the copies of the frame in address order, and what bridging them would leave.
+  std::vector<std::pair<uint32_t, uint32_t>>& pieces = census_.frame_pieces;
+  {
+    // In the order they were made: how many go on from the one before.
+    uint64_t previous_end = UINT64_MAX;
+    for (const std::pair<uint32_t, uint32_t>& piece : pieces) {
+      if (previous_end != UINT64_MAX && piece.first >= previous_end) {
+        const uint64_t gap = piece.first - previous_end;
+        census_.adjacent_in_order[0] += gap == 0;
+        census_.adjacent_in_order[1] += gap <= 4096;
+        census_.adjacent_in_order[2] += gap <= 65536;
+      }
+      previous_end = uint64_t(piece.first) + piece.second;
+    }
+  }
+  std::sort(pieces.begin(), pieces.end());
+  static constexpr uint64_t kThresholds[4] = {0, 4096, 16384, 65536};
+  uint64_t left[4] = {1, 1, 1, 1};
+  uint64_t end_so_far = uint64_t(pieces[0].first) + pieces[0].second;
+  for (size_t i = 1; i < pieces.size(); ++i) {
+    const int64_t gap = int64_t(pieces[i].first) - int64_t(end_so_far);
+    const size_t bucket = gap < 0 ? 0 : gap == 0 ? 1 : gap <= 4096 ? 2 : gap <= 16384 ? 3 : gap <= 65536 ? 4 : gap <= (1 << 20) ? 5 : 6;
+    ++census_.gap_hist[bucket];
+    for (size_t t = 0; t < 4; ++t) {
+      if (gap > int64_t(kThresholds[t])) {
+        ++left[t];
+      } else if (gap > 0) {
+        census_.merge_bytes[t] += uint64_t(gap);
+      }
+    }
+    end_so_far = std::max(end_so_far, uint64_t(pieces[i].first) + pieces[i].second);
+  }
+  for (size_t t = 0; t < 4; ++t) {
+    census_.merge_potential[t] += left[t];
+  }
+  pieces.clear();
+}
