 #include <algorithm>
+#include <atomic>  // LOCAL PATCH - MCLA (0755)
 #include <climits>
 #include <cmath>
 #include <memory>
@@ -80,6 +81,32 @@
 // clock covered the window (0.9 to 1.1 of its time). Otherwise the display-side numbers are printed as '?', with the
 // reason. Judged frames are compared with the cadence, the refreshes a frame is expected to last: the refresh rate
 // over the present rate (1 at 60 fps on 60 Hz; 2.75 at 60 fps on 165 Hz, where 2 and 3 are normal, in a 3-3-3-2 beat).
+
+// LOCAL PATCH - MCLA (0755) begin: the same counters as one exported struct of relaxed atomics, for the title's in-game
+// statistics screen (src/host/overlay in mcla-x86 reads it with GetProcAddress; the layout is its present_stats_abi.h and
+// must stay in step with it). All counters are cumulative since the process started (a reader subtracts two reads). They
+// are fed only while present_stats_log_s > 0, like the log lines.
+struct RexPresentStatsAbi {
+  uint32_t size = 0;  // set below: sizeof(RexPresentStatsAbi)
+  uint32_t version = 1;
+  std::atomic<uint64_t> presents{0};        // Present calls made
+  std::atomic<uint64_t> retired{0};         // presents the compositor retired
+  std::atomic<uint64_t> shown{0};           // retired presents that got a refresh of their own
+  std::atomic<uint64_t> dropped{0};         // retired presents that never got one
+  std::atomic<uint64_t> sync_refreshes{0};  // refreshes the refresh clock counted
+  std::atomic<int64_t> sync_qpc{0};         // QPC ticks those refreshes span
+  std::atomic<int64_t> qpf{0};              // QueryPerformanceFrequency
+  std::atomic<uint64_t> held[4] = {};       // shown frames that stayed 1, 2, 3, 4 or more refreshes
+  std::atomic<uint64_t> over_cadence{0};    // frames that stayed longer than the cadence allows (the hitch rule)
+  std::atomic<uint32_t> cadence_milli{0};   // the last judgeable cadence x 1000, 0 = none
+  std::atomic<uint32_t> valid{0};           // 1 while GetFrameStatistics works
+  RexPresentStatsAbi() { size = uint32_t(sizeof(RexPresentStatsAbi)); }
+};
+static_assert(sizeof(RexPresentStatsAbi) == 8 + 8 * 5 + 8 * 2 + 8 * 4 + 8 + 4 + 4, "the layout of present_stats_abi.h");
+extern "C" __declspec(dllexport) RexPresentStatsAbi rex_present_stats;
+RexPresentStatsAbi rex_present_stats;
+// LOCAL PATCH - MCLA (0755) end
+
