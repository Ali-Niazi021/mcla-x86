+// LOCAL PATCH - MCLA (0815): front_buffer_resolve_skip
+void D3D12RenderTargetCache::DisarmFrontBufferPending(bool by_work) {
+  FrontBufferPending& pending = front_buffer_pending_;
+  if (!pending.armed) {
+    return;
+  }
+  if (by_work) {
+    ++front_buffer_skip_stats_.disarmed_by_work;
+  }
+  if (pending.texture) {
+    pending.texture->Unpin();
+  }
+  pending = FrontBufferPending();
+}
+
+void D3D12RenderTargetCache::LogFrontBufferSkipIfDue() {
+  FrontBufferSkipStats& stats = front_buffer_skip_stats_;
+  const auto now = std::chrono::steady_clock::now();
+  const double seconds = std::chrono::duration<double>(now - stats.window_start).count();
+  if (seconds < 10.0) {
+    return;
+  }
+  if (stats.cancelled || stats.disarmed_by_work || stats.not_cancelled_swap || stats.not_armed_kept_store) {
+    REXGPU_INFO(
+        "[front-buffer-skip] {:.1f} s: {} front-buffer resolves cancelled at a swap from the render target ({:.1f} MB "
+        "read and written not); made: {} a draw or resolve came before the swap, {} the swap was a check or not from "
+        "that render target, {} the store is kept (a reader of the front buffer)",
+        seconds, stats.cancelled, double(stats.cancelled_bytes) / 1048576.0,
+        stats.disarmed_by_work, stats.not_cancelled_swap, stats.not_armed_kept_store);
+  }
+  stats = FrontBufferSkipStats();
+  stats.window_start = now;
+}
+
 void D3D12RenderTargetCache::UseSwapDirectSource(const SwapDirectSource& source,
                                                  D3D12_RESOURCE_STATES state) {
+  // LOCAL PATCH - MCLA (0815): front_buffer_resolve_skip: this swap is shown from the render target the armed resolve
+  // read, at the address it wrote, with nothing recorded in between: the resolve's work is not needed (not for a check
+  // swap, which compares against the texture).
+  FrontBufferPending& pending = front_buffer_pending_;
+  if (pending.armed) {
+    if (REXCVAR_GET(front_buffer_resolve_skip) && !REXCVAR_GET(swap_direct_present_check) &&
+        source.render_target == pending.render_target && source.dest_base == pending.dest_base &&
+        pending.texture_cache &&
+        command_processor_.GetDeferredCommandList().CancelDispatch(
+            DeferredCommandList::DispatchHandle{pending.dispatch_offset, pending.dispatch_generation})) {
+      pending.texture_cache->ForgetResolveDualWrite(pending.texture, pending.extent_start, pending.extent_length);
+      ++front_buffer_skip_stats_.cancelled;
+      front_buffer_skip_stats_.cancelled_bytes += pending.bytes;
+    } else {
+      ++front_buffer_skip_stats_.not_cancelled_swap;
+    }
+    DisarmFrontBufferPending(false);
+  }
+  LogFrontBufferSkipIfDue();
   auto* render_target = static_cast<D3D12RenderTarget*>(source.render_target);
   command_processor_.PushTransitionBarrier(
       render_target->resource(), render_target->SetResourceState(state), state);
