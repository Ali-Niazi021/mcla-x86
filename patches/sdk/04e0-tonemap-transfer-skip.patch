+// LOCAL PATCH - MCLA (04e0): tonemap_transfer_skip. The pixel shader of the title's tone map (the one the HDR scene check
+// in command_processor.cpp looks for), and the counts behind the log line. The CP thread only.
+constexpr uint64_t kTonemapPixelShaderHash = 0xE5EBEFAE4D165CBA;
+
+class TonemapSkipStats {
+ public:
+  // For every draw while tonemap_transfer_skip is acting: counts the frames the tone map marker was seen in and writes
+  // the summary every 10 seconds. The clock is read at each frame's first draw after the marker and every 8192 draws.
+  void NoteDraw(bool after_marker) {
+    const bool new_frame = after_marker && !marker_active_;
+    marker_active_ = after_marker;
+    if (new_frame) {
+      ++frames_;
+    } else if (++draws_ & 0x1FFF) {
+      return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    const double seconds = std::chrono::duration<double>(now - window_start_).count();
+    if (seconds >= 10.0) {
+      Report(seconds);
+      window_start_ = now;
+    }
+  }
+
+  // The registers the analysis reads, for the log (what the draw's state was when it was kept or skipped).
+  static std::string DescribeDrawRegisters(const RegisterFile& regs, uint32_t normalized_depth_control,
+                                           uint32_t normalized_color_mask) {
+    char buffer[640];
+    std::snprintf(buffer, sizeof(buffer),
+                  "RB_DEPTHCONTROL %08X (normalized %08X), RB_STENCILREFMASK %08X, RB_COLOR_MASK %08X (normalized "
+                  "%08X), RB_BLENDCONTROL0 %08X, RB_COLORCONTROL %08X, RB_MODECONTROL %08X, RB_SURFACE_INFO %08X, "
+                  "PA_SU_SC_MODE_CNTL %08X, PA_CL_CLIP_CNTL %08X, PA_CL_VTE_CNTL %08X, VGT_DRAW_INITIATOR %08X",
+                  regs[XE_GPU_REG_RB_DEPTHCONTROL], normalized_depth_control, regs[XE_GPU_REG_RB_STENCILREFMASK],
+                  regs[XE_GPU_REG_RB_COLOR_MASK], normalized_color_mask, regs[XE_GPU_REG_RB_BLENDCONTROL0],
+                  regs[XE_GPU_REG_RB_COLORCONTROL], regs[XE_GPU_REG_RB_MODECONTROL],
+                  regs[XE_GPU_REG_RB_SURFACE_INFO], regs[XE_GPU_REG_PA_SU_SC_MODE_CNTL],
+                  regs[XE_GPU_REG_PA_CL_CLIP_CNTL], regs[XE_GPU_REG_PA_CL_VTE_CNTL],
+                  regs[XE_GPU_REG_VGT_DRAW_INITIATOR]);
+    return buffer;
+  }
+
+  void Skipped(const RegisterFile& regs, uint32_t normalized_depth_control, uint32_t normalized_color_mask, uint32_t x,
+               uint32_t y, uint32_t width, uint32_t height, uint64_t vertex_shader_hash, bool poison) {
+    ++skipped_;
+    if (!logged_first_skip_) {
+      logged_first_skip_ = true;
+      REXGPU_INFO(
+          "[tonemap-skip] first skipped transfer: the tone map draw (vertex shader {:016X}, pixel shader {:016X}) "
+          "rewrites the whole screen {},{} {}x{} of its target{}; {}",
+          vertex_shader_hash, kTonemapPixelShaderHash, x, y, width, height,
+          poison ? " (the rectangle is filled with magenta: tonemap_transfer_skip_poison)" : "",
+          DescribeDrawRegisters(regs, normalized_depth_control, normalized_color_mask));
+    }
+  }
+
+  // reason: a string literal. Logged once for each reason, with the registers of the draw.
+  void Kept(const char* reason, const RegisterFile& regs, uint32_t normalized_depth_control,
+            uint32_t normalized_color_mask, uint32_t x, uint32_t y, uint32_t width, uint32_t height,
+            uint64_t vertex_shader_hash) {
+    ++kept_;
+    if (++kept_reasons_[reason] == 1) {
+      REXGPU_INFO(
+          "[tonemap-skip] kept a transfer ({}): vertex shader {:016X}, pixel shader {:016X}, rectangle {},{} {}x{}; {}",
+          reason, vertex_shader_hash, kTonemapPixelShaderHash, x, y, width, height,
+          DescribeDrawRegisters(regs, normalized_depth_control, normalized_color_mask));
+    }
+  }
+
+  // A rectangle draw after the marker that needed transfers and isn't the tone map.
+  void OtherDraw(uint64_t pixel_shader_hash) {
+    if (!other_++) {
+      other_first_pixel_shader_ = pixel_shader_hash;
+    }
+  }
+
+ private:
+  void Report(double seconds) {
+    std::string reasons;
+    for (const auto& kept : kept_reasons_) {
+      reasons += (reasons.empty() ? "" : "; ") + std::string(kept.first) + " x" + std::to_string(kept.second);
+    }
+    if (reasons.empty()) {
+      reasons = "none";
+    }
+    char first_pixel_shader[64] = "";
+    if (other_) {
+      std::snprintf(first_pixel_shader, sizeof(first_pixel_shader), " (the first: pixel shader %016llX)",
+                    static_cast<unsigned long long>(other_first_pixel_shader_));
+    }
+    REXGPU_INFO(
+        "[tonemap-skip] {} transfers skipped, {} kept ({}) in {:.1f} s; the tone map marker was seen in {} frames, {} "
+        "other rectangle draws after it needed transfers{}{}",
+        skipped_, kept_, reasons, seconds, frames_, other_, first_pixel_shader,
+        frames_ ? "" : " - no marker: the render markers are off (mcla_render_markers)");
+    skipped_ = kept_ = frames_ = other_ = 0;
+    kept_reasons_.clear();
+  }
+
+  uint64_t skipped_ = 0, kept_ = 0, frames_ = 0, other_ = 0, draws_ = 0;
+  uint64_t other_first_pixel_shader_ = 0;
+  std::map<const char*, uint64_t> kept_reasons_;
+  std::chrono::steady_clock::time_point window_start_ = std::chrono::steady_clock::now();
+  bool marker_active_ = false;
+  bool logged_first_skip_ = false;
+};
+
