   void Shutdown(bool from_destructor = false);
 
+  // LOCAL PATCH - MCLA (0790): the pipelines this cache makes on first use (the ownership transfer pipelines,
+  // 1 or 9 for each TransferShaderKey, and the dump pipelines) are made again in every run, on the command processor
+  // thread, in the middle of the first frames of a scene: ~200 of them in the quick drive, 78-119 in the one frame of
+  // the front end that hitches 140-200 ms. Their keys are appended to <title>.rtv.d3d12.xrtp, beside the pipeline
+  // storage, the first time a key is made, and this makes the stored ones at start (what InitializeShaderStorage does
+  // for the draw pipelines), without counting them as run-time creations. Call after Initialize, on the thread that
+  // runs the command processor (D3D12CommandProcessor::InitializeShaderStorage does). The file is dropped and made
+  // again if the options that change the pipelines differ (use_stencil_reference_output_, depth_transfer_not_equal_test,
+  // msaa_2x_supported_, the transfer modes).
+  void InitializeRuntimePipelineStorage(const std::filesystem::path& cache_root,
+                                        uint32_t title_id);
+
   void CompletedSubmissionUpdated();
   void BeginSubmission();
 
@@ -810,6 +825,22 @@
                      TransferShaderKey::Hasher>
       transfer_stencil_bit_pipelines_;
 
+  // LOCAL PATCH - MCLA (0790): the keys of the pipelines made on first use, kept across runs.
+  enum : uint32_t {
+    kRuntimePipelineKeyTransfer = 1,  // TransferShaderKey::key
+    kRuntimePipelineKeyDump = 2,      // DumpPipelineKey::key
+  };
+  // Appends the key to the file (and flushes: a few dozen records a run, and the process ends with _Exit) unless it
+  // is already there or the keys are being made from the file.
+  void RecordRuntimePipelineKey(uint32_t kind, uint32_t key);
+  void ShutdownRuntimePipelineStorage();
+  FILE* runtime_pipeline_keys_file_ = nullptr;
+  // (kind << 32) | key, of every record in the file.
+  std::unordered_set<uint64_t> runtime_pipeline_keys_known_;
+  // While the stored keys are being made: not counted as run-time creations (rexgpu_pipeline_creations) and not
+  // written again.
+  bool runtime_pipeline_keys_preloading_ = false;
+
   // Temporary storage for PerformTransfersAndResolveClears.
   std::vector<TransferInvocation> current_transfer_invocations_;
 
diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -474,6 +474,12 @@
                                                     uint32_t title_id, bool blocking) {
   CommandProcessor::InitializeShaderStorage(cache_root, title_id, blocking);
   pipeline_cache_->InitializeShaderStorage(cache_root, title_id, blocking);
+  // LOCAL PATCH - MCLA (0790): the render target pipelines made on first use (ownership transfers, dumps) of
+  // earlier runs, made here instead of in the frames that need them. After the pipeline storage, whose creation
+  // threads are done by now with a blocking preload.
+  if (render_target_cache_) {
+    render_target_cache_->InitializeRuntimePipelineStorage(cache_root, title_id);
+  }
 }
 
