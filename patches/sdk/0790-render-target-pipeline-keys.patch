+// LOCAL PATCH - MCLA (0790): the keys of the pipelines made on first use, kept across runs.
+namespace {
+constexpr uint32_t kRuntimePipelineKeysMagic = 0x50545258;  // 'XRTP'
+constexpr uint32_t kRuntimePipelineKeysVersion = 1;
+struct RuntimePipelineKeysHeader {
+  uint32_t magic;
+  uint32_t version;
+  // What changes the pipelines or the keys that are asked for: a file made with other values is made again.
+  uint32_t context;
+};
+}  // namespace
+
+void D3D12RenderTargetCache::InitializeRuntimePipelineStorage(
+    const std::filesystem::path& cache_root, uint32_t title_id) {
+  ShutdownRuntimePipelineStorage();
+  // The transfers and the dumps are what the host render targets path does; the root signatures are made by
+  // Initialize.
+  if (path_ != Path::kHostRenderTargets || !transfer_root_signatures_[0]) {
+    return;
+  }
+  const auto directory = cache_root / "shaders" / "shareable";
+  std::error_code directory_error;
+  std::filesystem::create_directories(directory, directory_error);
+  const auto file_path = directory / fmt::format("{:08X}.rtv.d3d12.xrtp", title_id);
+  FILE* file = rex::filesystem::OpenFile(file_path, "a+b");
+  if (!file) {
+    REXGPU_WARN(
+        "D3D12RenderTargetCache: Failed to open the render target pipeline key file, the pipelines made on first "
+        "use are not kept for the next runs: {}",
+        rex::path_to_utf8(file_path));
+    return;
+  }
+
+  RuntimePipelineKeysHeader header_wanted;
+  header_wanted.magic = kRuntimePipelineKeysMagic;
+  header_wanted.version = kRuntimePipelineKeysVersion;
+  header_wanted.context = uint32_t(use_stencil_reference_output_) |
+                          (uint32_t(REXCVAR_GET(depth_transfer_not_equal_test)) << 1) |
+                          (uint32_t(msaa_2x_supported_) << 2) | (uint32_t(TransferMode::kCount) << 8);
+  RuntimePipelineKeysHeader header;
+  std::vector<uint64_t> stored;
+  bool header_valid = fread(&header, sizeof(header), 1, file) == 1 &&
+                      std::memcmp(&header, &header_wanted, sizeof(header)) == 0;
+  if (header_valid) {
+    uint64_t record;
+    while (fread(&record, sizeof(record), 1, file) == 1) {
+      const uint32_t kind = uint32_t(record >> 32);
+      if (kind != kRuntimePipelineKeyTransfer && kind != kRuntimePipelineKeyDump) {
+        break;  // Corrupted: keep what's before.
+      }
+      stored.push_back(record);
+    }
+  }
+  const uint64_t valid_bytes =
+      header_valid ? sizeof(header) + stored.size() * sizeof(uint64_t) : sizeof(header);
+  if (!rex::filesystem::TruncateStdioFile(file, header_valid ? valid_bytes : 0)) {
+    fclose(file);
+    return;
+  }
+  rex::filesystem::Seek(file, 0, SEEK_END);
+  if (!header_valid) {
+    fwrite(&header_wanted, sizeof(header_wanted), 1, file);
+    fflush(file);
+  }
+  runtime_pipeline_keys_file_ = file;
+
+  // Make the stored ones, here, at the start, not in the first frames of the scene that needs them.
+  const auto start = std::chrono::steady_clock::now();
+  size_t transfer_keys = 0, dump_keys = 0, created = 0, failed = 0, rejected = 0;
+  runtime_pipeline_keys_preloading_ = true;
+  for (uint64_t record : stored) {
+    const uint32_t kind = uint32_t(record >> 32);
+    const uint32_t key_value = uint32_t(record);
+    runtime_pipeline_keys_known_.insert(record);
+    if (kind == kRuntimePipelineKeyTransfer) {
+      TransferShaderKey key;
+      key.key = key_value;
+      if (size_t(key.mode) >= size_t(TransferMode::kCount)) {
+        ++rejected;
+        continue;
+      }
+      ++transfer_keys;
+      ID3D12PipelineState* const* pipelines = GetOrCreateTransferPipelines(key);
+      if (pipelines) {
+        created += kTransferModes[size_t(key.mode)].output == TransferOutput::kStencilBit ? 8 : 1;
+      } else {
+        ++failed;
+      }
+    } else {
+      DumpPipelineKey key;
+      key.key = key_value;
+      ++dump_keys;
+      if (GetOrCreateDumpPipeline(key)) {
+        ++created;
+      } else {
+        ++failed;
+      }
+    }
+  }
+  runtime_pipeline_keys_preloading_ = false;
+  REXGPU_INFO(
+      "Created {} render target pipelines for {} ownership transfer and {} dump keys from the storage in {} "
+      "milliseconds ({} failed, {} rejected)",
+      created, transfer_keys, dump_keys,
+      std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count(),
+      failed, rejected);
+}
+
+void D3D12RenderTargetCache::RecordRuntimePipelineKey(uint32_t kind, uint32_t key) {
+  if (!runtime_pipeline_keys_file_ || runtime_pipeline_keys_preloading_) {
+    return;
+  }
+  const uint64_t record = (uint64_t(kind) << 32) | key;
+  if (!runtime_pipeline_keys_known_.insert(record).second) {
+    return;
+  }
+  fwrite(&record, sizeof(record), 1, runtime_pipeline_keys_file_);
+  fflush(runtime_pipeline_keys_file_);
+}
+
+void D3D12RenderTargetCache::ShutdownRuntimePipelineStorage() {
+  if (runtime_pipeline_keys_file_) {
+    fclose(runtime_pipeline_keys_file_);
+    runtime_pipeline_keys_file_ = nullptr;
+  }
+  runtime_pipeline_keys_known_.clear();
+  runtime_pipeline_keys_preloading_ = false;
+}
