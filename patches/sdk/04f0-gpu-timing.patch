+D3D12CommandProcessor::GpuTimingReport& D3D12CommandProcessor::GpuTimingGetReport() {
+  if (!gpu_timing_report_) {
+    gpu_timing_report_ = std::make_unique<GpuTimingReport>();
+  }
+  return *gpu_timing_report_;
+}
