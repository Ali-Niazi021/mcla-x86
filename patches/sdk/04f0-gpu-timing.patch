+// LOCAL PATCH - MCLA (04f0): gpu-timing exports, C data symbols of rexgpu-xenos.dll (GetProcAddress gives the address of
+// each atomic). The D3D12 command processor (d3d12/command_processor.cpp, GpuTiming) publishes the GPU time of each
+// finished frame, a few frames after it was drawn, whenever gpu_timing is on or gpu_timing_export is (the default):
+//   rexgpu_gpu_frame_us   the last resolved frame's GPU time in microseconds (first work of the frame to its last,
+//                         the presenter's paint not included), stored with release order, before ...
+//   rexgpu_gpu_frame_seq  ... this counter is incremented (acquire it, then read the time)
+//   rexgpu_gpu_frame_lag  how many frames the command processor has finished since the published one was (0: the
+//                         newest finished frame)
+// The next two belong to a later patch (variable rate shading): the game writes the level it wants, the SDK the number
+// of levels it can do; defined here so the game can find them now.
+//   rexgpu_vrs_level      -1: not set
+//   rexgpu_vrs_levels     0: none
+#if REX_PLATFORM_WIN32
+extern "C" __declspec(dllexport) std::atomic<uint32_t> rexgpu_gpu_frame_us{0};
+extern "C" __declspec(dllexport) std::atomic<uint32_t> rexgpu_gpu_frame_seq{0};
+extern "C" __declspec(dllexport) std::atomic<uint32_t> rexgpu_gpu_frame_lag{0};
+extern "C" __declspec(dllexport) std::atomic<int32_t> rexgpu_vrs_level{-1};
+extern "C" __declspec(dllexport) std::atomic<int32_t> rexgpu_vrs_levels{0};
+#else
+extern "C" std::atomic<uint32_t> rexgpu_gpu_frame_us{0};
+extern "C" std::atomic<uint32_t> rexgpu_gpu_frame_seq{0};
+extern "C" std::atomic<uint32_t> rexgpu_gpu_frame_lag{0};
+extern "C" std::atomic<int32_t> rexgpu_vrs_level{-1};
+extern "C" std::atomic<int32_t> rexgpu_vrs_levels{0};
+#endif
+
 // LOCAL PATCH - MCLA (0430): a WAIT_REG_MEM that sleeps (wait >= 0x100) is woken when the guest's vblank handler has
 // run, not left to a Sleep(1 ms) poll. The title's swap gate is such a wait (memory == 0, wait 0x100): the guest's vblank
 // handler releases it, and a poll at the host's 1-2 ms timer tick noticed the release 0-2 ms late, a different delay
