   bool PushTransitionBarrier(ID3D12Resource* resource, D3D12_RESOURCE_STATES old_state,
                              D3D12_RESOURCE_STATES new_state,
@@ -1059,6 +1080,101 @@ class D3D12CommandProcessor : public CommandProcessor {
 
   // Temporary storage for memexport stream constants used in the draw.
   std::vector<draw_util::MemExportRange> memexport_ranges_;
+
+  // LOCAL PATCH - MCLA (04f0): gpu_timing, the GPU time of each frame cut at the title's phase markers, and the draw
+  // experiments (gpu_draw_experiment). The methods are at the end of command_processor.cpp.
+  //
+  // A frame is the work between two swaps. Its first work records a timestamp (slot 0), each marker that starts a new
+  // segment another, and the last work before the frame's last submission closes one more, followed by one
+  // ResolveQueryData of the frame's slots into a readback ring; the results are read when the submission that holds the
+  // resolve has completed, never waited for. The segment of slot k is segment[k] (a segment id, below), it ends at slot
+  // k+1. Segment ids: 0..29 the title's phase bits, kIdLead before the first marker, kIdTail after the render loop,
+  // kIdSwap in IssueSwap.
+  void OnGuestMarker(uint32_t kind, uint32_t value) override;
+  // BeginSubmission, when a frame opens: reads the experiment cvars, starts the frame's timestamps.
+  void GpuTimingFrameBegin();
+  // EndSubmission(is_swap), the last list of the frame: the end timestamp and the resolve.
+  void GpuTimingFrameEnd();
+  // IssueSwap, before its work: the experiment cycle, the swap segment.
+  void GpuTimingBeforeSwap();
+  void GpuTimingCycleTick();
+  // A new segment starts here (a timestamp if the frame is timed in full).
+  void GpuTimingSetSegment(uint32_t id);
+  // Adds what was recorded since the last call to the current segment's group.
+  void GpuTimingAttribute();
+  bool GpuTimingInit();
+  void GpuTimingShutdown();
+  // Reads the frames whose submissions are done.
+  void GpuTimingCollect();
+  void GpuTimingFlushCsv();
+  // The experiment (0: none) the guest draw about to be recorded gets.
+  uint32_t GpuTimingDrawExperiment(bool memexport_used);
+  void GpuTimingCountDraw(uint32_t host_count, uint32_t experiment) {
+    uint32_t* counts = gpu_timing_.counts[gpu_timing_.group];
+    ++counts[kGtDraws];
+    counts[kGtVerts] += host_count;
+    counts[kGtExp] += experiment != 0;
+  }
+  // Experiment 3: the first primitive only.
+  static uint32_t GpuTimingDrawVertexCount(uint32_t experiment, D3D_PRIMITIVE_TOPOLOGY topology,
+                                           uint32_t count);
+
+  struct GpuTiming {
+    static constexpr uint32_t kRing = 8;    // frames; more than kQueueFrames, so a slot is read before it is reused
+    static constexpr uint32_t kSlots = 64;  // timestamps per frame (the last one is the frame's end)
+    static constexpr uint32_t kGroups = 13;
+    static constexpr uint32_t kIdLead = 30, kIdTail = 31, kIdSwap = 32, kIdNone = 33;
+    struct Frame {
+      enum State : uint8_t { kFree, kRecording, kPending };
+      State state = kFree;
+      uint8_t mode = 0;  // 1: start and end only, 2: all
+      uint8_t draw_mode = 0;
+      uint8_t slots = 0;
+      uint64_t seq = 0;
+      uint64_t submission = 0;  // its readback is valid once this submission has completed
+      int32_t experiment = -1;
+      uint32_t cp_frame = 0;
+      uint32_t guest_frame = 0;
+      std::chrono::steady_clock::time_point end_time;
+      uint8_t segment[kSlots] = {};
+      uint32_t counts[kGroups][kGtCounterCount] = {};
+    };
+    // The frame being recorded.
+    uint8_t mode = 0;  // 0 off, 1 start and end only, 2 all (set at the start of the frame)
+    bool active = false;
+    uint32_t ring = 0;
+    uint32_t slots = 0;
+    uint32_t cur_id = kIdLead;  // the segment the commands being recorded belong to
+    uint32_t group = 0;         // its group, where the counters go
+    uint32_t counts[kGroups][kGtCounterCount] = {};
+    DeferredCommandList::RecordedStats snapshot;
+    // Latched at the start of the frame.
+    uint32_t draw_experiment = 0;
+    uint32_t draw_phases = 0xFFFFFFFFu;
+    uint32_t draw_now = 0;  // what the draw being recorded gets
+    std::string draw_phases_text;
+    int32_t experiment = -1;  // the experiment cycle's entry in force
+    bool first_swap_set = false;
+    std::chrono::steady_clock::time_point first_swap;
+    // The frames.
+    uint64_t seq = 0;          // frames started
+    uint64_t collect_seq = 0;  // the next one to read
+    uint64_t last_ended = 0;
+    Frame frames[kRing];
+    bool init_failed = false;
+    Microsoft::WRL::ComPtr<ID3D12QueryHeap> heap;
+    Microsoft::WRL::ComPtr<ID3D12Resource> readback;
+    double us_per_tick = 0.0;
+    bool have_last_start = false;
+    uint64_t last_start_ticks = 0;
+  } gpu_timing_;
+  // Statistics, the CSV and the experiment cycle (defined in command_processor.cpp).
+  struct GpuTimingReport;
+  GpuTimingReport& GpuTimingGetReport();
+  void GpuTimingProcessFrame(const GpuTiming::Frame& frame, const uint64_t* ticks);
+  // Logs the statistics if gpu_timing_log_s seconds have passed (or `force`), and writes the CSV rows.
+  void GpuTimingMaybeLog(bool force);
+  std::unique_ptr<GpuTimingReport> gpu_timing_report_;
 };
 
 }  // namespace rex::graphics::d3d12
