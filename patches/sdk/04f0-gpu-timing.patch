+void D3D12CommandProcessor::OnGuestMarker(uint32_t kind, uint32_t value) {
+  CommandProcessor::OnGuestMarker(kind, value);
+  // The segment the marker starts. The named markers and the phase markers of the same phase bit are the same segment
+  // (the second finds the first one's segment current); a game that writes only the named ones is mapped to the bits.
+  uint32_t id = GpuTiming::kIdNone;
+  switch (GuestMarkerKind(kind)) {
+    case GuestMarkerKind::kFrameBegin:
+      id = GpuTiming::kIdLead;
+      break;
+    case GuestMarkerKind::kFrameEnd:
+    case GuestMarkerKind::kRenderEnd:
+      id = GpuTiming::kIdTail;
+      break;
+    case GuestMarkerKind::kSceneBegin:
+      id = 11;  // 0x800
+      break;
+    case GuestMarkerKind::kSceneTranslucent:
+      id = 20;  // 0x100000
+      break;
+    case GuestMarkerKind::kSceneComposite:
+      id = 26;  // 0x04000000
+      break;
+    case GuestMarkerKind::kSceneEnd:
+      id = 27;  // 0x08000000
+      break;
+    case GuestMarkerKind::kTonemapBegin:
+      id = 28;  // 0x10000000
+      break;
+    case GuestMarkerKind::kUIBegin:
+      id = 29;  // 0x20000000
+      break;
+    case GuestMarkerKind::kPhase: {
+      uint32_t bit;
+      if (value && !(value & (value - 1)) && rex::bit_scan_forward(value, &bit) && bit < 30) {
+        id = bit;
+      }
+    } break;
+    default:
+      break;
+  }
+  if (id == GpuTiming::kIdNone) {
+    return;
+  }
+  GpuTiming& g = gpu_timing_;
+  const bool full = REXCVAR_GET(gpu_timing) != 0;
+  if (id == g.cur_id && (!full || g.active)) {
+    return;
+  }
+  if (full) {
+    // The marker can be the first thing of the frame (or of its submission): the timestamp needs a list, and the frame
+    // its first timestamp before it.
+    BeginSubmission(true);
+  }
+  GpuTimingSetSegment(id);
+}
+
+void D3D12CommandProcessor::GpuTimingFrameBegin() {
+  GpuTiming& g = gpu_timing_;
+  // The draw experiment, for the whole frame.
+  g.draw_experiment = uint32_t(std::clamp(REXCVAR_GET(gpu_draw_experiment), 0, 3));
+  if (g.draw_experiment) {
+    const std::string& phases = REXCVAR_GET(gpu_draw_experiment_phases);
+    if (phases != g.draw_phases_text) {
+      g.draw_phases_text = phases;
+      char* end = nullptr;
+      const unsigned long long mask = std::strtoull(phases.c_str(), &end, 0);
+      g.draw_phases = end == phases.c_str() ? 0xFFFFFFFFu : uint32_t(mask);
+    }
+  }
+  // The swap segment of the previous frame is over (a game that writes no markers stays in the lead).
+  if (g.cur_id == GpuTiming::kIdSwap) {
+    g.cur_id = GpuTiming::kIdLead;
+    g.group = GpuTimingGroupOfId(g.cur_id);
+  }
+  // A timed frame that never ended is dropped.
+  if (g.active) {
+    g.active = false;
+    g.frames[g.ring].state = GpuTiming::Frame::kFree;
+  }
+  g.mode = REXCVAR_GET(gpu_timing) ? 2 : (REXCVAR_GET(gpu_timing_export) ? 1 : 0);
+  if (!g.mode || !GpuTimingInit()) {
+    g.mode = 0;
+    return;
+  }
+  // The frames done so far, so the ring slot this frame takes is free.
+  GpuTimingCollect();
+  g.ring = uint32_t(g.seq % GpuTiming::kRing);
+  GpuTiming::Frame& frame = g.frames[g.ring];
+  frame.state = GpuTiming::Frame::kRecording;
+  frame.mode = g.mode;
+  frame.draw_mode = uint8_t(g.draw_experiment);
+  frame.experiment = g.experiment;
+  frame.seq = g.seq++;
+  frame.segment[0] = uint8_t(g.cur_id);
+  g.group = GpuTimingGroupOfId(g.cur_id);
+  g.active = true;
+  g.slots = 1;
+  if (g.mode == 2) {
+    std::memset(g.counts, 0, sizeof(g.counts));
+    g.snapshot = deferred_command_list_.recorded_stats();
+  }
+  deferred_command_list_.D3DEndQuery(g.heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, g.ring * GpuTiming::kSlots);
+}
+
+void D3D12CommandProcessor::GpuTimingFrameEnd() {
+  GpuTiming& g = gpu_timing_;
+  if (!g.active) {
+    return;
+  }
+  g.active = false;
+  GpuTiming::Frame& frame = g.frames[g.ring];
+  if (frame.state != GpuTiming::Frame::kRecording) {
+    return;
+  }
+  if (g.mode == 2) {
+    GpuTimingAttribute();
+    std::memcpy(frame.counts, g.counts, sizeof(frame.counts));
+  }
+  const uint32_t first = g.ring * GpuTiming::kSlots;
+  deferred_command_list_.D3DEndQuery(g.heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, first + g.slots);
+  ++g.slots;
+  deferred_command_list_.D3DResolveQueryData(g.heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, first, g.slots,
+                                             g.readback.Get(), uint64_t(first) * sizeof(uint64_t));
+  frame.slots = uint8_t(g.slots);
+  frame.submission = submission_current_;  // the list this goes into
+  frame.end_time = std::chrono::steady_clock::now();
+  frame.cp_frame = counter();
+  frame.guest_frame = guest_marker_frame_;
+  frame.state = GpuTiming::Frame::kPending;
+  g.last_ended = frame.seq;
+}
+
+void D3D12CommandProcessor::GpuTimingAttribute() {
+  GpuTiming& g = gpu_timing_;
+  const DeferredCommandList::RecordedStats& now = deferred_command_list_.recorded_stats();
+  uint32_t* counts = g.counts[g.group];
+  counts[kGtPso] += now.pipeline_sets - g.snapshot.pipeline_sets;
+  counts[kGtCbv] += now.graphics_root_cbvs - g.snapshot.graphics_root_cbvs;
+  counts[kGtRt] += now.render_target_sets - g.snapshot.render_target_sets;
+  counts[kGtBar] += now.barrier_batches - g.snapshot.barrier_batches;
+  g.snapshot = now;
+}
+
+void D3D12CommandProcessor::GpuTimingSetSegment(uint32_t id) {
+  GpuTiming& g = gpu_timing_;
+  if (id == g.cur_id) {
+    return;
+  }
+  g.cur_id = id;
+  if (g.active && g.mode == 2 && submission_open_) {
+    // The last slot is the frame's end; a frame that runs out of slots goes on in its last segment.
+    if (g.slots + 1 >= GpuTiming::kSlots) {
+      return;
+    }
+    GpuTimingAttribute();
+    g.frames[g.ring].segment[g.slots] = uint8_t(id);
+    deferred_command_list_.D3DEndQuery(g.heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                       g.ring * GpuTiming::kSlots + g.slots);
+    ++g.slots;
+  }
+  g.group = GpuTimingGroupOfId(id);
+}
+
+void D3D12CommandProcessor::GpuTimingBeforeSwap() {
+  GpuTimingCycleTick();
+  GpuTimingSetSegment(GpuTiming::kIdSwap);
+}
+
+void D3D12CommandProcessor::GpuTimingCycleTick() {
+  GpuTiming& g = gpu_timing_;
+  const auto now = std::chrono::steady_clock::now();
+  if (!g.first_swap_set) {
+    g.first_swap_set = true;
+    g.first_swap = now;
+  }
+  const std::string& text = REXCVAR_GET(gpu_experiment_cycle);
+  if (text.empty()) {
+    g.experiment = -1;
+    return;
+  }
+  GpuTimingReport& r = GpuTimingGetReport();
+  if (text != r.cycle_text) {
+    r.cycle_text = text;
+    r.cycle_entries.clear();
+    r.cycle_labels.clear();
+    g.experiment = -1;
+    size_t entry_begin = 0;
+    while (entry_begin <= text.size()) {
+      size_t entry_end = text.find(';', entry_begin);
+      if (entry_end == std::string::npos) {
+        entry_end = text.size();
+      }
+      const std::string entry = GpuTimingTrim(text.substr(entry_begin, entry_end - entry_begin));
+      entry_begin = entry_end + 1;
+      if (entry.empty()) {
+        continue;
+      }
+      if (r.cycle_entries.size() >= GpuTimingReport::kMaxEntries) {
+        REXGPU_WARN("[gpu-exp] gpu_experiment_cycle: only the first {} entries are used",
+                    GpuTimingReport::kMaxEntries);
+        break;
+      }
+      std::vector<std::pair<std::string, std::string>> assignments;
+      size_t assignment_begin = 0;
+      while (assignment_begin <= entry.size()) {
+        size_t assignment_end = entry.find(',', assignment_begin);
+        if (assignment_end == std::string::npos) {
+          assignment_end = entry.size();
+        }
+        const std::string assignment =
+            GpuTimingTrim(entry.substr(assignment_begin, assignment_end - assignment_begin));
+        assignment_begin = assignment_end + 1;
+        const size_t equals = assignment.find('=');
+        if (equals == std::string::npos || equals == 0) {
+          if (!assignment.empty()) {
+            REXGPU_WARN("[gpu-exp] gpu_experiment_cycle: '{}' is not name=value, left out", assignment);
+          }
+          continue;
+        }
+        assignments.emplace_back(GpuTimingTrim(assignment.substr(0, equals)),
+                                 GpuTimingTrim(assignment.substr(equals + 1)));
+      }
+      r.cycle_entries.push_back(std::move(assignments));
+      r.cycle_labels.push_back(entry);
+    }
+  }
+  const int64_t elapsed_ms =
+      std::chrono::duration_cast<std::chrono::milliseconds>(now - g.first_swap).count();
+  const int64_t start_ms = int64_t(std::max(0, REXCVAR_GET(gpu_experiment_start_s))) * 1000;
+  int32_t index = -1;
+  if (elapsed_ms >= start_ms && !r.cycle_entries.empty()) {
+    const int64_t entry_count = int64_t(r.cycle_entries.size());
+    const int64_t steps = (elapsed_ms - start_ms) / std::max(1, REXCVAR_GET(gpu_experiment_period_ms));
+    index = int32_t(REXCVAR_GET(gpu_experiment_repeat) ? steps % entry_count
+                                                       : std::min(steps, entry_count - 1));
+  }
+  if (index == g.experiment) {
+    return;
+  }
+  g.experiment = index;
+  if (index < 0) {
+    return;
+  }
+  for (const auto& assignment : r.cycle_entries[index]) {
+    if (!rex::cvar::SetFlagByName(assignment.first, assignment.second)) {
+      REXGPU_WARN("[gpu-exp] entry {}: could not set {}={}", index, assignment.first, assignment.second);
+    }
+  }
+  REXGPU_INFO("[gpu-exp] entry {} at {:.1f} s: {}", index, double(elapsed_ms) * 1e-3, r.cycle_labels[index]);
+}
+
+uint32_t D3D12CommandProcessor::GpuTimingDrawExperiment(bool memexport_used) {
+  GpuTiming& g = gpu_timing_;
+  uint32_t experiment = g.draw_experiment;
+  // Not the swap segment (id 32); not draws that export to memory or count samples for the guest.
+  if (experiment && (memexport_used || active_occlusion_query_.valid || g.cur_id > 31 ||
+                     !((g.draw_phases >> g.cur_id) & 1))) {
+    experiment = 0;
+  }
+  g.draw_now = experiment;
+  return experiment;
+}
+
+uint32_t D3D12CommandProcessor::GpuTimingDrawVertexCount(uint32_t experiment,
+                                                        D3D_PRIMITIVE_TOPOLOGY topology,
+                                                        uint32_t count) {
+  if (experiment != 3) {
+    return count;
+  }
+  uint32_t first;
+  switch (topology) {
+    case D3D_PRIMITIVE_TOPOLOGY_POINTLIST:
+      first = 1;
+      break;
+    case D3D_PRIMITIVE_TOPOLOGY_LINELIST:
+    case D3D_PRIMITIVE_TOPOLOGY_LINESTRIP:
+      first = 2;
+      break;
+    case D3D_PRIMITIVE_TOPOLOGY_LINELIST_ADJ:
+      first = 4;
+      break;
+    default:
+      first = (topology >= D3D_PRIMITIVE_TOPOLOGY_1_CONTROL_POINT_PATCHLIST &&
+               topology <= D3D_PRIMITIVE_TOPOLOGY_32_CONTROL_POINT_PATCHLIST)
+                  ? uint32_t(topology) - uint32_t(D3D_PRIMITIVE_TOPOLOGY_1_CONTROL_POINT_PATCHLIST) + 1
+                  : 3;
+      break;
+  }
+  return std::min(count, first);
+}
+
+void D3D12CommandProcessor::GpuTimingCollect() {
+  GpuTiming& g = gpu_timing_;
+  if (!g.readback || g.collect_seq >= g.seq) {
+    return;
+  }
+  bool any = false;
+  while (g.collect_seq < g.seq) {
+    const uint32_t ring = uint32_t(g.collect_seq % GpuTiming::kRing);
+    GpuTiming::Frame& frame = g.frames[ring];
+    if (g.active && g.seq == g.collect_seq + 1) {
+      break;  // the frame being recorded
+    }
+    if (frame.seq != g.collect_seq || frame.state != GpuTiming::Frame::kPending) {
+      ++g.collect_seq;  // dropped
+      continue;
+    }
+    if (frame.submission > submission_completed_) {
+      break;
+    }
+    const uint64_t first_byte = uint64_t(ring) * GpuTiming::kSlots * sizeof(uint64_t);
+    const D3D12_RANGE read_range = {SIZE_T(first_byte), SIZE_T(first_byte + frame.slots * sizeof(uint64_t))};
+    void* mapping = nullptr;
+    if (SUCCEEDED(g.readback->Map(0, &read_range, &mapping))) {
+      uint64_t ticks[GpuTiming::kSlots];
+      std::memcpy(ticks, static_cast<const uint8_t*>(mapping) + first_byte, frame.slots * sizeof(uint64_t));
+      const D3D12_RANGE written_range = {0, 0};
+      g.readback->Unmap(0, &written_range);
+      GpuTimingProcessFrame(frame, ticks);
+      any = true;
+    }
+    frame.state = GpuTiming::Frame::kFree;
+    ++g.collect_seq;
+  }
+  if (any && gpu_timing_report_) {
+    GpuTimingMaybeLog(false);
+  }
+}
+
+void D3D12CommandProcessor::GpuTimingProcessFrame(const GpuTiming::Frame& frame, const uint64_t* ticks) {
+  GpuTiming& g = gpu_timing_;
+  const uint64_t start = ticks[0], end = ticks[frame.slots - 1];
+  if (end < start) {
+    return;
+  }
+  const uint32_t frame_us = uint32_t(std::min(double(end - start) * g.us_per_tick + 0.5, 4e9));
+  uint32_t interval_us = 0;
+  if (g.have_last_start && start > g.last_start_ticks) {
+    interval_us = uint32_t(std::min(double(start - g.last_start_ticks) * g.us_per_tick + 0.5, 4e9));
+  }
+  g.have_last_start = true;
+  g.last_start_ticks = start;
+
+  // The exports: the lag and the time first, then the counter the reader acquires.
+  rexgpu_gpu_frame_lag.store(uint32_t(g.last_ended - frame.seq), std::memory_order_relaxed);
+  rexgpu_gpu_frame_us.store(frame_us, std::memory_order_release);
+  rexgpu_gpu_frame_seq.fetch_add(1, std::memory_order_release);
+  if (frame.mode != 2) {
+    return;
+  }
+
+  // The segments, into the groups and the raw phase bits.
+  float group_us[GpuTiming::kGroups] = {};
+  float phase_us[30] = {};
+  for (uint32_t k = 0; k + 1 < frame.slots; ++k) {
+    const float us = ticks[k + 1] > ticks[k] ? float(double(ticks[k + 1] - ticks[k]) * g.us_per_tick) : 0.0f;
+    const uint32_t id = frame.segment[k];
+    group_us[GpuTimingGroupOfId(id)] += us;
+    if (id < 30) {
+      phase_us[id] += us;
+    }
+  }
+  GpuTimingReport& r = GpuTimingGetReport();
+  GpuTimingReport::Accumulator& acc =
+      r.accumulators[std::clamp<int32_t>(frame.experiment + 1, 0, GpuTimingReport::kMaxEntries)];
+  ++acc.frames;
+  acc.draw_mode = frame.draw_mode;
+  acc.frame_ms.push_back(float(frame_us) * 0.001f);
+  if (interval_us) {
+    acc.busy_percent.push_back(100.0f * float(frame_us) / float(interval_us));
+  }
+  for (uint32_t group = 0; group < GpuTiming::kGroups; ++group) {
+    acc.group_ms[group].push_back(group_us[group] * 0.001f);
+    for (uint32_t counter = 0; counter < kGtCounterCount; ++counter) {
+      acc.counts[group][counter] += frame.counts[group][counter];
+    }
+  }
+
+  const std::string& csv_path = REXCVAR_GET(gpu_timing_csv);
+  if (csv_path.empty()) {
+    return;
+  }
+  if (csv_path != r.csv_path) {
+    r.csv_path = csv_path;
+    r.csv_started = false;
+    r.csv_t0_set = false;
+    r.csv.clear();
+  }
+  if (!r.csv_t0_set) {
+    r.csv_t0_set = true;
+    r.csv_t0 = frame.end_time;
+  }
+  std::string& row = r.csv;
+  row += fmt::format("{},{},{},{:.1f},{},{},{}", frame.seq, frame.cp_frame, frame.guest_frame,
+                     std::chrono::duration<double, std::milli>(frame.end_time - r.csv_t0).count(),
+                     frame.experiment, frame_us, interval_us);
+  for (uint32_t group = 0; group < GpuTiming::kGroups; ++group) {
+    const uint32_t* c = frame.counts[group];
+    row += fmt::format(",{:.0f},{},{},{},{},{},{},{},{},{},{}", group_us[group], c[kGtDraws], c[kGtVerts],
+                       c[kGtPso], c[kGtCbv], c[kGtRt], c[kGtRes], c[kGtXfer], c[kGtTex], c[kGtBar], c[kGtExp]);
+  }
+  for (uint32_t bit = 0; bit < 30; ++bit) {
+    row += fmt::format(",{:.0f}", phase_us[bit]);
+  }
+  row += '\n';
+}
+
+void D3D12CommandProcessor::GpuTimingFlushCsv() {
+  if (!gpu_timing_report_ || gpu_timing_report_->csv.empty()) {
+    return;
+  }
+  GpuTimingReport& r = *gpu_timing_report_;
+  std::ofstream out(r.csv_path, std::ios::binary | (r.csv_started ? std::ios::app : std::ios::trunc));
+  if (!out) {
+    REXGPU_WARN("gpu_timing: cannot write {}", r.csv_path);
+  } else {
+    if (!r.csv_started) {
+      out << GpuTimingCsvHeader();
+    }
+    out << r.csv;
+  }
+  r.csv_started = true;
+  r.csv.clear();
+}
+
+void D3D12CommandProcessor::GpuTimingMaybeLog(bool force) {
+  GpuTimingReport& r = *gpu_timing_report_;
+  const auto now = std::chrono::steady_clock::now();
+  if (!r.last_log_set) {
+    r.last_log_set = true;
+    r.last_log = now;
+  }
+  const double seconds = std::chrono::duration<double>(now - r.last_log).count();
+  if (!force && seconds < double(std::max(1, REXCVAR_GET(gpu_timing_log_s)))) {
+    return;
+  }
+  r.last_log = now;
+  for (uint32_t entry = 0; entry <= GpuTimingReport::kMaxEntries; ++entry) {
+    GpuTimingReport::Accumulator& acc = r.accumulators[entry];
+    if (!acc.frames) {
+      continue;
+    }
+    const double frames = double(acc.frames);
+    auto group_text = [&](uint32_t group) {
+      const uint64_t* c = acc.counts[group];
+      bool counted = false;
+      for (uint32_t counter = 0; counter < kGtCounterCount; ++counter) {
+        counted |= c[counter] != 0;
+      }
+      const float p50 = GpuTimingPercentile(acc.group_ms[group], 0.5);
+      const float p95 = GpuTimingPercentile(acc.group_ms[group], 0.95);
+      if (!counted && p95 <= 0.0f) {
+        return std::string();
+      }
+      std::string text = fmt::format(
+          " | {} {:.2f}/{:.2f} d={:.0f} v={:.1f}k pso={:.0f} cbv={:.0f} rt={:.0f} res={:.0f} xfer={:.0f} "
+          "tex={:.0f} bar={:.0f}",
+          kGpuTimingGroupNames[group], p50, p95, double(c[kGtDraws]) / frames,
+          double(c[kGtVerts]) / frames * 1e-3, double(c[kGtPso]) / frames, double(c[kGtCbv]) / frames,
+          double(c[kGtRt]) / frames, double(c[kGtRes]) / frames, double(c[kGtXfer]) / frames,
+          double(c[kGtTex]) / frames, double(c[kGtBar]) / frames);
+      if (c[kGtExp]) {
+        text += fmt::format(" exp={:.0f}", double(c[kGtExp]) / frames);
+      }
+      return text;
+    };
+    std::string first = fmt::format(
+        "[gpu-timing] {:.1f} s, {} frames (exp {}, draw {}): frame p50 {:.2f} p95 {:.2f} ms, busy {:.0f} %", seconds,
+        acc.frames, entry ? std::to_string(entry - 1) : std::string("-"), acc.draw_mode,
+        GpuTimingPercentile(acc.frame_ms, 0.5), GpuTimingPercentile(acc.frame_ms, 0.95),
+        GpuTimingPercentile(acc.busy_percent, 0.5));
+    std::string second = "[gpu-timing]  ";
+    for (uint32_t group = 0; group < GpuTiming::kGroups; ++group) {
+      (group < 5 ? first : second) += group_text(group);
+    }
+    REXGPU_INFO("{}", first);
+    REXGPU_INFO("{}", second);
+    acc.Clear();
+  }
+  GpuTimingFlushCsv();
+}
+
