 namespace rex::graphics::d3d12 {
 
+// LOCAL PATCH - MCLA (04f0): gpu_timing's statistics, CSV rows and experiment cycle (see GpuTiming in the header).
+struct D3D12CommandProcessor::GpuTimingReport {
+  static constexpr uint32_t kMaxEntries = 16;
+  // The frames of one experiment entry in the current log interval (index 0: no entry in force).
+  struct Accumulator {
+    uint32_t frames = 0;
+    uint32_t draw_mode = 0;
+    std::vector<float> frame_ms;
+    std::vector<float> busy_percent;
+    std::vector<float> group_ms[GpuTiming::kGroups];
+    uint64_t counts[GpuTiming::kGroups][kGtCounterCount] = {};
+    void Clear() {
+      frames = 0;
+      frame_ms.clear();
+      busy_percent.clear();
+      for (auto& v : group_ms) {
+        v.clear();
+      }
+      std::memset(counts, 0, sizeof(counts));
+    }
+  } accumulators[kMaxEntries + 1];
+  std::chrono::steady_clock::time_point last_log;
+  bool last_log_set = false;
+  std::string csv;
+  std::string csv_path;
+  bool csv_started = false;
+  bool csv_t0_set = false;
+  std::chrono::steady_clock::time_point csv_t0;
+  // The experiment cycle: the text it was parsed from, and each entry's assignments.
+  std::string cycle_text;
+  std::vector<std::vector<std::pair<std::string, std::string>>> cycle_entries;
+  std::vector<std::string> cycle_labels;
+};
