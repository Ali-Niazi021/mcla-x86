+    kGtCbv,    // graphics root CBV sets
+    kGtRt,     // OMSetRenderTargets
+    kGtRes,    // resolves (IssueCopy)
+    kGtXfer,   // EDRAM ownership transfer draws
+    kGtTex,    // texture loads
+    kGtBar,    // ResourceBarrier batches
+    kGtExp,    // guest draws the draw experiment changed
+    kGtCounterCount,
+  };
+  void GpuTimingCount(GpuTimingCounter counter, uint32_t count = 1) {
+    gpu_timing_.counts[gpu_timing_.group][counter] += count;
+  }
