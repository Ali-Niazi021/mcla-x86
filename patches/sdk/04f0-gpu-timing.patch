+bool D3D12CommandProcessor::GpuTimingInit() {
+  GpuTiming& g = gpu_timing_;
+  if (g.readback) {
+    return true;
+  }
+  if (g.init_failed) {
+    return false;
+  }
+  static_assert(GpuTiming::kRing > kQueueFrames, "a timing slot must be read before it is reused");
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  UINT64 frequency = 0;
+  D3D12_QUERY_HEAP_DESC heap_desc = {D3D12_QUERY_HEAP_TYPE_TIMESTAMP, GpuTiming::kRing * GpuTiming::kSlots, 0};
+  D3D12_RESOURCE_DESC buffer_desc;
+  ui::d3d12::util::FillBufferResourceDesc(
+      buffer_desc, sizeof(uint64_t) * GpuTiming::kRing * GpuTiming::kSlots, D3D12_RESOURCE_FLAG_NONE);
+  if (!device || FAILED(device->CreateQueryHeap(&heap_desc, IID_PPV_ARGS(&g.heap))) ||
+      FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesReadback,
+                                             GetD3D12Provider().GetHeapFlagCreateNotZeroed(), &buffer_desc,
+                                             D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                             IID_PPV_ARGS(&g.readback))) ||
+      FAILED(GetD3D12Provider().GetDirectQueue()->GetTimestampFrequency(&frequency)) || !frequency) {
+    g.heap.Reset();
+    g.readback.Reset();
+    g.init_failed = true;
+    REXGPU_WARN("gpu_timing: GPU timestamps are not available on this device or queue, the GPU timing is off");
+    return false;
+  }
+  g.us_per_tick = 1e6 / double(frequency);
+  REXGPU_INFO("gpu_timing: GPU timestamps at {:.1f} MHz", double(frequency) * 1e-6);
+  return true;
+}
+
+void D3D12CommandProcessor::GpuTimingShutdown() {
+  GpuTiming& g = gpu_timing_;
+  if (g.readback) {
+    GpuTimingCollect();
+    if (gpu_timing_report_) {
+      GpuTimingMaybeLog(true);
+    }
+  }
+  g.active = false;
+  for (GpuTiming::Frame& frame : g.frames) {
+    frame.state = GpuTiming::Frame::kFree;
+  }
+  g.collect_seq = g.seq;
+  g.heap.Reset();
+  g.readback.Reset();
+}
