+#if REX_PLATFORM_WIN32
+// LOCAL PATCH - MCLA (0400): the Windows guest vblank. The SDK's own loop (below) sleeps 1 ms at a time and replays
+// every vblank it finds due, so the guest sees a period that wanders between ~16 and ~18 ms and bursts after a late
+// wake. PreciseVblank keeps an absolute grid of 1/refresh seconds from a QPC origin: a high-resolution waitable timer
+// sleeps to a little before the next grid point and a QPC spin does the rest. A vblank more than one period late
+// restarts the grid, it is never made up with a burst.
+namespace {
+
+int64_t QpcFrequency() {
+  LARGE_INTEGER frequency;
+  QueryPerformanceFrequency(&frequency);
+  return frequency.QuadPart;
+}
+
+int64_t QpcNow() {
+  LARGE_INTEGER counter;
+  QueryPerformanceCounter(&counter);
+  return counter.QuadPart;
+}
+
+class PreciseVblank {
+ public:
+  explicit PreciseVblank(double refresh_rate_hz) {
+    qpc_hz_ = QpcFrequency();
+    refresh_rate_hz_ = refresh_rate_hz;
+    nominal_ticks_ = double(qpc_hz_) / refresh_rate_hz;
+    period_ticks_ = nominal_ticks_;
+    max_overshoot_ticks_ = qpc_hz_ * 3 / 2000;  // 1.5 ms
+    timer_ = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                    TIMER_ALL_ACCESS);
+    if (!timer_) {
+      REXGPU_WARN(
+          "[guest-vblank] no high-resolution waitable timer (error {}): the precise vblank sleeps with Sleep(1) "
+          "and spins for the last 3 ms",
+          uint32_t(GetLastError()));
+    }
+    periods_ms_.reserve(4096);
+  }
+
+  ~PreciseVblank() {
+    Release();
+    if (timer_) {
+      CloseHandle(timer_);
+    }
+  }
+
+  PreciseVblank(const PreciseVblank&) = delete;
+  PreciseVblank& operator=(const PreciseVblank&) = delete;
+
+  // The calling thread goes to time-critical priority and joins MMCSS "Games"; a new grid starts now. Idempotent.
+  void Engage() {
+    if (engaged_) {
+      return;
+    }
+    engaged_ = true;
+    HANDLE thread = GetCurrentThread();
+    previous_priority_ = GetThreadPriority(thread);
+    const bool raised = SetThreadPriority(thread, THREAD_PRIORITY_TIME_CRITICAL) != 0;
+    const uint32_t priority_error = raised ? 0 : uint32_t(GetLastError());
+    // The priority first: once the thread is in MMCSS the scheduler manages it.
+    DWORD task_index = 0;
+    mmcss_ = AvSetMmThreadCharacteristicsW(L"Games", &task_index);
+    const uint32_t mmcss_error = mmcss_ ? 0 : uint32_t(GetLastError());
+    scalar_ = GuestTimeScalar();
+    period_ticks_ = nominal_ticks_ / scalar_;
+    origin_ = QpcNow();
+    index_ = 1;
+    BreakPeriod();
+    REXGPU_INFO(
+        "[guest-vblank] precise grid: {:.3f} Hz (period {:.4f} ms), {}, QPC spin for the last {} us (+ the timer's "
+        "overshoot), MMCSS Games {}, time-critical priority {}",
+        refresh_rate_hz_, 1e3 * period_ticks_ / double(qpc_hz_),
+        timer_ ? "high-resolution waitable timer" : "Sleep(1) (no high-resolution timer)",
+        REXCVAR_GET(guest_vblank_spin_us),
+        mmcss_ ? fmt::format("joined (task index {})", uint32_t(task_index))
+               : fmt::format("NOT joined (error {})", mmcss_error),
+        raised ? std::string("set") : fmt::format("NOT set (error {})", priority_error));
+  }
+
+  // The calling thread leaves MMCSS and gets its priority back. True if it was engaged.
+  bool Release() {
+    if (!engaged_) {
+      return false;
+    }
+    engaged_ = false;
+    if (mmcss_) {
+      AvRevertMmThreadCharacteristics(mmcss_);
+      mmcss_ = nullptr;
+    }
+    SetThreadPriority(GetCurrentThread(), previous_priority_);
+    BreakPeriod();
+    return true;
+  }
+
+  // Waits for the next point of the grid and returns the QPC stamp of the moment it was reached, 0 if `running` was
+  // cleared during the wait.
+  int64_t WaitForVblank(const std::atomic<bool>& running) {
+    int64_t now = QpcNow();
+    const double scalar = GuestTimeScalar();
+    if (scalar != scalar_) {
+      // The guest clock was re-scaled and the guest's vblank is in guest time: a new grid at the new period.
+      scalar_ = scalar;
+      period_ticks_ = nominal_ticks_ / scalar;
+      origin_ = now;
+      index_ = 1;
+      BreakPeriod();
+    }
+    const int64_t period = std::max<int64_t>(1, int64_t(period_ticks_));
+    const int64_t deadline = origin_ + int64_t(std::llround(double(index_) * period_ticks_));
+    if (now - deadline > period) {
+      // More than a period late (a stall, a long interrupt, the machine paused): the vblank fires now and the grid
+      // restarts from it. The vblanks that were missed are never replayed in a burst.
+      ++resync_;
+      origin_ = now;
+      index_ = 1;
+      return now;
+    }
+    const int64_t spin_ticks = int64_t(REXCVAR_GET(guest_vblank_spin_us)) * qpc_hz_ / 1000000;
+    const int64_t wake = deadline - spin_ticks - overshoot_ticks_;
+    if (now < wake) {
+      SleepUntil(wake);
+      NoteOvershoot(std::max<int64_t>(0, QpcNow() - wake));
+      if (!running.load(std::memory_order_relaxed)) {
+        return 0;
+      }
+    }
+    int64_t fired;
+    while ((fired = QpcNow()) < deadline) {
+      YieldProcessor();
+    }
+    ++index_;
+    return fired;
+  }
+
+  // A vblank of the grid fired at `fired` (WaitForVblank's result) and the guest has seen it.
+  void EndVblank(int64_t fired) { NoteVblank(fired, 1e3 * period_ticks_ / double(qpc_hz_)); }
+
+  // vsync=false: the SDK's loop is kept (a 1 kHz free-running vblank); the grid has no meaning there.
+  void WarnNoVsyncOnce() {
+    if (!warned_no_vsync_) {
+      warned_no_vsync_ = true;
+      REXGPU_WARN(
+          "[guest-vblank] guest_vblank_precise is on but vsync is off: the guest vblank free-runs at 1 kHz as in "
+          "the SDK (the precise grid needs vsync=true)");
+    }
+  }
+
+  // The SDK's loop (guest_vblank_precise off, or vsync off) reports through the same line.
+  void NoteLegacyVblank(double nominal_ms) { NoteVblank(QpcNow(), nominal_ms); }
+  void NoteLegacyResync() { ++resync_; }
+
+ private:
+  static double GuestTimeScalar() {
+    const double scalar = rex::chrono::Clock::guest_time_scalar();
+    return scalar > 0.0 ? scalar : 1.0;
+  }
+
+  void SleepUntil(int64_t wake) {
+    const int64_t remaining = wake - QpcNow();
+    if (remaining <= 0) {
+      return;
+    }
+    if (timer_) {
+      LARGE_INTEGER due;  // relative, in 100 ns units
+      due.QuadPart = -std::max<int64_t>(1, remaining * 10000000 / qpc_hz_);
+      if (SetWaitableTimer(timer_, &due, 0, nullptr, nullptr, FALSE)) {
+        WaitForSingleObject(timer_, DWORD(remaining * 1000 / qpc_hz_) + 100);
+        return;
+      }
+    }
+    // No usable timer: poll with Sleep(1) until 3 ms are left; the spin does the rest.
+    while (wake - QpcNow() > qpc_hz_ * 3 / 1000) {
+      Sleep(1);
+    }
+  }
+
+  // How late the timer woke the thread, as the largest overshoot of the last 64 waits: the next waits end that much
+  // earlier (up to 1.5 ms) and the spin makes up for it.
+  void NoteOvershoot(int64_t overshoot_ticks) {
+    block_overshoot_ticks_ = std::max(block_overshoot_ticks_, overshoot_ticks);
+    if (++block_waits_ >= 64) {
+      overshoot_ticks_ = std::min(block_overshoot_ticks_, max_overshoot_ticks_);
+      block_overshoot_ticks_ = 0;
+      block_waits_ = 0;
+    }
+  }
+
+  // The next period is not measured against the last vblank (the grid or the loop changed).
+  void BreakPeriod() { last_fired_ = 0; }
+
+  // The period between vblanks (QPC stamps taken when each one fired), reported every 10 s.
+  void NoteVblank(int64_t fired, double nominal_ms) {
+    if (last_fired_ != 0) {
+      const double ms = 1e3 * double(fired - last_fired_) / double(qpc_hz_);
+      periods_ms_.push_back(ms);
+      if (ms > nominal_ms * 1.05) {
+        ++late_;
+      }
+    }
+    last_fired_ = fired;
+    if (window_start_ == 0) {
+      window_start_ = fired;
+    } else if (fired - window_start_ >= 10 * qpc_hz_) {
+      ReportPeriods();
+      window_start_ = fired;
+    }
+  }
+
+  void ReportPeriods() {
+    const size_t n = periods_ms_.size();
+    if (n != 0) {
+      std::sort(periods_ms_.begin(), periods_ms_.end());
+      const auto rank = [&](double p) {
+        return periods_ms_[std::clamp<size_t>(size_t(std::ceil(p * double(n))), 1, n) - 1];
+      };
+      REXGPU_INFO("[guest-vblank] period p50={:.3f} p99={:.3f} late={} resync={} n={}", rank(0.50), rank(0.99),
+                  late_, resync_, n);
+    }
+    periods_ms_.clear();
+    late_ = 0;
+    resync_ = 0;
+  }
+
+  int64_t qpc_hz_ = 0;
+  double refresh_rate_hz_ = 60.0;
+  double nominal_ticks_ = 0.0;  // QPC ticks per vblank at guest time scalar 1
+  double period_ticks_ = 0.0;   // ... at the scalar in force
+  double scalar_ = 1.0;
+  int64_t origin_ = 0;    // QPC of grid point 0
+  uint64_t index_ = 1;    // the grid point WaitForVblank waits for
+  HANDLE timer_ = nullptr;
+  int64_t overshoot_ticks_ = 0;
+  int64_t block_overshoot_ticks_ = 0;
+  int64_t max_overshoot_ticks_ = 0;
+  uint32_t block_waits_ = 0;
+  bool engaged_ = false;
+  bool warned_no_vsync_ = false;
+  HANDLE mmcss_ = nullptr;
+  int previous_priority_ = THREAD_PRIORITY_NORMAL;
+  // The period statistics.
+  std::vector<double> periods_ms_;
+  int64_t last_fired_ = 0;
+  int64_t window_start_ = 0;
+  uint32_t late_ = 0;
+  uint32_t resync_ = 0;
+};
+
+}  // namespace
+#endif  // REX_PLATFORM_WIN32
+
 namespace rex::graphics {
 
 // Nvidia Optimus/AMD PowerXpress support.
@@ -158,7 +441,31 @@ X_STATUS GraphicsSystem::SetupGuestGpu(runtime::FunctionDispatcher* function_dis
             std::max(uint64_t(1), uint64_t(double(guest_tick_frequency) / refresh_rate_hz));
         uint64_t no_vsync_interval_ticks = std::max(uint64_t(1), guest_tick_frequency / 1000);
         uint64_t last_frame_time = chrono::Clock::QueryGuestTickCount();
+#if REX_PLATFORM_WIN32
+        PreciseVblank precise_vblank(refresh_rate_hz);  // LOCAL PATCH - MCLA (0400)
+#endif
         while (vsync_worker_running_) {
+#if REX_PLATFORM_WIN32
+          // LOCAL PATCH - MCLA (0400): the absolute grid, a high-resolution timer and a QPC spin. vsync=false keeps
+          // the loop below (a 1 kHz vblank), as does guest_vblank_precise=false.
+          if (REXCVAR_GET(guest_vblank_precise)) {
+            if (REXCVAR_GET(vsync)) {
+              precise_vblank.Engage();
+              const int64_t fired = precise_vblank.WaitForVblank(vsync_worker_running_);
+              if (fired == 0 || !vsync_worker_running_) {
+                break;
+              }
+              MarkVblank();
+              precise_vblank.EndVblank(fired);
+              continue;
+            }
+            precise_vblank.WarnNoVsyncOnce();
+          }
+          if (precise_vblank.Release()) {
+            // Back on the loop below: its clock restarts from now.
+            last_frame_time = chrono::Clock::QueryGuestTickCount();
+          }
+#endif
           uint64_t current_time = chrono::Clock::QueryGuestTickCount();
           uint64_t interval_ticks =
               REXCVAR_GET(vsync) ? vsync_interval_ticks : no_vsync_interval_ticks;
@@ -170,9 +477,16 @@ X_STATUS GraphicsSystem::SetupGuestGpu(runtime::FunctionDispatcher* function_dis
           if (behind < 0 || uint64_t(behind) > guest_tick_frequency / 4) {
             last_frame_time = current_time;
             behind = 0;
+#if REX_PLATFORM_WIN32
+            precise_vblank.NoteLegacyResync();  // LOCAL PATCH - MCLA (0400)
+#endif
           }
           while (uint64_t(behind) >= interval_ticks) {
             MarkVblank();
+#if REX_PLATFORM_WIN32
+            precise_vblank.NoteLegacyVblank(1e3 * double(interval_ticks) /
+                                            double(guest_tick_frequency));  // LOCAL PATCH - MCLA (0400)
+#endif
             last_frame_time += interval_ticks;
             behind -= int64_t(interval_ticks);
           }
