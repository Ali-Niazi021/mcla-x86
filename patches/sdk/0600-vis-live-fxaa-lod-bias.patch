+// LOCAL PATCH - MCLA (0600): the parser moved here from graphics_system.cpp (the init path calls this one too).
+CommandProcessor::SwapPostEffect CommandProcessor::ParseSwapPostEffect(
+    const std::string& effect_name) {
+  std::string lowered = effect_name;
+  std::transform(lowered.begin(), lowered.end(), lowered.begin(), [](unsigned char c) {
+    c = static_cast<unsigned char>(std::tolower(c));
+    return c == '-' ? '_' : char(c);
+  });
+  if (lowered == "fxaa") {
+    return SwapPostEffect::kFxaa;
+  }
+  if (lowered == "fxaa_extreme" || lowered == "extreme") {
+    return SwapPostEffect::kFxaaExtreme;
+  }
+  return SwapPostEffect::kNone;
+}
+
+// LOCAL PATCH - MCLA (0600): swap_post_effect is live. Runs on the command processor's thread (the backends'
+// IssueSwap), so the actual effect is set directly, no CallInThread; the desired one too, so that
+// GetDesiredSwapPostEffect and a later SetDesiredSwapPostEffect agree. Only a changed string is parsed, a
+// changed string that parses to the effect already in use (init set it, or "FXAA" for "fxaa") logs nothing.
+// HDR output is not looked at here: the backend skips the effect per swap while HDR is active.
+void CommandProcessor::RefreshSwapPostEffectFromCvar() {
+  const std::string& name = REXCVAR_GET(swap_post_effect);
+  if (name == swap_post_effect_cvar_seen_) {
+    return;
+  }
+  swap_post_effect_cvar_seen_ = name;
+  SwapPostEffect effect = ParseSwapPostEffect(name);
+  bool changed = effect != swap_post_effect_actual_;
+  swap_post_effect_desired_ = effect;
+  swap_post_effect_actual_ = effect;
+  if (changed) {
+    const char* effect_name = "none";
+    if (effect == SwapPostEffect::kFxaa) {
+      effect_name = "fxaa";
+    } else if (effect == SwapPostEffect::kFxaaExtreme) {
+      effect_name = "fxaa_extreme";
+    }
+    REXGPU_INFO("swap_post_effect: {} (live)", effect_name);
+  }
+}
