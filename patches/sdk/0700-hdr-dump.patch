From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mcla-x86 SDK patch layer
Date: Wed, 25 Nov 2026 00:00:00 +0000
Subject: [PATCH] 0700: hdr_dump: write the presented back buffer (HDR10 or SDR) to a DDS + JSON sidecar at chosen seconds

Source: Ours, written for this SDK (stream HDR). The SDK's presenter and its paint submission tracker are used as they are.
Licence: GPL-3 (owner's own work, part of mcla-x86); the patched files are ReXGlue SDK code (BSD-3-Clause)
Purpose: Verify HDR output with numbers instead of eyes on an HDR screen. Cvars (UI/Presenter): hdr_dump_dir (string, ""
  = off), hdr_dump_at (comma list of seconds since process start), hdr_dump_every_s (0 = off). When a dump is due, the
  D3D12 paint copies the back buffer (after the guest image and any UI overlay are drawn, before the PRESENT barrier) into
  a readback buffer, waits for that paint submission (a one-frame stall, debug only), and writes
  <dir>/hdr_<frame>_<t>s.dds (DX10 header, the swap chain's DXGI format: 24 R10G10B10A2 for HDR10, 87 B8G8R8A8 for SDR)
  plus a .json with the levels the presenter used (paper white, peak, min, UI, roll-off start, SDR EOTF, the display's
  DXGI levels). Off: one atomic load per paint. tools/hdr/hdr_analyze.py reads these files.
Bucket: REDO

Not covered: the frame generation paint (AMD's swap chain; logged and skipped). Run evidence: hdr2/hdr3 (14 dumps).
---
diff --git a/include/rex/ui/d3d12/d3d12_presenter.h b/include/rex/ui/d3d12/d3d12_presenter.h
index ac37ce71..bf254b0b 100644
--- a/include/rex/ui/d3d12/d3d12_presenter.h
+++ b/include/rex/ui/d3d12/d3d12_presenter.h
@@ -556,6 +556,29 @@ class D3D12Presenter final : public Presenter {
                              const GuestOutputPaintFlow& flow, uint64_t refresh_number);
   void CompleteFusedGammaCheck();
 
+  // HDR debug dump (hdr_dump_dir, Presenter::ClaimHdrDump): the back buffer of a paint copied to a
+  // readback buffer by that paint's command list, written to files once the paint submission has
+  // completed (the paint thread waits for it). Lives in the paint that claimed the dump.
+  struct HdrDumpCapture {
+    HdrDumpRequest request;
+    Microsoft::WRL::ComPtr<ID3D12Resource> readback;
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint = {};
+    UINT64 readback_size = 0;
+    DXGI_FORMAT format = DXGI_FORMAT_UNKNOWN;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    bool hdr10 = false;
+    uint64_t frame = 0;
+  };
+  // Records the copy (back buffer RENDER_TARGET -> COPY_SOURCE, left in COPY_SOURCE: the caller's
+  // next barrier starts from there). False: nothing was recorded, the back buffer is still in
+  // RENDER_TARGET.
+  bool RecordHdrDump(ID3D12GraphicsCommandList* command_list, ID3D12Resource* back_buffer,
+                     uint64_t frame, HdrDumpCapture& capture);
+  // Waits for the paint submission, writes the files (unless the device was lost, when there is
+  // nothing to read), releases the readback buffer.
+  void CompleteHdrDump(HdrDumpCapture& capture, UINT64 paint_submission, bool device_lost);
+
   // The first is the refresher submission tracker fence value at which the
   // guest output texture was last refreshed, the second is the reference to the
   // texture, which may be null. The indices are the mailbox indices.
diff --git a/include/rex/ui/presenter.h b/include/rex/ui/presenter.h
index a58b2f7f..5bd5bec8 100644
--- a/include/rex/ui/presenter.h
+++ b/include/rex/ui/presenter.h
@@ -22,6 +22,7 @@
 #include <map>
 #include <memory>
 #include <mutex>
+#include <optional>
 #include <string>
 #include <thread>
 #include <utility>
@@ -797,6 +798,44 @@ class Presenter {
   static HdrMetadataLevels GetHdrMetadataLevels();
   static void SetHdrOutputActive(bool active);
 
+  // HDR debug dump of the presented frame, for checking the output numerically (cvars hdr_dump_dir,
+  // hdr_dump_at, hdr_dump_every_s; off while hdr_dump_dir is empty). A backend calls ClaimHdrDump in
+  // every paint that ends in a present, and when it returns a request, copies the back buffer as it
+  // is presented (before it goes to the present state) and, once that copy is on the CPU, gives it
+  // to WriteHdrDump. Times are seconds on the steady clock since the process started (this
+  // translation unit's static initialization, a few milliseconds in).
+  struct HdrDumpRequest {
+    std::string dir;
+    // Seconds since the process started, at the claim.
+    double time_s = 0.0;
+    // Counting from 1, the dumps claimed so far.
+    uint64_t sequence = 0;
+  };
+  struct HdrDumpImage {
+    uint32_t width = 0;
+    uint32_t height = 0;
+    // The back buffer's DXGI_FORMAT value, 4 bytes per pixel (24 R10G10B10A2_UNORM, 87
+    // B8G8R8A8_UNORM).
+    uint32_t dxgi_format = 0;
+    // The swap chain is HDR10 (else SDR).
+    bool hdr10 = false;
+    // The guest frame (refresh number) painted, 0 if none.
+    uint64_t frame = 0;
+    // The pixels as the GPU wrote them, row_pitch bytes between rows (the rows' padding is not
+    // written).
+    const uint8_t* pixels = nullptr;
+    size_t row_pitch = 0;
+  };
+  // Any thread, and cheap: while nothing is due this is one atomic load (and, with a dump
+  // scheduled, the clock). Returns a request when one is due now, which consumes it: the dump is
+  // then expected to be made (the times of hdr_dump_at that have passed make one dump, not several;
+  // those already past when the setting is read are due at once).
+  static std::optional<HdrDumpRequest> ClaimHdrDump();
+  // Writes <dir>/hdr_<frame>_<t>s.dds (DX10 header, the format as is) and the .json beside it (the
+  // levels in use, written last: its presence means the image is complete), logs it, and warns once
+  // if it can't write. Returns whether both were written.
+  static bool WriteHdrDump(const HdrDumpRequest& request, const HdrDumpImage& image);
+
   // For capturing: guest output pixels (R10G10B10A2 words) to 8bpc ones as
   // Packed10bpcRGBTo8bpcBytes does; HDR10 images are turned back into SDR, with
   // SDR content coming back as it went in (to about one code) and light above
