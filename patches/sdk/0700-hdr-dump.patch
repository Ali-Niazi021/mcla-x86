+
   // End drawing to the back buffer.
   D3D12_RESOURCE_BARRIER barrier_rtv_to_present;
   barrier_rtv_to_present.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
   barrier_rtv_to_present.Flags = D3D12_RESOURCE_BARRIER_FLAG_NONE;
   barrier_rtv_to_present.Transition.pResource = back_buffer;
   barrier_rtv_to_present.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
-  barrier_rtv_to_present.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+  // From COPY_SOURCE if the dump copied it.
+  barrier_rtv_to_present.Transition.StateBefore =
+      hdr_dump ? D3D12_RESOURCE_STATE_COPY_SOURCE : D3D12_RESOURCE_STATE_RENDER_TARGET;
   barrier_rtv_to_present.Transition.StateAfter = D3D12_RESOURCE_STATE_PRESENT;
   command_list->ResourceBarrier(1, &barrier_rtv_to_present);
 
@@ -1694,6 +1717,13 @@ Presenter::PaintResult D3D12Presenter::PaintAndPresentImpl(bool execute_ui_drawe
   if (fused_gamma_check_.recorded) {
     CompleteFusedGammaCheck();
   }
+  // hdr_dump_dir: the paint submission (signaled right after the paint's command list, before the present)
+  // has to be done to read what it copied. The one-frame stall of the paint thread is the price of a dump.
+  if (hdr_dump) {
+    CompleteHdrDump(*hdr_dump, current_paint_submission,
+                    present_result == DXGI_ERROR_DEVICE_REMOVED ||
+                        present_result == DXGI_ERROR_DEVICE_RESET);
+  }
   switch (present_result) {
     case DXGI_ERROR_DEVICE_REMOVED:
       return PaintResult::kGpuLostExternally;
@@ -2394,4 +2424,93 @@ void D3D12Presenter::CompleteFusedGammaCheck() {
       differing_pixels ? fmt::format(", the first at {},{}", first_x, first_y) : std::string());
 }
 
+bool D3D12Presenter::RecordHdrDump(ID3D12GraphicsCommandList* command_list,
+                                   ID3D12Resource* back_buffer, uint64_t frame,
+                                   HdrDumpCapture& capture) {
+  ID3D12Device* device = provider_.GetDevice();
+  const D3D12_RESOURCE_DESC back_buffer_desc = back_buffer->GetDesc();
+  // The dump writes 4 bytes per pixel (R10G10B10A2 in HDR10, B8G8R8A8 in SDR).
+  if (back_buffer_desc.Format != kSwapChainFormat &&
+      back_buffer_desc.Format != kSwapChainFormatHdr10) {
+    REXLOG_ERROR("D3D12Presenter: HDR dump: the back buffer's format ({}) isn't one it can write",
+                 uint32_t(back_buffer_desc.Format));
+    return false;
+  }
+  UINT64 readback_size = 0;
+  device->GetCopyableFootprints(&back_buffer_desc, 0, 1, 0, &capture.footprint, nullptr, nullptr,
+                                &readback_size);
+  D3D12_RESOURCE_DESC readback_desc;
+  util::FillBufferResourceDesc(readback_desc, readback_size, D3D12_RESOURCE_FLAG_NONE);
+  if (FAILED(device->CreateCommittedResource(&util::kHeapPropertiesReadback, D3D12_HEAP_FLAG_NONE,
+                                             &readback_desc, D3D12_RESOURCE_STATE_COPY_DEST,
+                                             nullptr, IID_PPV_ARGS(&capture.readback)))) {
+    REXLOG_ERROR("D3D12Presenter: HDR dump: failed to create the readback buffer ({} bytes)",
+                 readback_size);
+    return false;
+  }
+  capture.readback_size = readback_size;
+  capture.format = back_buffer_desc.Format;
+  capture.width = uint32_t(back_buffer_desc.Width);
+  capture.height = back_buffer_desc.Height;
+  capture.hdr10 = paint_context_.swap_chain_hdr;
+  capture.frame = frame;
+
+  // Nothing can fail from here on: the back buffer is left in COPY_SOURCE.
+  D3D12_RESOURCE_BARRIER barrier;
+  barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+  barrier.Flags = D3D12_RESOURCE_BARRIER_FLAG_NONE;
+  barrier.Transition.pResource = back_buffer;
+  barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+  barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+  barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+  command_list->ResourceBarrier(1, &barrier);
+  D3D12_TEXTURE_COPY_LOCATION copy_dest = {};
+  copy_dest.pResource = capture.readback.Get();
+  copy_dest.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  copy_dest.PlacedFootprint = capture.footprint;
+  D3D12_TEXTURE_COPY_LOCATION copy_source = {};
+  copy_source.pResource = back_buffer;
+  copy_source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  copy_source.SubresourceIndex = 0;
+  command_list->CopyTextureRegion(&copy_dest, 0, 0, 0, &copy_source, nullptr);
+  return true;
+}
+
+void D3D12Presenter::CompleteHdrDump(HdrDumpCapture& capture, UINT64 paint_submission,
+                                     bool device_lost) {
+  // Always awaited, even with nothing to read: the readback buffer must not be released while the
+  // GPU may still be writing to it. This is the paint's own fence (signaled right after its command
+  // list), not the present's.
+  const bool completed =
+      paint_context_.paint_submission_tracker.AwaitSubmissionCompletion(paint_submission);
+  if (device_lost) {
+    capture.readback.Reset();
+    return;
+  }
+  if (!completed) {
+    REXLOG_ERROR("D3D12Presenter: HDR dump: the paint submission did not complete");
+    capture.readback.Reset();
+    return;
+  }
+  const D3D12_RANGE read_range = {0, SIZE_T(capture.readback_size)};
+  void* mapping = nullptr;
+  if (FAILED(capture.readback->Map(0, &read_range, &mapping)) || !mapping) {
+    REXLOG_ERROR("D3D12Presenter: HDR dump: failed to map the readback buffer");
+    capture.readback.Reset();
+    return;
+  }
+  HdrDumpImage image;
+  image.width = capture.width;
+  image.height = capture.height;
+  image.dxgi_format = uint32_t(capture.format);
+  image.hdr10 = capture.hdr10;
+  image.frame = capture.frame;
+  image.pixels = static_cast<const uint8_t*>(mapping) + capture.footprint.Offset;
+  image.row_pitch = capture.footprint.Footprint.RowPitch;
+  WriteHdrDump(capture.request, image);
+  const D3D12_RANGE written_range = {0, 0};
+  capture.readback->Unmap(0, &written_range);
+  capture.readback.Reset();
+}
+
 }  // namespace rex::ui::d3d12
