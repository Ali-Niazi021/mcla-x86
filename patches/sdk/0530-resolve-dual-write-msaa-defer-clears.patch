+  const uint32_t pitch_tiles = key.GetPitchTiles();
+  const uint32_t base_tiles = key.base_tiles;
+  const bool host_depth_tracked = key.is_depth &&
+                                  IsHostDepthEncodingDifferent(key.GetDepthFormat());
+  for (const auto& range_pair : ownership_ranges_) {
+    const OwnershipRange& range = range_pair.second;
+    uint32_t blocker;
+    if (range.render_target == key) {
+      blocker = kClearWholeOwnedOutside;
+    } else if (host_depth_tracked && range.GetHostDepthRenderTarget(key.GetDepthFormat()) == key) {
+      blocker = kClearWholeHostDepthOutside;
+    } else {
+      continue;
+    }
+    // GetRangeRectangles wants a range that is either from the base on or ends at it (the tail after the wrapping
+    // of the EDRAM addressing), and a range of the map may be across the base.
+    const uint32_t start_tiles = range_pair.first;
+    const uint32_t end_tiles = range.end_tiles;
+    for (uint32_t part = 0; part < 2; ++part) {
+      const uint32_t part_start = part ? start_tiles : std::max(start_tiles, base_tiles);
+      const uint32_t part_end = part ? std::min(end_tiles, base_tiles) : end_tiles;
+      if (part_start >= part_end) {
+        continue;
+      }
+      if (Transfer::GetRangeRectangles(part_start, part_end, base_tiles, pitch_tiles,
+                                       key.msaa_samples, is_64bpp, edram_tile_count_, nullptr,
+                                       &spared)) {
+        // Live pixels outside what is spared.
+        return blocker;
+      }
+    }
+  }
+  return kClearWholeOk;
+}
