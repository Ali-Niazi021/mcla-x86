   void ProcessResolveDualWriteVerifies(uint64_t completed_submission_index);
+
+  // ---- LOCAL PATCH - MCLA (0560): resolve_defer_memory_write (resolve_defer.cpp) ----
+  // One resolve write waiting for the bytes of its memory to be made.
+  struct DeferredResolveWrite {
+    uint64_t serial = 0;
+    // Pinned while this exists.
+    D3D12Texture* texture = nullptr;
+    DXGI_FORMAT uav_format = DXGI_FORMAT_UNKNOWN;
+    DeferredResolveGeometry geometry;
+    // The texture's xenos::Endian.
+    uint32_t texture_endian = 0;
+    // The range marked as resolved, and its pages (bytes, [start, end)).
+    uint32_t extent_start = 0;
+    uint32_t extent_length = 0;
+    uint32_t page_start = 0;
+    uint32_t page_end = 0;
+    // The bytes the resolve would have written (width x height x bytes a texel).
+    uint64_t bytes = 0;
+    // The memory was written for real as well (resolve_defer_memory_write_verify).
+    bool verify = false;
+    // What the resolve that's being recorded (BeginResolveOverwrite) does to this one, when it is:
+    // drop it (overwrites all of it), exclude the tiles it overwrites (pending_exclusion), keep it
+    // as it is (touches none of its tiles). The request of the resolve leaves it alone.
+    enum PendingAction : uint8_t { kPendingNone, kPendingDrop, kPendingExclude, kPendingKeep };
+    PendingAction pending = kPendingNone;
+    DeferredResolveExclusion pending_exclusion;
+    // Why the resolve that's being recorded makes the bytes instead (a string literal, for the log).
+    const char* fallback_reason = nullptr;
+    // The tiles resolves overwrote since: the shader doesn't write them.
+    static constexpr size_t kMaxExclusions = 4;
+    DeferredResolveExclusion exclusions[kMaxExclusions];
+    uint32_t exclusion_count = 0;
+  };
+  std::vector<DeferredResolveWrite> deferred_resolve_writes_;
+  uint64_t deferred_resolve_serial_ = 0;
+  // The sum of `bytes` of the records.
+  uint64_t deferred_resolve_bytes_ = 0;
+  bool resolve_defer_hook_registered_ = false;
+
