+  // LOCAL PATCH - MCLA (0530): resolve_dual_write_msaa: logs `[resolve-dual-write] fallback <reason> at
+  // 0xADDR WxH fmt msaaN` once for each destination (and reason), at most 32 lines in a run. The
+  // address is the texture base the guest resolves to, the size the area, fmt the destination
+  // format (xenos::TextureFormat), N the sample count of the render target (msaa_samples is its
+  // xenos::MsaaSamples).
+  void LogResolveDualWriteFallback(ResolveDualWriteFallback reason, uint32_t address,
+                                   uint32_t width, uint32_t height, uint32_t format,
+                                   uint32_t msaa_samples);
   // Every 10 s logs the counts since the last line, if there were any.
   void LogResolveDualWriteIfDue();
 
+  // ---- LOCAL PATCH - MCLA (0560): resolve_defer_memory_write ----
+  //
+  // A resolve that D3D12RenderTargetCache::Resolve has dual-written (resolve_dual_write) whole - the
+  // texture holds all of what the resolve stored: colour, no transformation, the area of the
+  // resolve is exactly the texture - leaves the shared memory's bytes unwritten (its memory
+  // stores go to a null view) and marks the range as resolved as it always did. The bytes are
+  // recorded (a DeferredResolveWrite: the texture, kept alive, and where and how the resolve's
+  // store would have put each of its texels) and made from the texture by a compute shader
+  // (resolve_materialize_{32,64}bpp) when anything may use them: a request of the shared memory
+  // that touches a page of the range (the hook of SharedMemory::RequestRanges: vertex and index
+  // fetches, memexport, texture loads, a resolve that doesn't overwrite them), the copy to the
+  // guest memory of a readback resolve, a write into the texture by something else (the temporal
+  // AA copying its output into the scene texture), a cache clear. A resolve that overwrites all of
+  // the bytes again drops the record: they were never needed (the same destination, pitch and
+  // texel size, an area not smaller; or, for any other shape of destination, every 32x32 tile the
+  // record's bytes are in is one the resolve writes whole). A resolve that overwrites only some
+  // tiles of the bytes, and touches no other tile of them, adds those tiles to the record's
+  // exclusions (up to 4: the materializing shader skips the groups in them) and leaves the record
+  // waiting. What is in the memory after that is what it would have been.
+  // Cvars: resolve_defer_memory_write, _poison, _verify.
+  // LOCAL PATCH - MCLA (0560): adaptive eligibility (resolve_defer_backoff_frames): a destination
+  // (base, size, format) whose record was made from the texture by anything but a cache clear, the
+  // limits or the dual-write verify is not deferred again for that many frames (the write is done
+  // as without the deferral: made once, it costs more than the write it saved). Exactness is not
+  // touched, it only chooses not to defer.
+  //
+  // What a resolve writes to the memory, to compare it with a record's.
+  struct DeferredResolveGeometry {
+    // The destination base address the resolve's shader adds to its tiled offsets (bytes), the
+    // row pitch aligned to 32 texels, bytes a texel, and the area from the texel (0, 0).
+    uint32_t dest_base = 0;
+    uint32_t pitch_texels = 0;
+    uint32_t bytes_per_texel = 0;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    // No array and no offset of the area in its base: the address of the pixel (x, y) is the
+    // tiled address of (x, y) from dest_base.
+    bool plain = false;
+    // LOCAL PATCH - MCLA (0560): the offset of the area in the destination base (texels), whether the
+    // destination is an array (its addresses are those of a 3D tiling), and the destination's
+    // xenos::TextureFormat (for the log).
+    uint32_t offset_x = 0;
+    uint32_t offset_y = 0;
+    bool array = false;
+    uint32_t format = 0;
+  };
+  // The 32x32 tiles of a resolve's area, relative to its destination base: the tiles at [tx0, tx1) x
+  // [ty0, ty1) are touched, in a grid of pitch_tiles columns; tile k of that grid is the bytes
+  // [base + (k << tile_shift), + (1 << tile_shift)). The shader (resolve_direct_materialize.xesli)
+  // skips the 16-byte groups in the touched tiles of an exclusion.
+  struct DeferredResolveExclusion {
+    uint32_t base = 0;
+    uint32_t pitch_tiles = 0;
+    uint32_t tile_shift = 0;
+    uint32_t tx0 = 0, tx1 = 0, ty0 = 0, ty1 = 0;
+  };
+  enum class DeferIneligible : uint32_t {
+    // The resolve wasn't dual-written (no texture of the cache at the destination, or why not
+    // is in the resolve_dual_write line).
+    kNotDualWritten,
+    // An array, or an offset of the area in the destination base.
+    kDestination,
+    // The resolve wrote a part of the texture (resolve_dual_write_msaa).
+    kPartial,
+    // The texture isn't colour (the load transforms depth).
+    kDepth,
+    // The destination base is at a texel of the texture other than (0, 0).
+    kOrigin,
+    // The area isn't the size of the texture.
+    kSize,
+    // Not 32 or 64 bits a texel.
+    kFormat,
+    // 64 bits a texel, and the device can't load R16G16B16A16_UINT unordered access views.
+    kTypedLoad,
+    // Every resolve is read back to the guest memory (the global readback mode).
+    kReadback,
+    // The materializing pipeline couldn't be made.
+    kPipeline,
+    // Not bindless: requesting descriptors in the middle of a draw's requests of the shared
+    // memory may change the descriptor heap the draw has bound its tables from.
+    kBindful,
+    // LOCAL PATCH - MCLA (0560): resolve_defer_backoff_frames: a write to this destination was made
+    // from its texture a short while ago (the deferral lost: the bytes are made anyway, with a pass
+    // more than the write would have cost).
+    kBackoff,
+
+    kCount,
+  };
+  // What made the bytes of a deferred resolve write be made (the first six are the kinds of
+  // SharedMemory requests, in their order).
+  enum class DeferTrigger : uint32_t {
+    kRequestOther,
+    kRequestTexture,
+    kRequestVertex,
+    kRequestIndex,
+    kRequestMemexport,
+    // A resolve that overwrites a part of the bytes.
+    kResolve,
+    // The copy of a resolve to the guest memory.
+    kReadback,
+    // Something other than a resolve writes the texture (the temporal AA).
+    kTextureWrite,
+    kCacheClear,
+    // More resolve writes waiting than the limits allow.
+    kCap,
+    // resolve_dual_write_verify loads the texture the usual way.
+    kDualVerify,
+
+    kCount,
+  };
+  static_assert(uint32_t(DeferTrigger::kResolve) == uint32_t(SharedMemory::kRequestKindResolve) &&
+                    uint32_t(DeferTrigger::kRequestMemexport) ==
+                        uint32_t(SharedMemory::kRequestKindMemexport),
+                "The first triggers are the kinds of the shared memory requests");
+
+  bool HasDeferredResolveWrites() const { return !deferred_resolve_writes_.empty(); }
+  // Whether the memory write of the resolve that is to be dual-written to dual_target (null if it
+  // isn't) can be deferred; counts the reason if not. verify_out: the write is done for real as
+  // well, and checked against what's made from the texture (resolve_defer_memory_write_verify).
+  bool CanDeferResolveMemoryWrite(const ResolveDualWriteTarget* dual_target,
+                                  const DeferredResolveGeometry& geometry, bool readback_enabled,
+                                  bool& verify_out);
+  // A resolve (of any kind) is about to request its destination from the shared memory: the
+  // records it overwrites entirely are left alone by the request (and dropped by
+  // EndResolveOverwrite(true) once the resolve is recorded), the ones it overwrites some tiles of
+  // and nothing else of get an exclusion then, the ones it doesn't touch at all stay, the others
+  // are made by the request. dual_texture is the texture the resolve writes along with the memory
+  // (null if none): a record of that texture is dropped or made, never left waiting.
+  // Returns true if a record is left waiting without being dropped: that holds only if the
+  // request uploads nothing (every page of the extent is valid), so the caller must hold the
+  // global critical region from before this call to after the request (it is recursive), and
+  // can let go of it at once if this returns false.
+  bool BeginResolveOverwrite(const DeferredResolveGeometry& geometry, uint32_t extent_start,
+                             uint32_t extent_length, const Texture* dual_texture);
+  // resolve_done: the resolve was recorded, the drops and the exclusions are done; otherwise
+  // nothing changes.
+  void EndResolveOverwrite(bool resolve_done);
+  // After the resolve that CanDeferResolveMemoryWrite said yes to has been recorded and marked.
+  void AddDeferredResolveWrite(const ResolveDualWriteTarget& target,
+                               const DeferredResolveGeometry& geometry, uint32_t extent_start,
+                               uint32_t extent_length, bool verify);
+  // Makes the bytes of the records that touch the pages of the range.
+  void MaterializeDeferredResolveWrites(uint32_t start, uint32_t length, DeferTrigger trigger);
+  void MaterializeAllDeferredResolveWrites(DeferTrigger trigger);
+  // Every 10 s, if there is anything to say.
+  void LogResolveDeferIfDue();
