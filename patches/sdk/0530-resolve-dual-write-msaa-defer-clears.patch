+    max_frame_clears_ = 0;
+    window_start_ = now;
+  }
+
+ private:
+  uint64_t counts_[kClearFullOutcomeCount] = {};
+  uint64_t whole_depth_ = 0, whole_color_ = 0, clears_ = 0, frames_ = 0;
