   // or loading the texture (swap_direct_present). False, with why_not_out (a string literal), if it isn't a tiled
   // single-level 2D k_8_8_8_8 texture at native resolution.
@@ -710,6 +885,12 @@ class D3D12TextureCache final : public TextureCache {
     uint32_t loads_skipped = 0;
