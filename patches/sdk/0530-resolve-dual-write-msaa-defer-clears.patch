+// LOCAL PATCH - MCLA (0560): resolve_defer_backoff_frames: the destinations remembered, and the
+// lines of the log about them (the churn of a map that's too small must not fill the log).
+constexpr size_t kMaxDeferBackoffEntries = 256;
+constexpr uint32_t kMaxDeferBackoffLogLines = 64;
+
+// The constants of the shader (resolve_direct_materialize.xesli).
+struct MaterializeConstants {
+  uint32_t dest_base;
+  uint32_t pitch_aligned;
+  uint32_t size;
+  uint32_t info;
+  uint32_t exclusions[kMaxMaterializeExclusions][4];
+};
+
+// A resolve overwrites all of the pixels of a record's resolve when the pixels are at the same
+// addresses (the same base, pitch and bytes a texel, both without an offset of the area) and its
+// area is not smaller.
+bool DeferredResolveGeometryCovers(const D3D12TextureCache::DeferredResolveGeometry& overwriting,
+                                   const D3D12TextureCache::DeferredResolveGeometry& written) {
+  return overwriting.plain && written.plain && overwriting.dest_base == written.dest_base &&
+         overwriting.pitch_texels == written.pitch_texels &&
+         overwriting.bytes_per_texel == written.bytes_per_texel &&
+         overwriting.width >= written.width && overwriting.height >= written.height;
+}
+
+// What a resolve writes, in 32x32 tiles. For 4, 8 and 16 bytes a texel (not for 1 and 2, whose tiles
+// aren't contiguous) a tile (tx, ty) of the destination grid is the 1024 * bytes bytes from
+// base + ((ty * pitch_tiles + tx) << tile_shift): the tiled address of every pixel of the tile is in
+// it, and the pixels are all of them. The tiles of the area are the touched ones; the ones whose
+// 32x32 pixels are all in the area are full: all of their bytes are written. The other touched
+// tiles have some bytes that aren't.
+struct ResolveTileFootprint {
+  D3D12TextureCache::DeferredResolveExclusion touched;
+  uint32_t full_tx0, full_tx1, full_ty0, full_ty1;
+};
+
+bool BuildResolveTileFootprint(const D3D12TextureCache::DeferredResolveGeometry& geometry,
+                               ResolveTileFootprint& footprint_out) {
+  if (geometry.array || !geometry.width || !geometry.height || !geometry.pitch_texels ||
+      (geometry.pitch_texels & 31) || geometry.dest_base >= (UINT32_C(1) << 29) ||
+      (geometry.dest_base & 15)) {
+    return false;
+  }
+  uint32_t tile_shift;
+  switch (geometry.bytes_per_texel) {
+    case 4:
+      tile_shift = 12;
+      break;
+    case 8:
+      tile_shift = 13;
+      break;
+    case 16:
+      tile_shift = 14;
+      break;
+    default:
+      return false;
+  }
+  const uint32_t pitch_tiles = geometry.pitch_texels >> 5;
+  const uint32_t end_x = geometry.offset_x + geometry.width;
+  const uint32_t end_y = geometry.offset_y + geometry.height;
+  D3D12TextureCache::DeferredResolveExclusion& touched = footprint_out.touched;
+  touched.base = geometry.dest_base;
+  touched.pitch_tiles = pitch_tiles;
+  touched.tile_shift = tile_shift;
+  touched.tx0 = geometry.offset_x >> 5;
+  touched.tx1 = (end_x + 31) >> 5;
+  touched.ty0 = geometry.offset_y >> 5;
+  touched.ty1 = (end_y + 31) >> 5;
+  // The fields of the shader's constants are 10 bits, and an area wider than its pitch wraps.
+  if (pitch_tiles > 1023 || touched.tx1 > pitch_tiles || touched.ty1 > 1023) {
+    return false;
+  }
+  footprint_out.full_tx0 = (geometry.offset_x + 31) >> 5;
+  footprint_out.full_tx1 = end_x >> 5;
+  footprint_out.full_ty0 = (geometry.offset_y + 31) >> 5;
+  footprint_out.full_ty1 = end_y >> 5;
+  return true;
+}
+
+enum class ResolveOverlap {
+  // None of the record's tiles has a byte the resolve writes.
+  kUntouched,
+  // Every tile of the record is written whole.
+  kCovered,
+  // Some are, the others have no byte the resolve writes.
+  kExclude,
+  // A tile of the record is one the resolve writes a part of, or the shapes can't be compared.
+  kUndecidable,
+};
+
+// The record's bytes are in its touched tiles (it is plain, with its area from the origin), each the
+// bytes of tile_bytes from base1 + ((ty * pitch_tiles + tx) * tile_bytes); each of them is in
+// one or more tiles of the footprint's grid, each full, partly written or not at all.
+ResolveOverlap ClassifyResolveOverlap(const D3D12TextureCache::DeferredResolveGeometry& record,
+                                      const ResolveTileFootprint& footprint) {
+  const uint64_t tile_bytes = uint64_t(record.bytes_per_texel) << 10;
+  const uint32_t record_pitch_tiles = record.pitch_texels >> 5;
+  const uint32_t record_tiles_x = (record.width + 31) >> 5;
+  const uint32_t record_tiles_y = (record.height + 31) >> 5;
+  if (!record_pitch_tiles || record_tiles_x > record_pitch_tiles) {
+    return ResolveOverlap::kUndecidable;
+  }
+  const D3D12TextureCache::DeferredResolveExclusion& grid = footprint.touched;
+  const uint64_t grid_base = grid.base;
+  const uint32_t grid_shift = grid.tile_shift;
+  bool any_full = false;
+  bool all_full = true;
+  for (uint32_t ty = 0; ty < record_tiles_y; ++ty) {
+    for (uint32_t tx = 0; tx < record_tiles_x; ++tx) {
+      uint64_t start = uint64_t(record.dest_base) + (uint64_t(ty) * record_pitch_tiles + tx) * tile_bytes;
+      const uint64_t end = start + tile_bytes;
+      if (start < grid_base) {
+        // The bytes below the grid aren't written.
+        all_full = false;
+        if (end <= grid_base) {
+          continue;
+        }
+        start = grid_base;
+      }
+      const uint64_t first_tile = (start - grid_base) >> grid_shift;
+      const uint64_t last_tile = (end - 1 - grid_base) >> grid_shift;
+      for (uint64_t tile = first_tile; tile <= last_tile; ++tile) {
+        const uint64_t tile_y = tile / grid.pitch_tiles;
+        const uint64_t tile_x = tile - tile_y * grid.pitch_tiles;
+        const bool touched = tile_x >= grid.tx0 && tile_x < grid.tx1 && tile_y >= grid.ty0 &&
+                             tile_y < grid.ty1;
+        if (!touched) {
+          all_full = false;
+        } else if (tile_x >= footprint.full_tx0 && tile_x < footprint.full_tx1 &&
+                   tile_y >= footprint.full_ty0 && tile_y < footprint.full_ty1) {
+          any_full = true;
+        } else {
+          return ResolveOverlap::kUndecidable;
+        }
+      }
+    }
+  }
+  if (all_full) {
+    return ResolveOverlap::kCovered;
+  }
+  return any_full ? ResolveOverlap::kExclude : ResolveOverlap::kUntouched;
+}
+
+}  // namespace
+
+void D3D12TextureCache::RequestRangesHookThunk(void* context,
+                                               const std::pair<uint32_t, uint32_t>* page_ranges,
+                                               size_t count, uint32_t request_kind) {
+  D3D12TextureCache& texture_cache = *static_cast<D3D12TextureCache*>(context);
+  DeferTrigger trigger = request_kind < uint32_t(SharedMemory::kRequestKindCount)
+                             ? DeferTrigger(request_kind)
+                             : DeferTrigger::kRequestOther;
+  texture_cache.MaterializeOverlappingDeferredResolveWrites(page_ranges, count, trigger);
+}
+
+void D3D12TextureCache::EnsureResolveDeferHook() {
+  if (resolve_defer_hook_registered_) {
+    return;
+  }
+  resolve_defer_hook_registered_ = true;
+  shared_memory().SetRequestRangesHook(RequestRangesHookThunk, this);
+}
+
+void D3D12TextureCache::UpdateResolveDeferHookActive() {
+  shared_memory().SetRequestRangesHookActive(!deferred_resolve_writes_.empty());
+}
+
+void D3D12TextureCache::ShutdownResolveDefer() {
+  if (resolve_defer_hook_registered_) {
+    shared_memory().SetRequestRangesHookActive(false);
+    shared_memory().SetRequestRangesHook(nullptr, nullptr);
+    resolve_defer_hook_registered_ = false;
+  }
+  for (DeferredResolveWrite& record : deferred_resolve_writes_) {
+    record.texture->Unpin();
+  }
+  deferred_resolve_writes_.clear();
+  deferred_resolve_bytes_ = 0;
+  resolve_defer_backoff_.clear();  // LOCAL PATCH - MCLA (0560): backoff
+  resolve_defer_verifies_.clear();
+  for (Microsoft::WRL::ComPtr<ID3D12PipelineState>& pipeline : materialize_pipelines_) {
+    pipeline.Reset();
+  }
+  materialize_root_signature_.Reset();
+}
+
+ID3D12PipelineState* D3D12TextureCache::GetMaterializePipeline(bool is_64bpp) {
+  if (materialize_pipelines_failed_) {
+    return nullptr;
+  }
+  if (materialize_pipelines_[size_t(is_64bpp)]) {
+    return materialize_pipelines_[size_t(is_64bpp)].Get();
+  }
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  if (!materialize_root_signature_) {
+    // 0 - the constants; 1 - the shared memory (u0); 2 - the texture (u1).
+    D3D12_ROOT_PARAMETER root_parameters[3];
+    root_parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    root_parameters[0].Constants.ShaderRegister = 0;
+    root_parameters[0].Constants.RegisterSpace = 0;
+    root_parameters[0].Constants.Num32BitValues = sizeof(MaterializeConstants) / sizeof(uint32_t);
+    root_parameters[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_DESCRIPTOR_RANGE memory_range;
+    memory_range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+    memory_range.NumDescriptors = 1;
+    memory_range.BaseShaderRegister = 0;
+    memory_range.RegisterSpace = 0;
+    memory_range.OffsetInDescriptorsFromTableStart = 0;
+    root_parameters[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    root_parameters[1].DescriptorTable.NumDescriptorRanges = 1;
+    root_parameters[1].DescriptorTable.pDescriptorRanges = &memory_range;
+    root_parameters[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_DESCRIPTOR_RANGE texture_range;
+    texture_range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+    texture_range.NumDescriptors = 1;
+    texture_range.BaseShaderRegister = 1;
+    texture_range.RegisterSpace = 0;
+    texture_range.OffsetInDescriptorsFromTableStart = 0;
+    root_parameters[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    root_parameters[2].DescriptorTable.NumDescriptorRanges = 1;
+    root_parameters[2].DescriptorTable.pDescriptorRanges = &texture_range;
+    root_parameters[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_ROOT_SIGNATURE_DESC root_signature_desc;
+    root_signature_desc.NumParameters = UINT(rex::countof(root_parameters));
+    root_signature_desc.pParameters = root_parameters;
+    root_signature_desc.NumStaticSamplers = 0;
+    root_signature_desc.pStaticSamplers = nullptr;
+    root_signature_desc.Flags = D3D12_ROOT_SIGNATURE_FLAG_NONE;
+    *(materialize_root_signature_.ReleaseAndGetAddressOf()) =
+        ui::d3d12::util::CreateRootSignature(provider, root_signature_desc);
+    if (!materialize_root_signature_) {
+      materialize_pipelines_failed_ = true;
+      REXGPU_ERROR("[resolve-defer] failed to create the root signature that makes the memory");
+      return nullptr;
+    }
+  }
+  const void* code = is_64bpp ? static_cast<const void*>(shaders::resolve_materialize_64bpp_cs)
+                              : static_cast<const void*>(shaders::resolve_materialize_32bpp_cs);
+  const size_t code_size = is_64bpp ? sizeof(shaders::resolve_materialize_64bpp_cs)
+                                    : sizeof(shaders::resolve_materialize_32bpp_cs);
+  *(materialize_pipelines_[size_t(is_64bpp)].ReleaseAndGetAddressOf()) =
+      ui::d3d12::util::CreateComputePipeline(device, code, code_size,
+                                             materialize_root_signature_.Get());
+  if (!materialize_pipelines_[size_t(is_64bpp)]) {
+    materialize_pipelines_failed_ = true;
+    REXGPU_ERROR("[resolve-defer] failed to create the pipeline that makes the memory ({} bits)",
+                 is_64bpp ? 64 : 32);
+    return nullptr;
+  }
+  materialize_pipelines_[size_t(is_64bpp)]->SetName(is_64bpp ? L"Resolve materialize 64bpp"
+                                                             : L"Resolve materialize 32bpp");
+  return materialize_pipelines_[size_t(is_64bpp)].Get();
+}
+
+bool D3D12TextureCache::CanDeferResolveMemoryWrite(const ResolveDualWriteTarget* dual_target,
+                                                   const DeferredResolveGeometry& geometry,
+                                                   bool readback_enabled, bool& verify_out) {
+  verify_out = false;
+  auto reject = [&](DeferIneligible reason) {
+    ++resolve_defer_stats_.ineligible[size_t(reason)];
+    return false;
+  };
+  if (!dual_target || !dual_target->texture) {
+    return reject(DeferIneligible::kNotDualWritten);
+  }
+  if (!bindless_resources_used_) {
+    return reject(DeferIneligible::kBindful);
+  }
+  if (!geometry.plain) {
+    return reject(DeferIneligible::kDestination);
+  }
+  if (dual_target->partial) {
+    return reject(DeferIneligible::kPartial);
+  }
+  // The transformation (bits 2:3 of the constant): colour is stored as it is.
+  if (((dual_target->constant_info >> 2) & 3u) != 0) {
+    return reject(DeferIneligible::kDepth);
+  }
+  // The origin of the destination base in the texture (bits 4:31): the area starts at the texture.
+  if ((dual_target->constant_info >> 4) != 0) {
+    return reject(DeferIneligible::kOrigin);
+  }
+  if ((dual_target->constant_size & 0xFFFFu) != geometry.width ||
+      (dual_target->constant_size >> 16) != geometry.height) {
+    return reject(DeferIneligible::kSize);
+  }
+  if (geometry.bytes_per_texel != 4 && geometry.bytes_per_texel != 8) {
+    return reject(DeferIneligible::kFormat);
+  }
+  if (geometry.bytes_per_texel == 8) {
+    if (materialize_64bpp_loadable_ < 0) {
+      D3D12_FEATURE_DATA_FORMAT_SUPPORT support = {};
+      support.Format = DXGI_FORMAT_R16G16B16A16_UINT;
+      materialize_64bpp_loadable_ =
+          (SUCCEEDED(command_processor_.GetD3D12Provider().GetDevice()->CheckFeatureSupport(
+               D3D12_FEATURE_FORMAT_SUPPORT, &support, sizeof(support))) &&
+           (support.Support2 & D3D12_FORMAT_SUPPORT2_UAV_TYPED_LOAD) != 0)
+              ? 1
+              : 0;
+    }
+    if (!materialize_64bpp_loadable_) {
+      return reject(DeferIneligible::kTypedLoad);
+    }
+  }
+  if (readback_enabled) {
+    return reject(DeferIneligible::kReadback);
+  }
+  if (!GetMaterializePipeline(geometry.bytes_per_texel == 8)) {
+    return reject(DeferIneligible::kPipeline);
+  }
+  // LOCAL PATCH - MCLA (0560): resolve_defer_backoff_frames: eligible otherwise, but the bytes of
+  // this destination were made from the texture a short while ago.
+  if (IsResolveDeferBackedOff(geometry)) {
+    return reject(DeferIneligible::kBackoff);
+  }
+  int32_t verify_every = REXCVAR_GET(resolve_defer_memory_write_verify);
+  if (verify_every > 0 && ++resolve_defer_verify_counter_ >= uint32_t(verify_every)) {
+    if (resolve_defer_verifies_.size() >= kMaxDeferVerifiesInFlight) {
+      ++resolve_defer_stats_.verify_skipped;
+    } else {
+      resolve_defer_verify_counter_ = 0;
+      verify_out = true;
+    }
+  }
+  return true;
+}
+
+bool D3D12TextureCache::BeginResolveOverwrite(const DeferredResolveGeometry& geometry,
+                                              uint32_t extent_start, uint32_t extent_length,
+                                              const Texture* dual_texture) {
+  resolve_overwrite_.active = true;
+  resolve_overwrite_.geometry = geometry;
+  resolve_overwrite_.extent_start = extent_start;
+  if (deferred_resolve_writes_.empty() || !extent_length || extent_start >= SharedMemory::kBufferSize) {
+    return false;
+  }
+  // The pages the request of the extent may upload to.
+  const uint32_t page_mask = (uint32_t(1) << shared_memory().GetPageSizeLog2()) - 1;
+  const uint32_t request_page_start = extent_start & ~page_mask;
+  const uint32_t request_page_end = uint32_t(std::min(
+      (uint64_t(extent_start) + extent_length + page_mask) & ~uint64_t(page_mask),
+      uint64_t(SharedMemory::kBufferSize)));
+  ResolveTileFootprint footprint;
+  const bool footprint_known = BuildResolveTileFootprint(geometry, footprint);
+  // Whether the request uploads nothing (asked once, if it matters).
+  int32_t request_uploads_nothing = -1;
+  bool leaves_waiting = false;
+  for (DeferredResolveWrite& record : deferred_resolve_writes_) {
+    record.pending = DeferredResolveWrite::kPendingNone;
+    record.fallback_reason = nullptr;
+    if (record.page_start >= request_page_end || record.page_end <= request_page_start) {
+      continue;
+    }
+    // The same pixels at the same addresses, and not fewer of them.
+    if (DeferredResolveGeometryCovers(geometry, record.geometry)) {
+      record.pending = DeferredResolveWrite::kPendingDrop;
+      continue;
+    }
+    if (!footprint_known) {
+      record.fallback_reason = "the resolve's shape can't be analysed (an array, 1 or 2 bytes a texel, ...)";
+      continue;
+    }
+    const ResolveOverlap overlap = ClassifyResolveOverlap(record.geometry, footprint);
+    if (overlap == ResolveOverlap::kCovered) {
+      record.pending = DeferredResolveWrite::kPendingDrop;
+      continue;
+    }
+    if (overlap == ResolveOverlap::kUndecidable) {
+      record.fallback_reason = "the resolve writes a part of a tile the record is in";
+      continue;
+    }
+    // The record stays: not if the texture it is made from is one the resolve writes, not if it
+    // has all the exclusions it can, and not if the request uploads anything (the pages it
+    // uploads over are the CPU's, over the record's bytes in them, which the shader would
+    // write over again).
+    if (record.texture == dual_texture) {
+      record.fallback_reason = "the resolve writes the record's texture";
+      continue;
+    }
+    bool already_excluded = false;
+    if (overlap == ResolveOverlap::kExclude) {
+      for (uint32_t i = 0; i < record.exclusion_count; ++i) {
+        const DeferredResolveExclusion& exclusion = record.exclusions[i];
+        if (exclusion.base == footprint.touched.base &&
+            exclusion.pitch_tiles == footprint.touched.pitch_tiles &&
+            exclusion.tile_shift == footprint.touched.tile_shift &&
+            exclusion.tx0 == footprint.touched.tx0 && exclusion.tx1 == footprint.touched.tx1 &&
+            exclusion.ty0 == footprint.touched.ty0 && exclusion.ty1 == footprint.touched.ty1) {
+          already_excluded = true;
+          break;
+        }
+      }
+      if (!already_excluded && record.exclusion_count >= DeferredResolveWrite::kMaxExclusions) {
+        record.fallback_reason = "the record has all the exclusions it can";
+        continue;
+      }
+    }
+    if (request_uploads_nothing < 0) {
+      request_uploads_nothing =
+          shared_memory().AreAllPagesValid(extent_start, extent_length) ? 1 : 0;
+    }
+    if (!request_uploads_nothing) {
+      record.fallback_reason = "the request may upload (a page isn't valid)";
+      continue;
+    }
+    if (overlap == ResolveOverlap::kExclude && !already_excluded) {
+      record.pending = DeferredResolveWrite::kPendingExclude;
+      record.pending_exclusion = footprint.touched;
+    } else {
+      record.pending = DeferredResolveWrite::kPendingKeep;
+    }
+    leaves_waiting = true;
+  }
+  return leaves_waiting;
+}
+
+void D3D12TextureCache::EndResolveOverwrite(bool resolve_done) {
+  std::string by;
+  if (resolve_done && resolve_defer_outcomes_logged_.size() < 48) {
+    by = DescribeResolveDeferTrigger(DeferTrigger::kResolve, 0, 0);
+  }
+  for (size_t i = deferred_resolve_writes_.size(); i-- > 0;) {
+    const DeferredResolveWrite::PendingAction action = deferred_resolve_writes_[i].pending;
+    deferred_resolve_writes_[i].pending = DeferredResolveWrite::kPendingNone;
+    if (action == DeferredResolveWrite::kPendingNone || !resolve_done) {
+      continue;
+    }
+    DeferredResolveWrite& record = deferred_resolve_writes_[i];
+    switch (action) {
+      case DeferredResolveWrite::kPendingDrop:
+        ++resolve_defer_stats_.dropped;
+        resolve_defer_stats_.dropped_bytes += record.bytes;
+        LogResolveDeferOutcome("drop", record, by);
+        RemoveDeferredResolveWriteAt(i);
+        break;
+      case DeferredResolveWrite::kPendingExclude:
+        if (record.exclusion_count < DeferredResolveWrite::kMaxExclusions) {
+          record.exclusions[record.exclusion_count++] = record.pending_exclusion;
+        }
+        ++resolve_defer_stats_.excluded;
+        LogResolveDeferOutcome("exclude", record, by);
+        break;
+      default:
+        ++resolve_defer_stats_.kept;
+        LogResolveDeferOutcome("keep", record, by);
+        break;
+    }
+  }
+  resolve_overwrite_.active = false;
+}
+
+void D3D12TextureCache::LogResolveDeferOutcome(const char* outcome,
+                                               const DeferredResolveWrite& record,
+                                               const std::string& by) {
+  constexpr size_t kMaxOutcomeLines = 48;
+  if (resolve_defer_outcomes_logged_.size() >= kMaxOutcomeLines) {
+    return;
+  }
+  const FormatInfo* format_info = FormatInfo::Get(record.texture->key().format);
+  const std::string line = fmt::format("{} 0x{:08X} {}x{} {} by {}", outcome, record.geometry.dest_base,
+                                       record.geometry.width, record.geometry.height,
+                                       format_info ? format_info->name : "?", by);
+  if (resolve_defer_outcomes_logged_.insert(line).second) {
+    REXGPU_INFO("[resolve-defer] {}", line);
+  }
+}
+
+std::string D3D12TextureCache::DescribeResolveDeferTrigger(DeferTrigger trigger,
+                                                           uint32_t range_start,
+                                                           uint32_t range_end) const {
+  if (trigger == DeferTrigger::kResolve && resolve_overwrite_.active) {
+    const DeferredResolveGeometry& geometry = resolve_overwrite_.geometry;
+    const FormatInfo* format_info = FormatInfo::Get(xenos::TextureFormat(geometry.format));
+    return fmt::format("resolve 0x{:08X} {}x{} {}", geometry.dest_base, geometry.width,
+                       geometry.height, format_info ? format_info->name : "?");
+  }
+  if (range_end) {
+    return fmt::format("{} 0x{:08X}-0x{:08X}", kDeferTriggerNames[size_t(trigger)], range_start,
+                       range_end);
+  }
+  return kDeferTriggerNames[size_t(trigger)];
+}
+
+// LOCAL PATCH - MCLA (0560): resolve_defer_backoff_frames.
+bool D3D12TextureCache::IsResolveDeferBackedOff(const DeferredResolveGeometry& geometry) const {
+  const int32_t backoff_frames = REXCVAR_GET(resolve_defer_backoff_frames);
+  if (backoff_frames <= 0 || resolve_defer_backoff_.empty()) {
+    return false;
+  }
+  const uint64_t frame = command_processor_.GetCurrentFrame();
+  for (const ResolveDeferBackoffEntry& entry : resolve_defer_backoff_) {
+    if (entry.dest_base == geometry.dest_base && entry.width == geometry.width &&
+        entry.height == geometry.height && entry.format == geometry.format &&
+        entry.bytes_per_texel == geometry.bytes_per_texel) {
+      return frame < entry.last_frame + uint64_t(backoff_frames);
+    }
+  }
+  return false;
+}
+
+bool D3D12TextureCache::ResolveDeferBackoffNeedsLog(const DeferredResolveGeometry& geometry) const {
+  if (resolve_defer_backoff_lines_logged_ >= kMaxDeferBackoffLogLines ||
+      REXCVAR_GET(resolve_defer_backoff_frames) <= 0) {
+    return false;
+  }
+  for (const ResolveDeferBackoffEntry& entry : resolve_defer_backoff_) {
+    if (entry.dest_base == geometry.dest_base && entry.width == geometry.width &&
+        entry.height == geometry.height && entry.format == geometry.format &&
+        entry.bytes_per_texel == geometry.bytes_per_texel) {
+      return !entry.logged;
+    }
+  }
+  return true;
+}
+
+void D3D12TextureCache::NoteResolveDeferMaterialized(const DeferredResolveGeometry& geometry,
+                                                     DeferTrigger trigger,
+                                                     const std::string& by) {
+  if (REXCVAR_GET(resolve_defer_backoff_frames) <= 0) {
+    return;
+  }
+  const uint64_t frame = command_processor_.GetCurrentFrame();
+  ResolveDeferBackoffEntry* found = nullptr;
+  for (ResolveDeferBackoffEntry& entry : resolve_defer_backoff_) {
+    if (entry.dest_base == geometry.dest_base && entry.width == geometry.width &&
+        entry.height == geometry.height && entry.format == geometry.format &&
+        entry.bytes_per_texel == geometry.bytes_per_texel) {
+      found = &entry;
+      break;
+    }
+  }
+  if (!found) {
+    if (resolve_defer_backoff_.size() >= kMaxDeferBackoffEntries) {
+      // The one that was made the longest ago.
+      auto oldest = std::min_element(
+          resolve_defer_backoff_.begin(), resolve_defer_backoff_.end(),
+          [](const ResolveDeferBackoffEntry& a, const ResolveDeferBackoffEntry& b) {
+            return a.last_frame < b.last_frame;
+          });
+      resolve_defer_backoff_.erase(oldest);
+    }
+    resolve_defer_backoff_.emplace_back();
+    found = &resolve_defer_backoff_.back();
+    found->dest_base = geometry.dest_base;
+    found->width = geometry.width;
+    found->height = geometry.height;
+    found->format = geometry.format;
+    found->bytes_per_texel = geometry.bytes_per_texel;
+  }
+  found->last_frame = frame;
+  ++found->count;
+  if (!found->logged) {
+    found->logged = true;
+    if (resolve_defer_backoff_lines_logged_ < kMaxDeferBackoffLogLines) {
+      ++resolve_defer_backoff_lines_logged_;
+      const FormatInfo* format_info = FormatInfo::Get(xenos::TextureFormat(geometry.format));
+      REXGPU_INFO("[resolve-defer] backoff 0x{:08X} {}x{} {} (materialised by {})",
+                  geometry.dest_base, geometry.width, geometry.height,
+                  format_info ? format_info->name : "?",
+                  by.empty() ? std::string(kDeferTriggerNames[size_t(trigger)]) : by);
+    }
+  }
+}
+
+void D3D12TextureCache::AddDeferredResolveWrite(const ResolveDualWriteTarget& target,
+                                                const DeferredResolveGeometry& geometry,
+                                                uint32_t extent_start, uint32_t extent_length,
+                                                bool verify) {
+  EnsureResolveDeferHook();
+  const uint64_t bytes =
+      uint64_t(geometry.width) * geometry.height * geometry.bytes_per_texel;
+  // Limits: the oldest are made first.
+  while (!deferred_resolve_writes_.empty() &&
+         (deferred_resolve_writes_.size() >= kMaxDeferredResolveWrites ||
+          deferred_resolve_bytes_ + bytes > kMaxDeferredResolveBytes)) {
+    MaterializeDeferredResolveWriteAt(0, DeferTrigger::kCap);
+  }
+  DeferredResolveWrite record;
+  record.serial = ++deferred_resolve_serial_;
+  record.texture = static_cast<D3D12Texture*>(target.texture);
+  record.uav_format = target.uav_format;
+  record.geometry = geometry;
+  record.texture_endian = target.constant_info & 3u;
+  extent_start &= 0x1FFFFFFF;
+  extent_length = std::min(extent_length, uint32_t(SharedMemory::kBufferSize) - extent_start);
+  record.extent_start = extent_start;
+  record.extent_length = extent_length;
+  const uint32_t page_mask = (uint32_t(1) << shared_memory().GetPageSizeLog2()) - 1;
+  record.page_start = extent_start & ~page_mask;
+  record.page_end = uint32_t(std::min((uint64_t(extent_start) + extent_length + page_mask) &
+                                          ~uint64_t(page_mask),
+                                      uint64_t(SharedMemory::kBufferSize)));
+  record.bytes = bytes;
+  record.verify = verify;
+  record.texture->Pin();
+  deferred_resolve_bytes_ += bytes;
+  deferred_resolve_writes_.push_back(record);
+  ++resolve_defer_stats_.deferred;
+  resolve_defer_stats_.deferred_bytes += bytes;
+  UpdateResolveDeferHookActive();
+  // A vertex buffer requested earlier in the frame at these addresses must be requested again.
+  command_processor_.InvalidateVertexBufferResidencyForRange(extent_start, extent_length);
+  if (REXCVAR_GET(resolve_defer_memory_write_poison) && !verify) {
+    // Whatever reads the bytes before they're made reads this.
+    if (DispatchMaterialize(record, true)) {
+      ++resolve_defer_stats_.poisoned;
+    }
+  }
+}
+
+bool D3D12TextureCache::DispatchMaterialize(const DeferredResolveWrite& record, bool poison) {
+  const bool is_64bpp = record.geometry.bytes_per_texel == 8;
+  ID3D12PipelineState* pipeline = GetMaterializePipeline(is_64bpp);
+  if (!pipeline) {
+    return false;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[2];
+  if (!command_processor_.RequestOneUseSingleViewDescriptors(2, descriptors)) {
+    return false;
+  }
+  D3D12Texture& texture = *record.texture;
+  D3D12SharedMemory& d3d12_shared_memory = static_cast<D3D12SharedMemory&>(shared_memory());
+  ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+  // u0: the shared memory as the 16-byte elements the resolves store through.
+  d3d12_shared_memory.WriteUintPow2UAVDescriptor(descriptors[0].first, 4);
+  // u1: the texture, through the view the dual write wrote it with.
+  D3D12_UNORDERED_ACCESS_VIEW_DESC uav_desc;
+  uav_desc.Format = record.uav_format;
+  uav_desc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2DARRAY;
+  uav_desc.Texture2DArray.MipSlice = 0;
+  uav_desc.Texture2DArray.FirstArraySlice = 0;
+  uav_desc.Texture2DArray.ArraySize = 1;
+  uav_desc.Texture2DArray.PlaneSlice = 0;
+  device->CreateUnorderedAccessView(texture.resource(), nullptr, &uav_desc, descriptors[1].first);
+  // This may run in the middle of a draw (the requests of its vertex buffers: the draw has bound
+  // its pipeline and its textures, which are in the state for sampling): what the draw expects of
+  // the texture and the pipeline is left as it was.
+  D3D12_RESOURCE_STATES texture_old_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  if (!poison) {
+    // Read through the view: after whatever wrote it (a resolve, a load) in the same state.
+    texture_old_state = texture.SetResourceState(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    if (texture_old_state == D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
+      command_processor_.PushUAVBarrier(texture.resource());
+    } else {
+      command_processor_.PushTransitionBarrier(texture.resource(), texture_old_state,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    }
+  }
+  d3d12_shared_memory.UseForWriting();
+  command_processor_.SubmitBarriers();
+
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  const D3D12CommandProcessor::PipelineBinding pipeline_binding =
+      command_processor_.GetPipelineBinding();
+  command_processor_.SetExternalPipeline(pipeline);
+  command_list.D3DSetComputeRootSignature(materialize_root_signature_.Get());
+  MaterializeConstants constants = {};
+  constants.dest_base = record.geometry.dest_base;
+  constants.pitch_aligned = record.geometry.pitch_texels;
+  constants.size = record.geometry.width | (record.geometry.height << 16);
+  static_assert(DeferredResolveWrite::kMaxExclusions == kMaxMaterializeExclusions,
+                "The shader takes the exclusions a record has");
+  const uint32_t exclusion_count = poison ? 0 : record.exclusion_count;
+  constants.info = (record.texture_endian & 3u) | (poison ? 4u : 0u) | (exclusion_count << 3);
+  for (uint32_t i = 0; i < exclusion_count; ++i) {
+    const DeferredResolveExclusion& exclusion = record.exclusions[i];
+    constants.exclusions[i][0] = exclusion.base | ((exclusion.tile_shift - 8) << 29);
+    constants.exclusions[i][1] = exclusion.pitch_tiles | (exclusion.tx0 << 10) | (exclusion.tx1 << 20);
+    constants.exclusions[i][2] = exclusion.ty0 | (exclusion.ty1 << 10);
+  }
+  command_list.D3DSetComputeRoot32BitConstants(0, sizeof(constants) / sizeof(uint32_t), &constants,
+                                               0);
+  command_list.D3DSetComputeRootDescriptorTable(1, descriptors[0].second);
+  command_list.D3DSetComputeRootDescriptorTable(2, descriptors[1].second);
+  const uint32_t texels_per_thread = is_64bpp ? 2 : 4;
+  const uint32_t group_count_x =
+      ((record.geometry.width + texels_per_thread - 1) / texels_per_thread + 7) / 8;
+  const uint32_t group_count_y = (record.geometry.height + 7) / 8;
+  command_list.D3DDispatch(group_count_x, group_count_y, 1);
+  command_processor_.RestorePipelineBinding(pipeline_binding);
+  // Order the writes with the next thing that uses the shared memory.
+  d3d12_shared_memory.MarkUAVWritesCommitNeeded();
+  // The texture goes back to the state it was in (unless that was the one it's written in).
+  if (!poison && texture_old_state != D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
+    command_processor_.PushTransitionBarrier(texture.resource(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                                             texture_old_state);
+    texture.SetResourceState(texture_old_state);
+  }
+  // The command list references the texture.
+  texture.MarkAsUsed();
+  return true;
+}
+
+void D3D12TextureCache::RemoveDeferredResolveWriteAt(size_t index) {
+  DeferredResolveWrite& record = deferred_resolve_writes_[index];
+  record.texture->Unpin();
+  deferred_resolve_bytes_ -= std::min(deferred_resolve_bytes_, record.bytes);
+  deferred_resolve_writes_.erase(deferred_resolve_writes_.begin() + std::ptrdiff_t(index));
+  UpdateResolveDeferHookActive();
+}
+
+void D3D12TextureCache::MaterializeDeferredResolveWriteAt(size_t index, DeferTrigger trigger,
+                                                          const std::string& by) {
+  const DeferredResolveWrite record = deferred_resolve_writes_[index];
+  LogResolveDeferOutcome("materialise", record,
+                         by.empty() ? std::string(kDeferTriggerNames[size_t(trigger)]) : by);
+  bool made = false;
+  if (!command_processor_.IsSubmissionOpen()) {
+    REXGPU_ERROR("[resolve-defer] no submission is open to make the memory of the resolve at 0x{:08X}",
+                 record.extent_start);
+  } else if (record.verify && resolve_defer_verifies_.size() < kMaxDeferVerifiesInFlight &&
+             record.extent_length && record.extent_length <= kMaxDeferVerifyBytes) {
+    // The range just before and just after the bytes are made from the texture (the resolve wrote
+    // them for real as well): they must be the same.
+    D3D12SharedMemory& d3d12_shared_memory = static_cast<D3D12SharedMemory&>(shared_memory());
+    const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+    const uint32_t half_size = uint32_t(rex::align(record.extent_length, UINT32_C(256)));
+    D3D12_RESOURCE_DESC readback_desc;
+    ui::d3d12::util::FillBufferResourceDesc(readback_desc, UINT64(half_size) * 2,
+                                            D3D12_RESOURCE_FLAG_NONE);
+    DeferredResolveVerify verify;
+    if (FAILED(provider.GetDevice()->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback, provider.GetHeapFlagCreateNotZeroed(),
+            &readback_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&verify.readback)))) {
+      REXGPU_WARN("[resolve-defer] verify: failed to create the readback buffer");
+      made = DispatchMaterialize(record, false);
+    } else {
+      DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+      d3d12_shared_memory.UseAsCopySource();
+      command_processor_.SubmitBarriers();
+      command_list.D3DCopyBufferRegion(verify.readback.Get(), 0, d3d12_shared_memory.GetBuffer(),
+                                       record.extent_start, record.extent_length);
+      made = DispatchMaterialize(record, false);
+      if (made) {
+        d3d12_shared_memory.UseAsCopySource();
+        command_processor_.SubmitBarriers();
+        command_list.D3DCopyBufferRegion(verify.readback.Get(), half_size,
+                                         d3d12_shared_memory.GetBuffer(), record.extent_start,
+                                         record.extent_length);
+      }
+      // The buffer is referenced by the command list now, made or not.
+      verify.compare = made;
+      verify.submission = command_processor_.GetCurrentSubmission();
+      verify.extent_start = record.extent_start;
+      verify.extent_length = record.extent_length;
+      verify.half_size = half_size;
+      verify.width = record.geometry.width;
+      verify.height = record.geometry.height;
+      verify.bytes_per_texel = record.geometry.bytes_per_texel;
+      resolve_defer_verifies_.push_back(std::move(verify));
+    }
+  } else {
+    made = DispatchMaterialize(record, false);
+  }
+  if (made) {
+    ++resolve_defer_stats_.materialized[size_t(trigger)];
+    // LOCAL PATCH - MCLA (0560): resolve_defer_backoff_frames: the cache clear, the limits and the
+    // dual-write verify (a proof mode) say nothing of whether this destination is worth deferring.
+    if (trigger != DeferTrigger::kCacheClear && trigger != DeferTrigger::kCap &&
+        trigger != DeferTrigger::kDualVerify) {
+      NoteResolveDeferMaterialized(record.geometry, trigger, by);
+    }
+  } else {
+    ++resolve_defer_stats_.materialize_failed;
+    REXGPU_ERROR(
+        "[resolve-defer] the memory of the resolve at 0x{:08X} ({}x{}, {} bytes a texel) could "
+        "not be made from its texture (trigger {}): the bytes there are stale",
+        record.extent_start, record.geometry.width, record.geometry.height,
+        record.geometry.bytes_per_texel, kDeferTriggerNames[size_t(trigger)]);
+  }
+  RemoveDeferredResolveWriteAt(index);
+}
+
+void D3D12TextureCache::MaterializeOverlappingDeferredResolveWrites(
+    const std::pair<uint32_t, uint32_t>* page_ranges, size_t count, DeferTrigger trigger) {
+  for (size_t i = 0; i < deferred_resolve_writes_.size();) {
+    const DeferredResolveWrite& record = deferred_resolve_writes_[i];
+    size_t overlapping_range = SIZE_MAX;
+    // A record a resolve being recorded overwrites, or leaves as it is, stays for it to finish.
+    if (record.pending == DeferredResolveWrite::kPendingNone) {
+      for (size_t r = 0; r < count; ++r) {
+        if (page_ranges[r].first < record.page_end && page_ranges[r].second > record.page_start) {
+          overlapping_range = r;
+          break;
+        }
+      }
+    }
+    if (overlapping_range != SIZE_MAX) {
+      std::string by;
+      // LOCAL PATCH - MCLA (0560): also for the line of a destination entering the backoff.
+      if (resolve_defer_outcomes_logged_.size() < 48 ||
+          ResolveDeferBackoffNeedsLog(record.geometry)) {
+        by = DescribeResolveDeferTrigger(trigger, page_ranges[overlapping_range].first,
+                                         page_ranges[overlapping_range].second);
+        if (trigger == DeferTrigger::kResolve && record.fallback_reason) {
+          by += std::string(" (") + record.fallback_reason + ")";
+        }
+      }
+      // Removes the record at i.
+      MaterializeDeferredResolveWriteAt(i, trigger, by);
+    } else {
+      ++i;
+    }
+  }
+}
+
+void D3D12TextureCache::MaterializeDeferredResolveWrites(uint32_t start, uint32_t length,
+                                                         DeferTrigger trigger) {
+  if (deferred_resolve_writes_.empty() || !length || start >= SharedMemory::kBufferSize) {
+    return;
+  }
+  const uint32_t page_mask = (uint32_t(1) << shared_memory().GetPageSizeLog2()) - 1;
+  const uint64_t end = std::min(uint64_t(start) + length, uint64_t(SharedMemory::kBufferSize));
+  const std::pair<uint32_t, uint32_t> page_range(
+      start & ~page_mask,
+      uint32_t(std::min((end + page_mask) & ~uint64_t(page_mask),
+                        uint64_t(SharedMemory::kBufferSize))));
+  MaterializeOverlappingDeferredResolveWrites(&page_range, 1, trigger);
+}
+
+void D3D12TextureCache::MaterializeAllDeferredResolveWrites(DeferTrigger trigger) {
+  if (!deferred_resolve_writes_.empty() && !command_processor_.IsSubmissionOpen()) {
+    REXGPU_ERROR("[resolve-defer] {} deferred resolve writes are lost: no submission is open",
+                 deferred_resolve_writes_.size());
+    while (!deferred_resolve_writes_.empty()) {
+      RemoveDeferredResolveWriteAt(deferred_resolve_writes_.size() - 1);
+    }
+    return;
+  }
+  while (!deferred_resolve_writes_.empty()) {
+    MaterializeDeferredResolveWriteAt(deferred_resolve_writes_.size() - 1, trigger);
+  }
+}
+
+void D3D12TextureCache::MaterializeDeferredResolveWritesOfTexture(const D3D12Texture& texture,
+                                                                  DeferTrigger trigger) {
+  for (size_t i = 0; i < deferred_resolve_writes_.size();) {
+    if (deferred_resolve_writes_[i].texture == &texture) {
+      MaterializeDeferredResolveWriteAt(i, trigger);
+    } else {
+      ++i;
+    }
+  }
+}
+
+void D3D12TextureCache::ProcessResolveDeferVerifies(uint64_t completed_submission_index) {
+  for (auto it = resolve_defer_verifies_.begin(); it != resolve_defer_verifies_.end();) {
+    DeferredResolveVerify& verify = *it;
+    if (verify.submission > completed_submission_index) {
+      ++it;
+      continue;
+    }
+    void* mapped = nullptr;
+    D3D12_RANGE read_range;
+    read_range.Begin = 0;
+    read_range.End = SIZE_T(verify.half_size) + verify.extent_length;
+    if (verify.compare && SUCCEEDED(verify.readback->Map(0, &read_range, &mapped))) {
+      const uint8_t* before = static_cast<const uint8_t*>(mapped);
+      const uint8_t* after = before + verify.half_size;
+      uint64_t differing_bytes = 0;
+      uint32_t first_offset = 0;
+      if (std::memcmp(before, after, verify.extent_length) != 0) {
+        for (uint32_t i = 0; i < verify.extent_length; ++i) {
+          if (before[i] == after[i]) {
+            continue;
+          }
+          if (!differing_bytes) {
+            first_offset = i;
+          }
+          ++differing_bytes;
+        }
+      }
+      uint8_t first_before = differing_bytes ? before[first_offset] : 0;
+      uint8_t first_after = differing_bytes ? after[first_offset] : 0;
+      D3D12_RANGE written_range = {0, 0};
+      verify.readback->Unmap(0, &written_range);
+      ++resolve_defer_stats_.verified;
+      if (differing_bytes) {
+        ++resolve_defer_stats_.verified_differing;
+        resolve_defer_stats_.verified_differing_bytes += differing_bytes;
+        REXGPU_ERROR(
+            "[resolve-defer] verify {}x{} ({} bytes a texel) at 0x{:08X}: MISMATCH, {} of {} bytes "
+            "differ, first at 0x{:08X}: written by the resolve 0x{:02X}, made from the texture "
+            "0x{:02X}",
+            verify.width, verify.height, verify.bytes_per_texel, verify.extent_start,
+            differing_bytes, verify.extent_length, verify.extent_start + first_offset,
+            uint32_t(first_before), uint32_t(first_after));
+      } else {
+        static uint32_t equal_logged = 0;
+        if (equal_logged < 8) {
+          ++equal_logged;
+          REXGPU_INFO("[resolve-defer] verify {}x{} ({} bytes a texel) at 0x{:08X}: 0 of {} bytes differ",
+                      verify.width, verify.height, verify.bytes_per_texel, verify.extent_start,
+                      verify.extent_length);
+        }
+      }
+    }
+    it = resolve_defer_verifies_.erase(it);
+  }
+}
+
+void D3D12TextureCache::LogResolveDeferIfDue() {
+  const uint64_t now = rex::chrono::Clock::QueryHostUptimeMillis();
+  if (!resolve_defer_last_log_ms_) {
+    resolve_defer_last_log_ms_ = now;
+    return;
+  }
+  if (now - resolve_defer_last_log_ms_ < 10000) {
+    return;
+  }
+  resolve_defer_last_log_ms_ = now;
+  const ResolveDeferStats& stats = resolve_defer_stats_;
+  auto megabytes = [](uint64_t bytes) { return fmt::format("{:.1f} MB", double(bytes) / 1048576.0); };
+  uint32_t materialized_count = 0;
+  std::string triggers;
+  for (size_t i = 0; i < size_t(DeferTrigger::kCount); ++i) {
+    if (!stats.materialized[i]) {
+      continue;
+    }
+    materialized_count += stats.materialized[i];
+    if (!triggers.empty()) {
+      triggers += ", ";
+    }
+    triggers += kDeferTriggerNames[i];
+    triggers += " x";
+    triggers += std::to_string(stats.materialized[i]);
+  }
+  uint32_t ineligible_count = 0;
+  std::string reasons;
+  for (size_t i = 0; i < size_t(DeferIneligible::kCount); ++i) {
+    if (!stats.ineligible[i]) {
+      continue;
+    }
+    ineligible_count += stats.ineligible[i];
+    if (!reasons.empty()) {
+      reasons += ", ";
+    }
+    reasons += kDeferIneligibleNames[i];
+    reasons += " x";
+    reasons += std::to_string(stats.ineligible[i]);
+  }
+  if (stats.deferred || materialized_count || stats.dropped || stats.excluded || stats.kept ||
+      ineligible_count || stats.materialize_failed || !deferred_resolve_writes_.empty()) {
+    REXGPU_INFO(
+        "[resolve-defer] {} deferred ({}), {} materialised ({}), {} dropped ({} never written), "
+        "{} overwritten in part by a resolve and left waiting ({} excluded, {} not touched), "
+        "{} ineligible ({}); {} waiting ({}){}{}",
+        stats.deferred, megabytes(stats.deferred_bytes), materialized_count,
+        triggers.empty() ? "none" : triggers, stats.dropped, megabytes(stats.dropped_bytes),
+        stats.excluded + stats.kept, stats.excluded, stats.kept, ineligible_count,
+        reasons.empty() ? "none" : reasons, deferred_resolve_writes_.size(),
+        megabytes(deferred_resolve_bytes_),
+        stats.poisoned ? ", " + std::to_string(stats.poisoned) + " poisoned" : std::string(),
+        stats.materialize_failed
+            ? ", " + std::to_string(stats.materialize_failed) + " COULD NOT BE MADE"
+            : std::string());
+  }
+  if (stats.verified || stats.verify_skipped) {
+    REXGPU_INFO(
+        "[resolve-defer] verify: {} ranges checked, {} differ ({} bytes), {} not checked (too many "
+        "checks in flight)",
+        stats.verified, stats.verified_differing, stats.verified_differing_bytes,
+        stats.verify_skipped);
+  }
+  resolve_defer_stats_ = ResolveDeferStats();
+}
+
