+    uint32_t partial = 0;
+    uint32_t partial_outdated = 0;
     uint32_t fallbacks[size_t(ResolveDualWriteFallback::kCount)] = {};
     // Textures checked against a load, and how many differed (resolve_dual_write_verify), since the
     // last line.
@@ -717,12 +898,18 @@ class D3D12TextureCache final : public TextureCache {
     uint32_t verified_differing = 0;
     uint64_t verified_differing_bytes = 0;
     uint32_t verify_skipped = 0;
+    // LOCAL PATCH - MCLA (0530): resolve_dual_write_msaa: of the verified, the multisampled and the partial.
+    uint32_t verified_multisampled = 0;
+    uint32_t verified_partial = 0;
   };
   ResolveDualWriteStats resolve_dual_write_stats_;
   // The textures written by a resolve and not used since (they have dual_write_unused()).
   uint32_t resolve_dual_write_unused_count_ = 0;
   uint64_t resolve_dual_write_last_log_ms_ = 0;
   uint32_t resolve_dual_write_verify_counter_ = 0;
+  // LOCAL PATCH - MCLA (0530): resolve_dual_write_msaa: the fallbacks already logged
+  // (LogResolveDualWriteFallback): address, size and reason with format and sample count.
+  std::set<std::array<uint32_t, 3>> resolve_dual_write_fallbacks_logged_;
   // A resolve_dual_write_verify check in flight: the texture and the one loaded the usual way,
   // copied to a readback buffer in the submission that has to complete before they're compared.
   struct ResolveDualWriteVerify {
@@ -739,10 +926,172 @@ class D3D12TextureCache final : public TextureCache {
     uint32_t address;
     uint32_t width;
     uint32_t height;
+    // LOCAL PATCH - MCLA (0530): resolve_dual_write_msaa: the part of the texture compared, in texels (all of
+    // it unless the resolve wrote a part of a texture that wasn't up to date before), and what
