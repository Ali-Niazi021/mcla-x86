+/**
+ * LOCAL PATCH - MCLA (0560): resolve_defer_memory_write (Direct3D 12).
+ *
+ * The deferral of the shared memory write of a dual-written resolve (resolve_dual_write, 0490):
+ * the records (D3D12TextureCache::DeferredResolveWrite), what makes the bytes of one be made
+ * (the hook of SharedMemory::RequestRanges and the other callers of the entry points below), the
+ * compute shader that makes them from the texture (resolve_materialize_{32,64}bpp), the proof
+ * modes (resolve_defer_memory_write_poison, resolve_defer_memory_write_verify) and the log. The
+ * design is in the comment of D3D12TextureCache in texture_cache.h and in the patch's header.
+ */
+
+#include <algorithm>
+#include <cstring>
+#include <string>
+#include <utility>
+
+#include <rex/assert.h>
+#include <rex/chrono/clock.h>
+#include <rex/cvar.h>
+#include <rex/graphics/d3d12/command_processor.h>
+#include <rex/graphics/d3d12/shared_memory.h>
+#include <rex/graphics/d3d12/texture_cache.h>
+#include <rex/graphics/pipeline/texture/info.h>
+#include <rex/logging.h>
+#include <rex/math.h>
+#include <rex/ui/d3d12/d3d12_util.h>
+
+REXCVAR_DEFINE_BOOL(resolve_defer_memory_write, false, "GPU/D3D12",
+                    "With resolve_dual_write: a resolve that wrote its whole texture (colour, "
+                    "no transformation, an area exactly the size of the texture, unscaled) does "
+                    "not write its bytes to the shared memory (its stores go to a null view); the "
+                    "range is marked as resolved as before, and the bytes are made from the "
+                    "texture by a compute shader when anything may use them (any request of the "
+                    "shared memory that touches a page of the range: vertex, index, memexport, "
+                    "texture loads, a resolve that does not overwrite them whole; the copy of a "
+                    "readback resolve; the temporal AA writing the texture; a cache clear), or "
+                    "dropped when a resolve overwrites all of them. The result in the shared "
+                    "memory, and so the picture, is the same as without. Logs [resolve-defer] "
+                    "counts every 10 s")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_BOOL(resolve_defer_memory_write_poison, false, "GPU/D3D12",
+                    "With resolve_defer_memory_write, fills the bytes a deferred resolve would "
+                    "have written with 0xDEADBEEF when it is deferred, so anything that reads "
+                    "them without the bytes being made first shows garbage (the picture must be "
+                    "the same as without resolve_defer_memory_write). A proof mode, not for play")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_INT32(resolve_defer_memory_write_verify, 0, "GPU/D3D12",
+                     "With resolve_defer_memory_write, every Nth deferred resolve writes its "
+                     "memory for real as well, and when its bytes are made from the texture the "
+                     "range of the shared memory is copied back before and after and compared "
+                     "(the bytes must not change: [resolve-defer] verify ... MISMATCH is an "
+                     "error). 0 is off. Only a few checks are in flight at a time and each copies "
+                     "the range twice through the CPU: a validation mode, not for play")
+    .range(0, 100000)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+// LOCAL PATCH - MCLA (0560): adaptive eligibility.
+REXCVAR_DEFINE_INT32(resolve_defer_backoff_frames, 300, "GPU/D3D12",
+                     "With resolve_defer_memory_write: after the bytes of a deferred resolve of a "
+                     "destination (its base, size and format) are made from the texture (by "
+                     "anything but a cache clear, the limits or the dual-write verify), resolves of "
+                     "that destination do not defer their memory write for this many frames (they "
+                     "write it as they do without the deferral: making the bytes costs a pass more "
+                     "than the write it saved). The result is the same, only the choice of what to "
+                     "defer changes. 0 is off. Logs [resolve-defer] backoff once for each "
+                     "destination")
+    .range(0, 100000)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
