new file mode 100644
index 00000000..74d858c4
--- /dev/null
+++ b/src/graphics/shaders/resolve_direct_materialize.xesli
@@ -0,0 +1,149 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2022 Ben Vanik. All rights reserved.                             *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+// LOCAL PATCH - MCLA (0560): resolve_defer_memory_write (Direct3D 12 only).
+//
+// Writes to the shared memory what a direct resolve that was dual-written (resolve_dual_write,
+// 0490) would have stored there, from the host texture the resolve wrote instead: for each texel
+// of the texture, the dwords the resolve's own store put at the tiled address of that texel
+// (resolve_direct_{fast,full}_{32,64}bpp.xesli: XeResolveDestPixelAddress, the same
+// XeTextureTiledOffset2D, the same bytes a texel, the same base and row pitch, the resolve's
+// destination offset being 0). The dual write stored XeEndianSwap32(stored, texture endian) into
+// the texture (resolve_direct.xesli, XeResolveDualStore{4Texels32bpb,2Texels64bpb}) where
+// `stored` is what the resolve stored to the shared memory, and every xenos::Endian swap is its
+// own inverse (byte swaps within 16 or 32 bits, a swap of the 16-bit halves), so
+// stored = XeEndianSwap32(texture dwords, texture endian), bit for bit. It holds for a texture
+// that the resolve wrote with no transformation (colour: kXeResolveDualTransform_None), whole
+// (the area of the resolve is the texture), which the host checks
+// (D3D12TextureCache::CanDeferResolveMemoryWrite).
+//
+// XE_RESOLVE_MATERIALIZE_64BPP: 64 bits a texel (the R16G16B16A16_UINT view of the texture; 2
+// texels, 16 bytes, a thread), otherwise 32 (R32_UINT; 4 texels, 16 bytes, a thread).
+// Constants: xe_materialize_dest_base - the destination base address the resolve adds to its
+// tiled offsets, in bytes (the resolve's xe_resolve_dest_base); xe_materialize_pitch_aligned -
+// the resolve's destination row pitch in texels (a multiple of 32); xe_materialize_size - the
+// texture's width in bits 0:15 and height in bits 16:31, in texels; xe_materialize_info - bits
+// 0:1 the texture's xenos::Endian, bit 2: poison (store 0xDEADBEEF for every dword the texture
+// would write instead, without reading the texture: resolve_defer_memory_write_poison), bits 3:5
+// the number of exclusions (0...4). An exclusion (xe_materialize_exclusions[i], xyz) is the 32x32
+// tiles of a later resolve's area, in the grid of that resolve: x - the base address of the grid
+// (bits 0:28) and log2 of the bytes of a tile minus 8 (bits 29:31); y - the pitch of the grid in
+// tiles (bits 0:9), the touched tile columns [x0, x1) (10:19, 20:29); z - the touched tile rows
+// [y0, y1) (bits 0:9, 10:19). The bytes of a tile of the grid that was written by that resolve
+// are not this resolve's any more (it overwrote them after): a group (16 bytes, always inside a
+// tile of any such grid) at an address in one is not stored.
+//
+// Bindings: u0 - the shared memory as R32G32B32A32_UINT elements (the view the resolves store
+// through), u1 - the texture as a 2D array.
+
+#ifndef XENIA_GPU_SHADERS_RESOLVE_DIRECT_MATERIALIZE_XESLI_
+#define XENIA_GPU_SHADERS_RESOLVE_DIRECT_MATERIALIZE_XESLI_
+
+#include "../../ui/shaders/xesl.xesli"
+
+#if !SHADING_LANGUAGE_HLSL_XE
+  #error The resolve materialization is only implemented for HLSL.
+#endif
+
+#include "endian.xesli"
+#include "texture_address.xesli"
+
+push_const_begin_xe(b0, space0)
+  uint xe_materialize_dest_base;
+  uint xe_materialize_pitch_aligned;
+  uint xe_materialize_size;
+  uint xe_materialize_info;
+  uint4_xe xe_materialize_exclusions[4];
+push_const_end_xe
+
+array_buffer_wo_declare_xe(uint4_xe, xe_materialize_dest, set=1, binding=0, u0,
+                           space0)
+#ifdef XE_RESOLVE_MATERIALIZE_64BPP
+  RWTexture2DArray<uint4_xe> xe_materialize_texture : register(u1, space0);
+  #define XE_MATERIALIZE_BPB_LOG2 3u
+  #define XE_MATERIALIZE_TEXELS_PER_THREAD 2u
+#else
