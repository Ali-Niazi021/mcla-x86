   };
   std::vector<ResolveDualWriteVerify> resolve_dual_write_verifies_;
-  void RecordResolveDualWriteVerify(D3D12Texture& texture);
+  void RecordResolveDualWriteVerify(D3D12Texture& texture, const ResolveDualWriteTarget& target,
