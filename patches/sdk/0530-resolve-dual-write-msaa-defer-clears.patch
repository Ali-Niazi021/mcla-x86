+// The four strips of the render target (width x height host pixels) outside the rectangle, the ones that are not
+// empty; returns how many.
+uint32_t ClearFullOutsideRects(LONG width, LONG height, const D3D12_RECT& rect,
+                               D3D12_RECT* rects_out) {
+  const LONG left = std::min(std::max(rect.left, LONG(0)), width);
+  const LONG top = std::min(std::max(rect.top, LONG(0)), height);
+  const LONG right = std::min(std::max(rect.right, left), width);
+  const LONG bottom = std::min(std::max(rect.bottom, top), height);
+  uint32_t count = 0;
+  if (top > 0) {
+    rects_out[count++] = {0, 0, width, top};
+  }
+  if (bottom < height) {
+    rects_out[count++] = {0, bottom, width, height};
+  }
+  if (left > 0 && bottom > top) {
+    rects_out[count++] = {0, top, left, bottom};
+  }
+  if (right < width && bottom > top) {
+    rects_out[count++] = {right, top, width, bottom};
+  }
+  return count;
