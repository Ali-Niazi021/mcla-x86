+// LOCAL PATCH - MCLA (0560): resolve_defer_memory_write
+void SharedMemory::RunRequestRangesHook(const std::pair<uint32_t, uint32_t>* ranges,
+                                        size_t count) {
+  if (!request_ranges_hook_ || request_ranges_hook_running_) {
+    return;
+  }
+  // The pages an upload for the request can write: the page of the first byte to the page of the
+  // last (and the chunks a widened request uploads, as RequestRanges widens them).
+  const uint32_t request_granularity_log2 =
+      std::min(uint32_t(REXCVAR_GET(shared_memory_request_granularity_log2)), uint32_t(24));
+  const uint32_t page_mask = (uint32_t(1) << page_size_log2_) - 1;
+  const uint32_t chunk_mask =
+      request_granularity_log2 > page_size_log2_ ? (uint32_t(1) << request_granularity_log2) - 1 : 0;
+  const uint32_t align_mask = std::max(page_mask, chunk_mask);
+  request_ranges_hook_ranges_.clear();
+  for (size_t i = 0; i < count; ++i) {
+    const uint32_t start = ranges[i].first;
+    const uint32_t length = ranges[i].second;
+    if (!length || start >= kBufferSize) {
+      continue;
+    }
+    const uint64_t end = std::min(uint64_t(start) + length, uint64_t(kBufferSize));
+    const uint64_t aligned_start = uint64_t(start) & ~uint64_t(align_mask);
+    const uint64_t aligned_end =
+        std::min((end + align_mask) & ~uint64_t(align_mask), uint64_t(kBufferSize));
+    request_ranges_hook_ranges_.emplace_back(uint32_t(aligned_start), uint32_t(aligned_end));
+  }
+  if (request_ranges_hook_ranges_.empty()) {
+    return;
+  }
+  request_ranges_hook_running_ = true;
+  request_ranges_hook_(request_ranges_hook_context_, request_ranges_hook_ranges_.data(),
+                       request_ranges_hook_ranges_.size(), request_kind_);
+  request_ranges_hook_running_ = false;
+}
