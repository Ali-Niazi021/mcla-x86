From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mcla-x86 SDK patch layer
Date: Wed, 25 Nov 2026 00:00:00 +0000
Subject: [PATCH] 0510: gpu_timing: the exported frame time is the GPU's busy time (idle gaps between a frame's lists removed); VRS default table without scene levels

Source: Ours, written for this SDK (stream LOCK60). Validated in game: runs lk-gov2, lk-val1
Licence: GPL-3 (owner's own work, part of mcla-x86); the patched files are ReXGlue SDK code (BSD-3-Clause)
Purpose: At a frame cap the GPU follows the CPU's submissions: the span from a frame's first to last timestamp is about the frame period
  (run lk-gov1: ~16 ms whatever the load; the idle sat inside the scene phase). A timestamp now ends every list in the middle of a
  frame (an idle mark) and starts the next one (resuming the segment); rexgpu_gpu_frame_us and the CSV's frame_us are the span
  minus those gaps (CSV span_us keeps the span); the per-phase times exclude the gaps too. vrs_levels default: the two measured
  levels only (post/composite; + translucent/pre).
Bucket: REDO

0510-gpu-timing-busy.patch (mcla-x86 LOCK60). lk-gov2: busy 11-12 ms at 1080p perf level 0 in normal driving at the 60 cap.

---
diff --git a/include/rex/graphics/d3d12/command_processor.h b/include/rex/graphics/d3d12/command_processor.h
index 4abba001..981d4d2d 100644
--- a/include/rex/graphics/d3d12/command_processor.h
+++ b/include/rex/graphics/d3d12/command_processor.h
@@ -1112,6 +1112,9 @@ class D3D12CommandProcessor : public CommandProcessor {
   void GpuTimingSetSegment(uint32_t id);
   // Adds what was recorded since the last call to the current segment's group.
   void GpuTimingAttribute();
+  // A list in the middle of a timed frame ends (an idle mark) / the next one starts (resumes the current segment).
+  void GpuTimingSubmissionEnd();
+  void GpuTimingSubmissionBegin();
   bool GpuTimingInit();
   void GpuTimingShutdown();
   // Reads the frames whose submissions are done.
@@ -1134,6 +1137,9 @@ class D3D12CommandProcessor : public CommandProcessor {
     static constexpr uint32_t kSlots = 64;  // timestamps per frame (the last one is the frame's end)
     static constexpr uint32_t kGroups = 13;
     static constexpr uint32_t kIdLead = 30, kIdTail = 31, kIdSwap = 32, kIdNone = 33;
+    // Only in Frame::segment: the GPU is idle from this timestamp (the end of a list in the middle of the frame) to the
+    // next one (the start of the next list), which resumes the segment then current. Busy time = span - idle.
+    static constexpr uint32_t kIdIdle = 34;
     struct Frame {
       enum State : uint8_t { kFree, kRecording, kPending };
       State state = kFree;
@@ -1178,6 +1184,7 @@ class D3D12CommandProcessor : public CommandProcessor {
     double us_per_tick = 0.0;
     bool have_last_start = false;
     uint64_t last_start_ticks = 0;
+    bool in_gap = false;  // an idle mark was written at the end of the last list of the open frame
   } gpu_timing_;
   // Statistics, the CSV and the experiment cycle (defined in command_processor.cpp).
   struct GpuTimingReport;
diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 6988aa01..e2ab5a58 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -204,10 +204,10 @@ REXCVAR_DEFINE_INT32(vrs_level, 0, "GPU/VRS",
 
 REXCVAR_DEFINE_STRING(
     vrs_levels,
