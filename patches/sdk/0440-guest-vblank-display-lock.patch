+// LOCAL PATCH - MCLA (0440): the display's vertical blank, for guest_vblank_display_lock.
+// The game window: the largest visible top-level window this process owns (the SDL window).
+HWND FindGameWindow() {
+  struct Search {
+    DWORD process_id;
+    HWND best;
+    LONG best_area;
+  } search = {GetCurrentProcessId(), nullptr, 0};
+  EnumWindows(
+      [](HWND window, LPARAM param) -> BOOL {
+        auto* s = reinterpret_cast<Search*>(param);
+        DWORD process_id = 0;
+        GetWindowThreadProcessId(window, &process_id);
+        RECT rect;
+        if (process_id != s->process_id || !IsWindowVisible(window) || IsIconic(window) ||
+            GetWindow(window, GW_OWNER) != nullptr || !GetWindowRect(window, &rect)) {
+          return TRUE;
+        }
+        const LONG area = (rect.right - rect.left) * (rect.bottom - rect.top);
+        if (area > s->best_area) {
+          s->best_area = area;
+          s->best = window;
+        }
+        return TRUE;
+      },
+      reinterpret_cast<LPARAM>(&search));
+  return search.best;
+}
+
+// IDXGIOutput::WaitForVBlank has no time-out, so it runs on a thread of its own: a display that turns off must not
+// stop the guest's vblank. The thread publishes the QPC time at which it woke for each vblank; the vblank thread reads
+// them and fits a line. The thread ends at its next vblank after `stop`, or when the output fails.
+struct DisplayVblankState {
+  static constexpr uint64_t kRing = 256;
+  std::atomic<uint64_t> count{0};  // vblanks seen; vblank j (1-based) is stamps[j % kRing]
+  std::array<std::atomic<int64_t>, kRing> stamps{};
+  std::atomic<bool> stop{false};
+  std::atomic<bool> failed{false};
+};
+
+void DisplayVblankThread(std::shared_ptr<DisplayVblankState> state, HMONITOR monitor) {
+  SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+  SetThreadDescription(GetCurrentThread(), L"GPU Display VBlank");
+  Microsoft::WRL::ComPtr<IDXGIOutput> output;
+  Microsoft::WRL::ComPtr<IDXGIFactory1> factory;
+  if (SUCCEEDED(CreateDXGIFactory1(IID_PPV_ARGS(&factory)))) {
+    Microsoft::WRL::ComPtr<IDXGIAdapter> adapter;
+    for (UINT a = 0; !output && SUCCEEDED(factory->EnumAdapters(a, adapter.ReleaseAndGetAddressOf())); ++a) {
+      Microsoft::WRL::ComPtr<IDXGIOutput> candidate;
+      for (UINT o = 0; SUCCEEDED(adapter->EnumOutputs(o, candidate.ReleaseAndGetAddressOf())); ++o) {
+        DXGI_OUTPUT_DESC desc;
+        if (SUCCEEDED(candidate->GetDesc(&desc)) && desc.Monitor == monitor) {
+          output = candidate;
+          break;
+        }
+      }
+    }
+  }
+  if (!output) {
+    state->failed.store(true, std::memory_order_release);
+    return;
+  }
+  while (!state->stop.load(std::memory_order_relaxed)) {
+    if (FAILED(output->WaitForVBlank())) {
+      state->failed.store(true, std::memory_order_release);
+      return;
+    }
+    const int64_t t = QpcNow();
+    const uint64_t j = state->count.load(std::memory_order_relaxed) + 1;
+    state->stamps[j % DisplayVblankState::kRing].store(t, std::memory_order_relaxed);
+    state->count.store(j, std::memory_order_release);
+  }
+}
