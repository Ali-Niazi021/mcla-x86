  private:
+  // The display's vblanks (guest_vblank_display_lock): a least-squares line through the last kFitTicks of the stamps the
+  // helper thread published, time(j) = fit_t_ + (j - fit_j_) * fit_period_ for the display's vblank number j. Noise in
+  // one stamp (the thread's wake-up, sd 0.15 ms measured) averages out; the guest's vblank is timed by the QPC timer
+  // and spin from this line, so it keeps the grid's precision and takes the display's phase and rate.
+  struct Tick {
+    int64_t j;
+    int64_t t;
+  };
+  static constexpr size_t kFitTicks = 128;
+
+  void ClearFit() {
+    tick_count_ = 0;
+    tick_head_ = 0;
+    rejected_ticks_ = 0;
+    fit_valid_ = false;
+  }
+
+  void UpdateFit() {
+    fit_valid_ = false;
+    if (tick_count_ < 48) {
+      return;
+    }
+    const Tick first = ticks_[tick_head_];
+    const Tick last = ticks_[(tick_head_ + tick_count_ - 1) % kFitTicks];
+    if (last.j - first.j < 40) {
+      return;
+    }
+    const double n = double(tick_count_);
+    double sx = 0, sy = 0, sxx = 0, sxy = 0;
+    for (size_t i = 0; i < tick_count_; ++i) {
+      const Tick& s = ticks_[(tick_head_ + i) % kFitTicks];
+      const double x = double(s.j - first.j), y = double(s.t - first.t);
+      sx += x;
+      sy += y;
+      sxx += x * x;
+      sxy += x * y;
+    }
+    const double det = n * sxx - sx * sx;
+    if (det <= 0.0) {
+      return;
+    }
+    const double slope = (n * sxy - sx * sy) / det;
+    const double intercept = (sy - slope * sx) / n;
+    double squares = 0;
+    for (size_t i = 0; i < tick_count_; ++i) {
+      const Tick& s = ticks_[(tick_head_ + i) % kFitTicks];
+      const double r = double(s.t - first.t) - (intercept + slope * double(s.j - first.j));
+      squares += r * r;
+    }
+    const double ms = double(qpc_hz_) / 1000.0;
+    // A period of 1.5-50 ms (20-666 Hz) and an rms scatter under 1 ms, else it is not a display's vblank.
+    if (slope < 1.5 * ms || slope > 50.0 * ms || std::sqrt(squares / n) > ms) {
+      return;
+    }
+    fit_j_ = first.j;
+    fit_t_ = double(first.t) + intercept;
+    fit_period_ = slope;
+    fit_valid_ = true;
+  }
+
+  // One more vblank of the display. A stamp more than 2 ms off the line is a late wake-up and is left out; nine in a row
+  // mean the display's timing changed, and the line is started again.
+  void AcceptTick(int64_t j, int64_t t) {
+    last_tick_t_ = t;
+    if (fit_valid_) {
+      const double predicted = fit_t_ + double(j - fit_j_) * fit_period_;
+      if (std::fabs(double(t) - predicted) > double(qpc_hz_) / 500.0) {
+        if (++rejected_ticks_ > 8) {
+          ClearFit();
+        }
+        return;
+      }
+      rejected_ticks_ = 0;
+    }
+    ticks_[(tick_head_ + tick_count_) % kFitTicks] = Tick{j, t};
+    if (tick_count_ < kFitTicks) {
+      ++tick_count_;
+    } else {
+      tick_head_ = (tick_head_ + 1) % kFitTicks;
+    }
+    UpdateFit();
+  }
+
+  int64_t DisplayTickTime(int64_t j) const {
+    return int64_t(std::llround(fit_t_ + double(j - fit_j_) * fit_period_));
+  }
+
+  int64_t NearestDisplayTick(int64_t t) const {
+    return fit_j_ + int64_t(std::llround((double(t) - fit_t_) / fit_period_));
+  }
+
+  void StopDisplay() {
+    if (display_) {
+      display_->stop.store(true, std::memory_order_relaxed);  // the thread ends at its next vblank
+      display_.reset();
+    }
+    display_monitor_ = nullptr;
+    ClearFit();
+    if (locked_) {
+      UnlockDisplay("the display source was released");
+    }
+  }
+
+  void LockDisplay(uint32_t k, int64_t now) {
+    if (!locked_) {
+      BreakPeriod();
+    }
+    locked_ = true;
+    k_ = k;
+    bad_evaluations_ = 0;
+    lock_tick_ = NearestDisplayTick(last_wait_return_ != 0 ? last_wait_return_ : now);
+    REXGPU_INFO(
+        "[guest-vblank] display lock on: output {:.4f} Hz ({:.5f} ms a vblank), the guest's vblank every {} of them = "
+        "{:.4f} Hz (asked for {:.3f} Hz), {} us after the display's",
+        double(qpc_hz_) / fit_period_, 1e3 * fit_period_ / double(qpc_hz_), k, double(qpc_hz_) / (double(k) * fit_period_),
+        double(qpc_hz_) / period_ticks_, REXCVAR_GET(guest_vblank_display_offset_us));
+  }
+
+  void UnlockDisplay(const char* why) {
+    locked_ = false;
+    bad_evaluations_ = 0;
+    origin_ = last_wait_return_ != 0 ? last_wait_return_ : QpcNow();
+    index_ = 1;
+    BreakPeriod();
+    REXGPU_INFO("[guest-vblank] display lock off ({}): back on the QPC grid", why);
+  }
+
+  // Each vblank: the display source (window -> monitor -> a helper thread on its output), its newest vblanks, and
+  // whether the grid may follow it. Fallbacks to the QPC grid: the display's refresh is no k x the guest's within 0.5 %,
+  // it stops delivering vblanks, WaitForVBlank fails, or the cvar is off.
+  void UpdateDisplayLock(int64_t now) {
+    if (!REXCVAR_GET(guest_vblank_display_lock)) {
+      if (display_ || locked_) {
+        StopDisplay();
+      }
+      return;
+    }
+    if (now >= display_next_look_) {
+      display_next_look_ = now + 2 * qpc_hz_;
+      HWND window = FindGameWindow();
+      HMONITOR monitor = window ? MonitorFromWindow(window, MONITOR_DEFAULTTONULL) : nullptr;
+      if (display_ && monitor != display_monitor_) {
+        StopDisplay();  // the window moved to another display (or is gone): start over there
+      }
+      if (!display_ && monitor) {
+        display_ = std::make_shared<DisplayVblankState>();
+        display_monitor_ = monitor;
+        display_consumed_ = 0;
+        try {
+          std::thread(DisplayVblankThread, display_, monitor).detach();
+        } catch (...) {
+          display_->failed.store(true, std::memory_order_release);
+        }
+      }
+    }
+    if (!display_) {
+      return;
+    }
+    if (display_->failed.load(std::memory_order_acquire)) {
+      REXGPU_WARN(
+          "[guest-vblank] the display's vblank can't be waited for (no DXGI output for the game window's monitor, or "
+          "WaitForVBlank failed): the QPC grid stays, next try in 5 s");
+      StopDisplay();
+      display_next_look_ = now + 5 * qpc_hz_;
+      return;
+    }
+    const int64_t count = int64_t(display_->count.load(std::memory_order_acquire));
+    if (count - display_consumed_ > 200) {  // this thread was away for long: the oldest stamps are gone
+      display_consumed_ = count - 100;
+      ClearFit();
+    }
+    while (display_consumed_ < count) {
+      ++display_consumed_;
+      AcceptTick(display_consumed_,
+                 display_->stamps[uint64_t(display_consumed_) % DisplayVblankState::kRing].load(
+                     std::memory_order_relaxed));
+    }
+    bool ok = false;
+    bool stale = false;
+    uint32_t k = 0;
+    const char* why = "no usable display vblanks yet";
+    if (fit_valid_) {
+      if (now - last_tick_t_ > int64_t(4.0 * fit_period_) + qpc_hz_ / 20) {
+        stale = true;
+        why = "the display stopped delivering vblanks";
+      } else {
+        const double kd = std::round(period_ticks_ / fit_period_);
+        if (kd >= 1.0 && kd <= 16.0 && std::fabs(kd * fit_period_ - period_ticks_) <= 0.005 * period_ticks_) {
+          ok = true;
+          k = uint32_t(kd);
+        } else {
+          why = "the display's refresh rate is not an integer multiple of the guest's (within 0.5 %)";
+          if (!locked_ && !mismatch_logged_) {
+            mismatch_logged_ = true;
+            REXGPU_INFO(
+                "[guest-vblank] display lock not used: the display refreshes at {:.4f} Hz, not an integer multiple of "
+                "the guest's {:.3f} Hz within 0.5 %: the QPC grid stays",
+                double(qpc_hz_) / fit_period_, double(qpc_hz_) / period_ticks_);
+          }
+        }
+      }
+    }
+    if (ok) {
+      bad_evaluations_ = 0;
