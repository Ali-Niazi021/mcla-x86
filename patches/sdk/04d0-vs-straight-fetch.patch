+void DxbcShaderTranslator::ApplyVertexShaderOptimizations(Modification& modification,
+                                                          const Shader& shader,
+                                                          bool shared_memory_is_uav) {
+  assert_true(shader.type() == xenos::ShaderType::kVertex);
+  assert_true(shader.is_ucode_analyzed());
+  bool straight_fetch = REXCVAR_GET(dxbc_vs_straight_fetch);
+  modification.vertex.vs_straight_fetch = uint32_t(straight_fetch);
+  // Only a shader that fetches vertices has a binding to choose.
+  modification.vertex.shared_memory_is_uav =
+      uint32_t(straight_fetch && shared_memory_is_uav && !shader.vertex_bindings().empty());
+}
+
+void DxbcShaderTranslator::EmitStraightEndianSwap(dxbc::Assembler& a, const dxbc::Src& endian_src,
+                                                  const dxbc::Dest& value_dest,
+                                                  const dxbc::Src& value_src,
+                                                  const dxbc::Dest& swap_temp_dest,
+                                                  const dxbc::Src& swap_temp_src,
+                                                  uint32_t aux_temp, uint32_t cond_temp) {
+  // The aux register mirrors the value: the same components, read the same way.
+  dxbc::Dest aux_dest(dxbc::Dest::R(aux_temp, value_dest.GetMask()));
+  dxbc::Src aux_src(dxbc::Src::R(aux_temp, value_src.swizzle_));
+  // Whether to swap the bytes in 16 bits: for 8-in-16 (1) and 8-in-32 (2), x = (endian + 1) & 2.
+  a.OpIAdd(dxbc::Dest::R(cond_temp, 0b0001), endian_src, dxbc::Src::LU(1));
+  a.OpAnd(dxbc::Dest::R(cond_temp, 0b0001), dxbc::Src::R(cond_temp, dxbc::Src::kXXXX),
+          dxbc::Src::LU(2));
+  // Whether to rotate by 16 bits: for 8-in-32 (2) and 16-in-32 (3), y = endian & 2.
+  a.OpAnd(dxbc::Dest::R(cond_temp, 0b0010), endian_src, dxbc::Src::LU(2));
+  // The bytes swapped in each 16 bits: temp = (x << 8) & 0xFF00FF00 | (x >> 8) & 0x00FF00FF (aux is the second part).
+  a.OpIShL(swap_temp_dest, value_src, dxbc::Src::LU(8));
+  a.OpAnd(swap_temp_dest, swap_temp_src, dxbc::Src::LU(0xFF00FF00));
+  a.OpUShR(aux_dest, value_src, dxbc::Src::LU(8));
+  a.OpAnd(aux_dest, aux_src, dxbc::Src::LU(0x00FF00FF));
+  a.OpOr(swap_temp_dest, swap_temp_src, aux_src);
+  a.OpMovC(value_dest, dxbc::Src::R(cond_temp, dxbc::Src::kXXXX), swap_temp_src, value_src);
+  // Temp = ZW00, value = ZWXY.
+  a.OpUShR(swap_temp_dest, value_src, dxbc::Src::LU(16));
+  a.OpBFI(swap_temp_dest, dxbc::Src::LU(16), dxbc::Src::LU(16), value_src, swap_temp_src);
+  a.OpMovC(value_dest, dxbc::Src::R(cond_temp, dxbc::Src::kYYYY), swap_temp_src, value_src);
+}
