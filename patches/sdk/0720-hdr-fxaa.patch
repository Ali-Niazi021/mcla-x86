+REXCVAR_DEFINE_BOOL(hdr_fxaa, true, "GPU",
+                    "HDR output (Direct3D 12): swap_post_effect = fxaa or fxaa_extreme works on the HDR10 "
+                    "image too: the swap's refresher writes the PQ code values and their luma to the FXAA "
