@@ -2973,13 +2976,14 @@ void D3D12CommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbu
                             frontbuffer_format != xenos::TextureFormat::k_2_10_10_10_AS_16_16_16_16;
