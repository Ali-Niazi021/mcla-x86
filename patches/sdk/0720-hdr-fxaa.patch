+// image, hdr_fxaa; Vulkan skips it while HDR is active).
 void CommandProcessor::RefreshSwapPostEffectFromCvar() {
   const std::string& name = REXCVAR_GET(swap_post_effect);
   if (name == swap_post_effect_cvar_seen_) {
