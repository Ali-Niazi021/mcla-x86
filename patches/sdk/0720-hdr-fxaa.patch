   Microsoft::WRL::ComPtr<ID3D12PipelineState> fxaa_extreme_pipeline_;
+  // FXAA on the HDR10 image (hdr_fxaa; IssueSwap): what was last said about it in the log (the effect and whether
+  // it ran; why not, if it was chosen and didn't), so that it is said once for every change. UINT32_MAX: nothing yet
+  // (or HDR output was off since).
+  uint32_t hdr_fxaa_noted_key_ = UINT32_MAX;
+  const char* hdr_fxaa_noted_why_not_ = nullptr;
+  uint64_t hdr_fxaa_note_last_ms_ = 0;
 
   struct ResolveDownscaleConstants {
     uint32_t scale_x;
