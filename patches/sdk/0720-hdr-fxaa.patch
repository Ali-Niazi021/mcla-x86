+        // FXAA on the HDR10 image (hdr_fxaa): the refresher writes the code values and their luma to the FXAA source
+        // image (flag bit 16), and the FXAA pass after it writes the guest output image, as in SDR. Not with frame
+        // generation (its refresher has no such output and its compose writes the guest output itself), and not
+        // with the debug views and the test pattern, which are for measuring the code values as they are.
+        if (use_hdr) {
+          const bool hdr_fxaa_selected = hdr_post_effect == SwapPostEffect::kFxaa ||
+                                         hdr_post_effect == SwapPostEffect::kFxaaExtreme;
+          const char* hdr_fxaa_why_not = nullptr;
+          if (hdr_fxaa_selected) {
+            if (!REXCVAR_GET(hdr_fxaa)) {
+              hdr_fxaa_why_not = "hdr_fxaa is off";
+            } else if (use_frame_generation) {
+              hdr_fxaa_why_not = "frame generation is on";
+            } else if (hdr_state.debug_ui || hdr_state.test_pattern) {
+              hdr_fxaa_why_not = "a debug view or the test pattern is on";
+            } else if (!fxaa_root_signature_ || !fxaa_pipeline_ || !fxaa_extreme_pipeline_) {
+              hdr_fxaa_why_not = "the FXAA passes aren't available";
+            } else if (!ensure_fxaa_source_texture()) {
+              hdr_fxaa_why_not = "the FXAA source image couldn't be created";
+            }
+            if (!hdr_fxaa_why_not) {
+              swap_post_effect = hdr_post_effect;
+              use_fxaa = true;
+            }
+          }
+          // Said once for every change (a state that flips from frame to frame, such as frame generation
+          // on a frame without a scene, at most once a second).
+          const uint32_t hdr_fxaa_key = uint32_t(hdr_post_effect) | (use_fxaa ? 0x100u : 0u);
+          const uint64_t hdr_fxaa_now_ms = rex::chrono::Clock::QueryHostUptimeMillis();
+          if ((hdr_fxaa_key != hdr_fxaa_noted_key_ || hdr_fxaa_why_not != hdr_fxaa_noted_why_not_) &&
+              (hdr_fxaa_noted_key_ == UINT32_MAX || hdr_fxaa_now_ms - hdr_fxaa_note_last_ms_ >= 1000)) {
+            hdr_fxaa_noted_key_ = hdr_fxaa_key;
+            hdr_fxaa_noted_why_not_ = hdr_fxaa_why_not;
+            hdr_fxaa_note_last_ms_ = hdr_fxaa_now_ms;
+            const char* hdr_fxaa_name = hdr_post_effect == SwapPostEffect::kFxaa ? "fxaa"
+                                        : hdr_post_effect == SwapPostEffect::kFxaaExtreme
+                                            ? "fxaa_extreme"
+                                            : "none";
+            if (use_fxaa) {
+              REXGPU_INFO("HDR: FXAA on the HDR10 image (swap_post_effect={})", hdr_fxaa_name);
+            } else if (hdr_fxaa_why_not) {
+              REXGPU_INFO("HDR: FXAA off on the HDR10 image (swap_post_effect={}: {})", hdr_fxaa_name,
+                          hdr_fxaa_why_not);
+            } else {
+              REXGPU_INFO("HDR: FXAA off on the HDR10 image (swap_post_effect={})", hdr_fxaa_name);
+            }
+          }
+        } else {
+          // Said again when HDR output comes back.
+          hdr_fxaa_noted_key_ = UINT32_MAX;
+          hdr_fxaa_noted_why_not_ = nullptr;
+        }
+
         // hdr_scene_fused: the refresher makes the scene from the tone map draw's inputs, if the frame is put
         // together from the front buffer and the underlay (the difference mask, or a frame without UI), and the
         // textures the draw read are still what it read. Otherwise the frame has no HDR scene (the old pass
@@ -3349,6 +3410,11 @@ void D3D12CommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbu
           HdrRefreshFlags(composite, hdr_state.debug_ui, hdr_refresh_constants.flags);
           hdr_refresh_constants.flags[0] |=
               uint32_t(hdr_state.sdr_pure_gamma_2_2) | (uint32_t(hdr_state.test_pattern) << 1);
+          if (use_fxaa) {
+            // FXAA on the HDR10 image: the destination (apply_gamma_dest, below) is the FXAA source image, and
+            // alpha is the code values' luma (never with frame generation: use_fxaa is off then).
+            hdr_refresh_constants.flags[0] |= 1u << 16;
+          }
           if (use_frame_generation) {
             // The compose of the generated frame: the same, its scene from the
             // generated code values (bit 12).
