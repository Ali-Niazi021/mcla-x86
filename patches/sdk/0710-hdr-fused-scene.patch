+bool CommandProcessor::HdrRefresherReadsFrontBuffer(HdrComposite composite,
+                                                    uint32_t debug_ui) const {
+  // As HdrRefreshFlags sets the flags and hdr_refresh.cs.xesl reads xe_hdr_refresh_source:
+  // the debug view that shows the front buffer (hdr_debug_ui 6) and the game's own frame
+  // (2) read it; the other debug views read the UI layer, the underlay or the other
+  // textures; of the composites only the UI layer's (2) doesn't read it.
+  if (debug_ui >= 3 && debug_ui <= 6) {
+    return debug_ui == 6;
+  }
+  if (debug_ui == 2) {
+    return true;
+  }
+  return composite != HdrComposite::kLayer;
+}
