   // The refresher's flags (hdr_refresh.cs.xesl), bits 3:10 and the glows' gain,
   // for a composite and the hdr_debug_ui view.
   void HdrRefreshFlags(HdrComposite composite, uint32_t debug_ui, uint32_t flags_out[2]) const;
@@ -606,6 +658,13 @@ class CommandProcessor {
   uint32_t HdrColorTargetKey(uint32_t rt_index) const;
   bool HdrBeforeDraw();
   void HdrBeforeResolve();
