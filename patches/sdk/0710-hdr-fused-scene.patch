+bool D3D12TextureCache::CaptureActiveTexture(
+    const D3D12Shader::TextureBinding& host_shader_binding, HdrTextureCapture& capture_out,
+    const char*& why_not_out) {
+  // LOCAL PATCH - MCLA (hdr_scene_fused). The texture and the view are the ones
+  // WriteActiveTextureBindfulSRV / GetActiveTextureBindlessSRVIndex hand to the draw (UpdateTextureBindingsImpl
+  // makes the descriptor with FindOrCreateTextureDescriptor for the binding's own dimension, the host swizzle
+  // and the signedness the shader binding asks for), for a plain 2D texture.
+  const TextureBinding* binding = GetValidTextureBinding(host_shader_binding.fetch_constant);
+  if (!binding) {
+    why_not_out = "no texture is bound";
+    return false;
+  }
+  if (!AreDimensionsCompatible(host_shader_binding.dimension, binding->key.dimension) ||
+      binding->key.dimension != xenos::DataDimension::k2DOrStacked ||
+      host_shader_binding.dimension != xenos::FetchOpDimension::k2D) {
+    why_not_out = "the binding isn't a plain 2D texture";
+    return false;
+  }
+  const bool is_signed = host_shader_binding.is_signed;
+  Texture* texture;
+  if (is_signed) {
+    if (!texture_util::IsAnySignSigned(binding->swizzled_signs)) {
+      why_not_out = "the fetch isn't signed as the shader asks";
+      return false;
+    }
+    texture = IsSignedVersionSeparateForFormat(binding->key) ? binding->texture_signed
+                                                             : binding->texture;
+  } else {
+    if (!texture_util::IsAnySignNotSigned(binding->swizzled_signs)) {
+      why_not_out = "the fetch isn't unsigned as the shader asks";
+      return false;
+    }
+    texture = binding->texture;
+  }
+  if (!texture) {
+    why_not_out = "the texture isn't there";
+    return false;
+  }
+  D3D12Texture* d3d12_texture = static_cast<D3D12Texture*>(texture);
+  const TextureKey texture_key = d3d12_texture->key();
+  if (IsSignedVersionSeparateForFormat(texture_key) &&
+      texture_key.signed_separate != uint32_t(is_signed)) {
+    why_not_out = "not the version with the needed signedness";
+    return false;
+  }
+  D3D12_SHADER_RESOURCE_VIEW_DESC desc = {};
+  desc.Format = is_signed ? host_formats_[uint32_t(texture_key.format)].dxgi_format_signed
+                          : GetDXGIUnormFormat(texture_key);
+  if (desc.Format == DXGI_FORMAT_UNKNOWN || texture_key.dimension == xenos::DataDimension::k3D) {
+    why_not_out = "the format has no view";
+    return false;
+  }
+  desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DARRAY;
+  desc.Shader4ComponentMapping =
+      binding->host_swizzle | D3D12_SHADER_COMPONENT_MAPPING_ALWAYS_SET_BIT_AVOIDING_ZEROMEM_MISTAKES;
+  desc.Texture2DArray.MostDetailedMip = 0;
+  desc.Texture2DArray.MipLevels = texture_key.mip_max_level + 1;
+  desc.Texture2DArray.FirstArraySlice = 0;
+  desc.Texture2DArray.ArraySize = texture_key.GetDepthOrArraySize();
+  desc.Texture2DArray.PlaneSlice = 0;
+  desc.Texture2DArray.ResourceMinLODClamp = 0.0f;
+  capture_out.resource = d3d12_texture->resource();
+  capture_out.srv_desc = desc;
+  capture_out.key = texture_key;
+  capture_out.texture = d3d12_texture;
+  capture_out.content_serial = d3d12_texture->content_serial();
+  capture_out.format = texture_key.format;
+  capture_out.width = texture_key.GetWidth();
+  capture_out.height = texture_key.GetHeight();
+  return true;
+}
+
+bool D3D12TextureCache::UseCapturedTexture(const HdrTextureCapture& capture) {
+  // LOCAL PATCH - MCLA (hdr_scene_fused).
+  Texture* texture = FindTexture(capture.key);
+  if (!texture || texture != capture.texture) {
+    return false;
+  }
+  D3D12Texture* d3d12_texture = static_cast<D3D12Texture*>(texture);
+  if (d3d12_texture->resource() != capture.resource.Get() ||
+      d3d12_texture->content_serial() != capture.content_serial) {
+    return false;
+  }
+  // Referenced by the command list, so not destroyed before it's done.
+  d3d12_texture->MarkAsUsed();
+  constexpr D3D12_RESOURCE_STATES kSrvState = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE |
+                                              D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+  command_processor_.PushTransitionBarrier(d3d12_texture->resource(),
+                                           d3d12_texture->SetResourceState(kSrvState), kSrvState);
+  return true;
+}
