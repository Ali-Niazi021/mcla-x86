+
+void CommandProcessor::HdrMaterializeUnderlay() {
+  if (!hdr_frame_.underlay_is_rt) {
+    return;
+  }
+  hdr_frame_.underlay_is_rt = false;
+  // What the skipped copy would have made, before kHdrTextureUnderlayRt changes.
+  if (!HdrCopyTexture(kHdrTextureUnderlayRt, kHdrTextureUnderlay,
+                      {0, 0, hdr_output_width_, hdr_output_height_}, 0, 0)) {
+    // As if the copy at the resolve had failed: that area isn't captured.
+    uint64_t area = uint64_t(hdr_output_width_) * hdr_output_height_;
+    hdr_frame_.captured_area -= std::min(hdr_frame_.captured_area, area);
+  }
+}
