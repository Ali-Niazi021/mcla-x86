+// HDR output (rexglue-hdr-scene-mcla.patch, hdr_scene_fused): Midnight Club: Los
+// Angeles's tone map (guest pixel shader E5EBEFAE4D165CBA) again, from the same
+// textures and constants, with the scene in the game's linear units (its output
+// before the 1/2.2 encode, 1 = its white). The math lives here once, for the two
+// places that run it, so that they can't drift apart:
+// - hdr_scene_mcla.cs.xesl: a compute pass after the tone map draw that writes
+//   the scene to an FP16 image;
+// - hdr_refresh.cs.xesl, XE_HDR_REFRESH_FUSED (hdr_scene_fused): the swap's
+//   refresher runs it per pixel, from the textures the tone map draw read.
+// Up to the knee the curve is the game's (Reinhard extended on luminance,
+// chromaticity kept through xy); above it an exponential shoulder with the same
+// value there approaches the peak, never under the game's curve up to its white
+// (with a peak at or below the game's white, the game's curve clipped at its
+// white). Bloom, saturation, colour balance and contrast follow in the game's
+// order, so the grade is the game's. Mode 1 (size_mode.z) is the game's curve
+// alone, for checking the pass against the game's own output. NaN (from a guest
+// texture or constant) doesn't reach the output.
+//
+// With XE_HDR_SCENE_GAME_OUTPUT defined before the include, XeHdrSceneColor also
+// gives the game's own result (its curve, its bloom weight 1: what the tone map
+// draw writes before its 8-bit encode), which the fused refresher encodes and
+// quantises to the 8-bit picture the draw made.
+//
+// Include after xesl.xesli. The constants (the HdrSceneConstants of the command
+// processor) are passed in by the including shader.
+
+#ifndef XE_HDR_SCENE_MCLA_XESLI_
+#define XE_HDR_SCENE_MCLA_XESLI_
+
+// The texture caches bind 2D textures as 2D arrays (layer 0 here).
+#if SHADING_LANGUAGE_GLSL_XE
+  #define XeHdrSceneTexture texture2DArray
+  #define XeHdrSceneFetch(texture_name, position) \
+      texelFetch(texture_name, int3_xe(position, 0), 0)
+#else
+  #define XeHdrSceneTexture Texture2DArray<float4_xe>
+  #define XeHdrSceneFetch(texture_name, position) \
+      ((texture_name).Load(int4_xe(position, 0, 0)))
+#endif
+
+// Not NaN, by the bits (a compiler may fold x == x).
+#define XeHdrSceneNotNan(value) ((float_bits_to_uint_xe(value) & 0x7FFFFFFFu) <= 0x7F800000u)
+
+// Back to RGB through x and y from the curve's output ld, then bloom after the
+// curve, saturation around Rec.709 luma, colour balance and contrast; not NaN,
+// and in FP16's range.
+float3_xe XeHdrSceneGrade(float ld, float chroma_x, float chroma_y_guarded, float3_xe bloom,
+                          float bloom_gain, float4_xe grade, float3_xe balance_color) {
+  float3_xe xyz = float3_xe(ld * chroma_x / chroma_y_guarded, ld,
+                            ld * (1.0f - chroma_x - chroma_y_guarded) / chroma_y_guarded);
+  float3_xe rgb = float3_xe(dot(xyz, float3_xe(2.5651f, -1.1665f, -0.3986f)),
+                            dot(xyz, float3_xe(-1.0217f, 1.9777f, 0.0439f)),
+                            dot(xyz, float3_xe(0.0753f, -0.2543f, 1.1892f)));
+
+  rgb += bloom * bloom_gain;
+  float luma = dot(rgb, float3_xe(0.2125f, 0.7154f, 0.0721f));
+  rgb = (rgb - luma) * grade.z + luma;
+  rgb = (2.0f * rgb * balance_color - 0.5f) * grade.w + 0.5f;
+
+  // Not NaN, and in FP16's range.
+  rgb = float3_xe(XeHdrSceneNotNan(rgb.r) ? rgb.r : 0.0f, XeHdrSceneNotNan(rgb.g) ? rgb.g : 0.0f,
+                  XeHdrSceneNotNan(rgb.b) ? rgb.b : 0.0f);
+  return clamp(rgb, float3_xe(0.0f, 0.0f, 0.0f), float3_xe(65504.0f, 65504.0f, 65504.0f));
+}
+
+// The scene at an output pixel, in the game's linear units. size_mode: x, y the
+// output's size, z 1 = the game's curve, no shoulder; pixel_offset.xy the
+// half-pixel offset of the game's draw, in pixels; curve: key (c64.z), white
+// squared (c65.x), epsilon (c255.w), blur weight scale (c252.w); grade: adapted
+// luminance clamp (vertex shader c64.x, c65.x), saturation (c67.x), contrast
+// (c69.x); balance: colour balance (c68.xyz), bloom gain; shoulder: knee (the
+// game's linear units), Ls at the knee, the shoulder's slope there (the
+// highlights setting, and at least what reaches the game's white at its white),
+// peak - knee (at most 1 - knee: no shoulder).
+// The game's fetches 0 (the scene, 16_16_16_16 float, shader units), 1 (motion
+// blur colour and weight), 2 (bloom) and the vertex shader's 16 (the adapted
+// luminance, 1x1) are the four textures.
+#ifdef XE_HDR_SCENE_GAME_OUTPUT
+  #define XE_HDR_SCENE_GAME_PARAMETER , out float3_xe game_rgb
+#else
+  #define XE_HDR_SCENE_GAME_PARAMETER
+#endif
+float3_xe XeHdrSceneColor(uint2_xe pixel_index, uint4_xe size_mode, float4_xe pixel_offset,
+                          float4_xe curve, float4_xe grade, float4_xe balance,
+                          float4_xe shoulder, XeHdrSceneTexture scene_texture,
+                          XeHdrSceneTexture blur_texture,
+                          XeHdrSceneTexture bloom_texture,
+                          XeHdrSceneTexture luminance_texture XE_HDR_SCENE_GAME_PARAMETER) {
+  // Where the game's draw samples for this pixel, with its pixel offset.
+  float2_xe uv = (float2_xe(pixel_index) + 0.5f - pixel_offset.xy) / float2_xe(size_mode.xy);
+
+  // The inputs' sizes (scaled with the resolution like the output).
+  uint2_xe scene_size, blur_size, bloom_size, luminance_size;
+#if SHADING_LANGUAGE_GLSL_XE
+  scene_size = uint2_xe(textureSize(scene_texture, 0).xy);
+  blur_size = uint2_xe(textureSize(blur_texture, 0).xy);
+  bloom_size = uint2_xe(textureSize(bloom_texture, 0).xy);
+  luminance_size = uint2_xe(textureSize(luminance_texture, 0).xy);
+#else
+  uint layers;
+  scene_texture.GetDimensions(scene_size.x, scene_size.y, layers);
+  blur_texture.GetDimensions(blur_size.x, blur_size.y, layers);
+  bloom_texture.GetDimensions(bloom_size.x, bloom_size.y, layers);
+  luminance_texture.GetDimensions(luminance_size.x, luminance_size.y, layers);
+#endif
+
+  // Point-sampled as the game does (its draw samples on texel edges: a little
+  // past them, as the texture unit's fixed-point coordinates mostly round),
+  // bilinear for the smaller blur and bloom.
+  float3_xe scene = XeHdrSceneFetch(
+      scene_texture,
+      clamp(int2_xe(floor(uv * float2_xe(scene_size) + (1.0f / 512.0f))), int2_xe(0, 0),
+            int2_xe(scene_size) - 1)).rgb;
+  float4_xe blur, bloom4;
+  {
+    float2_xe position = uv * float2_xe(blur_size) - 0.5f;
+    float2_xe weight = position - floor(position);
+    int2_xe last = int2_xe(blur_size) - 1;
+    int2_xe p0 = clamp(int2_xe(floor(position)), int2_xe(0, 0), last);
+    int2_xe p1 = clamp(int2_xe(floor(position)) + 1, int2_xe(0, 0), last);
+    float4_xe top = XeHdrSceneFetch(blur_texture, p0);
+    top += (XeHdrSceneFetch(blur_texture, int2_xe(p1.x, p0.y)) - top) * weight.x;
+    float4_xe bottom = XeHdrSceneFetch(blur_texture, int2_xe(p0.x, p1.y));
+    bottom += (XeHdrSceneFetch(blur_texture, p1) - bottom) * weight.x;
+    blur = top + (bottom - top) * weight.y;
+  }
+  {
+    float2_xe position = uv * float2_xe(bloom_size) - 0.5f;
+    float2_xe weight = position - floor(position);
+    int2_xe last = int2_xe(bloom_size) - 1;
+    int2_xe p0 = clamp(int2_xe(floor(position)), int2_xe(0, 0), last);
+    int2_xe p1 = clamp(int2_xe(floor(position)) + 1, int2_xe(0, 0), last);
+    float4_xe top = XeHdrSceneFetch(bloom_texture, p0);
+    top += (XeHdrSceneFetch(bloom_texture, int2_xe(p1.x, p0.y)) - top) * weight.x;
+    float4_xe bottom = XeHdrSceneFetch(bloom_texture, int2_xe(p0.x, p1.y));
+    bottom += (XeHdrSceneFetch(bloom_texture, p1) - bottom) * weight.x;
+    bloom4 = top + (bottom - top) * weight.y;
+  }
+
+  // Motion blur and depth of field: lerp(scene, blur, sat(scale x blur.a)).
+  float3_xe c = scene + saturate_xe(blur.a * curve.w) * (blur.rgb - scene);
+
+  // RGB -> XYZ (the DirectX SDK matrix the game uses), then x, y and Y.
+  float big_x = dot(c, float3_xe(0.514136f, 0.323879f, 0.160364f));
+  float big_y = dot(c, float3_xe(0.265068f, 0.670234f, 0.0640916f));
+  float big_s = dot(c, float3_xe(0.803323f, 1.11693f, 1.06888f));
+  big_s = select_xe(big_s == 0.0f, curve.z, big_s);
+  float chroma_x = big_x / big_s;
+  float chroma_y = big_y / big_s;
+  // The adapted luminance, 1x1 for the game (at a scaled resolution, its
+  // middle texel is the one the game's vertex shader reads).
+  float adapted = clamp(XeHdrSceneFetch(luminance_texture, int2_xe(luminance_size / 2u)).r,
+                        grade.x, grade.y);
+  // Not negative (the curve divides by 1 + Ls), not NaN, and finite (the
+  // shoulder and the clip take any size).
+  float ls = big_y * curve.x / (adapted + curve.z);
+  ls = XeHdrSceneNotNan(ls) ? clamp(ls, 0.0f, 1.0e18f) : 0.0f;
+
+  // Reinhard extended, then the shoulder above the knee: never under the
+  // game's curve up to its white (Ls = sqrt(W)); with no room above white,
+  // the game's curve clipped at it.
+  float ld = ls * (1.0f + ls / curve.y) / (1.0f + ls);
+#ifdef XE_HDR_SCENE_GAME_OUTPUT
+  float ld_game = ld;
+#endif
+  dont_flatten_xe
+  if (size_mode.z == 0u && ls > shoulder.y) {
+    dont_flatten_xe
+    if (shoulder.w > (1.0f - shoulder.x) * 1.0001f) {
+      float shoulder_ld = shoulder.x + shoulder.w * (1.0f - exp2(-(ls - shoulder.y) * shoulder.z /
+                                                                 shoulder.w * 1.44269504f));
+      ld = ls < sqrt(curve.y) ? max(shoulder_ld, ld) : shoulder_ld;
+    } else {
+      ld = min(ld, 1.0f);
+    }
+  }
+
+  // Back to RGB through x and y, and the grade.
+  float chroma_y_guarded = select_xe(chroma_y == 0.0f, curve.z, chroma_y);
+#ifdef XE_HDR_SCENE_GAME_OUTPUT
+  // What the game's draw writes (before its encode): its curve and its bloom.
+  game_rgb = XeHdrSceneGrade(ld_game, chroma_x, chroma_y_guarded, bloom4.rgb, 1.0f, grade,
+                             balance.xyz);
+#endif
+  return XeHdrSceneGrade(ld, chroma_x, chroma_y_guarded, bloom4.rgb, balance.w, grade,
+                         balance.xyz);
+}
