+bool CommandProcessor::HdrCopyUnderlay(const HdrRect& rect, uint32_t dest_x, uint32_t dest_y) {
+  if (HdrTrimSupported()) {
+    // hdr_trim: the copy of the whole output to the same place (the snapshot is the
+    // output's size) would only make a second copy of the snapshot: the refresher reads
+    // the snapshot as the underlay instead. The snapshot isn't written again before the
+    // refresher reads it (HdrMaterializeUnderlay, before the next one).
+    HdrTrimWhy why = kHdrTrimDone;
+    if (!hdr_frame_.trim) {
+      why = kHdrTrimOff;
+    } else if (rect.x || rect.y || dest_x || dest_y || rect.width != hdr_output_width_ ||
+               rect.height != hdr_output_height_) {
+      why = kHdrTrimPartial;
+    }
+    // One copy that isn't skipped is what the log tells.
