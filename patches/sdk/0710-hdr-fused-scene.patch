+// hdr_scene_fused (hdr_refresh_fused.cs, see CommandProcessor::HdrSceneFusedWanted and hdr_scene_mcla.xesli).
+
+bool D3D12CommandProcessor::HdrCaptureScene(const D3D12Shader& vertex_shader,
+                                            const D3D12Shader& pixel_shader) {
+  // The tone map draw has just been recorded (its textures were requested for it, and are in the cache's
+  // bindings now). Nothing is recorded here: what the pass after the draw would bind is kept for the swap.
+  hdr_fused_ = HdrFusedScene();
+  hdr_frame_.scene_fused = false;
+  const char* why_not = nullptr;
+  uint32_t failed_input = 0;
+  if (!hdr_refresh_fused_pipeline_) {
+    why_not = "the refresher's fused pipeline couldn't be made";
+  } else if (rex::cvar::GetFlagByName("frame_generation") != "off") {
+    // The generated frames' compose and the HUD-less image read the scene as images.
+    why_not = "frame generation is on";
+  }
+  const D3D12Shader::TextureBinding* bindings[4] = {};
+  for (uint32_t i = 0; i < 4 && !why_not; ++i) {
+    // The scene, blur and bloom are the pixel shader's fetches, the adapted luminance the vertex shader's.
+    for (const D3D12Shader::TextureBinding& binding :
+         (i < 3 ? pixel_shader : vertex_shader).GetTextureBindingsAfterTranslation()) {
+      if (binding.fetch_constant == kHdrSceneFetchConstants[i] &&
+          binding.dimension == xenos::FetchOpDimension::k2D) {
+        bindings[i] = &binding;
+      }
+    }
+    if (!bindings[i]) {
+      why_not = "a texture of the tone map draw isn't a plain 2D binding of its shader";
+      failed_input = i + 1;
+    }
+  }
+  uint64_t signature = 1469598103934665603ull;
+  for (uint32_t i = 0; i < 4 && !why_not; ++i) {
+    if (!texture_cache_->CaptureActiveTexture(*bindings[i], hdr_fused_.textures[i], why_not)) {
+      failed_input = i + 1;
+      break;
+    }
+    why_not = nullptr;
+    const D3D12TextureCache::HdrTextureCapture& capture = hdr_fused_.textures[i];
+    signature = (signature ^ (uint64_t(capture.format) | (uint64_t(capture.width) << 8) |
+                              (uint64_t(capture.height) << 24))) *
+                1099511628211ull;
+  }
+  if (why_not) {
+    hdr_fused_ = HdrFusedScene();
+    HdrNoteFusedScene(why_not, failed_input);
+    return false;
+  }
+  hdr_fused_.valid = true;
+  hdr_fused_.constants = hdr_scene_constants_;
+  // hdr_scene_fused_check: every Nth frame the old pass and the copy are made too.
+  const int32_t check_interval = REXCVAR_GET(hdr_scene_fused_check);
+  hdr_fused_.check = check_interval > 0 && hdr_refresh_fused_check_pipeline_ &&
+                     (++hdr_fused_check_counter_ % uint64_t(check_interval)) == 0;
+  hdr_frame_.scene_fused = true;
+  hdr_frame_.scene_width = hdr_output_width_;
+  hdr_frame_.scene_height = hdr_output_height_;
+  HdrNoteFusedScene(nullptr, signature);
+  return true;
+}
+
+bool D3D12CommandProcessor::HdrUseFusedScene(const char*& why_not_out) {
+  // The textures are the cache's, with the data the draw read: nothing wrote them (a texture load, or a resolve
+  // that wrote one along with the memory) between the draw and now, and none was destroyed. They go to the
+  // state the refresher reads them in, and are marked as used by this submission.
+  if (!hdr_fused_.valid) {
+    why_not_out = "the tone map draw's inputs weren't kept";
+    return false;
+  }
+  for (const D3D12TextureCache::HdrTextureCapture& capture : hdr_fused_.textures) {
+    if (!texture_cache_->UseCapturedTexture(capture)) {
+      why_not_out =
+          "a texture the tone map draw read was replaced or rewritten before the swap";
+      return false;
+    }
+  }
+  return true;
+}
+
+void D3D12CommandProcessor::HdrNoteFusedScene(const char* why_not, uint64_t signature) {
+  if (hdr_fused_noted_ && hdr_fused_noted_why_ == why_not && hdr_fused_noted_signature_ == signature) {
+    return;
+  }
+  const bool first = !hdr_fused_noted_;
+  hdr_fused_noted_ = true;
+  hdr_fused_noted_why_ = why_not;
+  hdr_fused_noted_signature_ = signature;
+  const uint64_t now_ms = rex::chrono::Clock::QueryHostUptimeMillis();
+  if (!first && now_ms - hdr_fused_note_last_ms_ < 2000) {
+    ++hdr_fused_note_suppressed_;
+    return;
+  }
+  hdr_fused_note_last_ms_ = now_ms;
+  const std::string suppressed =
+      hdr_fused_note_suppressed_ ? fmt::format(" ({} changes in the last 2 s not logged)",
+                                               hdr_fused_note_suppressed_)
+                                 : std::string();
+  hdr_fused_note_suppressed_ = 0;
+  if (why_not) {
+    REXGPU_INFO(
+        "HDR: scene not fused into the refresher: {}{}; the pass after the tone map draw makes the scene as "
+        "before{}",
+        why_not, signature ? fmt::format(" (input {})", signature) : std::string(), suppressed);
+    return;
+  }
+  static const char* const kNames[4] = {"scene", "blur", "bloom", "luminance"};
+  std::string inputs;
+  for (uint32_t i = 0; i < 4; ++i) {
+    const D3D12TextureCache::HdrTextureCapture& capture = hdr_fused_.textures[i];
+    inputs += fmt::format("{}{} {}x{} {}", i ? ", " : "", kNames[i], capture.width, capture.height,
+                          FormatInfo::Get(capture.format)->name);
+  }
+  REXGPU_INFO(
+      "HDR: scene fused into the refresher (tone map inputs captured: {}); no scene image or copy of the "
+      "tone map's output is made, the UI goes by difference{}{}",
+      inputs, hdr_fused_.check ? " (a check frame)" : "", suppressed);
+}
+
+bool D3D12CommandProcessor::HdrEnsureFusedCheckBuffers() {
+  if (hdr_fused_check_counts_) {
+    return true;
+  }
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  D3D12_RESOURCE_DESC counts_desc, plain_desc;
+  ui::d3d12::util::FillBufferResourceDesc(counts_desc, 256, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS);
+  ui::d3d12::util::FillBufferResourceDesc(plain_desc, 256, D3D12_RESOURCE_FLAG_NONE);
+  if (FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesDefault, D3D12_HEAP_FLAG_NONE, &counts_desc,
+          D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr, IID_PPV_ARGS(&hdr_fused_check_counts_))) ||
+      FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesUpload, D3D12_HEAP_FLAG_NONE, &plain_desc,
+          D3D12_RESOURCE_STATE_GENERIC_READ, nullptr, IID_PPV_ARGS(&hdr_fused_check_zero_))) ||
+      FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesReadback, D3D12_HEAP_FLAG_NONE, &plain_desc,
+          D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&hdr_fused_check_readback_[0]))) ||
+      FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesReadback, D3D12_HEAP_FLAG_NONE, &plain_desc,
+          D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&hdr_fused_check_readback_[1])))) {
+    static bool logged = false;
+    if (!logged) {
+      logged = true;
+      REXGPU_ERROR("hdr_scene_fused_check: failed to create the buffers of the counts");
+    }
+    hdr_fused_check_counts_.Reset();
+    hdr_fused_check_zero_.Reset();
+    hdr_fused_check_readback_[0].Reset();
+    hdr_fused_check_readback_[1].Reset();
+    return false;
+  }
+  void* zero_mapping = nullptr;
+  const D3D12_RANGE no_read = {0, 0};
+  if (SUCCEEDED(hdr_fused_check_zero_->Map(0, &no_read, &zero_mapping))) {
+    std::memset(zero_mapping, 0, 256);
+    hdr_fused_check_zero_->Unmap(0, nullptr);
+  }
+  return true;
+}
+
+void D3D12CommandProcessor::HdrRecordFusedCheck(
+    const HdrRefreshFusedConstants& constants,
+    const ui::d3d12::util::DescriptorCpuGpuHandlePair* descriptors,
+    const ui::d3d12::util::DescriptorCpuGpuHandlePair& destination,
+    const ui::d3d12::util::DescriptorCpuGpuHandlePair& source,
+    const ui::d3d12::util::DescriptorCpuGpuHandlePair& ramp, uint32_t group_count_x,
+    uint32_t group_count_y) {
+  // descriptors: the underlay (0), the tone map draw's four textures (1 to 4), then for the check the old pass's
+  // image (5), the tone map's output copy (6) and the counts (7).
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  const uint32_t slot = hdr_fused_check_next_slot_;
+  HdrWriteTextureSRV(kHdrTextureScene, descriptors[5].first);
+  HdrWriteTextureSRV(kHdrTextureTonemap, descriptors[6].first);
+  D3D12_UNORDERED_ACCESS_VIEW_DESC counts_uav_desc = {};
+  counts_uav_desc.Format = DXGI_FORMAT_R32_TYPELESS;
+  counts_uav_desc.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+  counts_uav_desc.Buffer.FirstElement = 0;
+  counts_uav_desc.Buffer.NumElements = 8;
+  counts_uav_desc.Buffer.StructureByteStride = 0;
+  counts_uav_desc.Buffer.Flags = D3D12_BUFFER_UAV_FLAG_RAW;
+  device->CreateUnorderedAccessView(hdr_fused_check_counts_.Get(), nullptr, &counts_uav_desc,
+                                    descriptors[7].first);
+
+  // The counts to zero (the buffer rests in the UAV state).
+  PushTransitionBarrier(hdr_fused_check_counts_.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                        D3D12_RESOURCE_STATE_COPY_DEST);
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyBufferRegion(hdr_fused_check_counts_.Get(), 0,
+                                             hdr_fused_check_zero_.Get(), 0, 32);
+  PushTransitionBarrier(hdr_fused_check_counts_.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+                        D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+
+  // The check refresher: the refresher's bindings with the three tables more.
+  deferred_command_list_.D3DSetComputeRootSignature(hdr_refresh_fused_check_root_signature_.Get());
+  deferred_command_list_.D3DSetComputeRoot32BitConstants(
+      UINT(ApplyGammaRootParameter::kConstants), sizeof(constants) / sizeof(uint32_t), &constants,
+      0);
+  deferred_command_list_.D3DSetComputeRootDescriptorTable(
+      UINT(ApplyGammaRootParameter::kDestination), destination.second);
+  deferred_command_list_.D3DSetComputeRootDescriptorTable(UINT(ApplyGammaRootParameter::kSource),
+                                                          source.second);
+  deferred_command_list_.D3DSetComputeRootDescriptorTable(UINT(ApplyGammaRootParameter::kRamp),
+                                                          ramp.second);
+  for (uint32_t i = 0; i < 8; ++i) {
+    deferred_command_list_.D3DSetComputeRootDescriptorTable(
+        UINT(ApplyGammaRootParameter::kCount) + i, descriptors[i].second);
+  }
+  SetExternalPipeline(hdr_refresh_fused_check_pipeline_.Get());
+  SubmitBarriers();
+  deferred_command_list_.D3DDispatch(group_count_x, group_count_y, 1);
+
+  // The counts to the readback buffer; read when this submission has completed (HdrCollectFusedCheck).
+  PushTransitionBarrier(hdr_fused_check_counts_.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                        D3D12_RESOURCE_STATE_COPY_SOURCE);
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyBufferRegion(hdr_fused_check_readback_[slot].Get(), 0,
+                                             hdr_fused_check_counts_.Get(), 0, 32);
+  PushTransitionBarrier(hdr_fused_check_counts_.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE,
+                        D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  HdrFusedCheckPending& pending = hdr_fused_check_pending_[slot];
+  pending.pending = true;
+  pending.submission = submission_current_;
+  pending.number = ++hdr_fused_check_number_;
+  pending.pixels = uint64_t(constants.refresh.size[0]) * constants.refresh.size[1];
+  hdr_fused_check_next_slot_ = (slot + 1) & 1;
+}
+
+void D3D12CommandProcessor::HdrCollectFusedCheck() {
+  for (HdrFusedCheckPending& pending : hdr_fused_check_pending_) {
+    if (!pending.pending || submission_completed_ < pending.submission) {
+      continue;
+    }
+    pending.pending = false;
+    ID3D12Resource* readback = hdr_fused_check_readback_[&pending - hdr_fused_check_pending_].Get();
+    uint32_t counts[8] = {};
+    const D3D12_RANGE read_range = {0, sizeof(counts)};
+    void* mapping = nullptr;
+    if (!readback || FAILED(readback->Map(0, &read_range, &mapping))) {
+      REXGPU_ERROR("hdr_scene_fused_check: failed to map the counts");
+      continue;
+    }
+    std::memcpy(counts, mapping, sizeof(counts));
+    const D3D12_RANGE written_range = {0, 0};
+    readback->Unmap(0, &written_range);
+    // The counts: 0 pixels whose tone map output is off by more than a code, 1 the largest difference in codes
+    // among them, 2 pixels whose scene is off by more than 0.5%, 3 the largest relative difference among them
+    // (float), 4 pixels one code off.
+    float max_relative;
+    std::memcpy(&max_relative, &counts[3], sizeof(float));
+    REXGPU_INFO(
+        "HDR: fused check #{}: tonemap mismatches {} of {} px (max d {}/255), scene mismatches {} "
+        "(max rel {:.4f}); {} px are one code off in the tone map's output (not counted as "
+        "mismatches)",
+        pending.number, counts[0], pending.pixels, counts[1], counts[2], max_relative, counts[4]);
+  }
+}
+
 }  // namespace rex::graphics::d3d12
