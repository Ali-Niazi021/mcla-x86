+void CommandProcessor::HdrLogTrim() {
+  // Only the frames the backend's refresher decided the swap texture's load of (HDR output
+  // used), by the kind of frame.
+  if (!hdr_frame_.trim_swap_load) {
+    return;
+  }
+  uint32_t kind = uint32_t(hdr_last_composite_);
+  uint32_t state = uint32_t(hdr_frame_.trim_swap_load) |
+                   (uint32_t(hdr_frame_.trim_layer_clear) << 8) |
+                   (uint32_t(hdr_frame_.trim_underlay_copy) << 16);
+  if (kind >= std::size(hdr_last_trim_) || hdr_last_trim_[kind] == state) {
+    return;
+  }
+  hdr_last_trim_[kind] = state;
+  static const char* const kReasons[] = {
+      "",
+      "",
+      "hdr_trim is off",
+      "the frame isn't put together from the UI layer",
+      "a debug view shows the front buffer",
+      "frame generation is on",
+      "the swap's texture isn't a plain 8_8_8_8 one at 1x, so it's loaded to know its size",
+      "no UI over the area, nothing is copied to the UI layer",
+      "the copy doesn't cover the whole output",
+      ""};
+  static_assert(std::size(kReasons) == size_t(kHdrTrimCount));
+  static const char* const kCuts[] = {"swap texture load", "UI layer clear", "underlay copy"};
+  static const char* const kFrames[] = {"the front buffer as SDR", "the difference mask",
+                                        "the UI layer", "the front buffer as the scene"};
+  const uint8_t whys[] = {hdr_frame_.trim_swap_load, hdr_frame_.trim_layer_clear,
+                          hdr_frame_.trim_underlay_copy};
+  std::string text;
+  for (size_t i = 0; i < std::size(whys); ++i) {
+    if (whys[i] == kHdrTrimNotReached || whys[i] >= kHdrTrimCount) {
+      continue;
+    }
+    if (!text.empty()) {
+      text += ", ";
+    }
+    text += kCuts[i];
+    if (whys[i] == kHdrTrimDone) {
+      text += " skipped";
+    } else if (whys[i] == kHdrTrimFromTarget) {
+      text += " skipped (the refresher reads the front buffer's render target)";
+    } else {
+      text += std::string(" not skipped (") + kReasons[whys[i]] + ")";
+    }
+  }
+  REXGPU_INFO("HDR: trim (frames put together from {}): {}", kFrames[kind], text);
+}
