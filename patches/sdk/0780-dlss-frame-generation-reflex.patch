+// Reflex through Streamline: the low-latency layer's frames (their ids: the swap packets'
+// ordinals) are Streamline's frame indices, the same DLSS-G's constants and Present use.
+class StreamlineReflexBackend final : public LowLatencyBackend {
+ public:
+  const char* Name() const override { return "NVIDIA REFLEX"; }
+  bool SupportsBoost() const override { return true; }
+  bool Untested() const override { return true; }
+  bool OnByDefault() const override { return true; }
+  bool PresentMarkersAtHandOff() const override { return true; }
+  bool SupportsLimit() const override { return true; }
+  bool SetMode(bool on, bool boost, uint32_t minimum_interval_us) override {
+    const Api* api = GetApi();
+    if (!api || !api->slReflexSetOptions) {
+      failure_ = "NOT LOADED";
+      return false;
+    }
+    sl::ReflexOptions options;
+    options.mode = on ? (boost ? sl::ReflexMode::eLowLatencyWithBoost : sl::ReflexMode::eLowLatency)
+                      : sl::ReflexMode::eOff;
+    options.frameLimitUs = minimum_interval_us;
+    const sl::Result result = api->slReflexSetOptions(options);
+    if (result != sl::Result::eOk) {
+      failure_ = "REFUSED";
+      return false;
+    }
+    return true;
+  }
+  const char* FailureReason() const override { return failure_; }
+  bool Sleep(uint64_t frame_id) override {
+    const Api* api = GetApi();
+    sl::FrameToken* token = api ? GetFrameToken(uint32_t(frame_id)) : nullptr;
+    return token && api->slReflexSleep(*token) == sl::Result::eOk;
+  }
+  void Marker(LatencyMarker marker, uint64_t frame_id) override {
+    sl::PCLMarker pcl;
+    switch (marker) {
+      case LatencyMarker::kSimulationStart:
+        pcl = sl::PCLMarker::eSimulationStart;
+        break;
+      case LatencyMarker::kSimulationEnd:
+        pcl = sl::PCLMarker::eSimulationEnd;
+        break;
+      case LatencyMarker::kRenderSubmitStart:
+        pcl = sl::PCLMarker::eRenderSubmitStart;
+        break;
+      case LatencyMarker::kRenderSubmitEnd:
+        pcl = sl::PCLMarker::eRenderSubmitEnd;
+        break;
+      case LatencyMarker::kPresentStart:
+        pcl = sl::PCLMarker::ePresentStart;
+        break;
+      case LatencyMarker::kPresentEnd:
+        pcl = sl::PCLMarker::ePresentEnd;
+        break;
+      case LatencyMarker::kInputSample:
+        pcl = sl::PCLMarker::eControllerInputSample;
+        break;
+      case LatencyMarker::kOutOfBandRenderSubmitStart:
+        pcl = sl::PCLMarker::eOutOfBandRenderSubmitStart;
+        break;
+      case LatencyMarker::kOutOfBandRenderSubmitEnd:
+        pcl = sl::PCLMarker::eOutOfBandRenderSubmitEnd;
+        break;
+      case LatencyMarker::kOutOfBandPresentStart:
+        pcl = sl::PCLMarker::eOutOfBandPresentStart;
+        break;
+      case LatencyMarker::kOutOfBandPresentEnd:
+        pcl = sl::PCLMarker::eOutOfBandPresentEnd;
+        break;
+      default:
+        // The generated frames are DLSS-G's own (it marks them itself).
+        return;
+    }
+    const Api* api = GetApi();
+    sl::FrameToken* token = api ? GetFrameToken(uint32_t(frame_id)) : nullptr;
+    if (token) {
+      api->slPCLSetMarker(pcl, *token);
+    }
+  }
+
+ private:
+  const char* failure_ = "NOT SUPPORTED";
+};
