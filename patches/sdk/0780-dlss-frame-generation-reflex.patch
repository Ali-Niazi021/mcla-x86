+// Debug aid (streamline_log >= 1): an access violation or illegal instruction is logged with its address and stack as module +
+// offset before the process dies, so a crash inside NVIDIA's DLLs or ours is told apart. Once.
+LONG CALLBACK CrashLogger(PEXCEPTION_POINTERS info) {
+  const DWORD code = info->ExceptionRecord->ExceptionCode;
+  if (code != EXCEPTION_ACCESS_VIOLATION && code != EXCEPTION_ILLEGAL_INSTRUCTION &&
+      code != EXCEPTION_STACK_OVERFLOW && code != EXCEPTION_INT_DIVIDE_BY_ZERO) {
+    return EXCEPTION_CONTINUE_SEARCH;
+  }
+  // The guest memory's own faults are handled by the SDK's handler, which runs before this one only if it was added later:
+  // only exceptions that reach the end of the chain matter, so this is added first (called last).
+  static std::atomic<bool> logged{false};
+  if (logged.exchange(true)) {
+    return EXCEPTION_CONTINUE_SEARCH;
+  }
+  void* frames[32] = {};
+  const USHORT count = RtlCaptureStackBackTrace(0, 32, frames, nullptr);
+  std::string text = fmt::format("exception 0x{:08X} at {} (thread {}); stack:", uint32_t(code),
+                                 info->ExceptionRecord->ExceptionAddress, GetCurrentThreadId());
+  auto describe = [](const void* address) {
+    HMODULE module = nullptr;
+    char name[MAX_PATH] = {};
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           static_cast<const char*>(address), &module) &&
+        GetModuleFileNameA(module, name, MAX_PATH)) {
+      const char* base = strrchr(name, '\\');
+      return fmt::format(" {}+0x{:X}", base ? base + 1 : name,
+                         uintptr_t(address) - uintptr_t(module));
+    }
+    return fmt::format(" {}", address);
+  };
+  text += " [rip]" + describe(info->ExceptionRecord->ExceptionAddress);
+  for (USHORT i = 0; i < count; ++i) {
+    text += describe(frames[i]);
+  }
+  REXLOG_ERROR("Streamline debug: {}", text);
+  return EXCEPTION_CONTINUE_SEARCH;
+}
