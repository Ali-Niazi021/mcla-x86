+void TaaDlssPublishFrame(const TaaDlssDispatch& camera) {
+  const uint64_t id = rex::ui::LowLatency::GpuFrameId();
+  if (!id) {
+    return;
+  }
+  ui_sl::FrameConstants constants;
+  constants.render_width = camera.render_width;
+  constants.render_height = camera.render_height;
+  constants.jitter[0] = camera.jitter[0];
+  constants.jitter[1] = camera.jitter[1];
+  constants.near_plane = camera.near_plane;
+  constants.far_plane = camera.far_plane;
+  constants.fov_vertical = camera.fov_vertical;
+  constants.aspect_ratio = camera.aspect_ratio;
+  constants.reset = camera.reset;
+  constants.matrices_valid = camera.matrices_valid;
+  std::memcpy(constants.view_to_clip, camera.view_to_clip, sizeof(constants.view_to_clip));
+  std::memcpy(constants.clip_to_view, camera.clip_to_view, sizeof(constants.clip_to_view));
+  std::memcpy(constants.clip_to_prev_clip, camera.clip_to_prev_clip,
+              sizeof(constants.clip_to_prev_clip));
+  std::memcpy(constants.prev_clip_to_clip, camera.prev_clip_to_clip,
+              sizeof(constants.prev_clip_to_clip));
+  std::memcpy(constants.position, camera.position, sizeof(constants.position));
+  std::memcpy(constants.up, camera.up, sizeof(constants.up));
+  std::memcpy(constants.right, camera.right, sizeof(constants.right));
+  std::memcpy(constants.forward, camera.forward, sizeof(constants.forward));
+  ui_sl::PublishFrameConstants(id, constants);
+}
