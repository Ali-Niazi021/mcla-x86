+// LOCAL PATCH - MCLA (0812): stencil_transfer_cut. The CP thread only.
+class StencilTransferCutStats {
+ public:
+  // A draw whose depth / stencil target needs transfers: reason null when the cut was set, else why not.
+  void NoteDraw(const char* reason) {
+    if (!reason) {
+      ++draws_cut_;
+    } else {
+      ++kept_reasons_[reason];
+    }
+  }
+  void NoteTransfers(uint32_t dropped, uint32_t cut, uint32_t kept, uint64_t pixel_passes_saved) {
+    dropped_ += dropped;
+    cut_ += cut;
+    kept_ += kept;
+    pixel_passes_saved_ += pixel_passes_saved;
+  }
+  void LogIfDue(bool poison) {
+    const auto now = std::chrono::steady_clock::now();
+    const double seconds = std::chrono::duration<double>(now - window_start_).count();
+    if (seconds < 10.0) {
+      return;
+    }
+    std::string reasons;
+    uint64_t draws_kept = 0;
+    for (const auto& kept : kept_reasons_) {
+      draws_kept += kept.second;
+      reasons += (reasons.empty() ? "" : "; ") + std::string(kept.first) + " x" + std::to_string(kept.second);
+    }
+    if (draws_cut_ || draws_kept || dropped_ || cut_ || kept_) {
+      REXGPU_INFO(
+          "[stencil-transfer-cut] {:.1f} s: {} draws needing depth / stencil transfers had their stencil cut, {} not "
+          "({}); stencil-bit transfers left out {} ({} draws of a stencil bit), made over a smaller area {}, made whole "
+          "{}; {:.1f} host Mpx of stencil-bit passes saved{}",
+          seconds, draws_cut_, draws_kept, reasons.empty() ? "none" : reasons, dropped_, uint64_t(dropped_) * 8, cut_,
+          kept_, double(pixel_passes_saved_) / 1e6,
+          poison ? " (the left-out stencil is filled with 0xA5: stencil_transfer_cut_poison)" : "");
+    }
+    draws_cut_ = dropped_ = cut_ = kept_ = pixel_passes_saved_ = 0;
+    kept_reasons_.clear();
+    window_start_ = now;
+  }
+
+ private:
+  uint64_t draws_cut_ = 0, dropped_ = 0, cut_ = 0, kept_ = 0, pixel_passes_saved_ = 0;
+  std::map<const char*, uint64_t> kept_reasons_;
+  std::chrono::steady_clock::time_point window_start_ = std::chrono::steady_clock::now();
+};
+
+StencilTransferCutStats g_stencil_transfer_cut_stats;
+
+// Why a draw does not rewrite the stencil of every sample it covers (nullptr when it does), from the state the host sets
+// for a rectangle list (pipeline_cache.cpp: not polygonal, so the front face's state and write mask are used for both):
+// the stencil test always passes, the depth test cannot fail (no depth-fail operation can happen), the pass operation is
+// REPLACE (the reference is written, whatever it is), and all 8 bits are written.
+const char* StencilRewriteRejectReason(reg::RB_DEPTHCONTROL normalized_depth_control, const RegisterFile& regs) {
+  if (!normalized_depth_control.stencil_enable) {
+    return "the stencil is not written (no stencil test)";
+  }
+  if (normalized_depth_control.stencilfunc != xenos::CompareFunction::kAlways) {
+    return "the stencil function is not ALWAYS";
+  }
+  if (normalized_depth_control.z_enable && normalized_depth_control.zfunc != xenos::CompareFunction::kAlways) {
+    return "the depth test can fail";
+  }
+  if (normalized_depth_control.stencilzpass != xenos::StencilOp::kReplace) {
+    return "the stencil pass operation is not REPLACE";
+  }
+  if (regs.Get<reg::RB_STENCILREFMASK>().stencilwritemask != 0xFF) {
+    return "the stencil write mask is not 0xFF";
+  }
+  return nullptr;
+}
+
 // LOCAL PATCH - MCLA (0811): transfer_census_log. The CP thread only.
 class TransferCensus {
  public:
@@ -969,6 +1060,7 @@ bool RenderTargetCache::Update(bool is_rasterization_done,
   const Shader* pixel_shader = update_pixel_shader_;
   update_pixel_shader_ = nullptr;
   last_update_overwritten_rectangle_valid_ = false;
+  transfer_stencil_cutout_valid_ = false;  // LOCAL PATCH - MCLA (0812): stencil_transfer_cut
 
   // LOCAL PATCH - MCLA (04e0): whether the title's tone map marker has been seen in this frame (the command processor
   // says so for every draw), for tonemap_transfer_skip. skip_overwritten_transfers, which covers the tone map as well,
@@ -1386,6 +1478,40 @@ bool RenderTargetCache::Update(bool is_rasterization_done,
     }
   }
 
+  // LOCAL PATCH - MCLA (0812): stencil_transfer_cut: the rectangle of the depth / stencil target whose stencil this draw
+  // rewrites, if its transfers need it. The coverage is GetOverwrittenRectangle's (with the depth and stencil tests that
+  // always pass allowed: those never change which samples are written), run again here (after the census took its reason)
+  // only for a rectangle draw that writes the stencil this way.
+  if (REXCVAR_GET(stencil_transfer_cut) && !interlock_barrier_only && (depth_and_color_rts_used_bits & 1)) {
+    uint32_t depth_length_tiles = 0;
+    for (uint32_t i = 0; i < edram_bases_sorted_count; ++i) {
+      if (edram_bases_sorted[i].second == 0) {
+        depth_length_tiles = rt_lengths_tiles[i];
+      }
+    }
+    if (depth_length_tiles && WouldOwnershipChangeRequireTransfers(rt_keys[0], 0, depth_length_tiles)) {
+      const char* reason = nullptr;
+      if (!pixel_shader || !is_rasterization_done ||
+          regs.Get<reg::VGT_DRAW_INITIATOR>().prim_type != xenos::PrimitiveType::kRectangleList) {
+        reason = "not a rectangle-list draw";
+      } else {
+        reason = StencilRewriteRejectReason(normalized_depth_control, regs);
+      }
+      if (!reason) {
+        Transfer::Rectangle stencil_rectangle;
+        if (GetOverwrittenRectangle(vertex_shader, *pixel_shader, normalized_depth_control, normalized_color_mask,
+                                    stencil_rectangle, nullptr, true)) {
+          transfer_stencil_cutout_ = stencil_rectangle;
+          transfer_stencil_cutout_valid_ = true;
+        } else {
+          reason = g_overwrite_reject_reason[0] ? g_overwrite_reject_reason : "coverage not proven";
+        }
+      }
+      g_stencil_transfer_cut_stats.NoteDraw(reason);
+    }
+    g_stencil_transfer_cut_stats.LogIfDue(REXCVAR_GET(stencil_transfer_cut_poison));
+  }
+
   for (uint32_t i = 0; i < edram_bases_sorted_count; ++i) {
