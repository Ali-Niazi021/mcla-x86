From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mcla-x86 SDK patch layer
Date: Thu, 26 Nov 2026 00:00:00 +0000
Subject: [PATCH] 0590: pipeline-creation export: rexgpu_pipeline_creations / rexgpu_shader_translations / rexgpu_pipelines_pending, '[pipelines]' log

Source: Ours (stream LOCK60 wave 3, P3). Validated in game: runs lk-w3cold2 (fresh shader cache, scene tour), lk-w3tour
Licence: GPL-3 (owner's own work, part of mcla-x86); the patched files are ReXGlue SDK code (BSD-3-Clause)
Purpose: Data exports of rexgpu-xenos.dll so the title's pacer and governor can tell shader-compile bursts from GPU overload:
  cumulative D3D12 pipelines created at run time (sync, async and the end-of-submission drain; the EDRAM transfer pipelines made
  on first use too; not the storage preload), cumulative shaders translated at run time, and async creations in flight. A
  '[pipelines] N created, M shaders translated in 10 s (pending P)' line every 10 s with activity. No behaviour change.
Bucket: REDO

0590-pipeline-creation-export.patch (mcla-x86 LOCK60 wave 3).

---
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index b6618e75..b5c22e03 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -380,6 +380,29 @@ extern "C" std::atomic<int32_t> rexgpu_vrs_level{-1};
 extern "C" std::atomic<int32_t> rexgpu_vrs_levels{0};
 #endif
 
+// LOCAL PATCH - MCLA (0590): pipeline-creation exports, C data symbols of rexgpu-xenos.dll (GetProcAddress gives the
+// address of each atomic), written by the D3D12 pipeline cache (d3d12/pipeline_cache.cpp) with relaxed atomics. They tell
+// the game layer when the GPU emulator is compiling at run time (first visit of a scene state with a cold shader cache),
+// the frame-time bursts of which are not GPU overload. Only work done while the game runs counts; the stored
+// shaders / pipelines the startup preload (InitializeShaderStorage) translates and creates are left out.
+//   rexgpu_pipeline_creations   cumulative D3D12 pipeline state objects the driver compiled for draws (synchronous in
+//                               ConfigurePipeline, and asynchronous on the creation threads or at the end of a
+//                               submission); a creation that failed is not counted
+//   rexgpu_shader_translations  cumulative guest shader translations to DXBC (one per shader and modification) done
+//                               while the game runs (the draw path or an async pipeline's queued creation); a failed
+//                               translation is not counted
+//   rexgpu_pipelines_pending    asynchronous pipeline creations queued by draws or in flight right now (always 0 with
+//                               async_shader_compilation off or no creation threads)
+#if REX_PLATFORM_WIN32
+extern "C" __declspec(dllexport) std::atomic<uint32_t> rexgpu_pipeline_creations{0};
+extern "C" __declspec(dllexport) std::atomic<uint32_t> rexgpu_shader_translations{0};
+extern "C" __declspec(dllexport) std::atomic<int32_t> rexgpu_pipelines_pending{0};
+#else
+extern "C" std::atomic<uint32_t> rexgpu_pipeline_creations{0};
+extern "C" std::atomic<uint32_t> rexgpu_shader_translations{0};
+extern "C" std::atomic<int32_t> rexgpu_pipelines_pending{0};
+#endif
+
 // LOCAL PATCH - MCLA (0430): a WAIT_REG_MEM that sleeps (wait >= 0x100) is woken when the guest's vblank handler has
 // run, not left to a Sleep(1 ms) poll. The title's swap gate is such a wait (memory == 0, wait 0x100): the guest's vblank
 // handler releases it, and a poll at the host's 1-2 ms timer tick noticed the release 0-2 ms late, a different delay
diff --git a/src/graphics/d3d12/pipeline_cache.cpp b/src/graphics/d3d12/pipeline_cache.cpp
index fe554b7f..94f11aa9 100644
--- a/src/graphics/d3d12/pipeline_cache.cpp
+++ b/src/graphics/d3d12/pipeline_cache.cpp
@@ -68,8 +68,62 @@ REXCVAR_DEFINE_BOOL(d3d12_tessellation_wireframe, false, "GPU/D3D12",
 
 REXCVAR_DECLARE(bool, gpu_batch_perf_counters);
 
+// LOCAL PATCH - MCLA (0590): the pipeline-creation exports. The data symbols are defined (and exported) in
+// graphics/command_processor.cpp, in this DLL; see there for what each counts.
+extern "C" std::atomic<uint32_t> rexgpu_pipeline_creations;
+extern "C" std::atomic<uint32_t> rexgpu_shader_translations;
+extern "C" std::atomic<int32_t> rexgpu_pipelines_pending;
+
 namespace rex::graphics::d3d12 {
 
+// LOCAL PATCH - MCLA (0590): counters of the compiling done while the game runs. Relaxed atomics (the counters are
+// advisory and order nothing), safe from the command processor thread and the pipeline creation threads alike. The
+// stored pipelines and shaders of the startup preload never reach these.
+namespace {
+
+// One shader (modification) translated to DXBC for a draw: on the processor thread in ConfigurePipeline, or for an
+// async pipeline's queued creation.
+inline void CountRuntimeShaderTranslation() {
+  rexgpu_shader_translations.fetch_add(1, std::memory_order_relaxed);
+}
+
+// One pipeline state object the driver compiled for a draw (a failed creation, a null state, is not counted).
+inline void CountRuntimePipelineCreation(const ID3D12PipelineState* state) {
+  if (state != nullptr) {
+    rexgpu_pipeline_creations.fetch_add(1, std::memory_order_relaxed);
+  }
+}
+
+// Once per submission, from the command processor thread (the only caller, which keeps the state below unshared):
+// every 10 s, if pipelines were created or shaders translated since the last line, log how many.
+void LogRuntimePipelineActivity() {
+  using Clock = std::chrono::steady_clock;
+  static Clock::time_point window_start = Clock::now();
+  static uint32_t creations_at_window_start = 0;
+  static uint32_t translations_at_window_start = 0;
+  Clock::time_point now = Clock::now();
+  if (now - window_start < std::chrono::seconds(10)) {
+    return;
+  }
+  int64_t window_ms =
+      std::chrono::duration_cast<std::chrono::milliseconds>(now - window_start).count();
+  window_start = now;
+  uint32_t creations = rexgpu_pipeline_creations.load(std::memory_order_relaxed);
+  uint32_t translations = rexgpu_shader_translations.load(std::memory_order_relaxed);
+  // Unsigned subtraction, so a wrapped counter still gives the difference.
+  uint32_t created = creations - creations_at_window_start;
+  uint32_t translated = translations - translations_at_window_start;
+  creations_at_window_start = creations;
+  translations_at_window_start = translations;
+  if (created || translated) {
+    REXGPU_INFO("[pipelines] {} created, {} shaders translated in {} s (pending {})", created,
+                translated, (window_ms + 500) / 1000,
+                rexgpu_pipelines_pending.load(std::memory_order_relaxed));
+  }
+}
+
+}  // namespace
+
 // Generated with `xb buildshaders`.
 namespace shaders {
 #include "../shaders/bytecode/d3d12_5_1/adaptive_quad_hs.h"
@@ -190,6 +244,9 @@ void PipelineCache::Shutdown() {
     creation_threads_.clear();
   }
   creation_completion_event_.reset();
+  // LOCAL PATCH - MCLA (0590): the creation threads left without making the pipelines still queued (they are
+  // destroyed below), which would keep the pending count up for good.
+  rexgpu_pipelines_pending.store(0, std::memory_order_relaxed);
 
   // Shut down the persistent shader / pipeline storage.
   ShutdownShaderStorage();
@@ -830,6 +887,8 @@ void PipelineCache::ShutdownShaderStorage() {
 }
 
 void PipelineCache::EndSubmission() {
+  // LOCAL PATCH - MCLA (0590): the rate-limited pipeline-creation log line, before the async early return below.
+  LogRuntimePipelineActivity();
   if (shader_storage_file_flush_needed_ || pipeline_storage_file_flush_needed_) {
     {
       std::lock_guard<std::mutex> lock(storage_write_request_lock_);
@@ -1033,6 +1092,8 @@ bool PipelineCache::ConfigurePipeline(
         REXGPU_ERROR("Failed to translate the vertex shader!");
         return false;
       }
+      // LOCAL PATCH - MCLA (0590): a vertex shader translated for a draw (synchronous path).
+      CountRuntimeShaderTranslation();
       if (shader_storage_file_ &&
           vertex_shader->shader().ucode_storage_index() != shader_storage_index_) {
         vertex_shader->shader().set_ucode_storage_index(shader_storage_index_);
@@ -1060,6 +1121,8 @@ bool PipelineCache::ConfigurePipeline(
           REXGPU_ERROR("Failed to translate the pixel shader!");
           return false;
         }
+        // LOCAL PATCH - MCLA (0590): a pixel shader translated for a draw (synchronous path).
+        CountRuntimeShaderTranslation();
         if (shader_storage_file_ &&
             pixel_shader->shader().ucode_storage_index() != shader_storage_index_) {
           pixel_shader->shader().set_ucode_storage_index(shader_storage_index_);
@@ -1126,6 +1189,9 @@ bool PipelineCache::ConfigurePipeline(
         bound_rts, shader_writes_color_targets, shader_writes_depth);
     new_pipeline->pending_vertex_shader = vertex_shader;
     new_pipeline->pending_pixel_shader = pixel_shader;
+    // LOCAL PATCH - MCLA (0590): counted before the pipeline is queued, so a creation thread's decrement (when the
+    // pipeline is done) can't come first. Paired with the exchange of async_creation_pending that clears the flag.
+    rexgpu_pipelines_pending.fetch_add(1, std::memory_order_relaxed);
     new_pipeline->async_creation_pending.store(true, std::memory_order_release);
     // Submit the pipeline for creation to any available thread.
     {
@@ -1134,7 +1200,10 @@ bool PipelineCache::ConfigurePipeline(
     }
     creation_request_cond_.notify_one();
   } else {
-    new_pipeline->state.store(CreateD3D12Pipeline(runtime_description), std::memory_order_release);
+    // LOCAL PATCH - MCLA (0590): a pipeline created synchronously for a draw (not from the storage).
+    ID3D12PipelineState* created_state = CreateD3D12Pipeline(runtime_description);
+    CountRuntimePipelineCreation(created_state);
+    new_pipeline->state.store(created_state, std::memory_order_release);
   }
 
   if (pipeline_storage_file_) {
@@ -3301,6 +3370,9 @@ bool PipelineCache::PrepareRuntimeDescriptionForQueuedCreation(
           REXGPU_ERROR("Failed to translate queued {} shader", shader_type);
           return false;
         }
+        // LOCAL PATCH - MCLA (0590): a shader translated on a creation thread (or the processor thread's
+        // end-of-submission drain) for a pipeline a draw queued; the preload never comes here.
+        CountRuntimeShaderTranslation();
         if (shader_storage_file_ &&
             translation->shader().ucode_storage_index() != shader_storage_index_) {
           translation->shader().set_ucode_storage_index(shader_storage_index_);
@@ -3395,6 +3467,10 @@ void PipelineCache::CreationThread(size_t thread_index) {
       --creation_threads_busy_;
     }
     if (was_async_pending) {
+      // LOCAL PATCH - MCLA (0590): a pipeline a draw queued is done (only those have the flag; the preload's
+      // stored pipelines, queued the same way, do not): count it if the driver made it, and it's no longer pending.
+      CountRuntimePipelineCreation(pipeline_to_create->state.load(std::memory_order_acquire));
+      rexgpu_pipelines_pending.fetch_sub(1, std::memory_order_relaxed);
       async_creation_done_cond_.notify_all();
     }
   }
@@ -3438,7 +3514,12 @@ void PipelineCache::CreateQueuedPipelinesOnProcessorThread() {
     }
     ReportPreloadCreation(pipeline_to_create);
     // The processor thread is the only one waiting for these, and it's here.
-    pipeline_to_create->async_creation_pending.store(false, std::memory_order_release);
+    // LOCAL PATCH - MCLA (0590): exchange instead of store, to know whether this one was queued by a draw (the preload's
+    // stored pipelines go through here too and are not counted) and to count it as in CreationThread.
+    if (pipeline_to_create->async_creation_pending.exchange(false, std::memory_order_acq_rel)) {
+      CountRuntimePipelineCreation(pipeline_to_create->state.load(std::memory_order_acquire));
+      rexgpu_pipelines_pending.fetch_sub(1, std::memory_order_relaxed);
+    }
   }
 }
 
