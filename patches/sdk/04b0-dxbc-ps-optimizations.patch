diff --git a/src/graphics/pipeline/shader/dxbc_translator.cpp b/src/graphics/pipeline/shader/dxbc_translator.cpp
index e75f85e2..8709e9ea 100644
--- a/src/graphics/pipeline/shader/dxbc_translator.cpp
+++ b/src/graphics/pipeline/shader/dxbc_translator.cpp
@@ -28,6 +28,49 @@ REXCVAR_DEFINE_BOOL(dxbc_switch, true, "GPU/Shader", "Use switch statements in D
 
 REXCVAR_DEFINE_BOOL(dxbc_source_map, false, "GPU/Shader", "Generate source maps for DXBC");
 
+// LOCAL PATCH - MCLA (04b0): pixel shader translation options, all off by default. They change the DXBC, and are folded
+// into the pixel shader modification (Modification::pixel; DxbcShaderTranslator::ApplyPixelShaderOptimizations) when
+// a draw asks for it, so the translations, the pipelines and the stored pipeline descriptions of each combination are
+// kept apart and a change of a cvar at any time makes (and compiles, on first use) new ones.
+REXCVAR_DEFINE_BOOL(dxbc_ps_refactoring_allowed, false, "GPU/Shader",
+                    "Direct3D 12 (host render targets): set the refactoringAllowed global flag in the pixel shaders "
+                    "that don't write depth (neither oDepth nor the conversion of the depth to float24 in the pixel "
+                    "shader), so the driver compiles them in fast math mode (fused multiply-add, reassociation, "
+                    "uniform integer work on the scalar unit) instead of precise mode. Last-ulp differences in "
+                    "colours only. Static analysis: about 20% fewer vector ALU instructions")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_BOOL(dxbc_ps_mad, false, "GPU/Shader",
+                    "Direct3D 12 (host render targets): with dxbc_ps_refactoring_allowed, translate the Xenos mad, and "
+                    "the terms of dp2add/dp3/dp4 after the first, to the DXBC mad (one fused multiply-add) instead of a "
+                    "multiplication, the Shader Model 3 0 * anything = 0 check and an addition. The check is dropped "
+                    "for these, so 0 * infinity or 0 * NaN in them is NaN, not 0")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_BOOL(dxbc_sample_bias, false, "GPU/Shader",
+                    "Direct3D 12 (host render targets): in pixel shaders, where the texture LOD is computed by the "
+                    "hardware (no gradients from registers, mip filtering on), sample with the DXBC sample_b "
+                    "(LOD bias from the fetch constant and the instruction) instead of sample_d with the coarse "
+                    "derivatives multiplied by 2^bias, which is the same LOD with fewer instructions and address "
+                    "registers")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_BOOL(dxbc_forward_cf, false, "GPU/Shader",
+                    "Direct3D 12 (host render targets): translate pixel shaders whose control flow is execs and "
+                    "forward jumps only (jmp, no loop, call or return) without the main loop that is emitted for "
+                    "jumping back (the code of a label is an if on the program counter, and a jump or the end "
+                    "skips the rest of the region for the lanes that took it), so the compiler doesn't have to "
+                    "keep a loop back-edge")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_BOOL(dxbc_ps_ieee_mul, false, "GPU/Shader",
+                    "Direct3D 12 (host render targets): in pixel shaders, don't emulate the Shader Model 3 rule that "
+                    "+-0 or a denormal times anything is +0 in mul, mad, dp2add/dp3/dp4, dst, muls, mulsc and mulsprev "
+                    "(the min/eq/movc after each multiplication), use plain IEEE multiplication: 0 * infinity and "
+                    "0 * NaN become NaN instead of 0, which can leave NaN pixels (bloom, TAA smears). About 27% "
+                    "fewer vector ALU instructions on its own. Risky: check a frozen frame")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 namespace rex::graphics {
 using namespace ucode;
 
@@ -112,6 +155,26 @@ uint64_t DxbcShaderTranslator::GetDefaultPixelShaderModification(
   return shader_modification.value;
 }
 
