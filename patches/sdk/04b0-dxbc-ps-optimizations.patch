diff --git a/include/rex/graphics/format/dxbc.h b/include/rex/graphics/format/dxbc.h
index a5eaa8fe..016723e6 100644
--- a/include/rex/graphics/format/dxbc.h
+++ b/include/rex/graphics/format/dxbc.h
@@ -1383,6 +1383,7 @@ enum class Opcode : uint32_t {
   kRSq = 68,
   kSampleL = 72,
   kSampleD = 73,
+  kSampleB = 74,
   kSqRt = 75,
   kSwitch = 76,
   kSinCos = 77,
@@ -1819,6 +1820,25 @@ class Assembler {
     ++stat_.instruction_count;
     ++stat_.texture_normal_instructions;
   }
+  // LOCAL PATCH - MCLA (04b0): sample_b - the same operand layout as sample_l, with the LOD bias in place of the
+  // LOD (added to the implicitly calculated LOD, after the sampler's own LOD bias).
+  void OpSampleB(const Dest& dest, const Src& address, uint32_t address_components,
+                 const Src& resource, const Src& sampler, const Src& bias) {
+    uint32_t dest_write_mask = dest.GetMask();
+    uint32_t address_mask = (1 << address_components) - 1;
+    uint32_t operands_length = dest.GetLength() + address.GetLength(address_mask) +
+                               resource.GetLength(dest_write_mask, true) +
+                               sampler.GetLength(0b0000) + bias.GetLength(0b0000);
+    code_.reserve(code_.size() + 1 + operands_length);
+    code_.push_back(OpcodeToken(Opcode::kSampleB, operands_length, false, 0));
+    dest.Write(code_);
+    address.Write(code_, false, address_mask);
+    resource.Write(code_, false, dest_write_mask, true);
+    sampler.Write(code_, false, 0b0000);
+    bias.Write(code_, false, 0b0000);
+    ++stat_.instruction_count;
+    ++stat_.texture_normal_instructions;
+  }
   void OpSampleD(const Dest& dest, const Src& address, uint32_t address_components,
                  const Src& resource, const Src& sampler, const Src& x_derivatives,
                  const Src& y_derivatives, uint32_t derivatives_components, int32_t aoffimmi_u = 0,
diff --git a/include/rex/graphics/pipeline/shader/dxbc_translator.h b/include/rex/graphics/pipeline/shader/dxbc_translator.h
index 8d3ea5d5..85bd7f26 100644
--- a/include/rex/graphics/pipeline/shader/dxbc_translator.h
+++ b/include/rex/graphics/pipeline/shader/dxbc_translator.h
@@ -177,6 +177,25 @@ class DxbcShaderTranslator : public ShaderTranslator {
       uint32_t dynamic_addressable_register_count : 8;
       // Non-ROV - depth / stencil output mode.
       DepthStencilMode depth_stencil_mode : 2;
+      // LOCAL PATCH - MCLA (04b0): pixel shader translation options (cvars dxbc_ps_refactoring_allowed,
+      // dxbc_ps_mad, dxbc_sample_bias, dxbc_forward_cf, dxbc_ps_ieee_mul). They change the DXBC, so they are part of
+      // the key of the translation, of the pipeline and of the stored pipeline description (the cvars are read when the
+      // modification is made, never by the translation). All 0 gives the stock translation, so the stored
+      // descriptions of older runs stay valid. Set only for host render targets (not ROV), and only where they have
+      // an effect, by ApplyPixelShaderOptimizations; vertex shaders have none of these.
+      // Set the refactoringAllowed global flag (stock: none, so the driver compiles in precise mode). Not set for
+      // shaders writing oDepth, or converting the depth to float24 in the epilogue (position / depth invariance).
+      uint32_t ps_refactoring_allowed : 1;
+      // Emit DXBC mad for the Xenos mad, and for the dp# terms after the first (instead of mul + SM3 zero check +
+      // add). Drops the SM3 0 * anything = 0 emulation for these. Only together with ps_refactoring_allowed.
+      uint32_t ps_mad : 1;
+      // sample_b (bias operand) instead of sample_d with the coarse gradients multiplied by 2^bias, where the LOD is
+      // computed implicitly and there are no register gradients.
+      uint32_t sample_bias : 1;
+      // For a shader with forward jumps only (Shader::control_flow_forward_jumps_only): no main loop.
+      uint32_t forward_cf : 1;
+      // No SM3 0 * anything = 0 emulation in mul, mad, dp#, muls and mulsc (IEEE multiplication).
+      uint32_t ps_ieee_mul : 1;
     } pixel;
 
     explicit Modification(uint64_t modification_value = 0) : value(modification_value) {
@@ -536,6 +555,13 @@ class DxbcShaderTranslator : public ShaderTranslator {
   // state of the translator.
   std::vector<uint8_t> CreateDepthOnlyPixelShader();
 
+  // LOCAL PATCH - MCLA (04b0): sets the pixel shader translation options of the modification (see
+  // Modification::pixel) from the cvars dxbc_ps_refactoring_allowed, dxbc_ps_mad, dxbc_sample_bias, dxbc_forward_cf and
+  // dxbc_ps_ieee_mul, for the shader with its ucode analyzed, where they apply to it; the other bits are not touched.
+  // The cvars are read here (every time a draw makes the modification) and nowhere else, the translation only follows
+  // the bits, so toggling a cvar never reuses a translation or a pipeline made without it.
+  static void ApplyPixelShaderOptimizations(Modification& modification, const Shader& shader);
+
   // Common functions useful not only for the translator, but also for render
   // target reinterpretation.
 
@@ -684,6 +710,31 @@ class DxbcShaderTranslator : public ShaderTranslator {
   // Whether to use switch-case rather than if (pc >= label) for control flow.
   bool UseSwitchForControlFlow() const;
 
+  // LOCAL PATCH - MCLA (04b0): the pixel shader translation options of the modification (see Modification::pixel). All
+  // false for vertex shaders (the union members overlap) and for the depth-only pixel shader.
+  bool HasPixelShaderOptimizationBits() const {
+    return is_pixel_shader() && !is_depth_only_pixel_shader_;
+  }
+  bool IsPsRefactoringAllowed() const {
+    return HasPixelShaderOptimizationBits() &&
+           GetDxbcShaderModification().pixel.ps_refactoring_allowed;
+  }
+  bool IsPsMad() const {
+    return HasPixelShaderOptimizationBits() && GetDxbcShaderModification().pixel.ps_mad;
+  }
+  bool IsSampleBias() const {
+    return HasPixelShaderOptimizationBits() && GetDxbcShaderModification().pixel.sample_bias;
+  }
+  bool IsPsIeeeMul() const {
+    return HasPixelShaderOptimizationBits() && GetDxbcShaderModification().pixel.ps_ieee_mul;
+  }
+  // Whether the shader is translated without the main loop: forward jumps are ifs on pc, and jumping and ending skip
+  // the rest of the region (up to the next label) of the lanes that jumped or ended.
+  bool UseForwardControlFlow() const {
+    return HasPixelShaderOptimizationBits() && GetDxbcShaderModification().pixel.forward_cf &&
+           current_shader().control_flow_forward_jumps_only();
+  }
+
   // Allocates new consecutive r# registers for internal use and returns the
   // index of the first.
   uint32_t PushSystemTemp(uint32_t zero_mask = 0, uint32_t count = 1);
@@ -867,6 +918,10 @@ class DxbcShaderTranslator : public ShaderTranslator {
   // conditional, but can't itself be predicated.
   void CloseInstructionPredication();
   void JumpToLabel(uint32_t address);
+  // UseForwardControlFlow: after a jump or the end, closes the exec and the label region, and opens the rest of the
+  // region for the lanes that have neither jumped nor ended (pc is still at or below the label of the region; the
+  // end sets it to the maximum value).
+  void SplitForwardControlFlowRegion();
 
   uint32_t FindOrAddTextureBinding(uint32_t fetch_constant, xenos::FetchOpDimension dimension,
                                    bool is_signed);
@@ -1157,6 +1212,8 @@ class DxbcShaderTranslator : public ShaderTranslator {
   // the exec-level predicate value, and can't merge two execs with the same
   // predicate condition anymore.
   bool cf_exec_predicate_written_;
+  // UseForwardControlFlow: the address of the label that opened the current region (0 for the first one).
+  uint32_t cf_forward_region_start_;
 
   // Number of SRV resources used in this shader - also used for generation of
   // indices of SRV resources that are optional.
