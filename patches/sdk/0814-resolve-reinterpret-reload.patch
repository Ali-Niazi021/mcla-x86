+// LOCAL PATCH - MCLA (0814): resolve_reinterpret_reload
+void D3D12TextureCache::NoteScaledResolveForReload(const ResolveElideGeometry& geometry,
+                                                   const ResolveDualWriteTarget* dual_target) {
+  if (reload_resolves_.size() != kReloadResolveRingSize) {
+    reload_resolves_.assign(kReloadResolveRingSize, ReloadResolveEntry());
+  }
+  ReloadResolveEntry& entry = reload_resolves_[size_t(reload_resolve_serial_ % kReloadResolveRingSize)];
+  ++reload_resolve_serial_;
+  entry.serial = reload_resolve_serial_;
+  entry.extent_start = geometry.extent_start;
+  entry.extent_end = geometry.extent_start + geometry.extent_length;
+  entry.pitch_div_32 = geometry.pitch_div_32;
+  entry.bytes_per_texel = geometry.bytes_per_texel;
+  entry.array = geometry.array;
+  entry.dual = dual_target && dual_target->texture;
+  entry.dual_key = entry.dual ? dual_target->texture->key() : TextureKey();
+  // A texture the resolve left up to date (written whole, or in part while up to date) holds this resolve's data.
+  if (entry.dual) {
+    auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+    if (!dual_target->texture->base_outdated(global_lock)) {
+      static_cast<D3D12Texture*>(dual_target->texture)->SetReloadResolveSerial(reload_resolve_serial_);
+    }
+  }
+}
+
+D3D12TextureCache::ReloadDecision D3D12TextureCache::DecideScaledReload(
+    const D3D12Texture& texture, std::vector<std::pair<uint32_t, uint32_t>>* reinterpret_out) {
+  const TextureKey key = texture.key();
+  const uint64_t since = texture.reload_resolve_serial();
+  const FormatInfo* format_info = FormatInfo::Get(key.format);
+  if (key.mip_max_level || key.GetDepthOrArraySize() != 1 || !key.tiled ||
+      key.dimension != xenos::DataDimension::k2DOrStacked || !format_info || format_info->block_width != 1 ||
+      format_info->block_height != 1 || texture.GetGuestMipsSize()) {
+    return ReloadDecision::kNotBaseOnly;
+  }
+  if (!since) {
+    return ReloadDecision::kUnknown;
+  }
+  if (texture.cpu_written_since_up_to_date()) {
+    return ReloadDecision::kCpuWrite;
+  }
+  // Every resolve after `since` must still be in the ring.
+  const uint64_t oldest = reload_resolve_serial_ > kReloadResolveRingSize
+                              ? reload_resolve_serial_ - kReloadResolveRingSize + 1
+                              : 1;
+  if (since + 1 < oldest || reload_resolves_.size() != kReloadResolveRingSize) {
+    return ReloadDecision::kHistoryLost;
+  }
+  const uint32_t start = key.base_page << 12;
+  const uint32_t end = start + texture.GetGuestBaseSize();
+  const uint32_t bytes_per_texel = format_info->bytes_per_block();
+  uint32_t reinterpreting = 0;
+  for (uint64_t serial = since + 1; serial <= reload_resolve_serial_; ++serial) {
+    const ReloadResolveEntry& entry = reload_resolves_[size_t((serial - 1) % kReloadResolveRingSize)];
+    if (entry.serial != serial || entry.extent_end <= start || entry.extent_start >= end) {
+      continue;
+    }
+    // Written into this texture along with the memory (dual write): its data has it.
+    if (entry.dual && entry.dual_key == key) {
+      continue;
+    }
+    // The same pitch and texel size (whatever the base: an area at an offset in it): the texture's own layout, a write
+    // the texture must be loaded for.
+    if (!entry.array && entry.pitch_div_32 == key.pitch && entry.bytes_per_texel == bytes_per_texel) {
+      return ReloadDecision::kSameLayout;
+    }
+    ++reinterpreting;
+    if (reinterpret_out) {
+      const uint32_t range_start = std::max(entry.extent_start, start);
+      const uint32_t range_end = std::min(entry.extent_end, end);
+      reinterpret_out->emplace_back(range_start, range_end - range_start);
+    }
+  }
+  // Outdated by no resolve (memexport, or anything else of the GPU's): loaded.
+  return reinterpreting ? ReloadDecision::kSkip : ReloadDecision::kNotByResolve;
+}
+
+bool D3D12TextureCache::PoisonScaledResolveRange(uint32_t start_unscaled, uint32_t length_unscaled) {
+  if (!length_unscaled || !MakeScaledResolveRangeCurrent(start_unscaled, length_unscaled, 2)) {
+    return false;
+  }
+  ResolveElideRecord record;
+  record.extent_start = start_unscaled;
+  record.extent_end = start_unscaled + length_unscaled;
+  const uint64_t poisoned_before = resolve_elide_stats_.poisoned;
+  PoisonResolveElideRecord(record);
+  return resolve_elide_stats_.poisoned != poisoned_before;
+}
+
+void D3D12TextureCache::LogReloadIfDue() {
+  static const char* const kReloadDecisionNames[] = {
+      "not loaded",         "not a base-only 2D texture", "no known state", "written by the CPU",
+      "history lost",       "a resolve of its own layout", "outdated by no resolve",
+  };
+  static_assert(rex::countof(kReloadDecisionNames) == size_t(ReloadDecision::kCount), "A name for every decision");
+  const uint64_t now = rex::chrono::Clock::QueryHostUptimeMillis();
+  if (!reload_last_log_ms_) {
+    reload_last_log_ms_ = now;
+    return;
+  }
+  if (now - reload_last_log_ms_ < 10000) {
+    return;
+  }
+  std::string loaded;
+  uint64_t decided = 0;
+  for (size_t i = 0; i < size_t(ReloadDecision::kCount); ++i) {
+    decided += reload_stats_.decided[i];
+    if (i && reload_stats_.decided[i]) {
+      loaded += fmt::format("{}{} {}", loaded.empty() ? "" : ", ", kReloadDecisionNames[i], reload_stats_.decided[i]);
+    }
+  }
+  if (decided || reload_stats_.reinterpret_reads) {
+    REXGPU_INFO(
+        "[resolve-reload] {:.1f} s: {} scaled loads, {} outdated only by resolves of another layout ({}: {:.1f} MB), "
+        "loaded {} ({}); {} reads of the scaled buffer by a texture of another layout than the stores (not reads of "
+        "resolve_elide's)",
+        double(now - reload_last_log_ms_) / 1000.0, decided, reload_stats_.decided[size_t(ReloadDecision::kSkip)],
+        REXCVAR_GET(resolve_reinterpret_reload) == 1
+            ? "not loaded"
+            : fmt::format("loaded, poisoned {} ranges", reload_stats_.poisoned),
+        double(reload_stats_.skipped_bytes) / 1048576.0,
+        decided - reload_stats_.decided[size_t(ReloadDecision::kSkip)], loaded.empty() ? "none" : loaded,
+        reload_stats_.reinterpret_reads);
+  }
+  reload_stats_ = ReloadStats();
+  reload_last_log_ms_ = now;
+}
