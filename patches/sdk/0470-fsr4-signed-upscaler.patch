-      ffxReturnCode_t result = fsr.runtime.create(&fsr.context, &create.header, nullptr);
+      // With AMD's signed runtime: the version of the API this was built against, and the
+      // version to use if one is pinned (without one the runtime picks the newest the device
+      // supports: FSR 4 on RDNA 2 and newer and the Radeon 800M series).
+      ffxCreateContextDescUpscaleVersion api_version = {};
+      api_version.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE_VERSION;
+      api_version.version = FFX_UPSCALER_VERSION;
+      ffxOverrideVersion override_version = {};
+      override_version.header.type = FFX_API_DESC_TYPE_OVERRIDE_VERSION;
+      // create, then the API version (signed runtime only), the override (if pinned), the backend.
+      auto create_context = [&](uint64_t pinned_id) {
+        ffxApiHeader* tail = &create.header;
+        if (signed_loader) {
+          tail->pNext = &api_version.header;
+          tail = &api_version.header;
