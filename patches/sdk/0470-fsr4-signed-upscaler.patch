+std::vector<FsrUpscalerVersion> FsrListUpscalerVersions(const FsrRuntime& runtime, void* device) {
+  std::vector<FsrUpscalerVersion> versions;
+  if (!runtime.query) {
+    return versions;
+  }
+  ffxQueryDescGetVersions query = {};
+  query.header.type = FFX_API_QUERY_DESC_TYPE_GET_VERSIONS;
+  query.createDescType = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+  query.device = device;
+  uint64_t count = 0;
+  query.outputCount = &count;
+  // The count, then the ids and the names together (their order may differ between queries).
+  if (runtime.query(nullptr, &query.header) != FFX_API_RETURN_OK || !count) {
+    return versions;
+  }
+  std::vector<uint64_t> ids(count);
+  std::vector<const char*> names(count);
+  query.versionIds = ids.data();
+  query.versionNames = names.data();
+  if (runtime.query(nullptr, &query.header) != FFX_API_RETURN_OK) {
+    return versions;
+  }
+  count = std::min<uint64_t>(count, ids.size());
+  for (uint64_t i = 0; i < count; ++i) {
+    FsrUpscalerVersion& version = versions.emplace_back();
+    version.id = ids[i];
+    // A copy: the runtime may overwrite the name with a later query.
+    version.name = names[i] ? names[i] : "";
+    // The name's first number ("4.1.2", "FSR 4.1.2 *"); else the id's own, FFX_UPSCALER_MAKE_VERSION's
+    // major (bit 31 marks a driver-provided version).
+    size_t digit = 0;
+    while (digit < version.name.size() && !std::isdigit(static_cast<unsigned char>(version.name[digit]))) {
+      ++digit;
+    }
+    version.major = digit < version.name.size() ? uint32_t(std::atoi(version.name.c_str() + digit))
+                                                : uint32_t((ids[i] & 0x7FFFFFFFu) >> 22);
+  }
+  return versions;
+}
+
+uint64_t FsrPickUpscalerVersion(const std::vector<FsrUpscalerVersion>& versions,
+                                std::string_view want, std::string* name_out) {
+  const uint32_t major = want == "fsr4" ? 4 : want == "fsr3" ? 3 : 0;
+  const FsrUpscalerVersion* best = nullptr;
+  for (const FsrUpscalerVersion& version : versions) {
+    if (version.major == major &&
+        (!best || (version.id & 0x7FFFFFFFu) > (best->id & 0x7FFFFFFFu))) {
+      best = &version;
+    }
+  }
+  if (!best) {
+    return 0;
+  }
+  if (name_out) {
+    *name_out = best->name;
+  }
+  return best->id;
+}
+
+std::string FsrLabel(std::string_view name) {
+  if (name.empty()) {
+    return "FSR";
+  }
+  return std::isdigit(static_cast<unsigned char>(name[0])) ? "FSR " + std::string(name)
+                                                           : std::string(name);
+}
