diff --git a/cmake/rexglue_fsr_signed.cmake b/cmake/rexglue_fsr_signed.cmake
new file mode 100644
index 00000000..d51f9e6a
--- /dev/null
+++ b/cmake/rexglue_fsr_signed.cmake
@@ -0,0 +1,121 @@
+# rexglue_fsr_signed.cmake - AMD's signed FSR runtime, for FSR 4 (patch 0470-fsr4-signed-upscaler)
+#
+# FSR 4 (the machine-learning upscaler) is only distributed as AMD's signed binaries, never as source,
+# so cmake/rexglue_fsr.cmake (FSR 3.1 built from source) cannot make it. FidelityFX SDK 2.4.0 ships two
+# of them for Direct3D 12:
+#   amd_fidelityfx_loader_dx12.dll    the ffx-api entry points (the same five exports as the runtime built
+#                                     from source); picks the effect version and loads the effect DLL
+#   amd_fidelityfx_upscaler_dx12.dll  FSR 4.1.2, FSR 3.1.6 and FSR 2.3.4 (57.7 MB)
+# This file fetches them, with the SDK's licence, and installs them next to the SDK's own DLLs; the GPU
+# plugin loads the loader from the executable's folder (src/graphics/temporal_aa.cpp, FsrRuntime::Load) and
+# falls back to the runtime built from source when they are not there.
+#
+# The files come from the commit of the v2.4.0 tag of AMD's FidelityFX-SDK repository and are checked
+# against pinned SHA-256 hashes, so what is installed is exactly what was reviewed. Nothing is vendored. The
+# licence (docs/license.md of that commit) lists these two DLLs among the files under the MIT licence.
+# REXGLUE_FSR_SIGNED_DIR may point at a folder that already holds the three files (checked the same way),
+# which saves the 57.7 MB download for every new build tree.
+#
+# Optional, like the rest of FSR: when a file can't be fetched or verified the SDK builds without them and
+# the GPU plugin runs the FSR 3.1 it built from source. Windows with the Direct3D 12 backend only.
+
+set(REXGLUE_FSR_SIGNED_STATUS "OFF")
+if(NOT WIN32 OR NOT REXGLUE_ENABLE_FSR OR NOT REXGLUE_USE_D3D12)
+    return()
+endif()
+
+option(REXGLUE_FSR_SIGNED "Fetch AMD's signed FSR runtime (FSR 4.1.2, 3.1.6, 2.3.4; FidelityFX SDK 2.4.0, MIT) and install it next to the executable" ON)
+set(REXGLUE_FSR_SIGNED_DIR "" CACHE PATH
+    "A folder holding amd_fidelityfx_loader_dx12.dll, amd_fidelityfx_upscaler_dx12.dll and license.md of FidelityFX SDK 2.4.0's signedbin (checked by SHA-256; fetched into the build tree otherwise)")
+if(NOT REXGLUE_FSR_SIGNED)
+    set(REXGLUE_FSR_SIGNED_STATUS "OFF (REXGLUE_FSR_SIGNED)")
+    return()
+endif()
+
+# FidelityFX-SDK tag v2.4.0.
+set(_rexglue_fsr_signed_commit "7539ae8b6568ad29ed78a753404351daf3b5cca7")
+set(_rexglue_fsr_signed_url "https://raw.githubusercontent.com/GPUOpen-LibrariesAndSDKs/FidelityFX-SDK/${_rexglue_fsr_signed_commit}")
+# name; path in the repository; SHA-256
+set(_rexglue_fsr_signed_files
+    "amd_fidelityfx_loader_dx12.dll|Kits/FidelityFX/signedbin/amd_fidelityfx_loader_dx12.dll|e2191d3c0828be45eb8affd4e3ec0378f2293adc345b772a7170edcf3b021ecb"
+    "amd_fidelityfx_upscaler_dx12.dll|Kits/FidelityFX/signedbin/amd_fidelityfx_upscaler_dx12.dll|aad4fccccb29084a655f9a4f9f613bd22c8c03fb4a0f8840148cc6543b4ccace"
+    "license.md|docs/license.md|410f9c138e766e846acf2dc93db768198def0293a017d7e3296815b451688dbe")
+set(_rexglue_fsr_signed_dest "${CMAKE_BINARY_DIR}/_deps/ffx-signed")
+
+# Whether `file` exists and its SHA-256 is `hash`.
+function(_rexglue_fsr_signed_matches ok_var file hash)
+    set(${ok_var} FALSE PARENT_SCOPE)
+    if(EXISTS "${file}")
+        file(SHA256 "${file}" actual)
+        if(actual STREQUAL "${hash}")
+            set(${ok_var} TRUE PARENT_SCOPE)
+        endif()
+    endif()
+endfunction()
+
+# Puts the verified file in the build tree: already there, or copied from REXGLUE_FSR_SIGNED_DIR, or
+# downloaded through a temporary name that is renamed only once verified.
+function(_rexglue_fsr_signed_fetch ok_var name path hash)
+    set(${ok_var} FALSE PARENT_SCOPE)
+    set(dest "${_rexglue_fsr_signed_dest}/${name}")
+    _rexglue_fsr_signed_matches(ok "${dest}" "${hash}")
+    if(ok)
+        set(${ok_var} TRUE PARENT_SCOPE)
+        return()
+    endif()
+    file(MAKE_DIRECTORY "${_rexglue_fsr_signed_dest}")
+    if(REXGLUE_FSR_SIGNED_DIR)
+        _rexglue_fsr_signed_matches(ok "${REXGLUE_FSR_SIGNED_DIR}/${name}" "${hash}")
+        if(ok)
+            file(COPY_FILE "${REXGLUE_FSR_SIGNED_DIR}/${name}" "${dest}" ONLY_IF_DIFFERENT)
+            set(${ok_var} TRUE PARENT_SCOPE)
+            return()
+        endif()
+    endif()
+    set(tmp "${dest}.tmp")
+    file(REMOVE "${tmp}")
+    message(STATUS "FSR: fetching ${name} (FidelityFX SDK 2.4.0, ${_rexglue_fsr_signed_commit})")
+    # (Not EXPECTED_HASH: a mismatch there is a configure error, not a status.)
+    file(DOWNLOAD "${_rexglue_fsr_signed_url}/${path}" "${tmp}"
+         STATUS status TLS_VERIFY ON INACTIVITY_TIMEOUT 60 TIMEOUT 900)
+    list(GET status 0 code)
+    list(GET status 1 reason)
+    _rexglue_fsr_signed_matches(ok "${tmp}" "${hash}")
+    if(NOT code EQUAL 0 OR NOT ok)
+        if(code EQUAL 0)
+            set(reason "the SHA-256 is not the pinned ${hash}")
+        endif()
+        set(_rexglue_fsr_signed_why "${name}: ${reason}" PARENT_SCOPE)
+        file(REMOVE "${tmp}")
+        return()
+    endif()
+    file(RENAME "${tmp}" "${dest}")
+    set(${ok_var} TRUE PARENT_SCOPE)
+endfunction()
+
+set(_rexglue_fsr_signed_ok TRUE)
+set(_rexglue_fsr_signed_why "")
+foreach(entry IN LISTS _rexglue_fsr_signed_files)
+    string(REPLACE "|" ";" fields "${entry}")
+    list(GET fields 0 name)
+    list(GET fields 1 path)
+    list(GET fields 2 hash)
+    _rexglue_fsr_signed_fetch(ok "${name}" "${path}" "${hash}")
+    if(NOT ok)
+        set(_rexglue_fsr_signed_ok FALSE)
+        break()
+    endif()
+endforeach()
+
+if(_rexglue_fsr_signed_ok)
+    install(FILES "${_rexglue_fsr_signed_dest}/amd_fidelityfx_loader_dx12.dll"
+                  "${_rexglue_fsr_signed_dest}/amd_fidelityfx_upscaler_dx12.dll"
+            DESTINATION "${CMAKE_INSTALL_BINDIR}")
+    # AMD's licence travels with the binaries.
+    install(FILES "${_rexglue_fsr_signed_dest}/license.md" DESTINATION "${CMAKE_INSTALL_BINDIR}"
+            RENAME amd_fidelityfx_signed_LICENSE.md)
+    set(REXGLUE_FSR_SIGNED_STATUS "ON (FidelityFX SDK 2.4.0 signed loader + upscaler: FSR 4.1.2, 3.1.6, 2.3.4)")
+else()
+    message(WARNING "FSR: AMD's signed FSR runtime is unavailable (${_rexglue_fsr_signed_why}); FSR 4 will not be offered, the FSR 3.1 built from source stays (set REXGLUE_FSR_SIGNED_DIR to a folder with the three files of FidelityFX SDK 2.4.0's signedbin to avoid the download)")
+    set(REXGLUE_FSR_SIGNED_STATUS "ON, but the files could not be fetched (see the warning above)")
+endif()
