+  // MarkRangeAsResolved for the written range with the texture kept up to date, and, with
+  // resolve_dual_write_verify, the check of the texture against a load of the usual kind.
+  void FinishResolveDualWrite(const ResolveDualWriteTarget& target, uint32_t written_start,
+                              uint32_t written_length);
+  void CountResolveDualWriteFallback(ResolveDualWriteFallback reason) {
+    ++resolve_dual_write_stats_.fallbacks[size_t(reason)];
+  }
+  // Every 10 s logs the counts since the last line, if there were any.
+  void LogResolveDualWriteIfDue();
+
