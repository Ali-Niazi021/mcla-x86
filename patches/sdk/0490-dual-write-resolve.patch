+ID3D12PipelineState* D3D12RenderTargetCache::GetDirectResolveDualPipeline(
+    draw_util::ResolveCopyShaderIndex copy_shader) {
+  size_t index = size_t(GetDirectResolveCopyShader(copy_shader));
+  if (index >= size_t(draw_util::ResolveCopyShaderIndex::kCount)) {
+    return nullptr;
+  }
+  const ResolveDirectShaderCode& shader_code = kResolveDirectDualShaders[index];
+  if (!shader_code.unscaled) {
+    return nullptr;
+  }
+  if (direct_resolve_dual_pipelines_[index] || direct_resolve_dual_failed_ ||
+      !direct_resolve_root_signature_) {
+    return direct_resolve_dual_pipelines_[index];
+  }
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  if (!direct_resolve_dual_root_signature_) {
+    // Parameters 0 to 3 as of direct_resolve_root_signature_ (the constants including the source
+    // ones, the shared memory UAV at u0, the source SRVs at t0 and t1), 4 the UAV of the texture
+    // at u1.
+    D3D12_ROOT_PARAMETER root_parameters[5];
+    root_parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    root_parameters[0].Constants.ShaderRegister = 0;
+    root_parameters[0].Constants.RegisterSpace = 0;
+    root_parameters[0].Constants.Num32BitValues =
+        (sizeof(draw_util::ResolveCopyShaderConstants) + sizeof(DirectResolveSourceConstants) +
+         sizeof(DirectResolveDualConstants)) /
+        sizeof(uint32_t);
+    root_parameters[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_DESCRIPTOR_RANGE ranges[4];
+    const D3D12_DESCRIPTOR_RANGE_TYPE range_types[4] = {
+        D3D12_DESCRIPTOR_RANGE_TYPE_UAV, D3D12_DESCRIPTOR_RANGE_TYPE_SRV,
+        D3D12_DESCRIPTOR_RANGE_TYPE_SRV, D3D12_DESCRIPTOR_RANGE_TYPE_UAV};
+    const UINT range_registers[4] = {0, 0, 1, 1};
+    for (uint32_t i = 0; i < 4; ++i) {
+      ranges[i].RangeType = range_types[i];
+      ranges[i].NumDescriptors = 1;
+      ranges[i].BaseShaderRegister = range_registers[i];
+      ranges[i].RegisterSpace = 0;
+      ranges[i].OffsetInDescriptorsFromTableStart = 0;
+      root_parameters[1 + i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+      root_parameters[1 + i].DescriptorTable.NumDescriptorRanges = 1;
+      root_parameters[1 + i].DescriptorTable.pDescriptorRanges = &ranges[i];
+      root_parameters[1 + i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    }
+    D3D12_ROOT_SIGNATURE_DESC root_signature_desc;
+    root_signature_desc.NumParameters = UINT(rex::countof(root_parameters));
+    root_signature_desc.pParameters = root_parameters;
+    root_signature_desc.NumStaticSamplers = 0;
+    root_signature_desc.pStaticSamplers = nullptr;
+    root_signature_desc.Flags = D3D12_ROOT_SIGNATURE_FLAG_NONE;
+    direct_resolve_dual_root_signature_ =
+        ui::d3d12::util::CreateRootSignature(provider, root_signature_desc);
+  }
+  ID3D12PipelineState* pipeline = nullptr;
+  if (direct_resolve_dual_root_signature_) {
+    pipeline = ui::d3d12::util::CreateComputePipeline(provider.GetDevice(), shader_code.unscaled,
+                                                      shader_code.unscaled_size,
+                                                      direct_resolve_dual_root_signature_);
+  }
+  if (!pipeline) {
+    direct_resolve_dual_failed_ = true;
+    REXGPU_ERROR(
+        "D3D12RenderTargetCache: Failed to create the dual-write direct {} pipeline, resolve_dual_write "
+        "stops writing textures",
+        draw_util::resolve_copy_shader_info[index].debug_name);
+    return nullptr;
+  }
+  std::u16string pipeline_name = rex::string::to_utf16(fmt::format(
+      "Direct dual-write {} from 1x RT", draw_util::resolve_copy_shader_info[index].debug_name));
+  pipeline->SetName(reinterpret_cast<LPCWSTR>(pipeline_name.c_str()));
+  direct_resolve_dual_pipelines_[index] = pipeline;
+  REXGPU_INFO("D3D12RenderTargetCache: the dual-write direct {} pipeline is made",
+              draw_util::resolve_copy_shader_info[index].debug_name);
+  return pipeline;
+}
