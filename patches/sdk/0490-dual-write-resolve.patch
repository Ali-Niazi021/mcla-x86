+  // resolve_dual_write (rexglue-dual-write-resolve.patch): a direct resolve that covers a resolved
+  // texture of the cache entirely also writes that texture, so it isn't loaded from the shared
+  // memory afterwards. D3D12RenderTargetCache::Resolve asks for the texture with
+  // FindResolveDualWriteTarget, calls BeginResolveDualWrite before the dispatch of the resolve
+  // shader that writes it, and FinishResolveDualWrite in place of MarkRangeAsResolved after.
+  //
+  // Why a resolve didn't write a texture along with the shared memory (counted and logged by
+  // LogResolveDualWriteIfDue, in this order).
+  enum class ResolveDualWriteFallback : uint32_t {
+    // draw_resolution_scale above 1: scaled resolves have no textures to write.
+    kScaled,
+    // The resolve isn't a direct one (the render targets are dumped to the EDRAM buffer first).
+    kNoDirectSource,
+    // Reading the render target through the FSR stretch.
+    kStretch,
+    // The render target the direct resolve reads is multisampled.
+    kMultisampled,
+    // The kind of resolve (8, 16, 128 bits a pixel) has no shader that writes a texture.
+    kShader,
+    // A resolve into an array, a part of a texture, or not at a page boundary.
+    kDestination,
+    // No resolved texture of the cache is at the address (nothing has sampled it since a resolve
+    // first wrote it).
+    kNoTexture,
+    // The texture at the address has another pitch, size of texel or kind.
+    kLayout,
+    // The resolve doesn't cover the texture (or starts later than the origin).
+    kPartial,
+    // The texture can't be written through a UAV.
+    kNotUAV,
+    // The pipeline that writes the texture couldn't be made.
+    kPipeline,
+
+    kCount,
+  };
+  // What a resolve writes, to look for the texture it can write along with it.
+  struct ResolveDualWriteQuery {
+    // The page of the resolve's destination (its copy_dest_base).
+    uint32_t base_page;
+    // The row pitch of the destination in 32-texel units.
+    uint32_t pitch_div_32;
+    // 4 or 8.
+    uint32_t bytes_per_texel;
+    // The area of the resolve, from the texel (0, 0), in texels.
+    uint32_t width, height;
+  };
+  struct ResolveDualWriteTarget {
+    Texture* texture = nullptr;
+    // The unsigned integer view format to write the texture through (the one it's loaded through).
+    DXGI_FORMAT uav_format = DXGI_FORMAT_UNKNOWN;
+    // The values of the xe_resolve_dual_info and xe_resolve_dual_size constants of the shader
+    // (resolve_direct.xesli).
+    uint32_t constant_info = 0;
+    uint32_t constant_size = 0;
+  };
+  // Finds the texture, returning true, or the reason it didn't.
+  bool FindResolveDualWriteTarget(const ResolveDualWriteQuery& query,
+                                  ResolveDualWriteTarget& target_out,
+                                  ResolveDualWriteFallback& fallback_out);
+  // Writes the UAV of the texture to the handle and moves the texture to the UAV state (barriers
+  // pushed, not submitted).
+  void BeginResolveDualWrite(const ResolveDualWriteTarget& target,
