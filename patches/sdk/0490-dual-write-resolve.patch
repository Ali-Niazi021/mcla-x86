+bool D3D12TextureCache::FindResolveDualWriteTarget(const ResolveDualWriteQuery& query,
+                                                   ResolveDualWriteTarget& target_out,
+                                                   ResolveDualWriteFallback& fallback_out) {
+  constexpr size_t kMaxCandidates = 8;
+  Texture* candidates[kMaxCandidates];
+  size_t candidate_count =
+      GetResolvedTexturesAtBasePage(query.base_page, candidates, kMaxCandidates);
+  if (!candidate_count) {
+    fallback_out = ResolveDualWriteFallback::kNoTexture;
+    return false;
+  }
+  // The most recently used of the textures the resolve covers; the reason for the others, if none
+  // is fit, is the one closest to fitting: partial, then layout, then no UAV.
+  D3D12Texture* best = nullptr;
+  uint32_t best_transform = 0;
+  uint32_t reject_rank = 0;
+  ResolveDualWriteFallback reject_reason = ResolveDualWriteFallback::kNoTexture;
+  auto reject = [&](ResolveDualWriteFallback reason, uint32_t rank) {
+    if (rank > reject_rank) {
+      reject_rank = rank;
+      reject_reason = reason;
+    }
+  };
+  for (size_t i = 0; i < candidate_count; ++i) {
+    D3D12Texture* texture = static_cast<D3D12Texture*>(candidates[i]);
+    const TextureKey& key = texture->key();
+    const FormatInfo* format_info = FormatInfo::Get(key.format);
+    if (key.pitch != query.pitch_div_32 || !key.tiled ||
+        key.dimension != xenos::DataDimension::k2DOrStacked || key.mip_max_level != 0 ||
+        key.GetDepthOrArraySize() != 1 || key.scaled_resolve || key.signed_separate ||
+        !key.resolved_unscaled || format_info->block_width != 1 || format_info->block_height != 1 ||
+        format_info->bytes_per_block() != query.bytes_per_texel || texture->GetGuestMipsSize()) {
+      reject(ResolveDualWriteFallback::kLayout, 2);
+      continue;
+    }
+    if (texture->direct_load_uav_format() == DXGI_FORMAT_UNKNOWN) {
+      reject(ResolveDualWriteFallback::kNotUAV, 1);
+      continue;
+    }
+    // What the load of the texture would do with the dwords, the same way (the shaders of
+    // texture_load_direct_unscaled).
+    DirectLoadShader direct_load_shader = GetDirectLoadShader(GetLoadShaderIndex(key));
+    if (direct_load_shader == kDirectLoadShaderUnknown ||
+        (direct_load_shader == kDirectLoadShader64bpb) != (query.bytes_per_texel == 8)) {
+      reject(ResolveDualWriteFallback::kNotUAV, 1);
+      continue;
+    }
+    if (key.GetWidth() > query.width || key.GetHeight() > query.height) {
+      reject(ResolveDualWriteFallback::kPartial, 3);
+      continue;
+    }
+    if (best && texture->last_usage_submission_index() < best->last_usage_submission_index()) {
+      continue;
+    }
+    best = texture;
+    switch (direct_load_shader) {
+      case kDirectLoadShaderDepthFloat:
+        best_transform = 1;
+        break;
+      case kDirectLoadShaderDepthUnorm:
+        best_transform = 2;
+        break;
+      default:
+        best_transform = 0;
+        break;
+    }
+  }
+  if (!best) {
+    fallback_out = reject_reason;
+    return false;
+  }
+  const TextureKey& best_key = best->key();
+  target_out.texture = best;
+  target_out.uav_format = best->direct_load_uav_format();
+  target_out.constant_info = uint32_t(best_key.endianness) | (best_transform << 2);
+  target_out.constant_size = best_key.GetWidth() | (best_key.GetHeight() << 16);
+  return true;
+}
+
+void D3D12TextureCache::BeginResolveDualWrite(const ResolveDualWriteTarget& target,
+                                              D3D12_CPU_DESCRIPTOR_HANDLE uav_handle) {
+  D3D12Texture& texture = *static_cast<D3D12Texture*>(target.texture);
+  // The same view that texture_load_direct writes the texture through.
+  D3D12_UNORDERED_ACCESS_VIEW_DESC uav_desc;
+  uav_desc.Format = target.uav_format;
+  uav_desc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2DARRAY;
+  uav_desc.Texture2DArray.MipSlice = 0;
+  uav_desc.Texture2DArray.FirstArraySlice = 0;
+  uav_desc.Texture2DArray.ArraySize = 1;
+  uav_desc.Texture2DArray.PlaneSlice = 0;
+  command_processor_.GetD3D12Provider().GetDevice()->CreateUnorderedAccessView(
+      texture.resource(), nullptr, &uav_desc, uav_handle);
+  // The whole texture is written. A previous direct load or resolve may still be writing if
+  // nothing has read the texture since.
+  D3D12_RESOURCE_STATES texture_old_state =
+      texture.SetResourceState(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  if (texture_old_state == D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
+    command_processor_.PushUAVBarrier(texture.resource());
+  } else {
+    command_processor_.PushTransitionBarrier(texture.resource(), texture_old_state,
+                                             D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  }
+  // The command list references the texture.
+  texture.MarkAsUsed();
+}
+
+void D3D12TextureCache::FinishResolveDualWrite(const ResolveDualWriteTarget& target,
+                                               uint32_t written_start, uint32_t written_length) {
+  D3D12Texture& texture = *static_cast<D3D12Texture*>(target.texture);
+  MarkRangeAsResolvedWithTextureWritten(written_start, written_length, texture);
+  ++resolve_dual_write_stats_.written;
+  if (texture.dual_write_unused()) {
+    // The previous write has never been used.
+    ++resolve_dual_write_stats_.unused;
+  } else {
+    texture.SetDualWriteUnused(true);
+    ++resolve_dual_write_unused_count_;
+  }
+  int32_t verify_every = REXCVAR_GET(resolve_dual_write_verify);
+  if (verify_every > 0 && ++resolve_dual_write_verify_counter_ >= uint32_t(verify_every)) {
+    resolve_dual_write_verify_counter_ = 0;
+    RecordResolveDualWriteVerify(texture);
+  }
+}
+
+void D3D12TextureCache::LogResolveDualWriteIfDue() {
+  uint64_t now = rex::chrono::Clock::QueryHostUptimeMillis();
+  if (!resolve_dual_write_last_log_ms_) {
+    resolve_dual_write_last_log_ms_ = now;
+    return;
+  }
+  if (now - resolve_dual_write_last_log_ms_ < 10000) {
+    return;
+  }
+  resolve_dual_write_last_log_ms_ = now;
+  const ResolveDualWriteStats& stats = resolve_dual_write_stats_;
+  uint32_t fallback_count = 0;
+  std::string reasons;
+  for (size_t i = 0; i < size_t(ResolveDualWriteFallback::kCount); ++i) {
+    if (!stats.fallbacks[i]) {
+      continue;
+    }
+    fallback_count += stats.fallbacks[i];
+    if (!reasons.empty()) {
+      reasons += ", ";
+    }
+    reasons += kResolveDualWriteFallbackNames[i];
+    reasons += ' ';
+    reasons += std::to_string(stats.fallbacks[i]);
+  }
+  if (stats.written || stats.loads_skipped || fallback_count || stats.unused) {
+    REXGPU_INFO(
+        "[resolve-dual-write] {} resolves dual-written, {} loads skipped, {} fallbacks ({}){}",
+        stats.written, stats.loads_skipped, fallback_count, reasons.empty() ? "none" : reasons,
+        stats.unused ? (", " + std::to_string(stats.unused) +
+                        " dual writes unused (written again or loaded over before a draw used "
+                        "them)")
+                     : std::string());
+  }
+  if (stats.verified || stats.verify_skipped) {
+    REXGPU_INFO(
+        "[resolve-dual-write] verify: {} textures checked, {} differ ({} bytes), {} not checked "
+        "(too many checks in flight)",
+        stats.verified, stats.verified_differing, stats.verified_differing_bytes,
+        stats.verify_skipped);
+  }
+  resolve_dual_write_stats_ = ResolveDualWriteStats();
+}
+
+void D3D12TextureCache::RecordResolveDualWriteVerify(D3D12Texture& texture) {
+  // Each check holds the texture a second time, and two copies of it for the CPU.
+  constexpr size_t kMaxVerifiesInFlight = 4;
+  if (resolve_dual_write_verifies_.size() >= kMaxVerifiesInFlight) {
+    ++resolve_dual_write_stats_.verify_skipped;
+    return;
+  }
+  const TextureKey key = texture.key();
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  D3D12_RESOURCE_DESC desc = texture.resource()->GetDesc();
+  D3D12_PLACED_SUBRESOURCE_FOOTPRINT layout;
+  UINT rows;
+  UINT64 row_size_bytes, total_bytes;
+  device->GetCopyableFootprints(&desc, 0, 1, 0, &layout, &rows, &row_size_bytes, &total_bytes);
+  uint64_t second_offset =
+      rex::align(uint64_t(total_bytes), uint64_t(D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT));
+
+  ResolveDualWriteVerify verify;
+  verify.second_offset = second_offset;
+  verify.row_pitch = layout.Footprint.RowPitch;
+  verify.row_bytes = uint32_t(row_size_bytes);
+  verify.rows = rows;
+  verify.bytes_per_texel = FormatInfo::Get(key.format)->bytes_per_block();
+  verify.address = key.base_page << 12;
+  verify.width = key.GetWidth();
+  verify.height = key.GetHeight();
+  // The texture the usual way, in a resource of its own.
+  if (FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesDefault, provider.GetHeapFlagCreateNotZeroed(), &desc,
+          D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&verify.scratch)))) {
+    REXGPU_WARN("[resolve-dual-write] verify: failed to create the texture to load into");
+    return;
+  }
+  D3D12_RESOURCE_DESC readback_desc;
+  ui::d3d12::util::FillBufferResourceDesc(readback_desc, second_offset + total_bytes,
+                                          D3D12_RESOURCE_FLAG_NONE);
+  if (FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesReadback, provider.GetHeapFlagCreateNotZeroed(),
+          &readback_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+          IID_PPV_ARGS(&verify.readback)))) {
+    REXGPU_WARN("[resolve-dual-write] verify: failed to create the readback buffer");
+    return;
+  }
+
+  // The load of the usual kind, over the shared memory the resolve has just written.
+  D3D12Texture scratch_texture(*this, key, verify.scratch.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+                               false);
+  scratch_texture.SetDirectLoadUAVFormat(texture.direct_load_uav_format());
+  if (!LoadTextureDataFromResidentMemoryImpl(scratch_texture, true, false)) {
+    REXGPU_WARN("[resolve-dual-write] verify: the load into the texture failed");
+    return;
+  }
+  command_processor_.PushTransitionBarrier(
+      texture.resource(), texture.SetResourceState(D3D12_RESOURCE_STATE_COPY_SOURCE),
+      D3D12_RESOURCE_STATE_COPY_SOURCE);
+  command_processor_.PushTransitionBarrier(
+      verify.scratch.Get(), scratch_texture.SetResourceState(D3D12_RESOURCE_STATE_COPY_SOURCE),
+      D3D12_RESOURCE_STATE_COPY_SOURCE);
+  command_processor_.SubmitBarriers();
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  D3D12_TEXTURE_COPY_LOCATION location_source, location_dest;
+  location_source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  location_source.SubresourceIndex = 0;
+  location_dest.pResource = verify.readback.Get();
+  location_dest.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  location_dest.PlacedFootprint = layout;
+  location_dest.PlacedFootprint.Offset = 0;
+  location_source.pResource = texture.resource();
+  command_list.D3DCopyTextureRegion(&location_dest, 0, 0, 0, &location_source, nullptr);
+  location_dest.PlacedFootprint.Offset = second_offset;
+  location_source.pResource = verify.scratch.Get();
+  command_list.D3DCopyTextureRegion(&location_dest, 0, 0, 0, &location_source, nullptr);
+  verify.submission = command_processor_.GetCurrentSubmission();
+  resolve_dual_write_verifies_.push_back(std::move(verify));
+}
+
+void D3D12TextureCache::ProcessResolveDualWriteVerifies(uint64_t completed_submission_index) {
+  for (auto it = resolve_dual_write_verifies_.begin(); it != resolve_dual_write_verifies_.end();) {
+    ResolveDualWriteVerify& verify = *it;
+    if (verify.submission > completed_submission_index) {
+      ++it;
+      continue;
+    }
+    void* mapped = nullptr;
+    D3D12_RANGE read_range;
+    read_range.Begin = 0;
+    read_range.End = SIZE_T(verify.second_offset) +
+                     SIZE_T(verify.row_pitch) * (verify.rows ? verify.rows - 1 : 0) +
+                     verify.row_bytes;
+    if (SUCCEEDED(verify.readback->Map(0, &read_range, &mapped))) {
+      const uint8_t* dual_written = static_cast<const uint8_t*>(mapped);
+      const uint8_t* loaded = dual_written + verify.second_offset;
+      uint64_t differing_bytes = 0;
+      uint32_t first_x = 0, first_y = 0, first_dual_written = 0, first_loaded = 0;
+      for (uint32_t y = 0; y < verify.rows; ++y) {
+        const uint8_t* row_dual_written = dual_written + uint64_t(y) * verify.row_pitch;
+        const uint8_t* row_loaded = loaded + uint64_t(y) * verify.row_pitch;
+        if (!std::memcmp(row_dual_written, row_loaded, verify.row_bytes)) {
+          continue;
+        }
+        for (uint32_t i = 0; i < verify.row_bytes; ++i) {
+          if (row_dual_written[i] == row_loaded[i]) {
+            continue;
+          }
+          if (!differing_bytes) {
+            uint32_t texel_start = i - (i % verify.bytes_per_texel);
+            first_x = texel_start / verify.bytes_per_texel;
+            first_y = y;
+            std::memcpy(&first_dual_written, row_dual_written + texel_start, sizeof(uint32_t));
+            std::memcpy(&first_loaded, row_loaded + texel_start, sizeof(uint32_t));
+          }
+          ++differing_bytes;
+        }
+      }
+      D3D12_RANGE written_range = {0, 0};
+      verify.readback->Unmap(0, &written_range);
+      ++resolve_dual_write_stats_.verified;
+      if (differing_bytes) {
+        ++resolve_dual_write_stats_.verified_differing;
+        resolve_dual_write_stats_.verified_differing_bytes += differing_bytes;
+        REXGPU_ERROR(
+            "[resolve-dual-write] verify {}x{} at 0x{:08X}: MISMATCH, {} of {} bytes differ, first "
+            "at texel ({}, {}): written by the resolve 0x{:08X}, loaded 0x{:08X} (first 4 bytes "
+            "of the texel)",
+            verify.width, verify.height, verify.address, differing_bytes,
+            uint64_t(verify.row_bytes) * verify.rows, first_x, first_y, first_dual_written,
+            first_loaded);
+      } else {
+        static uint32_t equal_logged = 0;
+        if (equal_logged < 8) {
+          ++equal_logged;
+          REXGPU_INFO("[resolve-dual-write] verify {}x{} at 0x{:08X}: 0 of {} bytes differ",
+                      verify.width, verify.height, verify.address,
+                      uint64_t(verify.row_bytes) * verify.rows);
+        }
+      }
+    }
+    it = resolve_dual_write_verifies_.erase(it);
+  }
+}
+
 }  // namespace rex::graphics::d3d12
