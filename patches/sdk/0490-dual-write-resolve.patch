+bool D3D12RenderTargetCache::PrepareDirectResolveDualWrite(
+    const draw_util::ResolveInfo& resolve_info, draw_util::ResolveCopyShaderIndex copy_shader,
+    const D3D12RenderTarget* direct_source, bool stretching, D3D12TextureCache& texture_cache,
+    D3D12TextureCache::ResolveDualWriteTarget& target_out, ID3D12PipelineState*& pipeline_out) {
+  using Fallback = D3D12TextureCache::ResolveDualWriteFallback;
+  auto reject = [&texture_cache](Fallback reason) {
+    texture_cache.CountResolveDualWriteFallback(reason);
+    return false;
+  };
+  if (IsDrawResolutionScaled()) {
+    return reject(Fallback::kScaled);
+  }
+  if (!direct_source) {
+    return reject(Fallback::kNoDirectSource);
+  }
+  if (stretching) {
+    return reject(Fallback::kStretch);
+  }
+  if (direct_source->key().msaa_samples != xenos::MsaaSamples::k1X) {
+    return reject(Fallback::kMultisampled);
+  }
+  // The size of a texel the resolve writes (what the shader stores to the shared memory, and what
+  // a texture loaded directly is made of).
+  uint32_t bytes_per_texel;
+  switch (GetDirectResolveCopyShader(copy_shader)) {
+    case draw_util::ResolveCopyShaderIndex::kFast32bpp1x2xMSAA:
+    case draw_util::ResolveCopyShaderIndex::kFull32bpp:
+      bytes_per_texel = 4;
+      break;
+    case draw_util::ResolveCopyShaderIndex::kFast64bpp1x2xMSAA:
+    case draw_util::ResolveCopyShaderIndex::kFull64bpp:
+      bytes_per_texel = 8;
+      break;
+    default:
+      return reject(Fallback::kShader);
+  }
+  // The texel (x, y) of the resolve is the texel (x, y) of a texture that starts at the destination
+  // base (the base is the one adjusted to the origin of the area when that is on a granularity
+  // boundary), if the area isn't offset from it, and the tiling doesn't depend on a slice.
+  uint32_t dest_base = resolve_info.copy_dest_base & 0x1FFFFFFF;
+  if (resolve_info.copy_dest_info.copy_dest_array ||
+      resolve_info.copy_dest_coordinate_info.offset_x_div_8 ||
+      resolve_info.copy_dest_coordinate_info.offset_y_div_8 || (dest_base & 0xFFF) || !dest_base) {
+    return reject(Fallback::kDestination);
+  }
+  D3D12TextureCache::ResolveDualWriteQuery query;
+  query.base_page = dest_base >> 12;
+  query.pitch_div_32 = resolve_info.copy_dest_coordinate_info.pitch_aligned_div_32;
+  query.bytes_per_texel = bytes_per_texel;
+  query.width = resolve_info.coordinate_info.width_div_8 << xenos::kResolveAlignmentPixelsLog2;
+  query.height = resolve_info.height_div_8 << xenos::kResolveAlignmentPixelsLog2;
+  Fallback fallback;
+  if (!texture_cache.FindResolveDualWriteTarget(query, target_out, fallback)) {
+    return reject(fallback);
+  }
+  ID3D12PipelineState* pipeline = GetDirectResolveDualPipeline(copy_shader);
+  if (!pipeline) {
+    return reject(Fallback::kPipeline);
+  }
+  pipeline_out = pipeline;
+  return true;
+}
