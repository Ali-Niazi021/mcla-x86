+  // so it is the same whatever the two endianness settings are.
+  // XE_RESOLVE_DIRECT_DUAL_WRITE_64BPP: 64 bits a texel (R16G16B16A16_UINT view), otherwise 32
+  // (R32_UINT view). Constants: xe_resolve_dual_info - bits 0:1 the texture's xenos::Endian,
+  // bits 2:3 the transformation (kXeResolveDualTransform_*); xe_resolve_dual_size - the
+  // texture's width in bits 0:15 and height in bits 16:31, in texels.
+  #if SHADING_LANGUAGE_HLSL_XE
+    #ifdef XE_RESOLVE_DIRECT_DUAL_WRITE_64BPP
+      RWTexture2DArray<uint4_xe> xe_resolve_dual_texture : register(u1, space0);
+    #else
+      RWTexture2DArray<uint> xe_resolve_dual_texture : register(u1, space0);
+    #endif
+  #else
+    #error The resolve dual write is only implemented for HLSL.
+  #endif
+
+  #define kXeResolveDualTransform_None 0u
+  // 24_8_FLOAT depth: XeFloat20e4To32 of the 24 high bits.
+  #define kXeResolveDualTransform_DepthFloat24 1u
+  // 24_8 depth: XeUNorm24To32 of the 24 high bits, as float bits.
+  #define kXeResolveDualTransform_DepthUNorm24 2u
+
+  struct XeResolveDualInfo {
+    uint endian_32;
+    uint transform;
+    uint2_xe size;
+  };
+
+  XeResolveDualInfo XeResolveDualGetInfo(param_push_consts_xe) {
+    XeResolveDualInfo dual_info;
+    uint info = push_const_xe(xe_resolve_dual_info);
+    uint size = push_const_xe(xe_resolve_dual_size);
+    dual_info.endian_32 = info & 3u;
+    dual_info.transform = (info >> 2u) & 3u;
+    dual_info.size = uint2_xe(size & 0xFFFFu, size >> 16u);
+    return dual_info;
+  }
+
+  #ifdef XE_RESOLVE_DIRECT_DUAL_WRITE_64BPP
+    // The texels first_texel and first_texel + (1, 0), from the 4 dwords the resolve has stored
+    // for them to the shared memory (XeEndianSwap64 of the pixels): texture_load_direct_scaled.xesli
+    // XeTextureLoadDirectStore with XE_TEXTURE_LOAD_DIRECT_64BPB.
+    void XeResolveDualStore2Texels64bpb(XeResolveDualInfo dual_info,
+                                        uint2_xe first_texel, uint4_xe stored) {
+      uint4_xe blocks = XeEndianSwap32(stored, dual_info.endian_32);
+      dont_flatten_xe
+      if (first_texel.y < dual_info.size.y) {
+        dont_flatten_xe
+        if (first_texel.x < dual_info.size.x) {
+          xe_resolve_dual_texture[uint3_xe(first_texel, 0u)] =
+              uint4_xe(blocks.x & 0xFFFFu, blocks.x >> 16u, blocks.y & 0xFFFFu,
+                       blocks.y >> 16u);
+        }
+        dont_flatten_xe
+        if (first_texel.x + 1u < dual_info.size.x) {
+          xe_resolve_dual_texture[uint3_xe(first_texel.x + 1u, first_texel.y, 0u)] =
+              uint4_xe(blocks.z & 0xFFFFu, blocks.z >> 16u, blocks.w & 0xFFFFu,
+                       blocks.w >> 16u);
+        }
+      }
+    }
+  #else
+    // The texels first_texel to first_texel + (3, 0), from the 4 dwords the resolve has stored for
+    // them to the shared memory (XeEndianSwap32 of the pixels): texture_load_direct_scaled.xesli
+    // with XE_TEXTURE_LOAD_32BPB_TRANSFORM of the load shader of the texture's format.
+    void XeResolveDualStore4Texels32bpb(XeResolveDualInfo dual_info,
+                                        uint2_xe first_texel, uint4_xe stored) {
+      uint4_xe blocks = XeEndianSwap32(stored, dual_info.endian_32);
+      dont_flatten_xe
+      if (dual_info.transform == kXeResolveDualTransform_DepthFloat24) {
+        blocks = XeFloat20e4To32(blocks >> 8u);
+      } else if (dual_info.transform == kXeResolveDualTransform_DepthUNorm24) {
+        blocks = float_bits_to_uint_xe(XeUNorm24To32(blocks >> 8u));
+      }
+      dont_flatten_xe
+      if (first_texel.y < dual_info.size.y) {
+        dont_flatten_xe
+        if (first_texel.x < dual_info.size.x) {
+          xe_resolve_dual_texture[uint3_xe(first_texel, 0u)] = blocks.x;
+        }
+        dont_flatten_xe
+        if (first_texel.x + 1u < dual_info.size.x) {
+          xe_resolve_dual_texture[uint3_xe(first_texel.x + 1u, first_texel.y, 0u)] = blocks.y;
+        }
+        dont_flatten_xe
+        if (first_texel.x + 2u < dual_info.size.x) {
+          xe_resolve_dual_texture[uint3_xe(first_texel.x + 2u, first_texel.y, 0u)] = blocks.z;
+        }
+        dont_flatten_xe
+        if (first_texel.x + 3u < dual_info.size.x) {
+          xe_resolve_dual_texture[uint3_xe(first_texel.x + 3u, first_texel.y, 0u)] = blocks.w;
+        }
+      }
+    }
+  #endif  // XE_RESOLVE_DIRECT_DUAL_WRITE_64BPP
+#endif  // XE_RESOLVE_DIRECT_DUAL_WRITE
+
