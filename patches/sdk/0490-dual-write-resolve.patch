+size_t TextureCache::GetResolvedTexturesAtBasePage(uint32_t base_page, Texture** textures_out,
+                                                   size_t max_count) const {
+  size_t count = 0;
+  auto range = resolved_textures_by_base_page_.equal_range(base_page);
+  for (auto it = range.first; it != range.second && count < max_count; ++it) {
+    textures_out[count++] = it->second;
+  }
+  return count;
+}
+
+void TextureCache::MarkRangeAsResolvedWithTextureWritten(uint32_t start_unscaled,
+                                                         uint32_t length_unscaled,
+                                                         Texture& written_texture) {
+  // The critical region is recursive: the shared memory takes it again for the invalidation, and
+  // nothing else gets between the invalidation of the texture and it being up to date again.
+  auto global_lock = global_critical_region_.Acquire();
+  MarkRangeAsResolved(start_unscaled, length_unscaled);
+  written_texture.MakeUpToDateAndWatch(global_lock);
+}
