+// What became of a draw that needed ownership transfers: once for every vertex shader, pixel shader and outcome (at
+// most 256), the registers the analysis reads; every 10 seconds, the counts. The CP thread only.
+void LogOverwriteOutcome(const RegisterFile& regs, const Shader& vertex_shader,
+                         const Shader& pixel_shader, bool cut, uint32_t rectangle_x,
+                         uint32_t rectangle_y, uint32_t rectangle_width, uint32_t rectangle_height) {
+  static std::set<std::tuple<uint64_t, uint64_t, const char*>> seen;
+  static std::map<const char*, uint64_t> kept_reasons;
+  static uint64_t analysed = 0, cut_count = 0;
+  static std::chrono::steady_clock::time_point window_start = std::chrono::steady_clock::now();
+  const char* reason = g_overwrite_reject_reason;
+  ++analysed;
+  if (cut) {
+    ++cut_count;
+  } else {
+    ++kept_reasons[reason];
+  }
+  const uint64_t vs_hash = vertex_shader.ucode_data_hash();
+  const uint64_t ps_hash = pixel_shader.ucode_data_hash();
+  if (seen.size() < 256 && seen.emplace(vs_hash, ps_hash, cut ? "" : reason).second) {
+    const uint32_t msaa = uint32_t(1) << uint32_t(regs.Get<reg::RB_SURFACE_INFO>().msaa_samples);
+    if (cut) {
+      REXGPU_INFO(
+          "skip_overwritten_transfers: cut to the rectangle {},{} {}x{} - vertex shader {:016X}, pixel shader "
+          "{:016X}, {}x MSAA; RB_DEPTHCONTROL {:08X}, RB_COLOR_MASK {:08X}, RB_BLENDCONTROL0 {:08X}, "
+          "RB_COLORCONTROL {:08X}, PA_SU_SC_MODE_CNTL {:08X}, PA_CL_CLIP_CNTL {:08X}, PA_CL_VTE_CNTL {:08X}, "
+          "VGT_DRAW_INITIATOR {:08X}",
+          rectangle_x, rectangle_y, rectangle_width, rectangle_height, vs_hash,
+          ps_hash, msaa, regs[XE_GPU_REG_RB_DEPTHCONTROL], regs[XE_GPU_REG_RB_COLOR_MASK],
+          regs[XE_GPU_REG_RB_BLENDCONTROL0], regs[XE_GPU_REG_RB_COLORCONTROL],
+          regs[XE_GPU_REG_PA_SU_SC_MODE_CNTL], regs[XE_GPU_REG_PA_CL_CLIP_CNTL],
+          regs[XE_GPU_REG_PA_CL_VTE_CNTL], regs[XE_GPU_REG_VGT_DRAW_INITIATOR]);
+    } else {
+      REXGPU_INFO(
+          "skip_overwritten_transfers: kept ({}) - vertex shader {:016X}, pixel shader {:016X}, {}x MSAA; "
+          "RB_DEPTHCONTROL {:08X}, RB_COLOR_MASK {:08X}, RB_BLENDCONTROL0 {:08X}, RB_COLORCONTROL {:08X}, "
+          "PA_SU_SC_MODE_CNTL {:08X}, PA_CL_CLIP_CNTL {:08X}, PA_CL_VTE_CNTL {:08X}, VGT_DRAW_INITIATOR {:08X}",
+          reason, vs_hash, ps_hash, msaa, regs[XE_GPU_REG_RB_DEPTHCONTROL], regs[XE_GPU_REG_RB_COLOR_MASK],
+          regs[XE_GPU_REG_RB_BLENDCONTROL0], regs[XE_GPU_REG_RB_COLORCONTROL],
+          regs[XE_GPU_REG_PA_SU_SC_MODE_CNTL], regs[XE_GPU_REG_PA_CL_CLIP_CNTL],
+          regs[XE_GPU_REG_PA_CL_VTE_CNTL], regs[XE_GPU_REG_VGT_DRAW_INITIATOR]);
+    }
+  }
+  const auto now = std::chrono::steady_clock::now();
+  const double seconds = std::chrono::duration<double>(now - window_start).count();
+  if (seconds >= 10.0) {
+    std::string reasons;
+    for (const auto& kept : kept_reasons) {
+      reasons += (reasons.empty() ? ": " : "; ") + std::string(kept.first) + " x" + std::to_string(kept.second);
+    }
+    REXGPU_INFO(
+        "skip_overwritten_transfers: {} draws needed ownership transfers in {:.1f} s: {} cut to a rectangle, {} "
+        "kept{}",
+        analysed, seconds, cut_count, analysed - cut_count, reasons);
+    analysed = cut_count = 0;
+    kept_reasons.clear();
+    window_start = now;
+  }
+}
