diff --git a/cmake/rexglue_streamline.cmake b/cmake/rexglue_streamline.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/rexglue_streamline.cmake
@@ -0,0 +1,56 @@
+# LOCAL PATCH - MCLA (0770): NVIDIA Streamline (DLSS Super Resolution; with 0780 DLSS Frame Generation and
+# Reflex) for the Direct3D 12 backend.
+#
+# Nothing of NVIDIA's is in this tree. REXGLUE_STREAMLINE_DIR names an unpacked Streamline SDK release
+# (github.com/NVIDIA-RTX/Streamline/releases, e.g. streamline-sdk-v2.14.16.zip: include/sl.h, bin/x64/...), which
+# mcla-x86's tools/setup.py downloads into its work folder and tools/prepare_sdk.py passes here. With it the GPU
+# plugin and the UI code are compiled against its headers (REX_HAS_STREAMLINE=1; everything is loaded at run time
+# from sl.interposer.dll, no import library is linked) and its DLLs are installed next to the SDK's own, from where
+# the game's build copies them next to its executable. Without it the SDK builds as before and DLSS reports
+# itself unavailable.
+#
+#   REXGLUE_STREAMLINE_DIR       the SDK folder (empty: no Streamline)
+#   REXGLUE_STREAMLINE_VARIANT   development (default: unsigned, NVIDIA's watermark, the plugins' hotkeys and
+#                                ImGui) or production (signed; DLSS-G hotkeys and on-screen text off)
+
+set(REXGLUE_STREAMLINE_DIR "" CACHE PATH
+    "NVIDIA Streamline SDK folder (an unpacked release with include/sl.h); empty: built without DLSS")
+set(REXGLUE_STREAMLINE_VARIANT "development" CACHE STRING
+    "Which Streamline DLLs are installed next to the SDK's: development or production")
+set_property(CACHE REXGLUE_STREAMLINE_VARIANT PROPERTY STRINGS development production)
+
+set(REXGLUE_HAS_STREAMLINE OFF)
+if(WIN32 AND REXGLUE_USE_D3D12 AND REXGLUE_STREAMLINE_DIR)
+  if(EXISTS "${REXGLUE_STREAMLINE_DIR}/include/sl.h")
+    set(REXGLUE_HAS_STREAMLINE ON)
+    set(REXGLUE_STREAMLINE_INCLUDE_DIR "${REXGLUE_STREAMLINE_DIR}/include")
+    if(REXGLUE_STREAMLINE_VARIANT STREQUAL "production")
+      set(_rexglue_sl_bin "${REXGLUE_STREAMLINE_DIR}/bin/x64")
+    else()
+      set(_rexglue_sl_bin "${REXGLUE_STREAMLINE_DIR}/bin/x64/development")
+    endif()
+    # The interposer, the plugins this SDK loads (sl.common is always loaded) and NVIDIA's models.
+    set(_rexglue_sl_dlls
+        sl.interposer.dll sl.common.dll sl.dlss.dll sl.dlss_g.dll sl.reflex.dll sl.pcl.dll
+        nvngx_dlss.dll nvngx_dlssg.dll)
+    if(NOT REXGLUE_STREAMLINE_VARIANT STREQUAL "production")
+      list(APPEND _rexglue_sl_dlls sl.imgui.dll)
+    endif()
+    set(_rexglue_sl_found 0)
+    foreach(_dll IN LISTS _rexglue_sl_dlls)
+      if(EXISTS "${_rexglue_sl_bin}/${_dll}")
+        install(FILES "${_rexglue_sl_bin}/${_dll}" DESTINATION "${CMAKE_INSTALL_BINDIR}")
+        math(EXPR _rexglue_sl_found "${_rexglue_sl_found} + 1")
+      else()
+        message(WARNING "Streamline: ${_rexglue_sl_bin}/${_dll} is missing; DLSS may not run")
+      endif()
+    endforeach()
+    message(STATUS "Streamline: headers from ${REXGLUE_STREAMLINE_INCLUDE_DIR}; ${_rexglue_sl_found} "
+                   "${REXGLUE_STREAMLINE_VARIANT} DLLs installed next to the SDK's")
+    unset(_rexglue_sl_bin)
+    unset(_rexglue_sl_dlls)
+    unset(_rexglue_sl_found)
+  else()
+    message(WARNING "Streamline: ${REXGLUE_STREAMLINE_DIR} has no include/sl.h; built without DLSS")
+  endif()
+endif()
