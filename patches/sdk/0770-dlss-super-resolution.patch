+#pragma once
+/**
+ * LOCAL PATCH - MCLA (0770): NVIDIA DLSS Super Resolution as the temporal upscaler of
+ * temporal_aa = fsr on Direct3D 12 (temporal_aa_upscaler = dlss), through NVIDIA Streamline
+ * (include/rex/ui/d3d12/d3d12_streamline.h).
+ *
+ * DLSS takes FSR's place and nothing else changes: the scene's draws are jittered and squeezed
+ * as for FSR (graphics/temporal_aa.cpp), the motion vectors, the gathered colour and depth are
+ * the same textures (d3d12/temporal_aa.cpp, TaaRun), DLSS runs where FSR would (the motion
+ * blur draw, before the tone map: linear HDR colour) and writes the same output, which is
+ * copied back into the scene texture. Recorded into the deferred command list as an external
+ * callback, like FSR's dispatch: Streamline is given the submission thread's command list.
+ *
+ * What DLSS is told:
+ *   colour       R16G16B16A16_FLOAT, linear HDR (before the tone map): colorBuffersHDR, auto
+ *                exposure (the game's eye adaptation is applied after, in the tone map)
+ *   depth        R32_FLOAT, 1 near, 0 far: depthInverted
+ *   vectors      R16G16_FLOAT, previous minus current, render pixels, without the jitter, the
+ *                game's per-vehicle reprojection: mvecScale 1/render size, cameraMotionIncluded,
+ *                not jittered, low resolution (render size) through the tags' extents
+ *   jitter       Halton(2, 3), 8 x ratio^2 phases (TaaEndFrame), render pixels, the value FSR is
+ *                given (TaaFsrJitter: temporal_aa_flip_jitter flips it for both)
+ *   matrices     TaaCamera (TaaCheckDraw), Streamline's clip space
+ *   reset        TaaCamera::reset (a camera cut)
+ */
+
+#include <atomic>
+#include <cstdint>
+#include <string>
+
+#include <d3d12.h>
+
+namespace rex::graphics::d3d12 {
+
+// temporal_aa_upscaler asks for DLSS.
+bool TaaDlssWanted();
+// Streamline is active and the adapter has DLSS Super Resolution; else false with the reason.
+bool TaaDlssAvailable(std::string* why_out);
+// After a failed evaluation: DLSS counts as unavailable for the rest of the session.
+void TaaDlssGiveUp();
+// "DLSS 310.4.0" (the model's NGX version) for temporal_aa_upscaler_active and the log.
+std::string TaaDlssLabel();
+// Streamline's DLSS mode (sl::DLSSMode) for an output width and the render width it is drawn at.
+uint32_t TaaDlssMode(uint32_t output_width, uint32_t render_width);
+// Its name for the log ("Quality").
+const char* TaaDlssModeName(uint32_t mode);
+
+// One evaluation, copied into the deferred command list (plain data).
+struct TaaDlssDispatch {
+  ID3D12Resource* color;    // render size
+  ID3D12Resource* depth;    // render size
+  ID3D12Resource* vectors;  // render size
+  ID3D12Resource* output;   // output size
+  uint32_t color_state;     // D3D12_RESOURCE_STATES each is in when the callback runs
+  uint32_t depth_state;
+  uint32_t vectors_state;
+  uint32_t output_state;
+  uint32_t render_width;
+  uint32_t render_height;
+  uint32_t width;
+  uint32_t height;
