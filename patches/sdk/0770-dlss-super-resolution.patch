+REXCVAR_DEFINE_STRING(nvidia_streamline, "auto", "GPU",
+                      "NVIDIA Streamline (DLSS Super Resolution, and with frame_generation = dlss "
+                      "DLSS Frame Generation and Reflex; LOCAL PATCH 0770): loaded at start from "
+                      "sl.interposer.dll and its plugins next to the executable (tools/setup.py "
+                      "fetches them), on an NVIDIA GPU only.\n"
+                      " auto: when temporal_aa_upscaler = dlss or frame_generation = dlss (the "
+                      "default)\n"
+                      " on: whenever the DLLs and an NVIDIA GPU are there (the swap chain is then "
+                      "always Streamline's)\n"
+                      " off: never (FSR and AMD frame generation as before)\n"
+                      "Not with frame_generation = fsr (AMD's swap chain): Streamline then stays "
+                      "off and temporal_aa_upscaler = dlss runs FSR. A change takes effect at the "
+                      "next start")
+    .allowed({"auto", "on", "off"})
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+REXCVAR_DEFINE_INT32(streamline_log, 0, "GPU",
+                     "NVIDIA Streamline's messages: 0 its warnings and errors in this log (the "
+                     "default); 1 also its information messages; 2 also its own verbose log "
+                     "files (sl.log and the plugins', in the executable's folder) and its console "
+                     "window")
+    .range(0, 2)
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+REXCVAR_DEFINE_STRING(streamline_project_id, "5c0f3a6e-2b7d-4e91-a8c4-0d3f6b1e9a27", "GPU",
+                      "NVIDIA Streamline: the project id given to slInit (a GUID; any value works "
+                      "with the development DLLs, which also show NVIDIA's watermark)")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+namespace rex::ui::d3d12::streamline {
+
+namespace {
+
+constexpr uint32_t kVendorNvidia = 0x10DE;
+
+struct State {
+  HMODULE module = nullptr;
+  bool active = false;
+  bool dlss = false;
+  std::string why = "NOT LOADED";
+  std::string dlss_label = "DLSS";
+#if defined(REX_HAS_STREAMLINE) && REX_HAS_STREAMLINE
+  Api api;
+#endif
+  std::mutex token_mutex;
+};
+State g_state;
+
+#if defined(REX_HAS_STREAMLINE) && REX_HAS_STREAMLINE
+
+std::string ResultText(sl::Result result) {
+  switch (result) {
+    case sl::Result::eOk:
+      return "ok";
+    case sl::Result::eErrorIO:
+      return "I/O error";
+    case sl::Result::eErrorDriverOutOfDate:
+      return "the driver is too old";
+    case sl::Result::eErrorOSOutOfDate:
+      return "Windows is too old";
+    case sl::Result::eErrorOSDisabledHWS:
+      return "hardware-accelerated GPU scheduling is off";
+    case sl::Result::eErrorNoSupportedAdapterFound:
+      return "no supported adapter (not an RTX GPU, or the wrong one)";
+    case sl::Result::eErrorAdapterNotSupported:
+      return "the adapter isn't supported";
+    case sl::Result::eErrorFeatureMissing:
+      return "the feature's plugin is missing";
+    case sl::Result::eErrorFeatureNotSupported:
+      return "the feature isn't supported here";
+    case sl::Result::eErrorFeatureFailedToLoad:
+      return "the feature's plugin failed to load";
+    default:
+      return "Streamline result " + std::to_string(int(result));
+  }
+}
+
+// Streamline's messages into the log (they end with a line feed). Any thread.
+void LogMessage(sl::LogType type, const char* message) {
+  std::string text = message ? message : "";
+  while (!text.empty() && (text.back() == '\n' || text.back() == '\r')) {
+    text.pop_back();
+  }
+  switch (type) {
+    case sl::LogType::eError:
+      REXLOG_ERROR("Streamline: {}", text);
+      break;
+    case sl::LogType::eWarn:
+      REXLOG_WARN("Streamline: {}", text);
+      break;
+    default:
+      if (REXCVAR_GET(streamline_log) >= 1) {
+        REXLOG_INFO("Streamline: {}", text);
+      }
+      break;
+  }
+}
+
+template <typename T>
+bool Resolve(HMODULE module, const char* name, T*& out) {
+  out = reinterpret_cast<T*>(GetProcAddress(module, name));
+  return out != nullptr;
+}
+
+template <typename T>
+void ResolveFeature(sl::Feature feature, const char* name, T*& out) {
+  void* function = nullptr;
+  out = nullptr;
+  if (g_state.api.slGetFeatureFunction &&
+      g_state.api.slGetFeatureFunction(feature, name, function) == sl::Result::eOk) {
+    out = reinterpret_cast<T*>(function);
+  }
+}
+
+void Unload(const char* why) {
+  g_state.active = false;
+  g_state.dlss = false;
+  g_state.why = why;
+  g_state.api = Api();
+  if (g_state.module) {
+    FreeLibrary(g_state.module);
+    g_state.module = nullptr;
+  }
+}
+
+#endif  // REX_HAS_STREAMLINE
+
+}  // namespace
+
+bool Wanted() {
+  const std::string mode = REXCVAR_GET(nvidia_streamline);
+  if (mode == "off") {
+    return false;
+  }
+  // AMD's frame generation makes the swap chain through its own proxy: never both.
+  if (rex::cvar::GetFlagByName("frame_generation") == "fsr") {
+    return false;
+  }
+  if (mode == "on") {
+    return true;
+  }
+  return rex::cvar::GetFlagByName("temporal_aa_upscaler") == "dlss" ||
+         rex::cvar::GetFlagByName("frame_generation") == "dlss";
+}
+
+bool Initialize(ID3D12Device* native_device, const void* adapter_luid, uint32_t adapter_vendor_id) {
+#if defined(REX_HAS_STREAMLINE) && REX_HAS_STREAMLINE
+  if (g_state.active) {
+    return true;
+  }
+  if (!Wanted()) {
+    g_state.why = rex::cvar::GetFlagByName("frame_generation") == "fsr"
+                      ? "AMD FRAME GENERATION IN USE"
+                      : "NOT ASKED FOR";
+    if (REXCVAR_GET(nvidia_streamline) != "off" &&
+        rex::cvar::GetFlagByName("temporal_aa_upscaler") == "dlss") {
+      REXLOG_WARN("Streamline: not loaded with frame_generation = fsr (AMD's swap chain); "
+                  "temporal_aa_upscaler = dlss runs FSR");
+    }
+    return false;
+  }
+  if (adapter_vendor_id != kVendorNvidia) {
+    g_state.why = "NOT AN NVIDIA GPU";
+    REXLOG_INFO("Streamline: not loaded, the GPU isn't NVIDIA's (vendor 0x{:04X}); DLSS is "
+                "unavailable",
+                adapter_vendor_id);
+    return false;
+  }
+  const std::filesystem::path folder = rex::filesystem::GetExecutableFolder();
+  const std::filesystem::path interposer = folder / "sl.interposer.dll";
+  std::error_code exists_error;
+  if (!std::filesystem::exists(interposer, exists_error)) {
+    g_state.why = "SL.INTERPOSER.DLL MISSING";
+    REXLOG_WARN("Streamline: sl.interposer.dll isn't next to the executable (tools/setup.py "
+                "fetches NVIDIA's Streamline SDK and the build copies its DLLs); DLSS is "
+                "unavailable");
+    return false;
+  }
+  // The development DLLs are not signed; the production ones are, and the interposer checks the
+  // plugins' signatures itself. (No WinVerifyTrust here: personal-use build, owner's decision.)
+  g_state.module = LoadLibraryExW(interposer.c_str(), nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+  if (!g_state.module) {
+    REXLOG_ERROR("Streamline: sl.interposer.dll doesn't load (error {}); DLSS is unavailable",
+                 GetLastError());
+    Unload("SL.INTERPOSER.DLL DOESN'T LOAD");
+    return false;
+  }
+  Api& api = g_state.api;
+  bool resolved = Resolve(g_state.module, "slInit", api.slInit) &&
+                  Resolve(g_state.module, "slShutdown", api.slShutdown) &&
+                  Resolve(g_state.module, "slIsFeatureSupported", api.slIsFeatureSupported) &&
+                  Resolve(g_state.module, "slIsFeatureLoaded", api.slIsFeatureLoaded) &&
+                  Resolve(g_state.module, "slSetFeatureLoaded", api.slSetFeatureLoaded) &&
+                  Resolve(g_state.module, "slEvaluateFeature", api.slEvaluateFeature) &&
+                  Resolve(g_state.module, "slAllocateResources", api.slAllocateResources) &&
+                  Resolve(g_state.module, "slFreeResources", api.slFreeResources) &&
+                  Resolve(g_state.module, "slSetTagForFrame", api.slSetTagForFrame) &&
+                  Resolve(g_state.module, "slGetFeatureRequirements",
+                          api.slGetFeatureRequirements) &&
+                  Resolve(g_state.module, "slGetFeatureVersion", api.slGetFeatureVersion) &&
+                  Resolve(g_state.module, "slUpgradeInterface", api.slUpgradeInterface) &&
+                  Resolve(g_state.module, "slSetConstants", api.slSetConstants) &&
+                  Resolve(g_state.module, "slGetNativeInterface", api.slGetNativeInterface) &&
+                  Resolve(g_state.module, "slGetFeatureFunction", api.slGetFeatureFunction) &&
+                  Resolve(g_state.module, "slGetNewFrameToken", api.slGetNewFrameToken) &&
+                  Resolve(g_state.module, "slSetD3DDevice", api.slSetD3DDevice);
+  if (!resolved) {
+    REXLOG_ERROR("Streamline: sl.interposer.dll lacks Streamline's entry points; DLSS is "
+                 "unavailable");
+    Unload("SL.INTERPOSER.DLL IS NOT STREAMLINE");
+    return false;
+  }
+
+  const int32_t log = REXCVAR_GET(streamline_log);
+  const std::wstring plugin_folder = folder.wstring();
+  const wchar_t* plugin_paths[] = {plugin_folder.c_str()};
+  const std::string project_id = REXCVAR_GET(streamline_project_id);
+  // The features this patch uses (0780 adds frame generation, Reflex and PC latency).
+  const sl::Feature features[] = {sl::kFeatureDLSS};
+  sl::Preferences preferences;
+  preferences.showConsole = log >= 2;
+  preferences.logLevel = log >= 2 ? sl::LogLevel::eVerbose : sl::LogLevel::eDefault;
+  preferences.pathsToPlugins = plugin_paths;
+  preferences.numPathsToPlugins = 1;
+  preferences.pathToLogsAndData = log >= 2 ? plugin_folder.c_str() : nullptr;
+  preferences.logMessageCallback = &LogMessage;
+  // Manual hooking (the host keeps its native interfaces); no over-the-air updates, so what runs
+  // is exactly the DLLs next to the executable.
+  // Frame based resource tagging (slSetTagForFrame, which a FrameToken names: 2.14 refuses it without the flag).
+  preferences.flags = sl::PreferenceFlags::eDisableCLStateTracking |
+                      sl::PreferenceFlags::eUseManualHooking |
+                      sl::PreferenceFlags::eUseFrameBasedResourceTagging;
+  preferences.featuresToLoad = features;
+  preferences.numFeaturesToLoad = uint32_t(sizeof(features) / sizeof(features[0]));
+  preferences.applicationId = 0;
+  preferences.engine = sl::EngineType::eCustom;
+  preferences.engineVersion = "ReXGlue";
+  preferences.projectId = project_id.c_str();
+  preferences.renderAPI = sl::RenderAPI::eD3D12;
+  sl::Result result = api.slInit(preferences, sl::kSDKVersion);
+  if (result != sl::Result::eOk) {
+    REXLOG_ERROR("Streamline: slInit failed ({}); DLSS is unavailable", ResultText(result));
+    Unload("SLINIT FAILED");
+    return false;
+  }
+  result = api.slSetD3DDevice(native_device);
+  if (result != sl::Result::eOk) {
+    REXLOG_ERROR("Streamline: slSetD3DDevice failed ({}); DLSS is unavailable", ResultText(result));
+    api.slShutdown();
+    Unload("SLSETD3DDEVICE FAILED");
+    return false;
+  }
+  g_state.active = true;
+  g_state.why.clear();
+
+  sl::AdapterInfo adapter;
+  adapter.deviceLUID = reinterpret_cast<uint8_t*>(const_cast<void*>(adapter_luid));
+  adapter.deviceLUIDSizeInBytes = uint32_t(sizeof(LUID));
+  result = api.slIsFeatureSupported(sl::kFeatureDLSS, adapter);
+  g_state.dlss = result == sl::Result::eOk;
+  if (g_state.dlss) {
+    ResolveFeature(sl::kFeatureDLSS, "slDLSSGetOptimalSettings", api.slDLSSGetOptimalSettings);
+    ResolveFeature(sl::kFeatureDLSS, "slDLSSGetState", api.slDLSSGetState);
+    ResolveFeature(sl::kFeatureDLSS, "slDLSSSetOptions", api.slDLSSSetOptions);
+    if (!api.slDLSSGetOptimalSettings || !api.slDLSSSetOptions) {
+      g_state.dlss = false;
+      g_state.why = "DLSS FUNCTIONS MISSING";
+    }
+    sl::FeatureVersion version;
+    if (api.slGetFeatureVersion(sl::kFeatureDLSS, version) == sl::Result::eOk &&
+        version.versionNGX) {
+      g_state.dlss_label = "DLSS " + version.versionNGX.toStr();
+    }
+  } else {
+    g_state.why = "DLSS: " + ResultText(result);
+  }
+  REXLOG_INFO("Streamline {}.{}.{}: active (manual hooking, {} DLLs); DLSS Super Resolution {}",
+              SL_VERSION_MAJOR, SL_VERSION_MINOR, SL_VERSION_PATCH,
+              log >= 2 ? "development log" : "quiet",
+              g_state.dlss ? "available (" + g_state.dlss_label + ")"
+                           : "unavailable (" + ResultText(result) + ")");
+  return true;
+#else
+  (void)native_device;
+  (void)adapter_luid;
+  (void)adapter_vendor_id;
+  g_state.why = "NOT BUILT WITH STREAMLINE";
+  if (Wanted()) {
+    REXLOG_WARN("Streamline: this build has no Streamline (the SDK was configured without "
+                "REXGLUE_STREAMLINE_DIR); DLSS is unavailable");
+  }
+  return false;
+#endif
+}
+
+void Shutdown() {
+#if defined(REX_HAS_STREAMLINE) && REX_HAS_STREAMLINE
+  if (g_state.active && g_state.api.slShutdown) {
+    const sl::Result result = g_state.api.slShutdown();
+    if (result != sl::Result::eOk) {
+      REXLOG_WARN("Streamline: slShutdown failed ({})", ResultText(result));
+    }
+  }
+  Unload("SHUT DOWN");
+#endif
+}
+
+bool IsActive() { return g_state.active; }
+
+bool DlssSupported() { return g_state.active && g_state.dlss; }
+
+std::string UnavailableReason() { return g_state.why; }
+
+IDXGIFactory2* UpgradeFactory(IDXGIFactory2* native) {
+#if defined(REX_HAS_STREAMLINE) && REX_HAS_STREAMLINE
+  if (!g_state.active || !native) {
+    return nullptr;
+  }
+  // slUpgradeInterface replaces the pointer with the proxy, which keeps the reference it was given.
+  native->AddRef();
+  void* factory = native;
+  const sl::Result result = g_state.api.slUpgradeInterface(&factory);
+  if (result != sl::Result::eOk || factory == native) {
+    REXLOG_ERROR("Streamline: the DXGI factory couldn't be upgraded ({}); swap chains are made "
+                 "without Streamline, which then can't run",
+                 ResultText(result));
+    native->Release();
+    return nullptr;
+  }
+  REXLOG_INFO("Streamline: swap chains are made through its proxy factory");
+  return static_cast<IDXGIFactory2*>(factory);
+#else
+  (void)native;
+  return nullptr;
+#endif
+}
+
+#if defined(REX_HAS_STREAMLINE) && REX_HAS_STREAMLINE
+
+const Api* GetApi() { return g_state.active ? &g_state.api : nullptr; }
+
+sl::FrameToken* GetFrameToken(uint32_t frame_index) {
+  if (!g_state.active) {
+    return nullptr;
+  }
+  std::lock_guard<std::mutex> lock(g_state.token_mutex);
+  sl::FrameToken* token = nullptr;
+  if (g_state.api.slGetNewFrameToken(token, &frame_index) != sl::Result::eOk) {
+    return nullptr;
+  }
+  return token;
+}
+
+std::string DlssLabel() { return g_state.dlss_label; }
+
+#endif  // REX_HAS_STREAMLINE
+
+}  // namespace rex::ui::d3d12::streamline
