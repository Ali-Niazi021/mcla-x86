diff --git a/include/rex/ui/d3d12/d3d12_streamline.h b/include/rex/ui/d3d12/d3d12_streamline.h
new file mode 100644
--- /dev/null
+++ b/include/rex/ui/d3d12/d3d12_streamline.h
@@ -0,0 +1,102 @@
+#pragma once
+/**
+ * LOCAL PATCH - MCLA (0770): NVIDIA Streamline on Direct3D 12, for DLSS Super Resolution (the
+ * temporal upscaler, src/graphics/d3d12/temporal_aa_dlss.cpp) and, with 0780, DLSS Frame
+ * Generation and Reflex.
+ *
+ * Streamline (NVIDIA's SDK, github.com/NVIDIA-RTX/Streamline) is loaded at run time: the
+ * interposer sl.interposer.dll and its plugins (sl.common, sl.dlss, ...) with NVIDIA's models
+ * (nvngx_dlss.dll, ...) next to the executable. None of them is part of this repository or of
+ * the SDK: tools/setup.py fetches the SDK into the work folder and the build copies the DLLs
+ * next to the executable. Without them, or on a GPU without DLSS, everything here reports
+ * "unavailable" and the callers keep their own paths (FSR, no frame generation).
+ *
+ * The integration is Streamline's "manual hooking" one (ProgrammingGuideManualHooking.md): the
+ * host keeps its native DXGI and Direct3D 12 interfaces and only the swap chain is made through
+ * Streamline's proxy factory (so Streamline sees every Present, which it needs every frame), and
+ * with frame generation the direct queue through its proxy device. The device is created before
+ * slInit, which manual hooking allows, so the adapter's vendor is known when deciding.
+ *
+ * Threads: Initialize / OnDeviceCreated / Shutdown on the thread that makes the provider;
+ * GetFrameToken from any thread (serialised here: slGetNewFrameToken is not thread safe); the
+ * function table from any thread once Initialize has returned.
+ */
+
+#include <cstdint>
+#include <string>
+
+struct ID3D12Device;
+struct IDXGIFactory2;
+
+#if defined(REX_HAS_STREAMLINE) && REX_HAS_STREAMLINE
+#include <sl.h>
+#include <sl_consts.h>
+#include <sl_dlss.h>
+#endif
+
+namespace rex::ui::d3d12::streamline {
+
+// Whether the cvars ask for Streamline in this session (nvidia_streamline, and a consumer:
+// temporal_aa_upscaler = dlss or frame_generation = dlss). Read once, in Initialize.
+bool Wanted();
+
+// D3D12Provider::Initialize, once the device exists and before the direct queue and any swap
+// chain are made: loads sl.interposer.dll from the executable's folder, slInit (manual
+// hooking), slSetD3DDevice, and asks which features the adapter supports. False (logged, with
+// the reason in UnavailableReason) when Streamline isn't wanted or can't run: the session goes on
+// without it.
+bool Initialize(ID3D12Device* native_device, const void* adapter_luid, uint32_t adapter_vendor_id);
+// ~D3D12Provider, before the device and the factory are released.
+void Shutdown();
+
+// Loaded and initialised for this session.
+bool IsActive();
+// The adapter has DLSS Super Resolution (the plugin loaded and works on the device).
+bool DlssSupported();
+// Why Streamline or DLSS isn't there (for the log and temporal_aa_upscaler_active).
+std::string UnavailableReason();
+
+// The factory the presenter makes its swap chain with: Streamline's proxy of `native` while
+// Streamline is active (an added reference, the caller releases it), else null.
+IDXGIFactory2* UpgradeFactory(IDXGIFactory2* native);
+
+#if defined(REX_HAS_STREAMLINE) && REX_HAS_STREAMLINE
+// Streamline's entry points, resolved from sl.interposer.dll, and the features' functions
+// (slGetFeatureFunction). Null where not loaded; a feature function is null where its feature
+// isn't supported.
+struct Api {
+  PFun_slInit* slInit = nullptr;
+  PFun_slShutdown* slShutdown = nullptr;
+  PFun_slIsFeatureSupported* slIsFeatureSupported = nullptr;
+  PFun_slIsFeatureLoaded* slIsFeatureLoaded = nullptr;
+  PFun_slSetFeatureLoaded* slSetFeatureLoaded = nullptr;
+  PFun_slEvaluateFeature* slEvaluateFeature = nullptr;
+  PFun_slAllocateResources* slAllocateResources = nullptr;
+  PFun_slFreeResources* slFreeResources = nullptr;
+  PFun_slSetTagForFrame* slSetTagForFrame = nullptr;
+  PFun_slGetFeatureRequirements* slGetFeatureRequirements = nullptr;
+  PFun_slGetFeatureVersion* slGetFeatureVersion = nullptr;
+  PFun_slUpgradeInterface* slUpgradeInterface = nullptr;
+  PFun_slSetConstants* slSetConstants = nullptr;
+  PFun_slGetNativeInterface* slGetNativeInterface = nullptr;
+  PFun_slGetFeatureFunction* slGetFeatureFunction = nullptr;
+  PFun_slGetNewFrameToken* slGetNewFrameToken = nullptr;
+  PFun_slSetD3DDevice* slSetD3DDevice = nullptr;
+  // DLSS Super Resolution (sl_dlss.h).
+  PFun_slDLSSGetOptimalSettings* slDLSSGetOptimalSettings = nullptr;
+  PFun_slDLSSGetState* slDLSSGetState = nullptr;
+  PFun_slDLSSSetOptions* slDLSSSetOptions = nullptr;
+};
+// The table while Streamline is active, else null.
+const Api* GetApi();
+
+// The frame token for a frame index (slGetNewFrameToken with the index given, under a lock).
+// Null if Streamline isn't active or the call failed. The token stays valid for the frame (it is
+// Streamline's), so it can be passed to the calls of the frame on any thread.
+sl::FrameToken* GetFrameToken(uint32_t frame_index);
+
+// "DLSS 310.4.0" for the plugin's NGX version, once known (else "DLSS").
+std::string DlssLabel();
+#endif
+
+}  // namespace rex::ui::d3d12::streamline
