+/**
+ * LOCAL PATCH - MCLA (0770): NVIDIA Streamline on Direct3D 12. See
+ * include/rex/ui/d3d12/d3d12_streamline.h.
+ */
+
+#include <rex/ui/d3d12/d3d12_streamline.h>
+
+#include <atomic>
