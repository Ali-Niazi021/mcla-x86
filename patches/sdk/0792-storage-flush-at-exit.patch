@@ -68,6 +68,7 @@
   void InitializeShaderStorage(const std::filesystem::path& cache_root, uint32_t title_id,
                                bool blocking) override;
   std::string ShaderStorageReport(bool shutdown) override;
+  void FlushShaderStorage(uint32_t timeout_ms) override;  // LOCAL PATCH - MCLA (0792)
 
   ui::d3d12::D3D12Provider& GetD3D12Provider() const {
     return *static_cast<ui::d3d12::D3D12Provider*>(graphics_system_->provider());
diff --git a/include/rex/graphics/d3d12/pipeline_cache.h b/include/rex/graphics/d3d12/pipeline_cache.h
--- a/include/rex/graphics/d3d12/pipeline_cache.h
+++ b/include/rex/graphics/d3d12/pipeline_cache.h
@@ -72,6 +72,11 @@
   // shutdown. Empty without storage.
   std::string ShaderStorageReport(bool shutdown);
 
+  // LOCAL PATCH - MCLA (0792): for a process that ends with std::_Exit (ReXApp::OnClosing), which doesn't run
+  // the destructors or flush the stdio buffers: writes what the storage writer thread still has queued, flushes both
+  // files, and returns when that's done or after timeout_ms. Any thread. Without storage, returns at once.
+  void FlushShaderStorage(uint32_t timeout_ms);
+
   void EndSubmission();
   bool IsCreatingPipelines();
 
@@ -422,6 +427,10 @@
   bool storage_write_flush_shaders_ = false;
   bool storage_write_flush_pipelines_ = false;
   bool storage_write_thread_shutdown_ = false;
+  // LOCAL PATCH - MCLA (0792): the writer thread has nothing queued or to flush and is waiting (protected with
+  // storage_write_request_lock_; storage_write_idle_cond_ is notified when it becomes true).
+  bool storage_write_idle_ = true;
+  std::condition_variable storage_write_idle_cond_;
   std::unique_ptr<rex::thread::Thread> storage_write_thread_;
 
   // Pipeline creation threads.
diff --git a/include/rex/graphics/graphics_system.h b/include/rex/graphics/graphics_system.h
--- a/include/rex/graphics/graphics_system.h
+++ b/include/rex/graphics/graphics_system.h
@@ -91,6 +91,7 @@
   void InitializeShaderStorage(const std::filesystem::path& cache_root, uint32_t title_id,
                                bool blocking) override;
   std::string ShaderStorageReport(bool shutdown) override;
+  void FlushShaderStorage(uint32_t timeout_ms) override;  // LOCAL PATCH - MCLA (0792)
 
   bool is_paused() const { return paused_; }
   void Pause();
diff --git a/include/rex/system/interfaces/graphics.h b/include/rex/system/interfaces/graphics.h
--- a/include/rex/system/interfaces/graphics.h
+++ b/include/rex/system/interfaces/graphics.h
@@ -91,6 +91,11 @@
     return {};
   }
 
+  // LOCAL PATCH - MCLA (0792): for a process that ends without the graphics shutdown (ReXApp::OnClosing exits
+  // with std::_Exit): writes what the storage writer still has queued and flushes the storage files, waiting at most
+  // timeout_ms. Any thread, doesn't wait for the command processor thread. Default: nothing to flush.
+  virtual void FlushShaderStorage(uint32_t timeout_ms) { (void)timeout_ms; }
+
   // One-shot convenience for callers that don't care about the split.
   X_STATUS Setup(runtime::FunctionDispatcher* function_dispatcher, KernelState* kernel_state,
                  ui::WindowedAppContext* app_context, bool with_presentation) {
diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -482,6 +482,13 @@
   }
 }
 
+void D3D12CommandProcessor::FlushShaderStorage(uint32_t timeout_ms) {
+  // LOCAL PATCH - MCLA (0792)
+  if (pipeline_cache_) {
+    pipeline_cache_->FlushShaderStorage(timeout_ms);
+  }
+}
+
 std::string D3D12CommandProcessor::ShaderStorageReport(bool shutdown) {
   std::string storage = pipeline_cache_ ? pipeline_cache_->ShaderStorageReport(shutdown) : "";
   if (storage.empty()) {
diff --git a/src/graphics/d3d12/pipeline_cache.cpp b/src/graphics/d3d12/pipeline_cache.cpp
--- a/src/graphics/d3d12/pipeline_cache.cpp
+++ b/src/graphics/d3d12/pipeline_cache.cpp
@@ -946,6 +946,33 @@
   return report;
 }
 
+void PipelineCache::FlushShaderStorage(uint32_t timeout_ms) {
+  // LOCAL PATCH - MCLA (0792). The flags make the writer thread flush both files after it has written
+  // what's queued (it takes the flush flags only once its queues are empty); idle is true again after that.
+  std::unique_lock<std::mutex> lock(storage_write_request_lock_);
+  if (!storage_write_thread_ || storage_write_thread_shutdown_) {
+    return;
+  }
+  storage_write_flush_shaders_ = true;
+  storage_write_flush_pipelines_ = true;
+  storage_write_idle_ = false;
+  storage_write_request_cond_.notify_all();
+  const auto start = std::chrono::steady_clock::now();
+  const bool flushed = storage_write_idle_cond_.wait_for(lock, std::chrono::milliseconds(timeout_ms), [this]() {
+    return storage_write_idle_ && storage_write_shader_queue_.empty() &&
+           storage_write_pipeline_queue_.empty() && !storage_write_flush_shaders_ &&
+           !storage_write_flush_pipelines_;
+  });
+  // The last partial window of the [pipelines] line is never logged (the process ends first): the totals of the run.
+  REXGPU_INFO(
+      "[pipeline-storage] at exit: {} descriptions appended to {} this run ({} of them already in the file but skipped at "
+      "the preload), {} {} ms",
+      g_runtime_descriptions_appended.load(std::memory_order_relaxed), storage_report_file_,
+      g_runtime_descriptions_recreated.load(std::memory_order_relaxed),
+      flushed ? "queues written and files flushed in" : "NOT everything flushed after",
+      std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count());
+}
+
 void PipelineCache::ShutdownShaderStorage() {
   if (storage_write_thread_) {
     {
@@ -3394,7 +3421,10 @@
     bool write_pipeline = false;
     {
       std::unique_lock<std::mutex> lock(storage_write_request_lock_);
-      if (storage_write_thread_shutdown_) {
+      // LOCAL PATCH - MCLA (0792): a shutdown writes what is queued first (it used to drop it; the files are
+      // flushed by the fclose that follows).
+      if (storage_write_thread_shutdown_ && storage_write_shader_queue_.empty() &&
+          storage_write_pipeline_queue_.empty()) {
         return;
       }
       if (!storage_write_shader_queue_.empty()) {
@@ -3416,9 +3446,13 @@
       // A flush taken from the request flags runs at the top of the loop; waiting first would
       // leave the written data in the stdio buffer until the next storage request.
       if (!shader && !write_pipeline && !flush_shaders && !flush_pipelines) {
+        // LOCAL PATCH - MCLA (0792): everything asked for has been written and flushed (FlushShaderStorage).
+        storage_write_idle_ = true;
+        storage_write_idle_cond_.notify_all();
         storage_write_request_cond_.wait(lock);
         continue;
       }
+      storage_write_idle_ = false;  // LOCAL PATCH - MCLA (0792)
     }
 
     if (shader) {
diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -1090,6 +1090,13 @@
   return report;
 }
 
+void GraphicsSystem::FlushShaderStorage(uint32_t timeout_ms) {
+  // LOCAL PATCH - MCLA (0792): not through CallInThread - the command processor thread may be busy or gone.
+  if (command_processor_) {
+    command_processor_->FlushShaderStorage(timeout_ms);
+  }
+}
+
 void GraphicsSystem::Pause() {
   paused_ = true;
   command_processor_->Pause();
diff --git a/src/ui/rex_app.cpp b/src/ui/rex_app.cpp
--- a/src/ui/rex_app.cpp
+++ b/src/ui/rex_app.cpp
@@ -518,6 +518,11 @@
   // lock still held by a straggler TerminateTitle left running. Flush (not
   // ShutdownLogging, which frees loggers a straggler may still use); the OS
   // reclaims the rest.
+  // LOCAL PATCH - MCLA (0792): _Exit doesn't flush the stdio buffers of the shader / pipeline storage files or
+  // write what the storage writer thread still has queued: the records of the last frames would be lost. Bounded.
+  if (runtime_ && runtime_->graphics_system()) {
+    runtime_->graphics_system()->FlushShaderStorage(500);
+  }
   REXLOG_INFO("Title terminated; hard-exiting process.");
   rex::FlushLogging();
   std::_Exit(0);
