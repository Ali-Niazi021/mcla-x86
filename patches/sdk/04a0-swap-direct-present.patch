+// LOCAL PATCH - MCLA (04a0): swap_direct_present.
+//
+// The swap shows the guest's front buffer: a texture the game's last resolve wrote to memory and the swap loads
+// (RequestSwapTexture), then applies the gamma ramp to. When that resolve was a direct one that copied a whole
+// 8_8_8_8 picture straight from the one host render target that owned it, the render target holds exactly the
+// texels the load would produce, for as long as nothing has written either, and the load can be left out.
+//
+// What a resolve must be to be recorded (anything else leaves the swap as before):
+//  - direct: one single-sampled k_8_8_8_8 colour render target of the resolve's pitch owned the whole area, at the
+//    resolve's own base (no offset into the render target, no EDRAM offset, so the destination's texel (x, y) is the
+//    render target's), at 1x resolution and not stretched by the FSR upscaling;
+//  - to a k_8_8_8_8 destination with no red/blue swap, no exponent bias, not an array slice, at the texture's
+//    origin (no offset into its tiles), so the bytes the copy writes are the render target's bytes, endian
+//    swapped the way the texture's fetch constant undoes (checked at the swap against the fetch constant);
+//  - its memory range is still valid GPU-written data when it is recorded (no CPU write has come between).
+// It stops being usable when the shared memory reports a write to the range (a global watch, which also sees the next
+// resolve of the same memory), when the render target object is gone or replaced, or when it was put in a state it
+// can be written in (D3D12RenderTarget::SetResourceState: every draw, clear, ownership transfer and HDR copy does).
+
+void D3D12RenderTargetCache::SwapDirectWatchCallback(
+    const std::unique_lock<std::recursive_mutex>& global_lock, void* context,
+    uint32_t address_first, uint32_t address_last, bool invalidated_by_gpu) {
+  auto* cache = static_cast<D3D12RenderTargetCache*>(context);
+  for (SwapDirectWatch& watch : cache->swap_direct_watches_) {
+    if (address_first <= watch.end.load(std::memory_order_relaxed) &&
+        address_last >= watch.start.load(std::memory_order_relaxed)) {
+      watch.invalidations.fetch_add(1, std::memory_order_release);
+    }
+  }
+}
+
+void D3D12RenderTargetCache::NoteSwapDirectResolve(
+    D3D12SharedMemory& shared_memory, const draw_util::ResolveInfo& resolve_info,
+    D3D12RenderTarget* direct_source, const DirectResolveSourceConstants& direct_source_constants) {
+  if (!REXCVAR_GET(swap_direct_present)) {
+    ClearSwapDirectRecords();
+    return;
+  }
+  if (resolve_info.IsCopyingDepth()) {
+    return;
+  }
+  // What isn't a picture the swap can be made from is noted for the swap's "why not" (and, for a new reason, logged
+  // with the resolve's fields, once): see NoteSwapDirectRejected.
+  auto reject = [&](const char* reason) {
+    NoteSwapDirectRejected(resolve_info, direct_source, direct_source_constants, reason);
+  };
+  if (!direct_source) {
+    reject("front buffer resolve not direct (the render targets were dumped, no one render target owns the area)");
+    return;
+  }
+  if (IsDrawResolutionScaled()) {
+    reject("front buffer resolve at a resolution scale above 1");
+    return;
+  }
+  if (command_processor_.TaaSqueezingScene()) {
+    reject("front buffer resolve in a squeezed (FSR upscaled) scene");
+    return;
+  }
+  const RenderTargetKey key = direct_source->key();
+  DirectResolveSourceConversion conversion;
+  if (key.is_depth || key.msaa_samples != xenos::MsaaSamples::k1X ||
+      key.GetColorFormat() != xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+      !GetDirectResolveSourceConversion(key, conversion) ||
+      conversion != DirectResolveSourceConversion::k_8_8_8_8) {
+    reject("front buffer resolve's render target isn't a single-sampled k_8_8_8_8 one");
+    return;
+  }
+  const reg::RB_COPY_DEST_INFO& dest_info = resolve_info.copy_dest_info;
+  const draw_util::ResolveCopyDestCoordinateInfo& dest_coordinate =
+      resolve_info.copy_dest_coordinate_info;
+  if (direct_source_constants.offset != 0 ||
+      resolve_info.coordinate_info.edram_offset_x_div_8 != 0 ||
+      resolve_info.coordinate_info.edram_offset_y_div_8 != 0) {
+    reject("front buffer resolve starts inside the render target (a source offset)");
+    return;
+  }
+  if (resolve_info.color_edram_info.GetBaseTiles() !=
+      (resolve_info.color_original_base & (edram_tile_count() - 1))) {
+    reject("front buffer resolve's EDRAM base isn't the surface's (the resolved area doesn't start at its origin)");
+    return;
+  }
+  if (dest_info.copy_dest_format != xenos::ColorFormat::k_8_8_8_8 || dest_info.copy_dest_array) {
+    reject("front buffer resolve's destination isn't a k_8_8_8_8 non-array texture");
+    return;
+  }
+  if (dest_info.copy_dest_exp_bias != 0) {
+    reject("front buffer resolve with a destination exponent bias");
+    return;
+  }
+  if (dest_coordinate.offset_x_div_8 != 0 || dest_coordinate.offset_y_div_8 != 0) {
+    reject("front buffer resolve starts inside its destination texture's tiles (a destination offset)");
+    return;
+  }
+  const uint32_t width = resolve_info.coordinate_info.width_div_8 * 8;
+  const uint32_t height = resolve_info.height_div_8 * 8;
+  const uint32_t range_start = resolve_info.copy_dest_extent_start & 0x1FFFFFFF;
+  const uint32_t range_length = resolve_info.copy_dest_extent_length;
+  if (!width || !height || !range_length || range_length > 0x20000000 - range_start) {
+    return;
+  }
+
+  // From here on a write by the CPU or the GPU to the range can't be missed: the global critical region is held, so
+  // nothing invalidates while the range is checked, the watch's range is set and the count is read.
+  auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+  if (!shared_memory.AreAllPagesValidAndGpuWritten(range_start, range_length)) {
+    reject("front buffer resolve's memory isn't valid GPU-written data when recorded (a CPU write, or hot pages)");
+    return;
+  }
+  if (!swap_direct_watch_handle_) {
+    swap_direct_shared_memory_ = &shared_memory;
+    swap_direct_watch_handle_ = shared_memory.RegisterGlobalWatch(SwapDirectWatchCallback, this);
+  }
+  // The record of this destination, else a free one, else the least recent.
+  size_t index = SIZE_MAX;
+  bool replaced = false;
+  for (size_t i = 0; i < kSwapDirectRecordCount; ++i) {
+    if (swap_direct_records_[i].valid &&
+        swap_direct_records_[i].dest_base == resolve_info.copy_dest_base) {
+      index = i;
+      replaced = true;
+      break;
+    }
+  }
+  for (size_t i = 0; index == SIZE_MAX && i < kSwapDirectRecordCount; ++i) {
+    if (!swap_direct_records_[i].valid) {
+      index = i;
+    }
+  }
+  if (index == SIZE_MAX) {
+    index = 0;
+    for (size_t i = 1; i < kSwapDirectRecordCount; ++i) {
+      if (swap_direct_records_[i].sequence < swap_direct_records_[index].sequence) {
+        index = i;
+      }
+    }
+  }
+  SwapDirectWatch& watch = swap_direct_watches_[index];
+  watch.start.store(range_start, std::memory_order_relaxed);
+  watch.end.store(range_start + (range_length - 1), std::memory_order_relaxed);
+  SwapDirectRecord& record = swap_direct_records_[index];
+  record.valid = true;
+  record.render_target_key = key;
+  record.render_target_serial = direct_source->serial();
+  record.render_target_write_generation = direct_source->write_generation();
+  record.dest_base = resolve_info.copy_dest_base;
+  record.dest_pitch_div_32 = dest_coordinate.pitch_aligned_div_32;
+  record.endianness = uint32_t(dest_info.copy_dest_endian);
+  record.width = width;
+  record.height = height;
+  record.invalidations = watch.invalidations.load(std::memory_order_acquire);
+  record.sequence = ++swap_direct_sequence_;
+  static std::atomic<uint32_t> logged{0};
+  record.dest_swap = dest_info.copy_dest_swap != 0;
+  if (!replaced && logged.fetch_add(1, std::memory_order_relaxed) < 8) {
+    REXGPU_INFO(
+        "swap_direct_present: a resolve of the host render target {} to 0x{:08X} ({}x{}, pitch {}, "
+        "endian {}) can be shown without loading it",
+        key.GetDebugName(), record.dest_base, width, height, record.dest_pitch_div_32 * 32,
+        record.endianness);
+  }
+}
+
+bool D3D12RenderTargetCache::FindSwapDirectSource(const SwapDirectTexture& texture,
+                                                  SwapDirectSource& source_out,
+                                                  const char*& why_not_out) {
+  size_t index = SIZE_MAX;
+  for (size_t i = 0; i < kSwapDirectRecordCount; ++i) {
+    if (swap_direct_records_[i].valid && swap_direct_records_[i].dest_base == texture.base_address) {
+      index = i;
+      break;
+    }
+  }
+  if (index == SIZE_MAX) {
+    why_not_out = "no resolve of this address has been seen (not recorded, not rejected)";
+    for (const SwapDirectReject& reject : swap_direct_rejects_) {
+      if (reject.reason && reject.dest_base == texture.base_address) {
+        why_not_out = reject.reason;
+      }
+    }
+    // Once, for the first few swaps: the swap's texture next to what is recorded and rejected.
+    static std::atomic<uint32_t> logged{0};
+    if (logged.fetch_add(1, std::memory_order_relaxed) < 3) {
+      std::string known;
+      for (const SwapDirectRecord& record : swap_direct_records_) {
+        if (record.valid) {
+          known += fmt::format(" record 0x{:08X} {}x{} pitch {} endian {} swap {};", record.dest_base,
+                               record.width, record.height, record.dest_pitch_div_32 * 32,
+                               record.endianness, record.dest_swap);
+        }
+      }
+      for (const SwapDirectReject& reject : swap_direct_rejects_) {
+        if (reject.reason) {
+          known += fmt::format(" rejected 0x{:08X}: {};", reject.dest_base, reject.reason);
+        }
+      }
+      REXGPU_INFO(
+          "swap_direct_present: the swap's texture 0x{:08X} {}x{} pitch {} endian {} has no record "
+          "({}):{}",
+          texture.base_address, texture.width, texture.height, texture.pitch_div_32 * 32,
+          texture.endianness, why_not_out, known.empty() ? std::string(" nothing recorded or rejected") : known);
+    }
+    return false;
+  }
+  const SwapDirectRecord& record = swap_direct_records_[index];
+  if (texture.pitch_div_32 != record.dest_pitch_div_32 || texture.endianness != record.endianness) {
+    why_not_out = "the swap's texture has another pitch or endianness than the recorded resolve";
+    return false;
+  }
+  if (texture.width > record.width || texture.height > record.height) {
+    why_not_out = "the swap's texture is larger than the area resolved";
+    return false;
+  }
+  if (swap_direct_watches_[index].invalidations.load(std::memory_order_acquire) !=
+      record.invalidations) {
+    why_not_out = "the front buffer's memory was written since the resolve";
+    return false;
+  }
+  RenderTarget* found_render_target = FindRenderTargetByKey(record.render_target_key);
+  if (!found_render_target) {
+    why_not_out = "the render target is gone";
+    return false;
+  }
+  auto* render_target = static_cast<D3D12RenderTarget*>(found_render_target);
+  if (render_target->serial() != record.render_target_serial) {
+    why_not_out = "the render target was replaced";
+    return false;
+  }
+  if (render_target->write_generation() != record.render_target_write_generation) {
+    why_not_out = "the render target was written since the resolve";
+    return false;
+  }
+  D3D12_RESOURCE_DESC resource_desc = render_target->resource()->GetDesc();
+  if (texture.width > resource_desc.Width || texture.height > resource_desc.Height) {
+    why_not_out = "the swap's texture is larger than the render target";
+    return false;
+  }
+  source_out.resource = render_target->resource();
+  source_out.srv_format =
+      GetColorOwnershipTransferDXGIFormat(xenos::ColorRenderTargetFormat::k_8_8_8_8);
+  source_out.render_target = render_target;
+  source_out.swap_red_blue = record.dest_swap;
+  return true;
+}
+
+void D3D12RenderTargetCache::UseSwapDirectSource(const SwapDirectSource& source,
+                                                 D3D12_RESOURCE_STATES state) {
+  auto* render_target = static_cast<D3D12RenderTarget*>(source.render_target);
+  command_processor_.PushTransitionBarrier(
+      render_target->resource(), render_target->SetResourceState(state), state);
+}
+
+void D3D12RenderTargetCache::NoteSwapDirectRejected(
+    const draw_util::ResolveInfo& resolve_info, D3D12RenderTarget* direct_source,
+    const DirectResolveSourceConstants& direct_source_constants, const char* reason) {
+  const uint32_t width = resolve_info.coordinate_info.width_div_8 * 8;
+  const uint32_t height = resolve_info.height_div_8 * 8;
+  if (width < 640 || height < 360) {
+    return;
+  }
+  const uint32_t dest_base = resolve_info.copy_dest_base;
+  SwapDirectReject* entry = nullptr;
+  for (SwapDirectReject& candidate : swap_direct_rejects_) {
+    if (candidate.reason && candidate.dest_base == dest_base) {
+      entry = &candidate;
+      break;
+    }
+  }
+  for (SwapDirectReject& candidate : swap_direct_rejects_) {
+    if (!entry && !candidate.reason) {
+      entry = &candidate;
+    }
+  }
+  if (!entry) {
+    entry = &swap_direct_rejects_[0];
+  }
+  const bool changed = entry->reason != reason || entry->dest_base != dest_base;
+  entry->dest_base = dest_base;
+  entry->reason = reason;
+  if (!changed || swap_direct_reject_logs_ >= 12) {
+    return;
+  }
+  ++swap_direct_reject_logs_;
+  const reg::RB_COPY_DEST_INFO& dest_info = resolve_info.copy_dest_info;
+  const draw_util::ResolveCopyDestCoordinateInfo& dest_coordinate =
+      resolve_info.copy_dest_coordinate_info;
+  std::string source = "no direct source";
+  if (direct_source) {
+    const RenderTargetKey key = direct_source->key();
+    source = fmt::format("source {} (colour format {}, {}x MSAA, depth {})", key.GetDebugName(),
+                         uint32_t(key.GetColorFormat()), 1u << uint32_t(key.msaa_samples),
+                         key.is_depth);
+  }
+  REXGPU_INFO(
+      "swap_direct_present: the resolve to 0x{:08X} ({}x{}, destination pitch {}, endian {}, format {}, "
+      "swap red/blue {}, exp bias {}, array {}, destination offset {},{}) doesn't qualify: {}; "
+      "EDRAM base {} (the surface's {}), area offset {},{}, {}, source offset 0x{:08X}",
+      dest_base, width, height, dest_coordinate.pitch_aligned_div_32 * 32,
+      uint32_t(dest_info.copy_dest_endian), uint32_t(dest_info.copy_dest_format),
+      uint32_t(dest_info.copy_dest_swap), int32_t(dest_info.copy_dest_exp_bias),
+      uint32_t(dest_info.copy_dest_array), uint32_t(dest_coordinate.offset_x_div_8) * 8,
+      uint32_t(dest_coordinate.offset_y_div_8) * 8, reason,
+      resolve_info.color_edram_info.GetBaseTiles(), resolve_info.color_original_base,
+      uint32_t(resolve_info.coordinate_info.edram_offset_x_div_8) * 8,
+      uint32_t(resolve_info.coordinate_info.edram_offset_y_div_8) * 8, source,
+      direct_source_constants.offset);
+}
