+void D3D12CommandProcessor::PrepareSwapDirect(SwapDirect& direct) {
+  if (!REXCVAR_GET(swap_direct_present)) {
+    return;
+  }
+  ++swap_direct_stats_.swaps;
+  const char* why_not = nullptr;
+  if (render_target_cache_->GetPath() != RenderTargetCache::Path::kHostRenderTargets) {
+    why_not = "not the host render target path";
+  } else if (texture_cache_->GetSwapTextureInfo(direct.texture_info, why_not)) {
+    D3D12RenderTargetCache::SwapDirectTexture texture;
+    texture.base_address = direct.texture_info.base_address;
+    texture.pitch_div_32 = direct.texture_info.pitch_div_32;
+    texture.width = direct.texture_info.width;
+    texture.height = direct.texture_info.height;
+    texture.endianness = direct.texture_info.endianness;
+    if (render_target_cache_->FindSwapDirectSource(texture, direct.source, why_not)) {
+      if (direct.source.srv_format != direct.texture_info.dxgi_format) {
+        why_not = "the render target's format isn't the swap texture's";
+      } else {
+        direct.possible = true;
+      }
+    }
+  }
+  if (!direct.possible) {
+    NoteSwapDirect(why_not, false, false);
+    return;
+  }
+  const uint32_t check_interval = REXCVAR_GET(swap_direct_present_check);
+  direct.check = check_interval && (++swap_direct_check_counter_ % check_interval) == 0;
+  direct.in_place = !direct.check;
+  direct.fuse = REXCVAR_GET(swap_direct_present_fused);
+  // The swap texture's SRV, on the render target: the fetch constant's swizzle on the same host format. If the
+  // resolve swapped red and blue, the texture's channels 0 and 2 are the render target's 2 and 0: each component the
+  // mapping takes from channel c takes it from the render target's component {2, 1, 0, 3}[c] instead (0 and 1 constants
+  // stay).
+  uint32_t srv_mapping = direct.texture_info.shader_4_component_mapping;
+  if (direct.source.swap_red_blue) {
+    static constexpr uint32_t kSwapRedBlue[4] = {2, 1, 0, 3};
+    uint32_t swapped_mapping =
+        D3D12_SHADER_COMPONENT_MAPPING_ALWAYS_SET_BIT_AVOIDING_ZEROMEM_MISTAKES;
+    for (uint32_t i = 0; i < 4; ++i) {
+      uint32_t component =
+          (srv_mapping >> (D3D12_SHADER_COMPONENT_MAPPING_SHIFT * i)) &
+          D3D12_SHADER_COMPONENT_MAPPING_MASK;
+      if (component < 4) {
+        component = kSwapRedBlue[component];
+      }
+      swapped_mapping |= component << (D3D12_SHADER_COMPONENT_MAPPING_SHIFT * i);
+    }
+    srv_mapping = swapped_mapping;
+  }
+  direct.srv_desc.Format = direct.source.srv_format;
+  direct.srv_desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  direct.srv_desc.Shader4ComponentMapping = srv_mapping;
+  direct.srv_desc.Texture2D.MostDetailedMip = 0;
+  direct.srv_desc.Texture2D.MipLevels = 1;
+  direct.srv_desc.Texture2D.PlaneSlice = 0;
+  direct.srv_desc.Texture2D.ResourceMinLODClamp = 0.0f;
+}
+
+void D3D12CommandProcessor::NoteSwapDirect(const char* why_not, bool direct, bool fused) {
+  SwapDirectStats& stats = swap_direct_stats_;
+  if (direct) {
+    ++stats.direct;
+    if (fused) {
+      ++stats.fused;
+    }
+  } else if (why_not) {
+    bool counted = false;
+    for (std::pair<const char*, uint64_t>& entry : stats.why_not) {
+      if (entry.first && !std::strcmp(entry.first, why_not)) {
+        ++entry.second;
+        counted = true;
+        break;
+      }
+    }
+    if (!counted) {
+      for (std::pair<const char*, uint64_t>& entry : stats.why_not) {
+        if (!entry.first) {
+          entry = {why_not, 1};
+          break;
+        }
+      }
+    }
+  }
+  const uint64_t now_ms = rex::chrono::Clock::QueryHostUptimeMillis();
+  if (!stats.window_start_ms) {
+    stats.window_start_ms = now_ms;
+    return;
+  }
+  if (now_ms - stats.window_start_ms < 10000) {
+    return;
+  }
+  std::string reasons;
+  uint64_t from_texture = 0;
+  for (const std::pair<const char*, uint64_t>& entry : stats.why_not) {
+    if (entry.first) {
+      reasons += fmt::format("{}{} x{}", reasons.empty() ? ": " : "; ", entry.first, entry.second);
+      from_texture += entry.second;
+    }
+  }
+  REXGPU_INFO(
+      "swap_direct_present: {} swaps in {:.1f} s: {} made from the render target ({} with the gamma ramp "
+      "applied in the presenter's paint), {} from the loaded texture{}; {} checks",
+      stats.swaps, double(now_ms - stats.window_start_ms) * 0.001, stats.direct, stats.fused,
+      from_texture, reasons, stats.checks);
+  stats = SwapDirectStats();
+  stats.window_start_ms = now_ms;
+}
+
+bool D3D12CommandProcessor::RecordSwapDirectCheck(
+    const SwapDirect& direct, ID3D12Resource* mailbox, uint32_t width, uint32_t height,
+    const ui::d3d12::util::DescriptorCpuGpuHandlePair* descriptors,
+    const ui::d3d12::util::DescriptorCpuGpuHandlePair& ramp, D3D12_RESOURCE_STATES read_state) {
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  if (!swap_direct_check_texture_ || swap_direct_check_width_ != width ||
+      swap_direct_check_height_ != height) {
+    // The previous check's submission has completed (CompleteSwapDirectCheck waited for it).
+    swap_direct_check_texture_.Reset();
+    swap_direct_check_readback_[0].Reset();
+    swap_direct_check_readback_[1].Reset();
+    D3D12_RESOURCE_DESC texture_desc;
+    texture_desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    texture_desc.Alignment = 0;
+    texture_desc.Width = width;
+    texture_desc.Height = height;
+    texture_desc.DepthOrArraySize = 1;
+    texture_desc.MipLevels = 1;
+    texture_desc.Format = ui::d3d12::D3D12Presenter::kGuestOutputFormat;
+    texture_desc.SampleDesc.Count = 1;
+    texture_desc.SampleDesc.Quality = 0;
+    texture_desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    texture_desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    UINT64 readback_size;
+    device->GetCopyableFootprints(&texture_desc, 0, 1, 0, &swap_direct_check_footprint_, nullptr,
+                                  nullptr, &readback_size);
+    D3D12_RESOURCE_DESC readback_desc;
+    ui::d3d12::util::FillBufferResourceDesc(readback_desc, readback_size,
+                                            D3D12_RESOURCE_FLAG_NONE);
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesDefault, provider.GetHeapFlagCreateNotZeroed(),
+            &texture_desc, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+            IID_PPV_ARGS(&swap_direct_check_texture_))) ||
+        FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback, D3D12_HEAP_FLAG_NONE, &readback_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&swap_direct_check_readback_[0]))) ||
+        FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesReadback, D3D12_HEAP_FLAG_NONE, &readback_desc,
+            D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+            IID_PPV_ARGS(&swap_direct_check_readback_[1])))) {
+      REXGPU_ERROR("swap_direct_present_check: failed to create the check images");
+      swap_direct_check_texture_.Reset();
+      swap_direct_check_readback_[0].Reset();
+      swap_direct_check_readback_[1].Reset();
+      return false;
+    }
+    swap_direct_check_width_ = width;
+    swap_direct_check_height_ = height;
+  }
+
+  // What the batch holds (the usual pass's transition of the guest output image back) goes first.
+  SubmitBarriers();
+  // The same pass, from the render target to the scratch image.
+  D3D12_UNORDERED_ACCESS_VIEW_DESC uav_desc;
+  uav_desc.Format = ui::d3d12::D3D12Presenter::kGuestOutputFormat;
+  uav_desc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+  uav_desc.Texture2D.MipSlice = 0;
+  uav_desc.Texture2D.PlaneSlice = 0;
+  device->CreateUnorderedAccessView(swap_direct_check_texture_.Get(), nullptr, &uav_desc,
+                                    descriptors[0].first);
+  device->CreateShaderResourceView(direct.source.resource, &direct.srv_desc, descriptors[1].first);
+  render_target_cache_->UseSwapDirectSource(direct.source, read_state);
+  deferred_command_list_.D3DSetComputeRootSignature(apply_gamma_root_signature_.Get());
+  ApplyGammaConstants apply_gamma_constants;
+  apply_gamma_constants.size[0] = width;
+  apply_gamma_constants.size[1] = height;
+  deferred_command_list_.D3DSetComputeRoot32BitConstants(
+      UINT(ApplyGammaRootParameter::kConstants), sizeof(apply_gamma_constants) / sizeof(uint32_t),
+      &apply_gamma_constants, 0);
+  deferred_command_list_.D3DSetComputeRootDescriptorTable(
+      UINT(ApplyGammaRootParameter::kDestination), descriptors[0].second);
+  deferred_command_list_.D3DSetComputeRootDescriptorTable(
+      UINT(ApplyGammaRootParameter::kSource), descriptors[1].second);
+  deferred_command_list_.D3DSetComputeRootDescriptorTable(UINT(ApplyGammaRootParameter::kRamp),
+                                                          ramp.second);
+  SetExternalPipeline(apply_gamma_table_pipeline_.Get());
+  SubmitBarriers();
+  deferred_command_list_.D3DDispatch((width + 15) / 16, (height + 7) / 8, 1);
+
+  // Both images to the readback buffers.
+  ID3D12Resource* images[2] = {mailbox, swap_direct_check_texture_.Get()};
+  const D3D12_RESOURCE_STATES image_states[2] = {
+      ui::d3d12::D3D12Presenter::kGuestOutputInternalState, D3D12_RESOURCE_STATE_UNORDERED_ACCESS};
+  for (uint32_t i = 0; i < 2; ++i) {
+    PushTransitionBarrier(images[i], image_states[i], D3D12_RESOURCE_STATE_COPY_SOURCE);
+  }
+  SubmitBarriers();
+  for (uint32_t i = 0; i < 2; ++i) {
+    D3D12_TEXTURE_COPY_LOCATION copy_dest = {};
+    copy_dest.pResource = swap_direct_check_readback_[i].Get();
+    copy_dest.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    copy_dest.PlacedFootprint = swap_direct_check_footprint_;
+    D3D12_TEXTURE_COPY_LOCATION copy_source = {};
+    copy_source.pResource = images[i];
+    copy_source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    copy_source.SubresourceIndex = 0;
+    deferred_command_list_.D3DCopyTextureRegion(&copy_dest, 0, 0, 0, &copy_source, nullptr);
+    PushTransitionBarrier(images[i], D3D12_RESOURCE_STATE_COPY_SOURCE, image_states[i]);
+  }
+  return true;
+}
+
+void D3D12CommandProcessor::CompleteSwapDirectCheck(uint32_t width, uint32_t height) {
+  if (!AwaitAllQueueOperationsCompletion()) {
+    REXGPU_ERROR("swap_direct_present_check: the check submission did not complete");
+    return;
+  }
+  const D3D12_RANGE read_range = {0, SIZE_T(swap_direct_check_footprint_.Footprint.RowPitch) * height};
+  void* mappings[2] = {};
+  for (uint32_t i = 0; i < 2; ++i) {
+    if (FAILED(swap_direct_check_readback_[i]->Map(0, &read_range, &mappings[i]))) {
+      REXGPU_ERROR("swap_direct_present_check: failed to map a readback buffer");
+      if (i) {
+        swap_direct_check_readback_[0]->Unmap(0, nullptr);
+      }
+      return;
+    }
+  }
+  // R10G10B10A2: red in bits 0 to 9, green 10 to 19, blue 20 to 29, alpha 30 and 31.
+  uint32_t max_difference[4] = {};
+  uint64_t differing_pixels = 0;
+  uint32_t first_x = 0, first_y = 0;
+  const uint32_t row_pitch = swap_direct_check_footprint_.Footprint.RowPitch;
+  for (uint32_t y = 0; y < height; ++y) {
+    const uint32_t* usual =
+        reinterpret_cast<const uint32_t*>(static_cast<const uint8_t*>(mappings[0]) + size_t(y) * row_pitch);
+    const uint32_t* direct =
+        reinterpret_cast<const uint32_t*>(static_cast<const uint8_t*>(mappings[1]) + size_t(y) * row_pitch);
+    for (uint32_t x = 0; x < width; ++x) {
+      if (usual[x] == direct[x]) {
+        continue;
+      }
+      for (uint32_t c = 0; c < 4; ++c) {
+        const uint32_t shift = c < 3 ? c * 10 : 30;
+        const uint32_t mask = c < 3 ? 0x3FF : 0x3;
+        const uint32_t a = (usual[x] >> shift) & mask, b = (direct[x] >> shift) & mask;
+        max_difference[c] = std::max(max_difference[c], a > b ? a - b : b - a);
+      }
+      if (!differing_pixels) {
+        first_x = x;
+        first_y = y;
+      }
+      ++differing_pixels;
+    }
+  }
+  const D3D12_RANGE written_range = {0, 0};
+  swap_direct_check_readback_[0]->Unmap(0, &written_range);
+  swap_direct_check_readback_[1]->Unmap(0, &written_range);
+  ++swap_direct_check_number_;
+  ++swap_direct_stats_.checks;
+  REXGPU_INFO(
+      "swap_direct_present_check: apply-gamma image #{} {}x{}: largest difference of the render "
+      "target's from the loaded texture's (R/G/B/A, 10-bit units) {}/{}/{}/{}, {} pixels differ{}",
+      swap_direct_check_number_, width, height, max_difference[0], max_difference[1],
+      max_difference[2], max_difference[3], differing_pixels,
+      differing_pixels ? fmt::format(", the first at {},{}", first_x, first_y) : std::string());
+}
+
 }  // namespace rex::graphics::d3d12
