+++ b/src/ui/shaders/guest_output_gamma_table.ps.hlsl
@@ -0,0 +1,36 @@
+// guest_output_gamma_table.ps.hlsl - mcla-x86 patch 04a0 (swap_direct_present), written for this SDK.
+//
+// The guest output paint pass of the presenter with the swap's gamma ramp folded in: the 256-entry table path of
+// apply_gamma_table_cs (the ramp looked up by the source's 8-bit value of each channel, the result in the ramp's
+// 10 bits) in a pixel shader that writes the swap chain, instead of the compute pass that writes the guest output image
+// followed by the bilinear paint of that image. Used only where the bilinear paint is a plain 1:1 copy of an 8 bpc
+// image (the guest output's size, no scaling), so the filter would only have returned the texel it was given:
+// the output is the ramp's value of the source texel under the pixel, exactly, with the (xe_gamma_output_offset)
+// shift of the guest output's rectangle in the back buffer.
+//
+// The ramp is the SDK's R10G10B10X2 typed buffer of the gamma ramp (bytes 0x0...0x3FF of gamma_ramp_buffer_, B10G10R10X2
+// data read as R10G10B10X2 with a swizzle): red takes the entry's blue, green its green, blue its red, as apply_gamma_table
+// does.
+//
+// fxc /T ps_5_1 /E main /O3 /Qstrip_reflect /Qstrip_debug /Qstrip_priv /Vn guest_output_gamma_table_ps
+//     /Fh guest_output_gamma_table_ps.h guest_output_gamma_table.ps.hlsl
+
+Buffer<float4> xe_gamma_ramp : register(t0);
+Texture2D<float4> xe_gamma_source : register(t1);
+
+cbuffer push_consts_xe : register(b0) {
+  int2 xe_gamma_output_offset;
+};
+
+float4 main(float4 xe_position : SV_Position) : SV_Target {
+  // Truncated like the bilinear pass's own pixel index (ftoi), so a pixel centre maps to its own texel.
+  int2 pixel_index = int2(xe_position.xy) - xe_gamma_output_offset;
+  float3 source = xe_gamma_source.Load(int3(pixel_index, 0)).rgb;
+  // The same rounding as apply_gamma_table_cs: the 8-bit value of the channel.
+  uint3 table_indices = uint3(source * 255.0 + 0.5);
+  float3 result;
+  result.r = xe_gamma_ramp[table_indices.r].b;
+  result.g = xe_gamma_ramp[table_indices.g].g;
+  result.b = xe_gamma_ramp[table_indices.b].r;
+  return float4(result, 1.0);
+}
