+bool SharedMemory::AreAllPagesValidAndGpuWritten(uint32_t start, uint32_t length) {
+  if (length == 0 || start >= kBufferSize) {
+    return false;
+  }
+  length = std::min(length, kBufferSize - start);
+  const uint32_t page_first = start >> page_size_log2_;
+  const uint32_t page_last = (start + (length - 1)) >> page_size_log2_;
+  const uint32_t now_ms = uint32_t(rex::chrono::Clock::QueryHostUptimeMillis());
+  auto global_lock = global_critical_region_.Acquire();
+  const bool any_hot = AnyPageHot(now_ms);
+  for (uint32_t page = page_first; page <= page_last; ++page) {
+    const uint64_t bit = uint64_t(1) << (page & 63);
+    if (!(system_page_flags_valid_[page >> 6] & bit) ||
+        !(system_page_flags_valid_and_gpu_written_[page >> 6] & bit) ||
+        (any_hot && IsPageHot(page, now_ms))) {
+      return false;
+    }
+  }
+  return true;
+}
