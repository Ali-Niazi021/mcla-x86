diff --git a/include/rex/graphics/d3d12/command_processor.h b/include/rex/graphics/d3d12/command_processor.h
index 43e05a40..92cab70b 100644
--- a/include/rex/graphics/d3d12/command_processor.h
+++ b/include/rex/graphics/d3d12/command_processor.h
@@ -877,6 +877,52 @@ class D3D12CommandProcessor : public CommandProcessor {
   Microsoft::WRL::ComPtr<ID3D12Resource> fxaa_source_texture_;
   uint64_t fxaa_source_texture_submission_ = 0;
 
+  // LOCAL PATCH - MCLA (04a0): swap_direct_present (D3D12CommandProcessor::IssueSwap).
+  struct SwapDirect {
+    // A recorded resolve of the front buffer matches the swap's texture, and the render target can stand in for it.
+    bool possible = false;
+    // The swap's texture isn't loaded: the apply-gamma pass (or the presenter's paint) reads the render target.
+    bool in_place = false;
+    // A check swap (swap_direct_present_check): the picture is made from the loaded texture as before, and the render
+    // target's is compared with it.
+    bool check = false;
+    // swap_direct_present_fused.
+    bool fuse = false;
+    D3D12TextureCache::SwapTextureInfo texture_info;
+    D3D12RenderTargetCache::SwapDirectSource source;
+    D3D12_SHADER_RESOURCE_VIEW_DESC srv_desc = {};
+  };
+  void PrepareSwapDirect(SwapDirect& direct);
+  // Counts the swap's outcome: `why_not` (a string literal) if the swap didn't use the render target, and logs the
+  // counts every 10 seconds.
+  void NoteSwapDirect(const char* why_not, bool direct, bool fused);
+  // swap_direct_present_check: after the apply-gamma pass wrote `mailbox` from the loaded texture, the same pass from
+  // the render target into a scratch image of the same size, and the copies of both to readback buffers;
+  // `descriptors` are the scratch image's UAV and the render target's SRV; false if it can't be done.
+  bool RecordSwapDirectCheck(const SwapDirect& direct, ID3D12Resource* mailbox, uint32_t width,
+                             uint32_t height,
+                             const ui::d3d12::util::DescriptorCpuGpuHandlePair* descriptors,
+                             const ui::d3d12::util::DescriptorCpuGpuHandlePair& ramp,
+                             D3D12_RESOURCE_STATES read_state);
+  // After the check's submission completed: compares the two images and logs the largest difference.
+  void CompleteSwapDirectCheck(uint32_t width, uint32_t height);
+  struct SwapDirectStats {
+    uint64_t swaps = 0;
+    uint64_t direct = 0;
+    uint64_t fused = 0;
+    uint64_t checks = 0;
+    // The string literals of the reasons the render target wasn't used, and how many times each.
+    std::array<std::pair<const char*, uint64_t>, 16> why_not = {};
+    uint64_t window_start_ms = 0;
+  } swap_direct_stats_;
+  uint64_t swap_direct_check_counter_ = 0;
+  Microsoft::WRL::ComPtr<ID3D12Resource> swap_direct_check_texture_;
+  Microsoft::WRL::ComPtr<ID3D12Resource> swap_direct_check_readback_[2];
+  D3D12_PLACED_SUBRESOURCE_FOOTPRINT swap_direct_check_footprint_ = {};
+  uint32_t swap_direct_check_width_ = 0;
+  uint32_t swap_direct_check_height_ = 0;
+  uint64_t swap_direct_check_number_ = 0;
+
   // Unsubmitted barrier batch.
   std::vector<D3D12_RESOURCE_BARRIER> barriers_;
 
diff --git a/include/rex/graphics/d3d12/render_target_cache.h b/include/rex/graphics/d3d12/render_target_cache.h
index 0716fd5d..9124e1e9 100644
--- a/include/rex/graphics/d3d12/render_target_cache.h
+++ b/include/rex/graphics/d3d12/render_target_cache.h
@@ -13,6 +13,7 @@
 
 #include <algorithm>
 #include <array>
+#include <atomic>
 #include <cstddef>
 #include <cstdint>
 #include <deque>
@@ -38,6 +39,12 @@ namespace rex::graphics::d3d12 {
 
 class D3D12CommandProcessor;
 
+// LOCAL PATCH - MCLA (04a0): numbers the D3D12 render target objects (swap_direct_present).
+inline uint64_t NextSwapDirectRenderTargetSerial() {
+  static std::atomic<uint64_t> serial{0};
+  return ++serial;
+}
+
 class D3D12RenderTargetCache final : public RenderTargetCache {
  public:
   D3D12RenderTargetCache(const RegisterFile& register_file, const memory::Memory& memory,
@@ -98,6 +105,38 @@ class D3D12RenderTargetCache final : public RenderTargetCache {
   bool HdrRestoreColorTarget(uint32_t key, D3D12_GPU_DESCRIPTOR_HANDLE underlay_srv,
                              D3D12_RECT rect);
 
+  // LOCAL PATCH - MCLA (04a0): swap_direct_present. The host render target that the last resolve of a whole front buffer
+  // read, which the swap can show the picture from instead of from the resolved copy in memory (loaded to a texture
+  // and gamma-mapped): while the resolve is the only writer of that memory and nothing has drawn to, cleared or
+  // transferred into the render target since, its texels are the resolve's texels (see NoteSwapDirectResolve for what
+  // a resolve must be to count).
+  struct SwapDirectTexture {
+    // The texture the swap would load (the fetch constant of the swap packet): the resolve destination's address in
+    // bytes, its pitch in 32-texel units, its size, and its endianness (xenos::Endian).
+    uint32_t base_address = 0;
+    uint32_t pitch_div_32 = 0;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    uint32_t endianness = 0;
+  };
+  struct SwapDirectSource {
+    ID3D12Resource* resource = nullptr;
+    // R8G8B8A8_UNORM, the host format of the k_8_8_8_8 render target.
+    DXGI_FORMAT srv_format = DXGI_FORMAT_UNKNOWN;
+    // Opaque, for UseSwapDirectSource.
+    void* render_target = nullptr;
+    // The resolve swapped red and blue (RB_COPY_DEST_INFO copy_dest_swap): the texture's channels 0 and 2 are the render
+    // target's 2 and 0, which the SRV's component mapping (the caller's) has to undo.
+    bool swap_red_blue = false;
+  };
+  // Whether the swap's texture can be shown from the render target (true), or why not (a string literal). Changes
+  // nothing.
+  bool FindSwapDirectSource(const SwapDirectTexture& texture, SwapDirectSource& source_out,
+                            const char*& why_not_out);
+  // Pushes the transition of the render target to `state` (a state it is read in) and records it as the state, for a
+  // pass of the swap that reads it; the next draw into it transitions it back.
+  void UseSwapDirectSource(const SwapDirectSource& source, D3D12_RESOURCE_STATES state);
+
   // For host render targets.
 
   bool gamma_render_target_as_unorm16() const { return gamma_render_target_as_unorm16_; }
@@ -285,8 +324,19 @@ class D3D12RenderTargetCache final : public RenderTargetCache {
     D3D12_RESOURCE_STATES SetResourceState(D3D12_RESOURCE_STATES new_state) {
       D3D12_RESOURCE_STATES old_state = resource_state_;
       resource_state_ = new_state;
+      // LOCAL PATCH - MCLA (04a0): swap_direct_present's "written since" (draws, clears, ownership transfers, the
+      // HDR copies all go through a state it can be written in).
+      if (new_state & (D3D12_RESOURCE_STATE_RENDER_TARGET | D3D12_RESOURCE_STATE_DEPTH_WRITE |
+                       D3D12_RESOURCE_STATE_UNORDERED_ACCESS | D3D12_RESOURCE_STATE_COPY_DEST |
+                       D3D12_RESOURCE_STATE_RESOLVE_DEST)) {
+        ++write_generation_;
+      }
       return old_state;
     }
+    // LOCAL PATCH - MCLA (04a0): which object this is (a trimmed render target made again for the same key is another),
+    // and how many times it was put in a state it can be written in.
+    uint64_t serial() const { return serial_; }
+    uint64_t write_generation() const { return write_generation_; }
 
     uint32_t temporary_srv_descriptor_index() const { return temporary_srv_descriptor_index_; }
     void SetTemporarySRVDescriptorIndex(uint32_t index) { temporary_srv_descriptor_index_ = index; }
@@ -314,6 +364,8 @@ class D3D12RenderTargetCache final : public RenderTargetCache {
     uint32_t temporary_srv_descriptor_index_ = UINT32_MAX;
     uint32_t temporary_srv_descriptor_index_stencil_ = UINT32_MAX;
     uint32_t temporary_sort_index_ = 0;
+    uint64_t serial_ = NextSwapDirectRenderTargetSerial();
+    uint64_t write_generation_ = 0;
   };
 
   enum TransferCBVRegister : uint32_t {
@@ -828,6 +880,68 @@ class D3D12RenderTargetCache final : public RenderTargetCache {
   ID3D12PipelineState* resolve_rov_clear_32bpp_pipeline_ = nullptr;
   // Clearing 64bpp color.
   ID3D12PipelineState* resolve_rov_clear_64bpp_pipeline_ = nullptr;
+
+  // LOCAL PATCH - MCLA (04a0): swap_direct_present. The last resolves to whole pictures that qualified (a whole 8_8_8_8
+  // picture, one render target the source, no scaling, stretching or conversion), one record for each destination
+  // address (another small 8_8_8_8 resolve doesn't make the front buffer's forgotten), the least recent replaced.
+  static constexpr size_t kSwapDirectRecordCount = 4;
+  struct SwapDirectRecord {
+    bool valid = false;
+    RenderTargetKey render_target_key;
+    uint64_t render_target_serial = 0;
+    uint64_t render_target_write_generation = 0;
+    // The resolve destination and what it wrote (the texture's top-left corner is the render target's).
+    uint32_t dest_base = 0;
+    uint32_t dest_pitch_div_32 = 0;
+    uint32_t endianness = 0;
+    bool dest_swap = false;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    // The invalidation count of the memory range written, when it was written.
+    uint64_t invalidations = 0;
+    // When it was made, for replacing the least recent.
+    uint64_t sequence = 0;
+  };
+  SwapDirectRecord swap_direct_records_[kSwapDirectRecordCount];
+  uint64_t swap_direct_sequence_ = 0;
+  // For each record, what the shared memory's global watch needs (any thread, within the global critical region): the
+  // memory range written, inclusive (start > end: none), and how many times it was invalidated (CPU writes, other
+  // GPU writes).
+  struct SwapDirectWatch {
+    std::atomic<uint32_t> start{UINT32_MAX};
+    std::atomic<uint32_t> end{0};
+    std::atomic<uint64_t> invalidations{0};
+  };
+  SwapDirectWatch swap_direct_watches_[kSwapDirectRecordCount];
+  SharedMemory* swap_direct_shared_memory_ = nullptr;
+  SharedMemory::GlobalWatchHandle swap_direct_watch_handle_ = nullptr;
+  static void SwapDirectWatchCallback(const std::unique_lock<std::recursive_mutex>& global_lock,
+                                      void* context, uint32_t address_first, uint32_t address_last,
+                                      bool invalidated_by_gpu);
+  // Called by Resolve for every resolve that copied to memory: records it if it is a whole picture's resolve from one
+  // render target the way swap_direct_present can use (anything it overwrites is forgotten by the watch).
+  void NoteSwapDirectResolve(D3D12SharedMemory& shared_memory,
+                             const draw_util::ResolveInfo& resolve_info,
+                             D3D12RenderTarget* direct_source,
+                             const DirectResolveSourceConstants& direct_source_constants);
+  void ClearSwapDirectRecords() {
+    for (SwapDirectRecord& record : swap_direct_records_) {
+      record.valid = false;
+    }
+  }
+  // The last picture-sized colour resolve (640x360 or more) to each destination that didn't qualify, and the reason
+  // (a string literal), for the swap to say why it found no record, and one log line of the resolve's fields for each
+  // new reason (NoteSwapDirectRejected).
+  struct SwapDirectReject {
+    uint32_t dest_base = 0;
+    const char* reason = nullptr;
+  };
+  SwapDirectReject swap_direct_rejects_[kSwapDirectRecordCount];
+  uint32_t swap_direct_reject_logs_ = 0;
+  void NoteSwapDirectRejected(const draw_util::ResolveInfo& resolve_info,
+                              D3D12RenderTarget* direct_source,
+                              const DirectResolveSourceConstants& direct_source_constants,
+                              const char* reason);
 };
 
 }  // namespace rex::graphics::d3d12
