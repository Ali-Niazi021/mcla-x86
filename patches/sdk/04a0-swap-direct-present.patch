+bool D3D12TextureCache::GetSwapTextureInfo(SwapTextureInfo& info_out, const char*& why_not_out) {
+  const auto& regs = register_file();
+  xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(0);
+  TextureKey key;
+  BindingInfoFromFetchConstant(fetch, key, nullptr);
+  if (!key.is_valid || key.base_page == 0 || key.dimension != xenos::DataDimension::k2DOrStacked) {
+    why_not_out = "the swap's fetch constant is no 2D texture";
+    return false;
+  }
+  if (IsDrawResolutionScaled()) {
+    why_not_out = "resolution scaling";
+    return false;
+  }
+  if (key.format != xenos::TextureFormat::k_8_8_8_8) {
+    why_not_out = "the swap's texture isn't k_8_8_8_8";
+    return false;
+  }
+  if (!key.tiled || key.GetDepthOrArraySize() != 1 || key.mip_max_level != 0 ||
+      key.signed_separate) {
+    why_not_out = "the swap's texture isn't a tiled single-level one";
+    return false;
+  }
+  info_out.base_address = key.base_page << 12;
+  info_out.pitch_div_32 = key.pitch;
+  info_out.width = key.GetWidth();
+  info_out.height = key.GetHeight();
+  info_out.endianness = uint32_t(key.endianness);
+  info_out.format = key.format;
+  info_out.dxgi_format = GetDXGIUnormFormat(key);
+  info_out.shader_4_component_mapping =
+      GuestToHostSwizzle(fetch.swizzle, GetHostFormatSwizzle(key)) |
+      D3D12_SHADER_COMPONENT_MAPPING_ALWAYS_SET_BIT_AVOIDING_ZEROMEM_MISTAKES;
+  return true;
+}
