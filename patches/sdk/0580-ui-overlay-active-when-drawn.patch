@@ -392,6 +395,8 @@ void ImGuiDrawer::Draw(UIDrawContext& ui_draw_context) {
   SetupFontTexture();
 
   if (dialogs_.empty()) {
+    // LOCAL PATCH - MCLA (0580): nothing drawn (and nothing registered to draw).
+    drew_something_ = false;
     return;
   }
 
@@ -424,6 +429,9 @@ void ImGuiDrawer::Draw(UIDrawContext& ui_draw_context) {
 
   ImGui::Render();
   ImDrawData* draw_data = ImGui::GetDrawData();
+  // LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn. Whether this frame put anything on the screen: draw data
+  // with a vertex (also what a dialog that closed itself in this frame drew last).
+  bool drew_something = draw_data && draw_data->TotalVtxCount > 0;
   if (draw_data) {
     RenderDrawLists(draw_data, ui_draw_context);
   }
@@ -437,6 +445,16 @@ void ImGuiDrawer::Draw(UIDrawContext& ui_draw_context) {
   // it now if needed.
   DetachIfLastDialogRemoved();
 
+  // LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn. Or a dialog that is left says it has something to show
+  // (the default for a dialog: it is shown while it exists; the achievement toast says so only while it has a toast
+  // queued), such as one that draws nothing yet in its first frame (a fade-in at zero opacity).
+  if (!drew_something) {
+    drew_something = std::any_of(dialogs_.begin(), dialogs_.end(), [](const ImGuiDialog* dialog) {
+      return dialog->HasVisibleContent();
+    });
+  }
+  drew_something_ = drew_something;
+
   if (!dialogs_.empty()) {
     // Repaint (and handle input) continuously if still active. In detached mode
     // there is no presenter; the app drives repaint via its own present loop.
diff --git a/src/ui/overlay/achievement_toast.cpp b/src/ui/overlay/achievement_toast.cpp
index 53b8c0b4..f7f63c57 100644
--- a/src/ui/overlay/achievement_toast.cpp
+++ b/src/ui/overlay/achievement_toast.cpp
@@ -25,8 +25,19 @@ AchievementToastDialog::AchievementToastDialog(ImGuiDrawer* drawer,
 AchievementToastDialog::~AchievementToastDialog() {}
 
 void AchievementToastDialog::Push(const rex::system::AchievementEvent& event) {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    queue_.push_back({event, std::chrono::steady_clock::now()});
+  }
+  // LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn. The overlay counts as shown from the moment a toast is
+  // pushed (this may be a guest thread), not from the UI thread's next draw of it.
+  Presenter::NoteUIOverlayMayShow();
+}
+
+// LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn.
+bool AchievementToastDialog::HasVisibleContent() const {
   std::lock_guard<std::mutex> lock(mutex_);
-  queue_.push_back({event, std::chrono::steady_clock::now()});
+  return !queue_.empty();
 }
 
