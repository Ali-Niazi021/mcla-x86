   bool IsUIOverlayActive() const { return ui_overlay_active_.load(std::memory_order_acquire); }
+  // LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn. Whether something is (or may be about to be) on the
+  // screen in the overlay, as opposed to drawers being registered that have nothing to draw (the achievement toast
+  // dialog stays registered for the whole run). With the cvar off it is IsUIOverlayActive(), as before. With it on:
+  // a NoteUIOverlayMayShow that no drawer loop has covered yet, or an active overlay whose drawers said they drew
+  // something in either of the last two loops (a frame after they stop is still counted). Any thread. For what has to
+  // be conservative about an overlay (the fused paint's refusal, 04a0) and for an overlay pass that would change
+  // nothing; not for the drawers' repaint requests, which want every registered drawer.
+  bool IsUIOverlayShown() const;
   // The present log (cvar present_log): a present made by a pacer thread of the
   // implementation's, for the image of the given refresh.
   static void LogPresentFromPacer(uint64_t refresh_number, int result, uint64_t present_ns);
@@ -1227,6 +1241,15 @@ class Presenter {
   // overlay last published.
   uint64_t ui_frames_drawn_ = 0;
   std::atomic<uint64_t> ui_overlay_ui_frame_{0};
+  // LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn (IsUIOverlayShown). Written by the UI thread at the end
+  // of each drawer loop (ExecuteUIDrawersFromUIThread): whether the drawers said they drew something in this loop
+  // or in the one before (true until two loops in a row have drawn nothing), the wake sequence number the loop
+  // started with, and the loops in a row that drew nothing (UI thread only). The wake sequence number is bumped by
+  // NoteUIOverlayMayShow from any thread.
+  std::atomic<bool> ui_overlay_drew_{true};
+  std::atomic<uint64_t> ui_overlay_wake_seen_{0};
+  uint32_t ui_overlay_empty_loops_ = 0;
+  static std::atomic<uint64_t> ui_overlay_wake_seq_;
 
  protected:
   // Set by the UI thread when it has drawn the overlay with drawers, cleared when
diff --git a/include/rex/ui/ui_drawer.h b/include/rex/ui/ui_drawer.h
index 4006af6a..19b7a582 100644
--- a/include/rex/ui/ui_drawer.h
+++ b/include/rex/ui/ui_drawer.h
@@ -30,6 +30,13 @@ class UIDrawer {
   // quitting or resizing, if done in the UI, must be deferred via something
   // like WindowedAppContext::CallInUIThreadDeferred.
   virtual void Draw(UIDrawContext& context) = 0;
+
+  // LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn. Whether the Draw that just returned put something on
+  // the screen (or whether what it has to show is about to be: a dialog that exists, a queued pop-up), so the
+  // presenter can tell an overlay that is shown from drawers that are registered with nothing to draw. Asked in the
+  // UI thread right after Draw, from the presenter's drawer loop. The default, true, is "always shown": the old
+  // behaviour for a drawer that doesn't say.
+  virtual bool DrewSomething() const { return true; }
 };
 
 }  // namespace ui
diff --git a/src/ui/d3d12/d3d12_presenter.cpp b/src/ui/d3d12/d3d12_presenter.cpp
