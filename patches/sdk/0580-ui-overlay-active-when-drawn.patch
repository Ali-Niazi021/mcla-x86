-  } else if (!execute_ui_drawers && ui_overlay_paint_mode() && IsUIOverlayActive()) {
+  } else if (!execute_ui_drawers && ui_overlay_paint_mode() && IsUIOverlayActive() &&
+             IsUIOverlayShown()) {
     // UI overlay painting: the UI thread's overlay over the image.
+    // LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn: not while nothing is shown (IsUIOverlayShown is true
+    // with the cvar off): the layer is all zero then, which the premultiplied blend (ONE / INV_SRC_ALPHA) leaves
+    // exactly as it is, in SDR and HDR alike - a full-screen pass for nothing.
     CompositeUIOverlay(command_list, back_buffer_rtv);
     back_buffer_bound = true;
   } else if (execute_ui_drawers) {
diff --git a/src/ui/imgui_drawer.cpp b/src/ui/imgui_drawer.cpp
index 94380930..6b6c6dc7 100644
--- a/src/ui/imgui_drawer.cpp
+++ b/src/ui/imgui_drawer.cpp
@@ -133,6 +133,9 @@ void ImGuiDrawer::AddDialog(ImGuiDialog* dialog) {
     }
   }
   dialogs_.push_back(dialog);
+  // LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn. A dialog is shown from here on, before the UI thread has
