diff --git a/src/ui/presenter.cpp b/src/ui/presenter.cpp
index 2cd2a8bc..748397d5 100644
--- a/src/ui/presenter.cpp
+++ b/src/ui/presenter.cpp
@@ -127,6 +127,19 @@ REXCVAR_DEFINE_BOOL(present_ui_overlay, true, "UI/Presenter",
                     "sync (on Vulkan, with the IMMEDIATE or MAILBOX present mode)")
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
 
+// LOCAL PATCH - MCLA (0580): the overlay counts as shown (the fused gamma paint, 04a0, is refused; the overlay pass is
+// made) only while a drawer has something on the screen, instead of whenever drawers are registered.
+REXCVAR_DEFINE_BOOL(ui_overlay_active_when_drawn, false, "UI/Presenter",
+                    "With UI overlay painting (present_ui_overlay): count the UI overlay as shown only "
+                    "while one of the presenter's UI drawers has something on the screen (an overlay "
+                    "or a dialog is up, a pop-up such as an achievement toast is queued or fading, or "
+                    "has just stopped drawing) instead of for as long as drawers are registered (the "
+                    "achievement toast dialog is registered for the whole run, so the overlay was "
+                    "always counted). Where nothing is shown, the swap_direct_present fused gamma "
+                    "paint is allowed and the overlay pass over the picture, which would change "
+                    "nothing, is skipped. Off: the overlay is counted whenever drawers are registered")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 REXCVAR_DEFINE_INT32(present_debug_stall_ms, 0, "UI/Presenter",
                      "Development: when changed to a positive value, the guest output thread "
                      "sleeps that long once at its next refresh (to test how UI overlay painting "
@@ -896,6 +909,25 @@ bool Presenter::RenderUIOverlayForPaintsFromUIThread() {
   return rendered;
 }
 
+// LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn.
+std::atomic<uint64_t> Presenter::ui_overlay_wake_seq_{0};
+
+void Presenter::NoteUIOverlayMayShow() {
+  ui_overlay_wake_seq_.fetch_add(1, std::memory_order_acq_rel);
+}
+
+bool Presenter::IsUIOverlayShown() const {
+  if (!REXCVAR_GET(ui_overlay_active_when_drawn)) {
+    return IsUIOverlayActive();
+  }
+  // Something may be about to appear that no drawer loop has looked at yet (a dialog added, a pop-up pushed).
+  if (ui_overlay_wake_seq_.load(std::memory_order_acquire) !=
+      ui_overlay_wake_seen_.load(std::memory_order_acquire)) {
+    return true;
+  }
+  return IsUIOverlayActive() && ui_overlay_drew_.load(std::memory_order_acquire);
+}
+
 bool Presenter::IsUIOverlayPaintModeActive() const {
   if (!ui_overlay_paint_mode_ || ui_overlay_paint_suspended_ || ui_overlay_render_failed_) {
     return false;
@@ -926,7 +958,20 @@ void Presenter::UpdateUIOverlayPaintSuspensionFromUIThread(bool draw_ui) {
     // Before the first guest frame, silent since the presenter was set up.
     const uint64_t since = last ? last : ui_overlay_paint_start_ns_;
     const uint64_t silent_ns = ui_overlay_paint_forced_ ? kSilentForcedNs : kSilentNs;
-    if (draw_ui && now > since + silent_ns) {
+    // LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn. A silent guest takes the UI thread to repainting the
+    // last guest frame itself, which for a frame made as swap_direct_present's fused paint (a live render target,
+    // no finished image) shows an older one. With the cvar on the overlay isn't counted as shown just for having
+    // drawers registered, so fused frames are made while the toast dialog is idle; then a silent stretch must not
+    // take the UI thread over either (that frame is the one on the screen, and stays there) until something is shown:
+    // a dialog or a toast during a silent stretch still does, as it did, and its frames are the usual ones. Before the
+    // first guest frame (the UI thread paints the black the window shows meanwhile) and with frame generation (the
+    // pacer presents; never fused) it is as before.
+    bool suspension_wanted = draw_ui;
+    if (suspension_wanted && last && !ui_overlay_paint_forced_ &&
+        REXCVAR_GET(ui_overlay_active_when_drawn)) {
+      suspension_wanted = IsUIOverlayShown();
+    }
+    if (suspension_wanted && now > since + silent_ns) {
       ui_overlay_paint_suspended_ = true;
       ui_overlay_paint_suspended_ns_ = now;
       ui_overlay_active_.store(false, std::memory_order_release);
@@ -1419,7 +1464,8 @@ bool Presenter::LockForGuestOutputThreadPaintCheck(std::unique_lock<std::mutex>&
     why_not = "the surface connection isn't paintable";
   } else if (ui_overlay_paint_mode_ && !IsUIOverlayPaintModeActive()) {
     why_not = "UI overlay painting is suspended or off";
-  } else if (ui_overlay_paint_mode_ && IsUIOverlayActive()) {
+  } else if (ui_overlay_paint_mode_ && IsUIOverlayShown()) {
+    // LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn: IsUIOverlayShown is IsUIOverlayActive with the cvar off.
     why_not = "a UI overlay is shown (the UI thread can repaint the last guest frame while the guest is silent)";
   }
   if (why_not) {
@@ -1855,6 +1901,9 @@ void Presenter::ExecuteUIDrawersFromUIThread(UIDrawContext& ui_draw_context) {
   // Drawers can add or remove drawers (including themselves), need to ensure
   // iterator validity in this case.
   assert_false(is_executing_ui_drawers_);
+  // LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn. A wake from now on is not covered by this loop.
+  const uint64_t wake_seq_at_start = ui_overlay_wake_seq_.load(std::memory_order_acquire);
+  bool drawers_drew_something = false;
   ui_draw_next_iterator_ = ui_drawers_.begin();
   is_executing_ui_drawers_ = true;
   while (ui_draw_next_iterator_ != ui_drawers_.end()) {
@@ -1870,11 +1919,36 @@ void Presenter::ExecuteUIDrawersFromUIThread(UIDrawContext& ui_draw_context) {
     if (it_current->second.last_draw != ui_draw_current_) {
       ui_draw_current_z_order_ = it_current->first;
       it_current->second.last_draw = ui_draw_current_;
-      it_current->second.drawer->Draw(ui_draw_context);
+      // LOCAL PATCH - MCLA (0580): the iterator may be invalid after Draw (a drawer may unregister itself), the
+      // drawer is not.
+      UIDrawer* const drawer = it_current->second.drawer;
+      drawer->Draw(ui_draw_context);
+      drawers_drew_something = drawers_drew_something || drawer->DrewSomething();
     }
   }
   is_executing_ui_drawers_ = false;
   ++ui_draw_current_;
+  // LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn (IsUIOverlayShown). Counted as drawn until two loops in
+  // a row have drawn nothing: the first of them is the frame after the last drawn one, whose (empty) overlay layer
+  // gets published after it, so by the second the layer a paint would put over the image is an empty one. "Drew"
+  // is stored before the wake sequence number it covers, so a reader never sees both as nothing while something
+  // is shown.
+  if (drawers_drew_something) {
+    ui_overlay_empty_loops_ = 0;
+    if (!ui_overlay_drew_.exchange(true, std::memory_order_acq_rel) &&
+        REXCVAR_GET(ui_overlay_active_when_drawn)) {
+      REXLOG_INFO("Presenter: the UI drawers have something on the screen (ui_overlay_active_when_drawn)");
+    }
+  } else {
+    if (ui_overlay_empty_loops_ < 2) {
+      ++ui_overlay_empty_loops_;
+    }
+    if (ui_overlay_empty_loops_ >= 2 && ui_overlay_drew_.exchange(false, std::memory_order_acq_rel) &&
+        REXCVAR_GET(ui_overlay_active_when_drawn)) {
+      REXLOG_INFO("Presenter: the UI drawers have nothing on the screen (ui_overlay_active_when_drawn)");
+    }
+  }
+  ui_overlay_wake_seen_.store(wake_seq_at_start, std::memory_order_release);
 }
 
 void Presenter::SetPaintModeFromUIThread(PaintMode new_mode) {
