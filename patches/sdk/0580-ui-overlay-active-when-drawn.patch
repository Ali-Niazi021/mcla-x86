+  // LOCAL PATCH - MCLA (0580): ui_overlay_active_when_drawn. Whether the last Draw produced draw data with any
+  // vertex, or a dialog still has (or is about to have) something to show. True until the first Draw has said.
+  bool DrewSomething() const override { return drew_something_; }
+
  protected:
   void OnKeyDown(KeyEvent& e) override;
   void OnKeyUp(KeyEvent& e) override;
@@ -135,6 +139,9 @@ class ImGuiDrawer : public WindowInputListener, public UIDrawer {
 
   // Last value handed to the window, so detaching can clear it without a frame.
   bool text_input_active_ = false;
+
+  // LOCAL PATCH - MCLA (0580): see DrewSomething. UI thread only.
+  bool drew_something_ = true;
 };
 
 }  // namespace ui
