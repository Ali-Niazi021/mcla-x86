+// LOCAL PATCH - MCLA (0795): see the declaration.
+void D3D12UploadBufferPool::TouchPageImplementation(Page* page, uint32_t touch_mode) {
+  if (!touch_mode) {
+    return;
+  }
+  // The mapping is write-combined memory: written only, never read.
+  uint8_t* mapping = static_cast<uint8_t*>(static_cast<D3D12Page*>(page)->mapping_);
+  if (touch_mode >= 2) {
+    std::memset(mapping, 0, page_size_);
+    return;
+  }
+  for (size_t offset = 0; offset < page_size_; offset += 4096) {
+    *reinterpret_cast<volatile uint8_t*>(mapping + offset) = 0;
+  }
+}
