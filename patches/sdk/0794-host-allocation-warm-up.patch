+bool RenderTargetCache::PrecreateRenderTarget(RenderTargetKey key, uint64_t* host_memory_bytes_out) {
+  if (host_memory_bytes_out) {
+    *host_memory_bytes_out = 0;
+  }
+  if (GetPath() != Path::kHostRenderTargets) {
+    return false;
+  }
+  auto it_rt = render_targets_.find(key);
+  if (it_rt != render_targets_.end()) {
+    return it_rt->second != nullptr;
+  }
+  RenderTarget* render_target = CreateRenderTarget(key);
+  if (!render_target) {
+    return false;
+  }
+  // The clock of IsTrimDue: a render target nobody has used since this is trimmed like any other, after
+  // render_target_trim_seconds (not at the first check, as one with no time at all would be).
+  render_target->set_last_used_ms(rex::chrono::Clock::QueryHostUptimeMillis());
+  if (host_memory_bytes_out) {
+    *host_memory_bytes_out = render_target->host_memory_bytes();
+  }
+  render_targets_.emplace(key, render_target);
+  return true;
+}
