+// LOCAL PATCH - MCLA (0794): see the declaration. The unscaled range the heap is the scaled image of (EnsureScaled
+// ResolveMemoryCommitted multiplies the unscaled addresses by the area of the draw resolution scale); at a scale whose
+// area is not a power of two it also makes a neighbour of the heap, which is harmless.
+bool D3D12TextureCache::WarmUpScaledResolveHeap(uint32_t heap_index) {
+  if (!IsDrawResolutionScaled() || heap_index >= scaled_resolve_heaps_.size()) {
+    return false;
+  }
+  if (scaled_resolve_heaps_[heap_index]) {
+    return true;
+  }
+  const uint64_t area = uint64_t(draw_resolution_scale_x()) * draw_resolution_scale_y();
+  const uint64_t first_scaled = uint64_t(heap_index) << kScaledResolveHeapSizeLog2;
+  const uint64_t last_scaled = first_scaled + kScaledResolveHeapSize - 1;
+  const uint64_t start_unscaled = first_scaled / area;
+  const uint64_t end_unscaled = last_scaled / area;  // Inclusive.
+  if (end_unscaled >= SharedMemory::kBufferSize) {
+    return false;
+  }
+  warming_up_scaled_resolve_ = true;
+  const bool made = EnsureScaledResolveMemoryCommitted(
+      uint32_t(start_unscaled), uint32_t(end_unscaled - start_unscaled + 1), 0);
+  warming_up_scaled_resolve_ = false;
+  return made && scaled_resolve_heaps_[heap_index];
+}
