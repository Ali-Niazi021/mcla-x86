+// ---------------------------------------------------------------------------------------------------------------------
+// LOCAL PATCH - MCLA (0500): vrs, per-draw variable rate shading (see Vrs in the header).
+// ---------------------------------------------------------------------------------------------------------------------
+
+namespace {
+
+constexpr uint32_t kVrsGroups = 7;
+constexpr const char* kVrsGroupNames[kVrsGroups] = {"pre",       "shadow", "scene", "translucent",
+                                                    "composite", "post",   "tonemap"};
+// The gpu_timing group (kGpuTimingGroupNames: lead, refl, env, shadow, pre, scene, transl, comp, post, tonemap, ui, tail,
+// swap) to the vrs group; kVrsGroups: always 1x1. The reflection and environment map phases are 'pre'.
+constexpr uint8_t kVrsGroupOfTimingGroup[13] = {kVrsGroups, 0, 0, 1, 0, 2, 3, 4, 5, 6, kVrsGroups, kVrsGroups, kVrsGroups};
+
+struct VrsRateName {
+  const char* name;
+  D3D12_SHADING_RATE rate;
+};
+constexpr VrsRateName kVrsRates[] = {
+    {"1x1", D3D12_SHADING_RATE_1X1}, {"1x2", D3D12_SHADING_RATE_1X2}, {"2x1", D3D12_SHADING_RATE_2X1},
+    {"2x2", D3D12_SHADING_RATE_2X2}, {"2x4", D3D12_SHADING_RATE_2X4}, {"4x2", D3D12_SHADING_RATE_4X2},
+    {"4x4", D3D12_SHADING_RATE_4X4}};
+
+// A D3D12_SHADING_RATE is (horizontal log2 << 2) | vertical log2; each axis is limited to max_axis_log2 (1: the 2x4, 4x2
+// and 4x4 rates become 2x2).
+uint32_t VrsClampAxes(uint32_t rate, uint32_t max_axis_log2) {
+  return (std::min(rate >> 2, max_axis_log2) << 2) | std::min(rate & 3, max_axis_log2);
+}
+
+std::string VrsLower(std::string text) {
+  for (char& c : text) {
+    c = char(std::tolower(static_cast<unsigned char>(c)));
+  }
+  return text;
+}
+
+int32_t VrsGroupIndex(const std::string& name) {
+  const std::string lower = VrsLower(name);
+  for (uint32_t i = 0; i < kVrsGroups; ++i) {
+    if (lower == kVrsGroupNames[i]) {
+      return int32_t(i);
+    }
+  }
+  return lower == "transl" ? 3 : (lower == "comp" ? 4 : -1);
+}
+
+// Levels separated by ';', each a list of group=rate separated by ','. A rate that needs the additional shading rates is
+// clamped to 2x2 without them.
+void VrsParseTable(const std::string& text, bool additional,
+                   std::vector<std::array<uint8_t, kVrsGroups>>& levels) {
+  levels.clear();
+  size_t entry_begin = 0;
+  while (entry_begin <= text.size()) {
+    size_t entry_end = text.find(';', entry_begin);
+    if (entry_end == std::string::npos) {
+      entry_end = text.size();
+    }
+    const std::string entry = GpuTimingTrim(text.substr(entry_begin, entry_end - entry_begin));
+    entry_begin = entry_end + 1;
+    if (entry.empty()) {
+      continue;
+    }
+    std::array<uint8_t, kVrsGroups> level = {};
+    size_t assignment_begin = 0;
+    while (assignment_begin <= entry.size()) {
+      size_t assignment_end = entry.find(',', assignment_begin);
+      if (assignment_end == std::string::npos) {
+        assignment_end = entry.size();
+      }
+      const std::string assignment = GpuTimingTrim(entry.substr(assignment_begin, assignment_end - assignment_begin));
+      assignment_begin = assignment_end + 1;
+      if (assignment.empty()) {
+        continue;
+      }
+      const size_t equals = assignment.find('=');
+      const int32_t group =
+          equals == std::string::npos ? -1 : VrsGroupIndex(GpuTimingTrim(assignment.substr(0, equals)));
+      const std::string rate_text =
+          equals == std::string::npos ? std::string() : VrsLower(GpuTimingTrim(assignment.substr(equals + 1)));
+      const VrsRateName* rate = nullptr;
+      for (const VrsRateName& candidate : kVrsRates) {
+        if (rate_text == candidate.name) {
+          rate = &candidate;
+        }
+      }
+      if (group < 0 || !rate) {
+        REXGPU_WARN("[vrs] vrs_levels: level {}: '{}' is not group=rate, left out", levels.size() + 1, assignment);
+        continue;
+      }
+      level[group] = uint8_t(additional ? uint32_t(rate->rate) : VrsClampAxes(uint32_t(rate->rate), 1));
+    }
+    levels.push_back(level);
+  }
+}
+
+// The table in the syntax of vrs_levels (only the groups that are not 1x1; '-' for a level of none).
+std::string VrsTableText(const std::vector<std::array<uint8_t, kVrsGroups>>& levels) {
+  std::string text;
+  for (const auto& level : levels) {
+    std::string entry;
+    for (uint32_t group = 0; group < kVrsGroups; ++group) {
+      if (!level[group]) {
+        continue;
+      }
+      for (const VrsRateName& rate : kVrsRates) {
+        if (uint32_t(rate.rate) == level[group]) {
+          entry += fmt::format("{}{}={}", entry.empty() ? "" : ",", kVrsGroupNames[group], rate.name);
+        }
+      }
+    }
+    text += fmt::format("{}{}", text.empty() ? "" : ";", entry.empty() ? "-" : entry);
+  }
+  return text.empty() ? std::string("-") : text;
+}
+
+}  // namespace
+
+void D3D12CommandProcessor::VrsFrameBegin() {
+  static_assert(Vrs::kGroups == kVrsGroups);
+  Vrs& v = vrs_;
+  if (!v.probed) {
+    v.probed = true;
+    // The render target path is known by now (the render target cache is initialized with the context).
+    const char* off_reason = nullptr;
+    D3D12_FEATURE_DATA_D3D12_OPTIONS6 options6 = {};
+    ID3D12Device* device = GetD3D12Provider().GetDevice();
+    Microsoft::WRL::ComPtr<ID3D12GraphicsCommandList5> command_list_5;
+    if (!render_target_cache_ || render_target_cache_->GetPath() != RenderTargetCache::Path::kHostRenderTargets) {
+      off_reason =
+          "the render target path is ROV (render_target_path_d3d12): the guest's per-sample EDRAM emulation needs "
+          "every sample shaded";
+    } else if (!device ||
+               FAILED(device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS6, &options6, sizeof(options6))) ||
+               options6.VariableShadingRateTier == D3D12_VARIABLE_SHADING_RATE_TIER_NOT_SUPPORTED) {
+      off_reason = "the device does not support variable rate shading";
+    } else if (!command_list_ || FAILED(command_list_->QueryInterface(IID_PPV_ARGS(&command_list_5)))) {
+      off_reason = "the command list has no ID3D12GraphicsCommandList5 (the Direct3D 12 runtime is too old)";
+    }
+    if (off_reason) {
+      REXGPU_INFO("[vrs] off: {}", off_reason);
+    } else {
+      v.supported = true;
+      v.tier = int32_t(options6.VariableShadingRateTier);
+      v.additional = options6.AdditionalShadingRatesSupported != FALSE;
+    }
+  }
+  if (!v.supported) {
+    return;
+  }
+  // The level table, when the text changes (also the first time).
+  const std::string& table_text = REXCVAR_GET(vrs_levels);
+  if (!v.table_parsed || table_text != v.table_text) {
+    v.table_parsed = true;
+    v.table_text = table_text;
+    VrsParseTable(table_text, v.additional, v.levels);
+    rexgpu_vrs_levels.store(int32_t(v.levels.size()), std::memory_order_relaxed);
+    REXGPU_INFO("[vrs] tier {}, additional rates {}, levels {}: {}", v.tier, v.additional ? "yes" : "no",
+                v.levels.size(), VrsTableText(v.levels));
+  }
+  // The effective level: the title's governor, else the cvar.
+  int32_t level = rexgpu_vrs_level.load(std::memory_order_relaxed);
+  if (level < 0) {
+    level = REXCVAR_GET(vrs_level);
+  }
+  level = std::clamp<int32_t>(level, 0, int32_t(v.levels.size()));
+  if (level != v.level) {
+    REXGPU_INFO("[vrs] level {} -> {}", v.level, level);
+    v.level = level;
+  }
+  v.min_width = std::max(0, REXCVAR_GET(vrs_min_target_width));
+  // The rate of the draws of each gpu_timing segment id.
+  for (uint32_t id = 0; id < Vrs::kIds; ++id) {
+    const uint32_t group = kVrsGroupOfTimingGroup[GpuTimingGroupOfId(id)];
+    v.id_rate[id] = (level && group < kVrsGroups) ? v.levels[level - 1][group] : 0;
+  }
+}
+
+uint32_t D3D12CommandProcessor::VrsDrawRate(const D3D12Shader* pixel_shader, uint32_t depth_stencil_mode,
+                                            bool memexport_used) {
+  if (!pixel_shader) {
+    // Depth only (or only a vertex shader's memory export): nothing is shaded, the rate has no effect; leaving it saves
+    // the commands.
+    return UINT32_MAX;
+  }
+  const Vrs& v = vrs_;
+  uint32_t rate = v.id_rate[std::min(gpu_timing_.cur_id, Vrs::kIds - 1)];
+  if (!rate || memexport_used) {
+    // No level, a phase that stays 1x1, or exports from the pixel shader (one invocation per pixel is the contract).
+    return 0;
+  }
+  using DepthStencilMode = DxbcShaderTranslator::Modification::DepthStencilMode;
+  const DepthStencilMode mode = DepthStencilMode(depth_stencil_mode);
+  if (pixel_shader->writes_depth() || mode == DepthStencilMode::kFloat24Truncating ||
+      mode == DepthStencilMode::kFloat24Rounding) {
+    // SV_Depth / SV_DepthLessEqual (the guest's oDepth, or the float24 conversion in the pixel shader, which also
+    // shades per sample): exporting depth makes the hardware shade at the fine rate (D3D12 VRS spec, both tiers).
+    return 0;
+  }
+  if (v.tier < 2 && (pixel_shader->writes_color_targets() & 1) && mode != DepthStencilMode::kEarlyHint) {
+    // Tier 1: a shader that declares SV_Coverage (the translator's alpha to mask output of every colour 0 shader
+    // without [earlydepthstencil]) is shaded at the fine rate anyway; don't record what has no effect.
+    return 0;
+  }
+  const auto surface_info = register_file_->Get<reg::RB_SURFACE_INFO>();
+  if (int32_t(surface_info.surface_pitch) < v.min_width) {
+    return 0;
+  }
+  // MSAA: a coarse pixel can write at most 16 samples (D3D12 VRS spec); 1x1, 1x2, 2x1 and 2x2 are valid up to 4 samples
+  // (2x2 x 4 = 16), the additional rates (2x4, 4x2, 4x4) only for 1 sample (and 2x4 for 2). Clamped to 2x2.
+  uint32_t samples = uint32_t(1) << uint32_t(surface_info.msaa_samples);
+  if (samples == 2 && !render_target_cache_->msaa_2x_supported()) {
+    samples = 4;  // 2x is drawn as 4x with a sample mask
+  }
+  if (samples > 4) {
+    return 0;
+  }
+  return samples > 1 ? VrsClampAxes(rate, 1) : rate;
+}
+
