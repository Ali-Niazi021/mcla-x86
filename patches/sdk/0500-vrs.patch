+  // LOCAL PATCH - MCLA (0500): vrs, per-draw variable rate shading (D3D12 Tier 1 semantics: RSSetShadingRate with the
+  // base rate only), chosen per render phase (the gpu_timing segment the draw is in) as a run-time load valve. The
+  // methods are at the end of command_processor.cpp.
+  struct Vrs {
+    static constexpr uint32_t kGroups = 7;  // pre, shadow, scene, translucent, composite, post, tonemap
+    static constexpr uint32_t kIds = GpuTiming::kIdNone + 1;
+    bool probed = false;      // the device and the render target path were checked (once)
+    bool supported = false;   // variable rate shading can be used (else rexgpu_vrs_levels is 0)
+    bool additional = false;  // 2x4, 4x2, 4x4, and 2x4 with 2x MSAA
+    int32_t tier = 0;
+    bool table_parsed = false;
+    std::string table_text;  // the vrs_levels the table was parsed from
+    std::vector<std::array<uint8_t, kGroups>> levels;  // [level - 1][group]: a D3D12_SHADING_RATE
+    int32_t level = 0;       // the effective level of the frame
+    int32_t min_width = 640;  // vrs_min_target_width, of the frame
+    uint8_t id_rate[kIds] = {};  // the rate of the draws of each gpu_timing segment id, at this frame's level
+    uint32_t current = 0;        // the rate recorded last in the open submission (D3D12_SHADING_RATE_1X1 at its start)
+  } vrs_;
+  // Opening of a frame: the device probe (first frame), the level table, the effective level and the per-segment rates.
+  void VrsFrameBegin();
+  // The rate of the guest draw about to be recorded: a D3D12_SHADING_RATE, or UINT32_MAX when the draw shades nothing
+  // (no pixel shader) and the recorded rate stays. `depth_stencil_mode` is the pixel shader modification's.
+  uint32_t VrsDrawRate(const D3D12Shader* pixel_shader, uint32_t depth_stencil_mode, bool memexport_used);
+  // Records the rate if it is not the recorded one, and counts the coarse draw.
+  void VrsApplyRate(uint32_t rate) {
+    if (rate == UINT32_MAX) {
+      return;
+    }
+    if (rate != vrs_.current) {
+      deferred_command_list_.RSSetShadingRate(D3D12_SHADING_RATE(rate));
+      vrs_.current = rate;
+    }
+    if (rate) {
+      GpuTimingCount(kGtVrs);
+    }
+  }
 };
 
