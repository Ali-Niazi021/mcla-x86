+  // ---- LOCAL PATCH - MCLA (0810): resolve_elide (resolve_elide.cpp) ----
+  //
+  // At a draw resolution scale above 1 a resolve stores its bytes only in the scaled resolve buffer, which the guest CPU
+  // never sees. Its readers are all on the GPU: the load of a scaled_resolve texture over the range
+  // (LoadTextureDataFromResidentMemoryImpl: the cache's textures, the swap texture, resolve_dual_write_verify's scratch
+  // texture), and the 1x copy of resolve_unscaled_copy_rules and the copy to the guest memory of readback_resolve_rules,
+  // which read the resolve just made and are chosen by its rules. A dual-written resolve (resolve_dual_write at scale:
+  // scaled_copy_levers 1) has already put the same dwords into the texture that samples them, now up to date; the stored
+  // copy is read only if a load over the range comes before another resolve writes all of those bytes again: a texture
+  // of another shape over the range, or the written one after something else made it outdated.
+  //
+  // resolve_elide (1 learn, 2 elide, 3 elide + poison) keeps a record of the area each dual-written store wrote (its
+  // destination base, row pitch, bytes a texel and area, which fix the bytes: the scaled tiled address of a texel
+  // depends on nothing else) until a later resolve with the same base, pitch and texel size writes an area containing
+  // it, and checks every load from the scaled resolve buffer against the live records. A load over a record's range
+  // consumes it, and its destination (the key: extent, pitch, height, format and source of the copy registers, the
+  // fields of the rules) is kept (its bytes stored) for the rest of the run. With 2 the store of a key goes to a null
+  // view (no bytes) once resolve_elide_after of its resolves went by unconsumed, unless a rule reads it (unscaled copy,
+  // readback, resolve_elide_keep_rules), the texture was written only in part and is outdated (it will be loaded), or
+  // resolve_dual_write_verify is on. A load over an elided record reads what the buffer held before: one wrong load,
+  // logged ([resolve-elide] MISS), the key kept from then on. 1 makes every store and reports what 2 would have done
+  // (would-miss). 3 also fills the range of each elided store with resolve_elide_poison_value, so that a reader the
+  // tracking does not know of shows in the picture.
+  struct ResolveElideGeometry {
+    // The guest range the resolve may write (copy_dest_extent_start, copy_dest_extent_length).
+    uint32_t extent_start = 0;
+    uint32_t extent_length = 0;
+    // The address function of the area: the base its tiled offsets are relative to (copy_dest_base), the row pitch in 32
+    // texels, the bytes a texel (0 for a kind the records do not cover); the area in guest texels from that base,
+    // [x0, x1) x [y0, y1); into an array (not covered).
+    uint32_t dest_base = 0;
+    uint32_t pitch_div_32 = 0;
+    uint32_t bytes_per_texel = 0;
+    uint32_t x0 = 0, y0 = 0, x1 = 0, y1 = 0;
+    bool array = false;
+    // The rule fields of the copy registers: RB_COPY_DEST_PITCH pitch and height, RB_COPY_DEST_INFO format,
+    // RB_COPY_CONTROL source.
+    uint32_t rule_pitch = 0, rule_height = 0, rule_format = 0, rule_source = 0;
+    // copy_byte_census: the bytes of a host pixel of the source (the bytes of a sample times the samples).
+    uint32_t source_bytes_per_pixel = 0;
+  };
+  struct ResolveElideDecision {
+    // The store goes to a null view.
+    bool elide = false;
+    // resolve_elide 1: what 2 would have done.
+    bool would_elide = false;
+    // A record of the store is kept.
+    bool track = false;
+    uint32_t key_index = UINT32_MAX;
+    // The texture the resolve writes along with the store (for the log).
+    TextureKey written_texture_key;
+  };
+  // Whether DecideResolveElide and NoteResolveElideWritten have work: resolve_elide on, or records left from it.
+  bool IsResolveElideActive() const;
+  // Before the dispatch of a resolve at a draw resolution scale above 1. dual_target: the texture it writes as well
+  // (resolve_dual_write), null if none.
+  ResolveElideDecision DecideResolveElide(const ResolveElideGeometry& geometry,
+                                          const ResolveDualWriteTarget* dual_target);
+  // For an elided store, in place of CreateCurrentScaledResolveRangeUintPow2UAV: a null view of the same format.
+  void WriteNullScaledResolveRangeUAV(D3D12_CPU_DESCRIPTOR_HANDLE handle, uint32_t element_size_bytes_pow2);
+  // After the dispatch of a resolve at a draw resolution scale above 1 (while IsResolveElideActive), the range it made
+  // current still current: the records it overwrites whole go, its own is added, the poison is filled.
+  void NoteResolveElideWritten(const ResolveElideGeometry& geometry, const ResolveElideDecision& decision);
+  // copy_byte_census: after every resolve that copied (any scale).
+  void NoteResolveCopyBytes(const ResolveElideGeometry& geometry, bool dual_written, bool elided);
+
   // ---- LOCAL PATCH - MCLA (0560): resolve_defer_memory_write ----
   //
   // A resolve that D3D12RenderTargetCache::Resolve has dual-written (resolve_dual_write) whole - the
@@ -987,6 +1053,99 @@ class D3D12TextureCache final : public TextureCache {
                                     bool compare_all);  // LOCAL PATCH - MCLA (0530): resolve_dual_write_msaa
   void ProcessResolveDualWriteVerifies(uint64_t completed_submission_index);
 
+  // ---- LOCAL PATCH - MCLA (0810): resolve_elide (resolve_elide.cpp) ----
+  // Why a dual-written resolve was not elided (resolve_elide 2), in the order the reasons are tried; kElided when it was.
+  enum class ResolveElideKeep : uint32_t {
+    kElided,
+    // resolve_elide 1: the store is made anyway (it would have been elided).
+    kLearn,
+    kReadbackGlobal,
+    kUnscaledCopyRule,
+    kReadbackRule,
+    kKeepRule,
+    kConsumed,
+    kPartialOutdated,
+    kVerify,
+    kSmall,
+    kWarmUp,
+    kRecordsFull,
+    kCount,
+  };
+  // One destination: the extent and the rule fields (address, length, pitch, height, format, source).
+  using ResolveElideKeyFields = std::array<uint32_t, 6>;
+  struct ResolveElideKeyInfo {
+    ResolveElideKeyFields fields = {};
+    // Dual-written stores of it seen, elided, the bytes of those, the bytes of one.
+    uint64_t seen = 0;
+    uint64_t elided = 0;
+    uint64_t elided_bytes = 0;
+    uint64_t store_bytes = 0;
+    // Records of it a load read, and of those the elided ones (misses) and the ones 2 would have elided (resolve_elide 1).
+    uint64_t consumed = 0;
+    uint64_t misses = 0;
+    uint64_t would_misses = 0;
+    // Read once: stored from then on.
+    bool kept_consumed = false;
+    bool miss_logged = false;
+  };
+  // The area one tracked store wrote.
+  struct ResolveElideRecord {
+    uint32_t key_index = 0;
+    uint32_t extent_start = 0, extent_end = 0;
+    uint32_t dest_base = 0, pitch_div_32 = 0, bytes_per_texel = 0;
+    uint32_t x0 = 0, y0 = 0, x1 = 0, y1 = 0;
+    uint64_t host_bytes = 0;
+    // The texture the resolve wrote along with it (for the log).
+    TextureKey written_texture_key;
+    bool elided = false;
+    bool would_elide = false;
+    bool consumed = false;
+  };
+  struct ResolveElideStats {
+    // Since the last line: resolves at scale while active, dual-written ones tracked, why each tracked store was made
+    // (kElided: it was not), the bytes elided (and that 2 would have elided, with 1).
+    uint64_t resolves = 0;
+    uint64_t tracked = 0;
+    uint64_t keep[size_t(ResolveElideKeep::kCount)] = {};
+    uint64_t elided_bytes = 0;
+    uint64_t would_elide_bytes = 0;
+    // Records overwritten whole by a later resolve: stored and never read, elided (and the bytes).
+    uint64_t superseded_unread = 0, superseded_unread_bytes = 0;
+    uint64_t superseded_elided = 0, superseded_elided_bytes = 0;
+    // Loads over live records: records consumed (and the bytes), misses, would-misses, keys learned.
+    uint64_t consumed = 0, consumed_bytes = 0;
+    uint64_t misses = 0, would_misses = 0;
+    uint64_t keys_learned = 0;
+    // Not tracked: not dual-written, the key table full, a kind the records do not cover.
+    uint64_t not_dual_written = 0, keys_full = 0, not_covered = 0;
+    uint64_t poisoned = 0, poison_skipped = 0;
+  };
+  void NoteTextureLoadForResolveElide(const D3D12Texture& texture, bool load_base, bool load_mips);
+  void NoteResolveElideScaledRead(const TextureKey& reader, uint32_t start, uint32_t length);
+  void RemoveResolveElideRecordAt(size_t index);
+  void PoisonResolveElideRecord(const ResolveElideRecord& record);
+  std::string DescribeResolveElideKey(const ResolveElideKeyInfo& info) const;
+  void LogResolveElideIfDue(bool at_exit);
+  void ShutdownResolveElide();
+  std::vector<ResolveElideRecord> resolve_elide_records_;
+  size_t resolve_elide_elided_records_ = 0;
+  std::map<ResolveElideKeyFields, uint32_t> resolve_elide_key_indices_;
+  std::vector<ResolveElideKeyInfo> resolve_elide_keys_;
+  ResolveElideStats resolve_elide_stats_;
+  int32_t resolve_elide_mode_ = 0;
+  uint64_t resolve_elide_last_log_ms_ = 0;
+  uint64_t resolve_elide_last_log_frame_ = 0;
+  uint32_t resolve_elide_consumed_lines_ = 0;
+  // The frame the first destination was seen in (the rates of the lines at exit).
+  uint64_t resolve_elide_first_frame_ = 0;
+  // resolve_dual_write_verify's own load is not a reader the tracking learns from.
+  bool resolve_elide_ignore_reads_ = false;
+  // resolve_elide 3: the CPU descriptors ClearUnorderedAccessViewUint takes, a ring, and the submission each was last
+  // used in (reused only once that submission has completed: its deferred command list has been replayed by then).
+  Microsoft::WRL::ComPtr<ID3D12DescriptorHeap> resolve_elide_poison_heap_;
+  std::vector<uint64_t> resolve_elide_poison_slot_submission_;
+  uint32_t resolve_elide_poison_next_ = 0;
