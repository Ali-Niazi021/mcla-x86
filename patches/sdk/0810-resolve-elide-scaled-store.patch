 REXCVAR_DEFINE_BOOL(resolve_unscaled_copy_batch, true, "GPU",
                     "With resolve_unscaled_copy_rules: the copies of the scaled resolves wait for "
                     "the next draw, swap or end of the submission and are made together, with one "
@@ -886,6 +896,54 @@ int CommandProcessor::MatchUnscaledResolveCopyRule(uint32_t written_address,
       uint32_t(copy_control.copy_src_select), guest_marker_phase_);
 }
 
+// LOCAL PATCH - MCLA (0810): resolve_elide
+int CommandProcessor::MatchResolveScaledBytesReader(uint32_t written_address, uint32_t written_length) {
+  if (!written_length) {
+    return 0;
+  }
+  if (MatchUnscaledResolveCopyRule(written_address, written_length) >= 0) {
+    return 1;
+  }
+  // The rules are parsed here as well (GetReadbackResolveModeFor parses them only for the resolves it is asked about, and
+  // logs): the same text gives the same rules.
+  const std::string& readback_text = REXCVAR_GET(readback_resolve_rules);
+  if (readback_text != elide_readback_rules_text_) {
+    elide_readback_rules_text_ = readback_text;
+    ParseReadbackRules(elide_readback_rules_text_, elide_readback_rules_, "readback_resolve_rules");
+  }
+  std::string keep_text = REXCVAR_GET(resolve_elide_keep_rules);
+  if (keep_text == "off") {
+    keep_text.clear();
+  }
+  if (keep_text != elide_keep_rules_text_) {
+    elide_keep_rules_text_ = keep_text;
+    ParseReadbackRules(elide_keep_rules_text_, elide_keep_rules_, "resolve_elide_keep_rules");
+    REXGPU_INFO("resolve_elide_keep_rules: {} rule(s) from \"{}\"", elide_keep_rules_.size(),
+                elide_keep_rules_text_);
+  }
+  if (elide_readback_rules_.empty() && elide_keep_rules_.empty()) {
+    return 0;
+  }
+  const reg::RB_COPY_CONTROL copy_control = register_file_->Get<reg::RB_COPY_CONTROL>();
+  const reg::RB_COPY_DEST_INFO copy_dest_info = register_file_->Get<reg::RB_COPY_DEST_INFO>();
+  const reg::RB_COPY_DEST_PITCH copy_dest_pitch = register_file_->Get<reg::RB_COPY_DEST_PITCH>();
+  const uint64_t first = written_address;
+  const uint64_t last = first + (written_length - 1);
+  const uint32_t pitch = uint32_t(copy_dest_pitch.copy_dest_pitch);
+  const uint32_t height = uint32_t(copy_dest_pitch.copy_dest_height);
+  const uint32_t format = uint32_t(copy_dest_info.copy_dest_format);
+  const uint32_t source = uint32_t(copy_control.copy_src_select);
+  if (FindMatchingReadbackRule(elide_readback_rules_, first, last, written_length, pitch, height, format, source,
+                               guest_marker_phase_) >= 0) {
+    return 2;
+  }
+  if (FindMatchingReadbackRule(elide_keep_rules_, first, last, written_length, pitch, height, format, source,
+                               guest_marker_phase_) >= 0) {
+    return 3;
+  }
+  return 0;
+}
