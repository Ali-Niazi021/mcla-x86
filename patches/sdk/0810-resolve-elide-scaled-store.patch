+  geometry_out.extent_start = resolve_info.copy_dest_extent_start;
+  geometry_out.extent_length = resolve_info.copy_dest_extent_length;
+  geometry_out.dest_base = resolve_info.copy_dest_base & 0x1FFFFFFF;
+  geometry_out.pitch_div_32 = resolve_info.copy_dest_coordinate_info.pitch_aligned_div_32;
+  switch (copy_shader) {
+    case draw_util::ResolveCopyShaderIndex::kFast32bpp1x2xMSAA:
+    case draw_util::ResolveCopyShaderIndex::kFast32bpp4xMSAA:
+    case draw_util::ResolveCopyShaderIndex::kFull32bpp:
+      geometry_out.bytes_per_texel = 4;
+      break;
+    case draw_util::ResolveCopyShaderIndex::kFast64bpp1x2xMSAA:
+    case draw_util::ResolveCopyShaderIndex::kFast64bpp4xMSAA:
+    case draw_util::ResolveCopyShaderIndex::kFull64bpp:
+      geometry_out.bytes_per_texel = 8;
+      break;
+    case draw_util::ResolveCopyShaderIndex::kFull8bpp:
+      geometry_out.bytes_per_texel = 1;
+      break;
+    case draw_util::ResolveCopyShaderIndex::kFull16bpp:
+      geometry_out.bytes_per_texel = 2;
+      break;
+    default:
+      geometry_out.bytes_per_texel = 16;
+      break;
+  }
+  geometry_out.x0 = resolve_info.copy_dest_coordinate_info.offset_x_div_8 << xenos::kResolveAlignmentPixelsLog2;
+  geometry_out.y0 = resolve_info.copy_dest_coordinate_info.offset_y_div_8 << xenos::kResolveAlignmentPixelsLog2;
+  geometry_out.x1 =
+      geometry_out.x0 + (resolve_info.coordinate_info.width_div_8 << xenos::kResolveAlignmentPixelsLog2);
+  geometry_out.y1 = geometry_out.y0 + (resolve_info.height_div_8 << xenos::kResolveAlignmentPixelsLog2);
+  geometry_out.array = resolve_info.copy_dest_info.copy_dest_array != 0;
+  const reg::RB_COPY_DEST_PITCH copy_dest_pitch = regs.Get<reg::RB_COPY_DEST_PITCH>();
+  geometry_out.rule_pitch = uint32_t(copy_dest_pitch.copy_dest_pitch);
+  geometry_out.rule_height = uint32_t(copy_dest_pitch.copy_dest_height);
+  geometry_out.rule_format = uint32_t(resolve_info.copy_dest_info.copy_dest_format);
+  geometry_out.rule_source = uint32_t(regs.Get<reg::RB_COPY_CONTROL>().copy_src_select);
+  const draw_util::ResolveEdramInfo& edram_info =
+      resolve_info.IsCopyingDepth() ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  geometry_out.source_bytes_per_pixel = (edram_info.format_is_64bpp ? 8u : 4u)
+                                        << uint32_t(edram_info.msaa_samples);
+}
