diff --git a/include/rex/graphics/d3d12/copy_census.h b/include/rex/graphics/d3d12/copy_census.h
new file mode 100644
index 0000000..40d29d0
--- /dev/null
+++ b/include/rex/graphics/d3d12/copy_census.h
@@ -0,0 +1,43 @@
+/**
+ * LOCAL PATCH - MCLA (0810): copy_byte_census (Direct3D 12). The host bytes the copy work of a frame reads and writes, by
+ * class, counted where the work is recorded (resolves and texture loads: 0810; ownership transfers and resolve clears:
+ * 0811) and logged as `[copy-bytes] ...` every 10 s, per frame. The counts are what each operation addresses (the area
+ * times the scale times the bytes of a pixel), not what the GPU's caches and compression make of it. The command
+ * processor's thread only.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+namespace rex::graphics::d3d12 {
+
+enum class CopyByteClass : uint32_t {
+  // A resolve: the source render target's pixels it reads (every sample), the bytes it stores (the shared memory at 1x,
+  // the scaled resolve buffer at a draw resolution scale above 1), the stores resolve_elide sent to a null view, and
+  // the texture a dual write (resolve_dual_write) wrote along with them.
+  kResolveRead,
+  kResolveStore,
+  kResolveStoreElided,
+  kDualWriteTexture,
+  // A texture load: the guest (or scaled resolve buffer) bytes read and the texture written (taken as the same).
+  kTextureLoadRead,
+  kTextureLoadWrite,
+  // An EDRAM ownership transfer: the source render target read, the destination written (after the cut of
+  // skip_overwritten_transfers / tonemap_transfer_skip).
+  kTransferRead,
+  kTransferWrite,
+  // A resolve clear of a host render target.
+  kClearWrite,
+
+  kCount,
+};
+
+// copy_byte_census is on.
+bool IsCopyByteCensusOn();
+void CountCopyBytes(CopyByteClass byte_class, uint64_t bytes, uint32_t operations = 1);
+// While the census is on: logs the line when 10 s have gone by since the last one; current_frame:
+// D3D12CommandProcessor::GetCurrentFrame.
+void LogCopyByteCensusIfDue(uint64_t current_frame);
+
+}  // namespace rex::graphics::d3d12
