+/**
+ * LOCAL PATCH - MCLA (0810): resolve_elide and copy_byte_census (Direct3D 12).
+ *
+ * resolve_elide: at a draw resolution scale above 1, the store into the scaled resolve buffer of a resolve that was
+ * dual-written (resolve_dual_write, scaled_copy_levers 1) goes to a null view for the destinations whose stored bytes no
+ * load reads before another resolve writes them again; learned in the run (a load over the range of a tracked store keeps
+ * the destination), with rules (resolve_elide_keep_rules), a dry run (1), and a poison (3). The design is in the comment of
+ * D3D12TextureCache::ResolveElideGeometry (texture_cache.h) and in the patch's header.
+ *
+ * copy_byte_census: the host bytes of the copy work of a frame by class (copy_census.h).
+ */
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include <rex/assert.h>
+#include <rex/chrono/clock.h>
+#include <rex/cvar.h>
+#include <rex/graphics/d3d12/command_processor.h>
+#include <rex/graphics/d3d12/copy_census.h>
+#include <rex/graphics/d3d12/texture_cache.h>
+#include <rex/graphics/pipeline/texture/info.h>
+#include <rex/logging.h>
+#include <rex/math.h>
+#include <rex/thread/mutex.h>
+#include <rex/ui/d3d12/d3d12_util.h>
+
+REXCVAR_DECLARE(int32_t, resolve_dual_write_verify);
+
+REXCVAR_DEFINE_INT32(resolve_elide, 0, "GPU/D3D12",
+                     "At a draw resolution scale above 1, with resolve_dual_write (scaled_copy_levers 1): 0 (the "
+                     "default) every resolve stores its bytes in the scaled resolve buffer as before; 1 learn: the same, "
+                     "and every load from the buffer is checked against the stores of the dual-written resolves that no "
+                     "later resolve has overwritten whole: the destinations read are logged in the grammar of the rules "
+                     "('[resolve-elide] read: addr=...'), with what 2 would have done (would-miss); 2 elide: the store of "
+                     "a dual-written resolve goes to a null view (the texture that samples it is written and up to date) "
+                     "once resolve_elide_after of the resolves of its destination went by with no load reading them, "
+                     "unless a rule of resolve_unscaled_copy_rules, readback_resolve_rules or resolve_elide_keep_rules "
+                     "matches it; a load that does read an elided store gets what the buffer held before ('[resolve-elide] "
+                     "MISS', an error: one wrong texture), and the destination is stored from then on; 3: as 2, and the "
+                     "range of every elided store is filled with resolve_elide_poison_value, so that a reader the "
+                     "tracking does not see shows in the picture (a proof mode, not for play). '[resolve-elide] ...' "
+                     "every 10 s and at exit. No effect at a scale of 1")
+    .range(0, 3)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_INT32(resolve_elide_after, 60, "GPU/D3D12",
+                     "With resolve_elide 2 or 3: the resolves of a destination that are stored (and watched) before its "
+                     "stores are elided; one that is read in that time is never elided. 0: from the first")
+    .range(0, 1000000)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_INT32(resolve_elide_min_kb, 16384, "GPU/D3D12",
+                     "With resolve_elide 2 or 3: only stores of at least this many KiB of the scaled resolve buffer are "
+                     "elided (16384, the default: at 2000p the full-screen resolves, 25 MB in 8-bit colour and 50 MB in "
+                     "16-bit float, and none of the half-size or smaller ones); 0: every size. The tracking and the log "
+                     "(and resolve_elide 1's would-have-elided) take every size")
+    .range(0, 1 << 22)
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_UINT32(resolve_elide_poison_value, 0xFFFF00FF, "GPU/D3D12",
+                      "With resolve_elide 3: the dword the range of an elided store is filled with (0xFFFF00FF: a "
+                      "saturated magenta, yellow or cyan in an 8-bit colour texture, depending on its component order; "
+                      "not a number in a 16-bit float one)")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+REXCVAR_DEFINE_BOOL(copy_byte_census, false, "GPU/D3D12",
+                    "Log '[copy-bytes] ...' every 10 s: the host bytes read and written a frame by the copy work, by "
+                    "class: resolves (read, stored, stores elided by resolve_elide, dual-written textures), texture "
+                    "loads, EDRAM ownership transfers and resolve clears (each the area it addresses times the scale "
+                    "times the bytes of a pixel)")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+namespace rex::graphics::d3d12 {
+
+namespace {
+
+// Live records (the oldest store that was made goes first when full; an elided one is never dropped, so there are at most
+// this many elided ones, and an elision is refused at that count), destinations, consumed lines in the log.
+constexpr size_t kMaxResolveElideRecords = 1024;
+constexpr size_t kMaxResolveElideElidedRecords = 512;
+constexpr size_t kMaxResolveElideKeys = 1024;
+constexpr uint32_t kMaxResolveElideReadLines = 64;
+constexpr uint32_t kMaxResolveElideExitKeyLines = 64;
+// resolve_elide 3: the CPU descriptors of the clears.
+constexpr uint32_t kResolveElidePoisonSlots = 4096;
+
+const char* const kResolveElideKeepNames[] = {
+    "elided",           "learn (stored)",    "readback (all)", "unscaled copy rule", "readback rule", "keep rule",
+    "read before",      "partial, outdated", "dual-write verify", "smaller than resolve_elide_min_kb", "warm-up",
+    "records full",
+};
+
+const char* const kResolveElideModeNames[] = {"off", "learn", "elide", "elide + poison"};
+
+std::string Megabytes(double bytes) { return fmt::format("{:.2f} MB", bytes / 1048576.0); }
+
+// copy_byte_census.
+struct CopyByteCensusState {
+  uint64_t bytes[size_t(CopyByteClass::kCount)] = {};
+  uint64_t operations[size_t(CopyByteClass::kCount)] = {};
+  uint64_t window_start_ms = 0;
+  uint64_t window_start_frame = 0;
+};
+CopyByteCensusState g_copy_byte_census;
+
+}  // namespace
+
+bool IsCopyByteCensusOn() { return REXCVAR_GET(copy_byte_census); }
+
+void CountCopyBytes(CopyByteClass byte_class, uint64_t bytes, uint32_t operations) {
+  g_copy_byte_census.bytes[size_t(byte_class)] += bytes;
+  g_copy_byte_census.operations[size_t(byte_class)] += operations;
+}
+
+void LogCopyByteCensusIfDue(uint64_t current_frame) {
+  CopyByteCensusState& state = g_copy_byte_census;
+  const uint64_t now = rex::chrono::Clock::QueryHostUptimeMillis();
+  // Called only while the census is on; a window much older than the period is from before it was switched off.
+  if (!state.window_start_ms || now - state.window_start_ms > 30000) {
+    state = CopyByteCensusState();
+    state.window_start_ms = now;
+    state.window_start_frame = current_frame;
+    return;
+  }
+  if (now - state.window_start_ms < 10000) {
+    return;
+  }
+  const double seconds = double(now - state.window_start_ms) / 1000.0;
+  const uint64_t frames = current_frame > state.window_start_frame ? current_frame - state.window_start_frame : 0;
+  const double per_frame = frames ? 1.0 / double(frames) : 0.0;
+  auto mb = [&](CopyByteClass c) { return Megabytes(double(state.bytes[size_t(c)]) * per_frame); };
+  auto n = [&](CopyByteClass c) { return double(state.operations[size_t(c)]) * per_frame; };
+  uint64_t read = 0, written = 0;
+  for (CopyByteClass c : {CopyByteClass::kResolveRead, CopyByteClass::kTextureLoadRead, CopyByteClass::kTransferRead}) {
+    read += state.bytes[size_t(c)];
+  }
+  for (CopyByteClass c : {CopyByteClass::kResolveStore, CopyByteClass::kDualWriteTexture, CopyByteClass::kTextureLoadWrite,
+                          CopyByteClass::kTransferWrite, CopyByteClass::kClearWrite}) {
+    written += state.bytes[size_t(c)];
+  }
+  REXGPU_INFO(
+      "[copy-bytes] a frame over {} frames ({:.1f} s): resolve read {} ({:.1f}), stored {} ({:.1f}), stores elided {} "
+      "({:.1f}), dual-written textures {} ({:.1f}); texture loads read {} written {} ({:.1f}); transfers read {} written "
+      "{} ({:.1f}); resolve clears {} ({:.1f}); all read {}, all written {} (count a frame in brackets)",
+      frames, seconds, mb(CopyByteClass::kResolveRead), n(CopyByteClass::kResolveRead), mb(CopyByteClass::kResolveStore),
+      n(CopyByteClass::kResolveStore), mb(CopyByteClass::kResolveStoreElided), n(CopyByteClass::kResolveStoreElided),
+      mb(CopyByteClass::kDualWriteTexture), n(CopyByteClass::kDualWriteTexture), mb(CopyByteClass::kTextureLoadRead),
+      mb(CopyByteClass::kTextureLoadWrite), n(CopyByteClass::kTextureLoadRead), mb(CopyByteClass::kTransferRead),
+      mb(CopyByteClass::kTransferWrite), n(CopyByteClass::kTransferWrite), mb(CopyByteClass::kClearWrite),
+      n(CopyByteClass::kClearWrite), Megabytes(double(read) * per_frame), Megabytes(double(written) * per_frame));
+  state = CopyByteCensusState();
+  state.window_start_ms = now;
+  state.window_start_frame = current_frame;
+}
+
+bool D3D12TextureCache::IsResolveElideActive() const {
+  return REXCVAR_GET(resolve_elide) != 0 || !resolve_elide_records_.empty();
+}
+
+D3D12TextureCache::ResolveElideDecision D3D12TextureCache::DecideResolveElide(
+    const ResolveElideGeometry& geometry, const ResolveDualWriteTarget* dual_target) {
+  static_assert(rex::countof(kResolveElideKeepNames) == size_t(ResolveElideKeep::kCount), "A name for every reason");
+  ResolveElideDecision decision;
+  const int32_t mode = std::clamp(REXCVAR_GET(resolve_elide), int32_t(0), int32_t(3));
+  if (mode != resolve_elide_mode_) {
+    REXGPU_INFO("[resolve-elide] mode {} ({}), was {}; {} records live, {} of them elided", mode,
+                kResolveElideModeNames[mode], resolve_elide_mode_, resolve_elide_records_.size(),
+                resolve_elide_elided_records_);
+    resolve_elide_mode_ = mode;
+    if (!mode) {
+      // Only the elided stores still need watching: their bytes are not in the buffer.
+      for (size_t i = resolve_elide_records_.size(); i-- > 0;) {
+        if (!resolve_elide_records_[i].elided) {
+          RemoveResolveElideRecordAt(i);
+        }
+      }
+    }
+  }
+  if (!mode) {
+    return decision;
+  }
+  if (!dual_target || !dual_target->texture) {
+    // Nothing else holds the bytes: the store is what the texture will be loaded from.
+    ++resolve_elide_stats_.not_dual_written;
+    return decision;
+  }
+  if (geometry.array || !geometry.bytes_per_texel || !geometry.extent_length || geometry.x1 <= geometry.x0 ||
+      geometry.y1 <= geometry.y0) {
+    ++resolve_elide_stats_.not_covered;
+    return decision;
+  }
+  const ResolveElideKeyFields fields = {geometry.extent_start, geometry.extent_length, geometry.rule_pitch,
+                                        geometry.rule_height,  geometry.rule_format,   geometry.rule_source};
+  uint32_t key_index;
+  auto key_it = resolve_elide_key_indices_.find(fields);
+  if (key_it != resolve_elide_key_indices_.end()) {
+    key_index = key_it->second;
+  } else {
+    if (resolve_elide_keys_.size() >= kMaxResolveElideKeys) {
+      ++resolve_elide_stats_.keys_full;
+      return decision;
+    }
+    key_index = uint32_t(resolve_elide_keys_.size());
+    if (resolve_elide_keys_.empty()) {
+      resolve_elide_first_frame_ = command_processor_.GetCurrentFrame();
+    }
+    resolve_elide_keys_.emplace_back();
+    resolve_elide_keys_.back().fields = fields;
+    resolve_elide_key_indices_.emplace(fields, key_index);
+  }
+  const ResolveElideKeyInfo& info = resolve_elide_keys_[key_index];
+  decision.track = true;
+  decision.key_index = key_index;
+  // The reasons to store, in order: a reader that is not a texture load (the copies right after the resolve), the keys
+  // kept by hand or by a read, a texture the resolve leaves outdated (it is loaded from the buffer), the dual-write
+  // verify (it loads from the buffer), the warm-up, the limit of the watch.
+  ResolveElideKeep keep = ResolveElideKeep::kElided;
+  if (command_processor_.IsReadbackResolveGloballyEnabled()) {
+    keep = ResolveElideKeep::kReadbackGlobal;
+  } else {
+    switch (command_processor_.MatchResolveScaledBytesReader(geometry.extent_start, geometry.extent_length)) {
+      case 1:
+        keep = ResolveElideKeep::kUnscaledCopyRule;
+        break;
+      case 2:
+        keep = ResolveElideKeep::kReadbackRule;
+        break;
+      case 3:
+        keep = ResolveElideKeep::kKeepRule;
+        break;
+      default:
+        break;
+    }
+  }
+  if (keep == ResolveElideKeep::kElided && info.kept_consumed) {
+    keep = ResolveElideKeep::kConsumed;
+  }
+  if (keep == ResolveElideKeep::kElided && dual_target->partial) {
+    // FinishResolveDualWrite keeps a texture written in part up to date only if it was before.
+    auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+    if (dual_target->texture->base_outdated(global_lock)) {
+      keep = ResolveElideKeep::kPartialOutdated;
+    }
+  }
+  if (keep == ResolveElideKeep::kElided && REXCVAR_GET(resolve_dual_write_verify) > 0) {
+    keep = ResolveElideKeep::kVerify;
+  }
+  // The size floor applies to what 2 does (1 reports every size as what 2 would do with resolve_elide_min_kb 0).
+  if (keep == ResolveElideKeep::kElided && mode >= 2 &&
+      uint64_t(geometry.x1 - geometry.x0) * (geometry.y1 - geometry.y0) * geometry.bytes_per_texel *
+              draw_resolution_scale_x() * draw_resolution_scale_y() <
+          (uint64_t(std::max(REXCVAR_GET(resolve_elide_min_kb), int32_t(0))) << 10)) {
+    keep = ResolveElideKeep::kSmall;
+  }
+  if (keep == ResolveElideKeep::kElided && info.seen < uint64_t(std::max(REXCVAR_GET(resolve_elide_after), int32_t(0)))) {
+    keep = ResolveElideKeep::kWarmUp;
+  }
+  if (keep == ResolveElideKeep::kElided && resolve_elide_elided_records_ >= kMaxResolveElideElidedRecords) {
+    keep = ResolveElideKeep::kRecordsFull;
+  }
+  if (keep == ResolveElideKeep::kElided) {
+    if (mode >= 2) {
+      decision.elide = true;
+    } else {
+      decision.would_elide = true;
+      keep = ResolveElideKeep::kLearn;
+    }
+  }
+  ++resolve_elide_stats_.keep[size_t(keep)];
+  decision.written_texture_key = dual_target->texture->key();
+  return decision;
+}
+
+void D3D12TextureCache::WriteNullScaledResolveRangeUAV(D3D12_CPU_DESCRIPTOR_HANDLE handle,
+                                                       uint32_t element_size_bytes_pow2) {
+  // The format and the size of the view the resolve's stores would go through (they are discarded).
+  D3D12_UNORDERED_ACCESS_VIEW_DESC desc = {};
+  desc.Format = ui::d3d12::util::GetUintPow2DXGIFormat(element_size_bytes_pow2);
+  desc.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+  desc.Buffer.FirstElement = 0;
+  desc.Buffer.NumElements =
+      std::max(UINT(scaled_resolve_current_range_length_scaled_ >> element_size_bytes_pow2), UINT(1));
+  command_processor_.GetD3D12Provider().GetDevice()->CreateUnorderedAccessView(nullptr, nullptr, &desc, handle);
+}
+
+void D3D12TextureCache::RemoveResolveElideRecordAt(size_t index) {
+  if (resolve_elide_records_[index].elided) {
+    assert_not_zero(resolve_elide_elided_records_);
+    --resolve_elide_elided_records_;
+  }
+  // In age order: the oldest record of a store that was made is the first to go when the watch is full.
+  resolve_elide_records_.erase(resolve_elide_records_.begin() + ptrdiff_t(index));
+}
+
+void D3D12TextureCache::NoteResolveElideWritten(const ResolveElideGeometry& geometry,
+                                                const ResolveElideDecision& decision) {
+  ResolveElideStats& stats = resolve_elide_stats_;
+  ++stats.resolves;
+  // The records whose bytes this resolve has all written again: the same base, row pitch and bytes a texel (the scaled
+  // tiled address of a texel is a function of those and the texel alone, one to one) and an area containing theirs.
+  if (!geometry.array && geometry.bytes_per_texel && !resolve_elide_records_.empty()) {
+    for (size_t i = resolve_elide_records_.size(); i-- > 0;) {
+      const ResolveElideRecord& record = resolve_elide_records_[i];
+      if (record.dest_base != geometry.dest_base || record.pitch_div_32 != geometry.pitch_div_32 ||
+          record.bytes_per_texel != geometry.bytes_per_texel || geometry.x0 > record.x0 || geometry.y0 > record.y0 ||
+          geometry.x1 < record.x1 || geometry.y1 < record.y1) {
+        continue;
+      }
+      if (record.elided) {
+        ++stats.superseded_elided;
+        stats.superseded_elided_bytes += record.host_bytes;
+      } else if (!record.consumed) {
+        ++stats.superseded_unread;
+        stats.superseded_unread_bytes += record.host_bytes;
+      }
+      RemoveResolveElideRecordAt(i);
+    }
+  }
+  if (decision.track && decision.key_index < resolve_elide_keys_.size()) {
+    ResolveElideKeyInfo& info = resolve_elide_keys_[decision.key_index];
+    ResolveElideRecord record;
+    record.key_index = decision.key_index;
+    record.extent_start = geometry.extent_start;
+    record.extent_end = geometry.extent_start + geometry.extent_length;
+    record.dest_base = geometry.dest_base;
+    record.pitch_div_32 = geometry.pitch_div_32;
+    record.bytes_per_texel = geometry.bytes_per_texel;
+    record.x0 = geometry.x0;
+    record.y0 = geometry.y0;
+    record.x1 = geometry.x1;
+    record.y1 = geometry.y1;
+    record.host_bytes = uint64_t(geometry.x1 - geometry.x0) * (geometry.y1 - geometry.y0) * geometry.bytes_per_texel *
+                        draw_resolution_scale_x() * draw_resolution_scale_y();
+    record.written_texture_key = decision.written_texture_key;
+    record.elided = decision.elide;
+    record.would_elide = decision.would_elide;
+    if (resolve_elide_records_.size() >= kMaxResolveElideRecords) {
+      // At most kMaxResolveElideElidedRecords are elided (DecideResolveElide), so a store that was made is there to go.
+      for (size_t i = 0; i < resolve_elide_records_.size(); ++i) {
+        if (!resolve_elide_records_[i].elided) {
+          RemoveResolveElideRecordAt(i);
+          break;
+        }
+      }
+    }
+    if (resolve_elide_records_.size() < kMaxResolveElideRecords || record.elided) {
+      resolve_elide_records_.push_back(record);
+      if (record.elided) {
+        ++resolve_elide_elided_records_;
+      }
+    }
+    ++info.seen;
+    info.store_bytes = record.host_bytes;
+    ++stats.tracked;
+    if (decision.elide) {
+      ++info.elided;
+      info.elided_bytes += record.host_bytes;
+      stats.elided_bytes += record.host_bytes;
+      if (resolve_elide_mode_ >= 3) {
+        PoisonResolveElideRecord(record);
+      }
+    } else if (decision.would_elide) {
+      stats.would_elide_bytes += record.host_bytes;
+    }
+  }
+  LogResolveElideIfDue(false);
+}
+
+void D3D12TextureCache::NoteResolveCopyBytes(const ResolveElideGeometry& geometry, bool dual_written, bool elided) {
+  if (!IsCopyByteCensusOn()) {
+    return;
+  }
+  const uint64_t host_pixels = uint64_t(geometry.x1 > geometry.x0 ? geometry.x1 - geometry.x0 : 0) *
+                               (geometry.y1 > geometry.y0 ? geometry.y1 - geometry.y0 : 0) * draw_resolution_scale_x() *
+                               draw_resolution_scale_y();
+  const uint64_t stored = host_pixels * geometry.bytes_per_texel;
+  CountCopyBytes(CopyByteClass::kResolveRead, host_pixels * geometry.source_bytes_per_pixel);
+  CountCopyBytes(elided ? CopyByteClass::kResolveStoreElided : CopyByteClass::kResolveStore, stored);
+  if (dual_written) {
+    CountCopyBytes(CopyByteClass::kDualWriteTexture, stored);
+  }
+  LogCopyByteCensusIfDue(command_processor_.GetCurrentFrame());
+}
+
+void D3D12TextureCache::NoteTextureLoadForResolveElide(const D3D12Texture& texture, bool load_base, bool load_mips) {
+  const TextureKey key = texture.key();
+  if (IsCopyByteCensusOn()) {
+    const uint64_t scale_area = key.scaled_resolve ? uint64_t(draw_resolution_scale_x()) * draw_resolution_scale_y() : 1;
+    const uint64_t bytes =
+        (uint64_t(load_base ? texture.GetGuestBaseSize() : 0) + (load_mips ? texture.GetGuestMipsSize() : 0)) *
+        scale_area;
+    CountCopyBytes(CopyByteClass::kTextureLoadRead, bytes);
+    CountCopyBytes(CopyByteClass::kTextureLoadWrite, bytes);
+  }
+  // Only a scaled_resolve texture is loaded from the scaled resolve buffer.
+  if (!key.scaled_resolve || resolve_elide_records_.empty() || resolve_elide_ignore_reads_) {
+    return;
+  }
+  if (load_base) {
+    NoteResolveElideScaledRead(key, key.base_page << 12, texture.GetGuestBaseSize());
+  }
+  if (load_mips && key.mip_page) {
+    NoteResolveElideScaledRead(key, key.mip_page << 12, texture.GetGuestMipsSize());
+  }
+}
+
+void D3D12TextureCache::NoteResolveElideScaledRead(const TextureKey& reader, uint32_t start, uint32_t length) {
+  if (!length) {
+    return;
+  }
+  ResolveElideStats& stats = resolve_elide_stats_;
+  const uint64_t end = uint64_t(start) + length;
+  for (size_t i = resolve_elide_records_.size(); i-- > 0;) {
+    ResolveElideRecord& record = resolve_elide_records_[i];
+    if (record.extent_end <= start || record.extent_start >= end) {
+      continue;
+    }
+    ResolveElideKeyInfo& info = resolve_elide_keys_[record.key_index];
+    if (!record.consumed) {
+      record.consumed = true;
+      ++info.consumed;
+      ++stats.consumed;
+      stats.consumed_bytes += record.host_bytes;
+    }
+    const FormatInfo* reader_format = FormatInfo::Get(reader.format);
+    const std::string reader_text = fmt::format(
+        "a {} {}x{} texture at 0x{:08X} ({})", reader_format ? reader_format->name : "?", reader.GetWidth(),
+        reader.GetHeight(), reader.base_page << 12,
+        reader == record.written_texture_key ? "the one the resolve wrote, outdated since" : "not the one the resolve wrote");
+    if (!info.kept_consumed) {
+      info.kept_consumed = true;
+      ++stats.keys_learned;
+      if (resolve_elide_consumed_lines_ < kMaxResolveElideReadLines) {
+        ++resolve_elide_consumed_lines_;
+        REXGPU_INFO("[resolve-elide] read: {} - by the load of {}, after {} stores of it ({} elided); stored from now on",
+                    DescribeResolveElideKey(info), reader_text, info.seen, info.elided);
+      }
+    }
+    if (record.elided) {
+      ++info.misses;
+      ++stats.misses;
+      if (!info.miss_logged) {
+        info.miss_logged = true;
+        REXGPU_ERROR(
+            "[resolve-elide] MISS: the load of {} read the bytes of an elided store of {} (what the buffer held before: "
+            "this texture is wrong); the destination is stored from now on, to keep it in later runs: "
+            "resolve_elide_keep_rules={}",
+            reader_text, DescribeResolveElideKey(info), DescribeResolveElideKey(info));
+      }
+    } else {
+      if (record.would_elide) {
+        ++info.would_misses;
+        ++stats.would_misses;
+        if (!info.miss_logged) {
+          info.miss_logged = true;
+          REXGPU_WARN("[resolve-elide] would-miss: the load of {} read a store of {} that resolve_elide 2 would have "
+                      "elided (its texture would have been wrong once)",
+                      reader_text, DescribeResolveElideKey(info));
+        }
+      }
+      // The bytes were stored: the read is learnt, nothing more to watch.
+      RemoveResolveElideRecordAt(i);
+    }
+  }
+}
+
+void D3D12TextureCache::PoisonResolveElideRecord(const ResolveElideRecord& record) {
+  ResolveElideStats& stats = resolve_elide_stats_;
+  const uint64_t scale_area = uint64_t(draw_resolution_scale_x()) * draw_resolution_scale_y();
+  const uint64_t start_scaled = uint64_t(record.extent_start) * scale_area;
+  const uint64_t length_scaled = uint64_t(record.extent_end - record.extent_start) * scale_area;
+  // The resolve made its range current: the extent is in it.
+  const size_t buffer_index = GetCurrentScaledResolveBufferIndex();
+  const uint64_t buffer_base = uint64_t(buffer_index) << 30;
+  if (!length_scaled || (length_scaled & 3) || start_scaled < scaled_resolve_current_range_start_scaled_ ||
+      start_scaled + length_scaled >
+          scaled_resolve_current_range_start_scaled_ + scaled_resolve_current_range_length_scaled_ ||
+      start_scaled < buffer_base || ((start_scaled - buffer_base) & 3) || (length_scaled >> 2) > UINT32_MAX) {
+    ++stats.poison_skipped;
+    return;
+  }
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  if (!resolve_elide_poison_heap_) {
+    D3D12_DESCRIPTOR_HEAP_DESC heap_desc;
+    heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+    heap_desc.NumDescriptors = kResolveElidePoisonSlots;
+    heap_desc.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_NONE;
+    heap_desc.NodeMask = 0;
+    if (FAILED(device->CreateDescriptorHeap(&heap_desc, IID_PPV_ARGS(&resolve_elide_poison_heap_)))) {
+      ++stats.poison_skipped;
+      return;
+    }
+    resolve_elide_poison_slot_submission_.assign(kResolveElidePoisonSlots, 0);
+  }
+  // A CPU descriptor is read when the clear is recorded, which is when the deferred command list is replayed: one used in a
+  // submission that has not completed yet may not have been.
+  const uint32_t slot = resolve_elide_poison_next_;
+  if (resolve_elide_poison_slot_submission_[slot] > command_processor_.GetCompletedSubmission()) {
+    ++stats.poison_skipped;
+    return;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptor;
+  if (!command_processor_.RequestOneUseSingleViewDescriptors(1, &descriptor)) {
+    ++stats.poison_skipped;
+    return;
+  }
+  resolve_elide_poison_slot_submission_[slot] = command_processor_.GetCurrentSubmission();
+  resolve_elide_poison_next_ = (slot + 1) % kResolveElidePoisonSlots;
+  const D3D12_CPU_DESCRIPTOR_HANDLE cpu_handle =
+      provider.OffsetViewDescriptor(resolve_elide_poison_heap_->GetCPUDescriptorHandleForHeapStart(), slot);
+  ScaledResolveVirtualBuffer& buffer = GetCurrentScaledResolveBuffer();
+  ID3D12Resource* resource = buffer.resource();
+  for (D3D12_CPU_DESCRIPTOR_HANDLE handle : {cpu_handle, descriptor.first}) {
+    ui::d3d12::util::CreateBufferTypedUAV(device, handle, resource, DXGI_FORMAT_R32_UINT, uint32_t(length_scaled >> 2),
+                                          (start_scaled - buffer_base) >> 2);
+  }
+  TransitionCurrentScaledResolveRange(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  command_processor_.PushUAVBarrier(resource);
+  command_processor_.SubmitBarriers();
+  const uint32_t value = REXCVAR_GET(resolve_elide_poison_value);
+  const UINT values[4] = {value, value, value, value};
+  command_processor_.GetDeferredCommandList().D3DClearUnorderedAccessViewUint(descriptor.second, cpu_handle, resource,
+                                                                              values, 0, nullptr);
+  MarkCurrentScaledResolveRangeUAVWritesCommitNeeded();
+  ++stats.poisoned;
+}
+
+std::string D3D12TextureCache::DescribeResolveElideKey(const ResolveElideKeyInfo& info) const {
+  const ResolveElideKeyFields& f = info.fields;
+  return fmt::format("addr=0x{:08X},len={},pitch={},height={},fmt={},src={}", f[0], f[1], f[2], f[3], f[4], f[5]);
+}
+
+void D3D12TextureCache::LogResolveElideIfDue(bool at_exit) {
+  const uint64_t now = rex::chrono::Clock::QueryHostUptimeMillis();
+  const uint64_t frame = command_processor_.GetCurrentFrame();
+  if (!at_exit) {
+    if (!resolve_elide_last_log_ms_) {
+      resolve_elide_last_log_ms_ = now;
+      resolve_elide_last_log_frame_ = frame;
+      return;
+    }
+    if (now - resolve_elide_last_log_ms_ < 10000) {
+      return;
+    }
+  }
+  const double seconds = resolve_elide_last_log_ms_ ? double(now - resolve_elide_last_log_ms_) / 1000.0 : 0.0;
+  const uint64_t frames = frame > resolve_elide_last_log_frame_ ? frame - resolve_elide_last_log_frame_ : 0;
+  const double per_frame = frames ? 1.0 / double(frames) : 0.0;
+  resolve_elide_last_log_ms_ = now;
+  resolve_elide_last_log_frame_ = frame;
+  const ResolveElideStats& stats = resolve_elide_stats_;
+  uint64_t kept_keys = 0;
+  for (const ResolveElideKeyInfo& info : resolve_elide_keys_) {
+    kept_keys += info.kept_consumed ? 1 : 0;
+  }
+  if (stats.resolves || stats.tracked || !resolve_elide_records_.empty() || at_exit) {
+    std::string reasons;
+    for (size_t i = 0; i < size_t(ResolveElideKeep::kCount); ++i) {
+      if (!stats.keep[i]) {
+        continue;
+      }
+      reasons += reasons.empty() ? "" : ", ";
+      reasons += fmt::format("{} {}", kResolveElideKeepNames[i], stats.keep[i]);
+    }
+    std::string untracked;
+    if (stats.not_dual_written || stats.keys_full || stats.not_covered) {
+      untracked = fmt::format(", not tracked: {} not dual-written, {} not covered, {} with the key table full",
+                              stats.not_dual_written, stats.not_covered, stats.keys_full);
+    }
+    std::string poison;
+    if (stats.poisoned || stats.poison_skipped) {
+      poison = fmt::format(", {} poisoned ({} could not be)", stats.poisoned, stats.poison_skipped);
+    }
+    REXGPU_INFO(
+        "[resolve-elide] {} ({}) over {} frames ({:.1f} s): {} resolves at scale, {} dual-written tracked ({}); elided "
+        "{} a frame{}; overwritten whole before any read: {} stores ({} a frame), {} elided ones ({} a frame); read by a "
+        "load: {} records ({} a frame), {} MISSES, {} would-misses; {} destinations ({} stored after a read, {} new "
+        "this time), {} records live ({} elided){}{}",
+        resolve_elide_mode_, kResolveElideModeNames[std::clamp(resolve_elide_mode_, int32_t(0), int32_t(3))], frames,
+        seconds, stats.resolves, stats.tracked, reasons.empty() ? "none" : reasons,
+        Megabytes(double(stats.elided_bytes) * per_frame),
+        stats.would_elide_bytes
+            ? fmt::format(" (2 would elide {} a frame)", Megabytes(double(stats.would_elide_bytes) * per_frame))
+            : std::string(),
+        stats.superseded_unread, Megabytes(double(stats.superseded_unread_bytes) * per_frame), stats.superseded_elided,
+        Megabytes(double(stats.superseded_elided_bytes) * per_frame), stats.consumed,
+        Megabytes(double(stats.consumed_bytes) * per_frame), stats.misses, stats.would_misses,
+        resolve_elide_keys_.size(), kept_keys, stats.keys_learned, resolve_elide_records_.size(),
+        resolve_elide_elided_records_, untracked, poison);
+  }
+  if (at_exit && !resolve_elide_keys_.empty()) {
+    std::string rules;
+    for (const ResolveElideKeyInfo& info : resolve_elide_keys_) {
+      if (info.kept_consumed) {
+        rules += rules.empty() ? "" : ";";
+        rules += DescribeResolveElideKey(info);
+      }
+    }
+    REXGPU_INFO("[resolve-elide] at exit: {} destinations, {} read at least once; as keep rules: {}",
+                resolve_elide_keys_.size(), kept_keys, rules.empty() ? "(none)" : rules);
+    // The destinations with the most bytes stored, and what became of them: the inventory of the dual-written resolves.
+    const uint64_t run_frames =
+        frame > resolve_elide_first_frame_ ? frame - resolve_elide_first_frame_ : uint64_t(1);
+    std::vector<uint32_t> order(resolve_elide_keys_.size());
+    for (uint32_t i = 0; i < uint32_t(order.size()); ++i) {
+      order[i] = i;
+    }
+    std::sort(order.begin(), order.end(), [this](uint32_t a, uint32_t b) {
+      const ResolveElideKeyInfo& ka = resolve_elide_keys_[a];
+      const ResolveElideKeyInfo& kb = resolve_elide_keys_[b];
+      return ka.seen * ka.store_bytes > kb.seen * kb.store_bytes;
+    });
+    for (size_t i = 0; i < std::min(order.size(), size_t(kMaxResolveElideExitKeyLines)); ++i) {
+      const ResolveElideKeyInfo& info = resolve_elide_keys_[order[i]];
+      REXGPU_INFO(
+          "[resolve-elide] at exit: {}: {} stores ({:.2f} a frame over {} frames) of {} each, {} elided ({}), read {} "
+          "times ({} misses, {} would-misses){}",
+          DescribeResolveElideKey(info), info.seen, double(info.seen) / double(run_frames), run_frames,
+          Megabytes(double(info.store_bytes)), info.elided, Megabytes(double(info.elided_bytes)), info.consumed,
+          info.misses, info.would_misses, info.kept_consumed ? ", stored after a read" : "");
+    }
+  }
+  resolve_elide_stats_ = ResolveElideStats();
+}
+
+void D3D12TextureCache::ShutdownResolveElide() {
+  if (resolve_elide_mode_ || !resolve_elide_keys_.empty()) {
+    LogResolveElideIfDue(true);
+  }
+  resolve_elide_records_.clear();
+  resolve_elide_elided_records_ = 0;
+  resolve_elide_poison_heap_.Reset();
+}
