<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="mcla.x86.Host" version="1.0.0.0" processorArchitecture="amd64"/>
  <description>Midnight Club: Los Angeles - x86 host (mcla.exe)</description>

  <!-- Normal user rights: the game reads the game folder and writes under the user and cache folders. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/> <!-- Windows 10 / 11 -->
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- ANSI APIs and the C library's narrow file functions take UTF-8. The SDK turns every path cvar
           (game_data_root, user_data_root, cache_root, log_file) from std::string into a path through the ANSI code
           page (src/ui/rex_app.cpp), so without this a folder with a non-ASCII letter in its name is not found.
           (No two hyphens in a row inside an XML comment: the linker's manifest tool rejects the file.) -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>

      <!-- No DPI awareness here on purpose: the SDK's SDL3 declares per-monitor v2 itself when its video subsystem
           starts (SDL_windowsvideo.c, WIN_InitDPIAwareness: the SDL_WINDOWS_DPI_AWARENESS hint is unset, so
           DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2), before the first window exists. A second declaration in this
           manifest would only make that call fail. -->
    </windowsSettings>
  </application>
</assembly>
